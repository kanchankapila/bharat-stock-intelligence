{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "start": "concurrently \"npm run dev\" \"npm run api\" \"npm run ml-api\" \"npm run chatbot\"",
    "dev": "node --max-old-space-size=4096 node_modules/tsx/dist/cli.mjs watch server.ts",
    "serve": "node --max-old-space-size=4096 node_modules/tsx/dist/cli.mjs server.ts",
    "start:prod": "concurrently \"npm run serve\" \"npm run api\" \"npm run ml-api\" \"npm run chatbot\"",
    "pm2:start": "pm2 start ecosystem.config.cjs",
    "pm2:stop": "pm2 delete ecosystem.config.cjs",
    "pm2:logs": "pm2 logs",
    "api": "cd backend-python && node -e \"const{spawnSync:s}=require('child_process');const py=process.platform==='win32'?'venv/Scripts/python.exe':'venv/bin/python';const r=s(py,['-u','main.py'],{stdio:'inherit',env:{...process.env,PYTHONUNBUFFERED:'1'}});if(r.error)process.stderr.write('[api] spawn error: '+r.error.message+'\\n');process.exit(r.status??1);\"",
    "ml-api": "node -e \"const{spawnSync:s}=require('child_process');const py=process.platform==='win32'?'backend-python/venv/Scripts/python.exe':'backend-python/venv/bin/python';const r=s(py,['-u','src/server/python_api.py'],{stdio:'inherit',env:{...process.env,PYTHONUNBUFFERED:'1'}});if(r.error)process.stderr.write('[ml-api] spawn error: '+r.error.message+'\\n');process.exit(r.status??1);\"",
    "chatbot": "node -e \"const{spawnSync:s}=require('child_process');const py=process.platform==='win32'?'backend-python/venv/Scripts/python.exe':'backend-python/venv/bin/python';const r=s(py,['-u','src/server/chatbot/app.py'],{stdio:'inherit',env:{...process.env,PYTHONUNBUFFERED:'1'}});if(r.error)process.stderr.write('[chatbot] spawn error: '+r.error.message+'\\n');process.exit(r.status??1);\"",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "fetch:chart-patterns": "tsx scripts/fetchChartPatterns.ts",
    "sync:mappings": "tsx scripts/syncAllStockMappings.ts",
    "update:sectors": "tsx scripts/updateSectors.ts"
  },
  "dependencies": {
    "@google/genai": "^2.0.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@tailwindcss/vite": "^4.1.14",
    "@tanstack/react-query": "^5.100.9",
    "@trpc/client": "^11.17.0",
    "@trpc/react-query": "^11.17.0",
    "@trpc/server": "^11.17.0",
    "@types/ioredis": "^4.28.10",
    "@types/pg": "^8.20.0",
    "@vitejs/plugin-react": "^5.0.4",
    "axios": "^1.16.1",
    "better-sqlite3": "^12.9.0",
    "bullmq": "^5.76.7",
    "clsx": "^2.1.1",
    "d3": "^7.9.0",
    "date-fns": "^4.1.0",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "firebase": "^12.12.1",
    "ioredis": "^5.10.1",
    "lightweight-charts": "^5.2.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "ollama": "^0.6.3",
    "pg": "^8.21.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-markdown": "^9.1.0",
    "react-router-dom": "^7.15.1",
    "recharts": "^3.8.1",
    "remark-gfm": "^4.0.1",
    "superjson": "^2.2.6",
    "tailwind-merge": "^3.5.0",
    "vite": "^6.2.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.4.21",
    "concurrently": "^9.2.1",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "vitest": "^1.5.5"
  }
}
