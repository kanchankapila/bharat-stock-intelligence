{
  "__inputs": [
    {
      "name": "DS_POSTGRES",
      "label": "Postgres",
      "description": "The bharat_intel Postgres/TimescaleDB instance (127.0.0.1:5433)",
      "type": "datasource",
      "pluginId": "grafana-postgresql-datasource",
      "pluginName": "PostgreSQL"
    }
  ],
  "__requires": [
    { "type": "grafana", "id": "grafana", "name": "Grafana", "version": "10.0.0" },
    { "type": "datasource", "id": "grafana-postgresql-datasource", "name": "PostgreSQL", "version": "1.0.0" },
    { "type": "panel", "id": "timeseries", "name": "Time series", "version": "" },
    { "type": "panel", "id": "candlestick", "name": "Candlestick", "version": "" },
    { "type": "panel", "id": "table", "name": "Table", "version": "" },
    { "type": "panel", "id": "stat", "name": "Stat", "version": "" },
    { "type": "panel", "id": "gauge", "name": "Gauge", "version": "" },
    { "type": "panel", "id": "bargauge", "name": "Bar gauge", "version": "" }
  ],
  "annotations": { "list": [] },
  "editable": true,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "refresh": "",
  "schemaVersion": 39,
  "tags": ["bharat", "stocks", "nse"],
  "templating": {
    "list": [
      {
        "name": "symbol",
        "label": "Stock",
        "type": "query",
        "datasource": { "type": "grafana-postgresql-datasource", "uid": "${DS_POSTGRES}" },
        "definition": "SELECT symbol FROM nse_stocks WHERE status = 'ACTIVE' ORDER BY symbol",
        "query": "SELECT symbol FROM nse_stocks WHERE status = 'ACTIVE' ORDER BY symbol",
        "refresh": 1,
        "sort": 1,
        "includeAll": false,
        "multi": false,
        "current": { "selected": true, "text": "RELIANCE", "value": "RELIANCE" },
        "options": [],
        "hide": 0,
        "skipUrlSync": false
      }
    ]
  },
  "time": { "from": "now-1y", "to": "now" },
  "timepicker": {},
  "timezone": "Asia/Kolkata",
  "title": "Stock Explorer",
  "uid": "bharat-stock-explorer",
  "version": 1,
  "weekStart": "",
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Last Close",
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 0 },
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "${DS_POSTGRES}" },
      "fieldConfig": {
        "defaults": { "unit": "currencyINR", "decimals": 2, "color": { "mode": "fixed", "fixedColor": "text" } },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "graphMode": "none",
        "textMode": "auto",
        "colorMode": "value"
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT close FROM stock_ohlcv WHERE symbol = '$symbol' ORDER BY date DESC LIMIT 1",
          "datasource": { "type": "grafana-postgresql-datasource", "uid": "${DS_POSTGRES}" }
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "1-Day Change",
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 0 },
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "${DS_POSTGRES}" },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 0 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "graphMode": "none",
        "textMode": "auto",
        "colorMode": "value"
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT round((100.0 * (close - prev) / NULLIF(prev, 0))::numeric, 2) AS \"change\"\nFROM (\n  SELECT date, close, lag(close) OVER (ORDER BY date) AS prev\n  FROM stock_ohlcv WHERE symbol = '$symbol'\n) t\nORDER BY date DESC LIMIT 1",
          "datasource": { "type": "grafana-postgresql-datasource", "uid": "${DS_POSTGRES}" }
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Unified Score",
      "description": "unified_recommendations — the canonical cross-source ranking (unified_ranker.py). Measured forward-return IC is ~0; treat as descriptive, not a trade instruction.",
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 0 },
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "${DS_POSTGRES}" },
      "fieldConfig": {
        "defaults": {
          "decimals": 1,
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "orange", "value": 40 },
              { "color": "yellow", "value": 55 },
              { "color": "green", "value": 70 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "graphMode": "none",
        "textMode": "auto",
        "colorMode": "value"
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT unified_score FROM unified_recommendations WHERE symbol = '$symbol' ORDER BY computed_at DESC LIMIT 1",
          "datasource": { "type": "grafana-postgresql-datasource", "uid": "${DS_POSTGRES}" }
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Call / Conviction",
      "gridPos": { "h": 4, "w": 5, "x": 12, "y": 0 },
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "${DS_POSTGRES}" },
      "fieldConfig": { "defaults": { "color": { "mode": "fixed", "fixedColor": "text" } }, "overrides": [] },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "graphMode": "none",
        "textMode": "auto",
        "colorMode": "none"
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT coalesce(classification, 'n/a') || ' · ' || coalesce(conviction_level, '—') AS \"call\"\nFROM unified_recommendations WHERE symbol = '$symbol' ORDER BY computed_at DESC LIMIT 1",
          "datasource": { "type": "grafana-postgresql-datasource", "uid": "${DS_POSTGRES}" }
        }
      ]
    },
    {
      "id": 5,
      "type": "gauge",
      "title": "RSI (latest)",
      "gridPos": { "h": 4, "w": 4, "x": 17, "y": 0 },
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "${DS_POSTGRES}" },
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 100,
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 60 },
              { "color": "red", "value": 70 }
            ]
          }
        },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "showThresholdLabels": false, "showThresholdMarkers": true },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT rsi FROM technical_signals WHERE symbol = '$symbol' AND rsi IS NOT NULL ORDER BY date DESC LIMIT 1",
          "datasource": { "type": "grafana-postgresql-datasource", "uid": "${DS_POSTGRES}" }
        }
      ]
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Composite Rank",
      "gridPos": { "h": 4, "w": 3, "x": 21, "y": 0 },
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "${DS_POSTGRES}" },
      "fieldConfig": { "defaults": { "decimals": 1 }, "overrides": [] },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "graphMode": "none",
        "textMode": "auto",
        "colorMode": "value"
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT rank_composite FROM quant_scores WHERE symbol = '$symbol'",
          "datasource": { "type": "grafana-postgresql-datasource", "uid": "${DS_POSTGRES}" }
        }
      ]
    },

    {
      "id": 10,
      "type": "candlestick",
      "title": "$symbol — Price",
      "description": "stock_ohlcv, is_suspect rows excluded (ohlcv_quality.py owns that flag).",
      "gridPos": { "h": 11, "w": 16, "x": 0, "y": 4 },
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "${DS_POSTGRES}" },
      "fieldConfig": { "defaults": { "unit": "currencyINR", "custom": {} }, "overrides": [] },
      "options": {
        "mode": "candles",
        "candleStyle": "candles",
        "colorStrategy": "open-close",
        "includeAllFields": false,
        "colors": { "up": "green", "down": "red", "flat": "gray" },
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": false }
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT date AS \"time\", open, high, low, close\nFROM stock_ohlcv\nWHERE symbol = '$symbol'\n  AND coalesce(is_suspect, 0) = 0\n  AND $__timeFilter(date)\nORDER BY date",
          "datasource": { "type": "grafana-postgresql-datasource", "uid": "${DS_POSTGRES}" }
        }
      ]
    },
    {
      "id": 11,
      "type": "table",
      "title": "Latest Unified Recommendation — every field",
      "gridPos": { "h": 11, "w": 8, "x": 16, "y": 4 },
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "${DS_POSTGRES}" },
      "fieldConfig": { "defaults": { "custom": { "align": "auto" } }, "overrides": [] },
      "options": { "showHeader": true, "footer": { "show": false } },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT e.k AS \"Field\", e.v AS \"Value\"\nFROM (\n  SELECT to_jsonb(u) AS j\n  FROM unified_recommendations u\n  WHERE u.symbol = '$symbol'\n  ORDER BY u.computed_at DESC LIMIT 1\n) s,\nLATERAL jsonb_each_text(s.j) AS e(k, v)\nWHERE e.v IS NOT NULL AND e.k NOT IN ('id', 'symbol', 'screener_names_json')\nORDER BY 1",
          "datasource": { "type": "grafana-postgresql-datasource", "uid": "${DS_POSTGRES}" }
        }
      ]
    },

    {
      "id": 20,
      "type": "timeseries",
      "title": "Volume & Delivery %",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 15 },
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "${DS_POSTGRES}" },
      "fieldConfig": {
        "defaults": { "custom": { "drawStyle": "bars", "fillOpacity": 60, "lineWidth": 0 } },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Delivery %" },
            "properties": [
              { "id": "custom.drawStyle", "value": "line" },
              { "id": "custom.lineWidth", "value": 2 },
              { "id": "custom.fillOpacity", "value": 0 },
              { "id": "unit", "value": "percent" },
              { "id": "custom.axisPlacement", "value": "right" }
            ]
          }
        ]
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "none" } },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT o.date AS \"time\", o.volume AS \"Volume\", d.delivery_pct AS \"Delivery %\"\nFROM stock_ohlcv o\nLEFT JOIN stock_delivery_data d\n  ON d.symbol = o.symbol AND d.date = o.date::text\nWHERE o.symbol = '$symbol' AND $__timeFilter(o.date)\nORDER BY 1",
          "datasource": { "type": "grafana-postgresql-datasource", "uid": "${DS_POSTGRES}" }
        }
      ]
    },
    {
      "id": 21,
      "type": "timeseries",
      "title": "RSI / ADX / Win probability",
      "description": "technical_signals. win_probability is the LGBM ensemble output, scored the evening of each row's date.",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 15 },
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "${DS_POSTGRES}" },
      "fieldConfig": { "defaults": { "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 0, "spanNulls": true } }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "none" } },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT date::date AS \"time\",\n       rsi AS \"RSI\",\n       adx AS \"ADX\",\n       win_probability * 100 AS \"Win prob %\"\nFROM technical_signals\nWHERE symbol = '$symbol' AND $__timeFilter(date::date)\nORDER BY 1",
          "datasource": { "type": "grafana-postgresql-datasource", "uid": "${DS_POSTGRES}" }
        }
      ]
    },

    {
      "id": 30,
      "type": "timeseries",
      "title": "MACD / Bollinger width",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 23 },
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "${DS_POSTGRES}" },
      "fieldConfig": { "defaults": { "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 0, "spanNulls": true } }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "none" } },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT date::date AS \"time\",\n       macd AS \"MACD\",\n       macd_signal AS \"MACD signal\",\n       bb_width AS \"BB width\",\n       volume_ratio AS \"Volume ratio\"\nFROM technical_signals\nWHERE symbol = '$symbol' AND $__timeFilter(date::date)\nORDER BY 1",
          "datasource": { "type": "grafana-postgresql-datasource", "uid": "${DS_POSTGRES}" }
        }
      ]
    },
    {
      "id": 31,
      "type": "timeseries",
      "title": "Trendlyne DVM scores",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 23 },
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "${DS_POSTGRES}" },
      "fieldConfig": { "defaults": { "min": 0, "max": 100, "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 5, "spanNulls": true } }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "none" } },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT date::date AS \"time\",\n       d_score AS \"Durability\",\n       v_score AS \"Valuation\",\n       m_score AS \"Momentum\"\nFROM trendlyne_dvm_scores\nWHERE symbol = '$symbol' AND $__timeFilter(date::date)\nORDER BY 1",
          "datasource": { "type": "grafana-postgresql-datasource", "uid": "${DS_POSTGRES}" }
        }
      ]
    },

    {
      "id": 40,
      "type": "timeseries",
      "title": "Score history — unified & component engines",
      "description": "unified_recommendations_history (append-only snapshots keyed on generated_at).",
      "gridPos": { "h": 8, "w": 16, "x": 0, "y": 31 },
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "${DS_POSTGRES}" },
      "fieldConfig": { "defaults": { "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 0, "spanNulls": true, "pointSize": 6, "showPoints": "auto" } }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "none" } },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT computed_at::date AS \"time\",\n       unified_score      AS \"Unified\",\n       technical_score    AS \"Technical\",\n       ml_score           AS \"ML\",\n       confluence_score   AS \"Confluence\",\n       fundamental_score  AS \"Fundamental\",\n       screener_stock_score AS \"Screener\",\n       cs_score           AS \"Cross-sectional\",\n       breakout_score     AS \"Breakout\",\n       smart_money_score  AS \"Smart money\"\nFROM unified_recommendations_history\nWHERE symbol = '$symbol' AND $__timeFilter(computed_at::date)\nORDER BY 1",
          "datasource": { "type": "grafana-postgresql-datasource", "uid": "${DS_POSTGRES}" }
        }
      ]
    },
    {
      "id": 41,
      "type": "bargauge",
      "title": "Quant ranks",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 31 },
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "${DS_POSTGRES}" },
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 100,
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "orange", "value": 33 },
              { "color": "yellow", "value": 50 },
              { "color": "green", "value": 75 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "displayMode": "gradient",
        "orientation": "horizontal",
        "showUnfilled": true
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT rank_momentum AS \"Momentum\",\n       rank_quality  AS \"Quality\",\n       rank_value    AS \"Value\",\n       rank_composite AS \"Composite\",\n       mf_composite_score AS \"Multi-factor\"\nFROM quant_scores WHERE symbol = '$symbol'",
          "datasource": { "type": "grafana-postgresql-datasource", "uid": "${DS_POSTGRES}" }
        }
      ]
    },

    {
      "id": 50,
      "type": "table",
      "title": "Quant scores — every field",
      "gridPos": { "h": 11, "w": 8, "x": 0, "y": 39 },
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "${DS_POSTGRES}" },
      "fieldConfig": { "defaults": { "custom": { "align": "auto" } }, "overrides": [] },
      "options": { "showHeader": true, "footer": { "show": false } },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT e.k AS \"Field\", e.v AS \"Value\"\nFROM (SELECT to_jsonb(q) AS j FROM quant_scores q WHERE q.symbol = '$symbol') s,\nLATERAL jsonb_each_text(s.j) AS e(k, v)\nWHERE e.v IS NOT NULL AND e.k <> 'symbol'\nORDER BY 1",
          "datasource": { "type": "grafana-postgresql-datasource", "uid": "${DS_POSTGRES}" }
        }
      ]
    },
    {
      "id": 51,
      "type": "table",
      "title": "Latest technical features (non-null)",
      "description": "Most recent technical_signals row, NULL columns hidden. ~250 columns exist; many are legitimately empty pending calendar depth.",
      "gridPos": { "h": 11, "w": 8, "x": 8, "y": 39 },
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "${DS_POSTGRES}" },
      "fieldConfig": { "defaults": { "custom": { "align": "auto" } }, "overrides": [] },
      "options": { "showHeader": true, "footer": { "show": false } },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT e.k AS \"Feature\", e.v AS \"Value\"\nFROM (\n  SELECT to_jsonb(t) AS j FROM technical_signals t\n  WHERE t.symbol = '$symbol' ORDER BY t.date DESC LIMIT 1\n) s,\nLATERAL jsonb_each_text(s.j) AS e(k, v)\nWHERE e.v IS NOT NULL AND e.k NOT IN ('symbol', 'signals_json')\nORDER BY 1",
          "datasource": { "type": "grafana-postgresql-datasource", "uid": "${DS_POSTGRES}" }
        }
      ]
    },
    {
      "id": 52,
      "type": "table",
      "title": "Fundamentals history",
      "gridPos": { "h": 11, "w": 8, "x": 16, "y": 39 },
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "${DS_POSTGRES}" },
      "fieldConfig": { "defaults": { "custom": { "align": "auto" } }, "overrides": [] },
      "options": { "showHeader": true, "footer": { "show": false } },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT as_of_date AS \"As of\",\n       market_cap AS \"Market cap\",\n       price_to_book AS \"P/B\",\n       earnings_yield AS \"Earnings yield\",\n       return_on_equity AS \"ROE\",\n       operating_margins AS \"Op margin\",\n       revenue_growth AS \"Rev growth\",\n       earnings_growth AS \"EPS growth\",\n       debt_to_equity AS \"D/E\",\n       piotroski_f_score AS \"Piotroski F\",\n       pledge_pct AS \"Pledge %\",\n       fifty_two_week_high AS \"52w high\"\nFROM fundamentals_history\nWHERE symbol = '$symbol'\nORDER BY as_of_date DESC\nLIMIT 30",
          "datasource": { "type": "grafana-postgresql-datasource", "uid": "${DS_POSTGRES}" }
        }
      ]
    },

    {
      "id": 60,
      "type": "table",
      "title": "Signals emitted for $symbol",
      "gridPos": { "h": 10, "w": 12, "x": 0, "y": 50 },
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "${DS_POSTGRES}" },
      "fieldConfig": { "defaults": { "custom": { "align": "auto" } }, "overrides": [] },
      "options": { "showHeader": true, "footer": { "show": false } },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT signal_date AS \"Date\",\n       signal_source AS \"Source\",\n       signal_type AS \"Type\",\n       entry_price AS \"Entry\",\n       target_price AS \"Target\",\n       stop_loss AS \"Stop\",\n       confidence_score AS \"Confidence\",\n       status AS \"Status\",\n       reasoning AS \"Reasoning\"\nFROM unified_signals\nWHERE symbol = '$symbol'\nORDER BY signal_date DESC\nLIMIT 100",
          "datasource": { "type": "grafana-postgresql-datasource", "uid": "${DS_POSTGRES}" }
        }
      ]
    },
    {
      "id": 61,
      "type": "table",
      "title": "Graded outcomes",
      "description": "Do NOT compare win rates across different label_definition values — terminal_pct2 and path_barrier are structurally different rules (see .claude/rules/measurement.md).",
      "gridPos": { "h": 10, "w": 12, "x": 12, "y": 50 },
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "${DS_POSTGRES}" },
      "fieldConfig": {
        "defaults": { "custom": { "align": "auto" } },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Return %" },
            "properties": [
              { "id": "unit", "value": "percent" },
              { "id": "custom.cellOptions", "value": { "type": "color-text" } },
              {
                "id": "thresholds",
                "value": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 0 }] }
              }
            ]
          }
        ]
      },
      "options": { "showHeader": true, "footer": { "show": false } },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT signal_date AS \"Signal date\",\n       signal_source AS \"Source\",\n       horizon_days AS \"Horizon (d)\",\n       label_definition AS \"Label def\",\n       entry_price AS \"Entry\",\n       exit_price AS \"Exit\",\n       round(return_pct::numeric, 2) AS \"Return %\",\n       outcome AS \"Outcome\"\nFROM signal_outcomes\nWHERE symbol = '$symbol'\nORDER BY signal_date DESC, horizon_days\nLIMIT 200",
          "datasource": { "type": "grafana-postgresql-datasource", "uid": "${DS_POSTGRES}" }
        }
      ]
    },

    {
      "id": 70,
      "type": "table",
      "title": "News & sentiment",
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 60 },
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "${DS_POSTGRES}" },
      "fieldConfig": {
        "defaults": { "custom": { "align": "auto" } },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Headline" },
            "properties": [
              { "id": "custom.width", "value": 620 },
              { "id": "links", "value": [{ "title": "Open article", "url": "${__data.fields[\"URL\"]}", "targetBlank": true }] }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Score" },
            "properties": [
              { "id": "custom.cellOptions", "value": { "type": "color-text" } },
              {
                "id": "thresholds",
                "value": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "text", "value": -0.05 }, { "color": "green", "value": 0.05 }] }
              }
            ]
          },
          { "matcher": { "id": "byName", "options": "URL" }, "properties": [{ "id": "custom.hidden", "value": true }] }
        ]
      },
      "options": { "showHeader": true, "footer": { "show": false } },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT n.published_at AS \"Published\",\n       n.title AS \"Headline\",\n       n.sentiment AS \"Sentiment\",\n       round(n.sentiment_score::numeric, 3) AS \"Score\",\n       n.impact AS \"Impact\",\n       n.source AS \"Source\",\n       n.url AS \"URL\"\nFROM news_symbol_link l\nJOIN news_sentiment_items n ON n.id = l.news_id\nWHERE l.symbol = '$symbol'\nORDER BY n.published_at DESC\nLIMIT 100",
          "datasource": { "type": "grafana-postgresql-datasource", "uid": "${DS_POSTGRES}" }
        }
      ]
    }
  ]
}
