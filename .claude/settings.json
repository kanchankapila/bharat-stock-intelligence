{
  "permissions": {
    "allow": [
      "Bash(git commit *)",
      "Bash(npm test *)",
      "WebFetch(domain:trendlyne.com)",
      "WebFetch(domain:moneycontrol.com)",
      "WebFetch(domain:webapi.niftytrader.in)",
      "Bash(git check-ignore *)",
      "Bash(npx vitest *)",
      "Bash(npx tsc *)",
      "Bash(git checkout *)",
      "Bash(git add *)",
      "Bash(git commit -m ' *)",
      "Bash(git fetch *)",
      "Bash(git stash *)"
    ],
    "additionalDirectories": [
      "D:\\Github\\bharat-stock-intelligence\\src\\server"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh\"",
            "timeout": 900
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/rules-pointer.mjs"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/verify-gate.mjs"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "frontend-design@claude-plugins-official": true
  }
}
