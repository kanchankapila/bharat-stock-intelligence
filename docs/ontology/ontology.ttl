    bsi:leakageRisk "none" ;
    bsi:usableAsFeature "true"^^xsd:boolean ;
    bsi:isLabel "false"^^xsd:boolean ;
    bsi:boundTo bsis:insider_trades.quantity, bsis:block_deals.qty .

bsip:delivery_qty     rdf:type owl:DatatypeProperty ;
    rdfs:label "Delivered quantity" ;
    rdfs:comment "Shares actually delivered." ;
