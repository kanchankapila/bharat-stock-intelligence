bsip:value_inr     rdf:type owl:DatatypeProperty ;
    rdfs:label "Value (INR)" ;
    rdfs:comment "Transaction value in rupees, as a bare number." ;
    rdfs:range xsd:decimal ;
    bsi:semanticType "measure" ;
    bsi:timing "coincident" ;
    bsi:derivation "vendor" ;
    bsi:leakageRisk "none" ;
    bsi:usableAsFeature "true"^^xsd:boolean ;
    bsi:isLabel "false"^^xsd:boolean ;
    skos:altLabel "transaction_value" ;
    bsi:pointInTimeNote "Rupees as a bare number; no currency term is attached to the column." ;
    bsi:boundTo bsis:corporate_actions.amount, bsis:insider_trades.valueInr ;
    skos:closeMatch fibo-fnd-acc-cur:MonetaryAmount ;
    bsi:alignmentRationale "[fibo-fnd-acc-cur:MonetaryAmount] Insider-transaction value in rupees, again as a bare number with no currency term attached." ;
    bsi:verifiedFrom "https://github.com/edmcouncil/fibo (published prefix declarations) + FIBO IRI space under spec.edmcouncil.org; class symbols cross-checked against declared FIBO type stereotypes. Fetched 2026-09-21." .

bsip:value_cr     rdf:type owl:DatatypeProperty ;
    rdfs:label "Value (crore)" ;
    rdfs:comment "Transaction value in CRORES, as a bare number. The multiplier is not declared anywhere in the schema — see alignment.py." ;
    rdfs:range xsd:decimal ;
    bsi:semanticType "measure" ;
    bsi:timing "coincident" ;
    bsi:derivation "vendor" ;
    bsi:leakageRisk "none" ;
    bsi:usableAsFeature "true"^^xsd:boolean ;
    bsi:isLabel "false"^^xsd:boolean ;
    bsi:pointInTimeNote "CRORES as a bare number. Multiplying by 1e7 gives rupees, but nothing in the schema says so — the assumption must be stated by any consumer." ;
    bsi:boundTo bsis:block_deals.value_cr, bsis:technical_signals.block_deal_value_cr ;
    skos:closeMatch fibo-fnd-acc-cur:MonetaryAmount ;
    bsi:alignmentRationale "[fibo-fnd-acc-cur:MonetaryAmount] Block-deal value held in CRORES as a bare float. FIBO requires amount plus currency; our column carries neither, so a consumer must know the multiplier out of band. Exactly the ambiguity this alignment exists to surface." ;
    bsi:verifiedFrom "https://github.com/edmcouncil/fibo (published prefix declarations) + FIBO IRI space under spec.edmcouncil.org; class symbols cross-checked against declared FIBO type stereotypes. Fetched 2026-09-21." .

bsip:pcr     rdf:type owl:DatatypeProperty ;
    rdfs:label "Put-call ratio" ;
    rdfs:comment "Index put-call ratio." ;
    rdfs:range xsd:decimal ;
    bsi:semanticType "measure" ;
    bsi:timing "coincident" ;
    bsi:derivation "vendor" ;
    bsi:leakageRisk "none" ;
    bsi:usableAsFeature "true"^^xsd:boolean ;
    bsi:isLabel "false"^^xsd:boolean ;
    qudt:unit "ratio" ;
    bsi:boundTo bsis:nt_index_pcr_ts.pcr, bsis:nt_index_pcr_ts.volume_pcr, bsis:nt_index_pcr_ts.change_oi_pcr, bsis:intraday_regime_history.pcr .

bsip:pcr_oi     rdf:type owl:DatatypeProperty ;
