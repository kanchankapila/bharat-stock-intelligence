    bsi:trainingUse "forbidden" ;
    bsi:primaryKey "id" ;
    bsi:freshnessColumn "updated_at" ;
    bsi:writtenBy "url_explorer.ingest" ;
    bsi:caveat "Use it via `python -m url_explorer.ingest --find-alternates` from `src/server`, which is the sanctioned path.", "`host` and `provider` are different grains of the same concept and share one property here — read them by name." ;
    bsi:hasColumn _:col_url_endpoints_id, _:col_url_endpoints_template, _:col_url_endpoints_host, _:col_url_endpoints_method, _:col_url_endpoints_provider, _:col_url_endpoints_category, _:col_url_endpoints_description, _:col_url_endpoints_updated_at .

