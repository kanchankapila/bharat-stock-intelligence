    bsi:timing "context" ;
    bsi:derivation "vendor" ;
    bsi:leakageRisk "none" ;
    bsi:usableAsFeature "true"^^xsd:boolean ;
    bsi:isLabel "false"^^xsd:boolean ;
    bsi:boundTo bsis:market_endpoint_registry.output_fields .

bsip:option_premium     rdf:type owl:DatatypeProperty ;
    rdfs:label "Option premium" ;
    rdfs:comment "Premium of an option leg (call or put)." ;
    rdfs:range xsd:decimal ;
    bsi:semanticType "measure" ;
    bsi:timing "coincident" ;
    bsi:derivation "vendor" ;
    bsi:leakageRisk "none" ;
    bsi:usableAsFeature "true"^^xsd:boolean ;
    bsi:isLabel "false"^^xsd:boolean ;
    qudt:unit "per_share_INR" ;
    bsi:boundTo bsis:so_option_chain.ce_price, bsis:so_option_chain.pe_price .

bsip:option_volume     rdf:type owl:DatatypeProperty ;
    rdfs:label "Option volume" ;
    rdfs:comment "Contracts traded on that leg." ;
    rdfs:range xsd:decimal ;
    bsi:semanticType "measure" ;
    bsi:timing "coincident" ;
    bsi:derivation "vendor" ;
    bsi:leakageRisk "none" ;
    bsi:usableAsFeature "true"^^xsd:boolean ;
    bsi:isLabel "false"^^xsd:boolean ;
    qudt:unit "per_share_INR" ;
    bsi:boundTo bsis:so_option_chain.ce_volume, bsis:so_option_chain.pe_volume .

bsip:option_oi     rdf:type owl:DatatypeProperty ;
    rdfs:label "Option open interest" ;
    rdfs:comment "Open interest on that leg." ;
    rdfs:range xsd:decimal ;
    bsi:semanticType "measure" ;
    bsi:timing "coincident" ;
    bsi:derivation "vendor" ;
    bsi:leakageRisk "none" ;
    bsi:usableAsFeature "true"^^xsd:boolean ;
    bsi:isLabel "false"^^xsd:boolean ;
    qudt:unit "per_share_INR" ;
    bsi:boundTo bsis:so_option_chain.ce_oi, bsis:so_option_chain.pe_oi, bsis:index_max_pain.total_ce_oi, bsis:index_max_pain.total_pe_oi .

bsip:option_iv     rdf:type owl:DatatypeProperty ;
    rdfs:label "Option implied volatility" ;
    rdfs:comment "Implied volatility of that leg." ;
    rdfs:range xsd:decimal ;
    bsi:semanticType "measure" ;
    bsi:timing "coincident" ;
    bsi:derivation "vendor" ;
    bsi:leakageRisk "none" ;
    bsi:usableAsFeature "true"^^xsd:boolean ;
    bsi:isLabel "false"^^xsd:boolean ;
    qudt:unit "per_share_INR" ;
    bsi:boundTo bsis:so_option_chain.ce_iv, bsis:so_option_chain.pe_iv .

bsip:option_oi_chg_pct     rdf:type owl:DatatypeProperty ;
    rdfs:label "Option OI change percent" ;
    rdfs:comment "Session-over-session OI change for that leg." ;
    rdfs:range xsd:decimal ;
    bsi:semanticType "measure" ;
    bsi:timing "coincident" ;
    bsi:derivation "vendor" ;
    bsi:leakageRisk "none" ;
    bsi:usableAsFeature "true"^^xsd:boolean ;
    bsi:isLabel "false"^^xsd:boolean ;
    qudt:unit "per_share_INR" ;
    bsi:boundTo bsis:so_option_chain.ce_oi_chg_pct, bsis:so_option_chain.pe_oi_chg_pct .

bsip:futures_price     rdf:type owl:DatatypeProperty ;
    rdfs:label "Futures price" ;
    rdfs:comment "Price of the futures leg." ;
    rdfs:range xsd:decimal ;
    bsi:semanticType "measure" ;
    bsi:timing "coincident" ;
    bsi:derivation "vendor" ;
    bsi:leakageRisk "none" ;
    bsi:usableAsFeature "true"^^xsd:boolean ;
    bsi:isLabel "false"^^xsd:boolean ;
    qudt:unit "per_share_INR" ;
    bsi:boundTo bsis:stock_futures_oi_history.futures_price .

bsip:spot_price     rdf:type owl:DatatypeProperty ;
    rdfs:label "Spot price" ;
    rdfs:comment "Underlying spot price captured at the same instant as the derivative." ;
    rdfs:range xsd:decimal ;
    bsi:semanticType "measure" ;
    bsi:timing "coincident" ;
    bsi:derivation "vendor" ;
    bsi:leakageRisk "none" ;
    bsi:usableAsFeature "true"^^xsd:boolean ;
    bsi:isLabel "false"^^xsd:boolean ;
    qudt:unit "per_share_INR" ;
    bsi:boundTo bsis:stock_futures_oi_history.spot_price, bsis:fno_rollover.spot_price .

bsip:option_buildup     rdf:type owl:DatatypeProperty ;
    rdfs:label "Option buildup" ;
    rdfs:comment "Leg-level positioning label." ;
    rdfs:range xsd:string ;
    bsi:semanticType "enum" ;
    bsi:timing "context" ;
    bsi:derivation "vendor" ;
    bsi:leakageRisk "none" ;
    bsi:usableAsFeature "true"^^xsd:boolean ;
    bsi:isLabel "false"^^xsd:boolean ;
    skos:inScheme bsiv:option_buildup ;
    bsi:boundTo bsis:so_option_chain.ce_buildup, bsis:so_option_chain.pe_buildup .

bsir:instrumentHasBar     rdf:type owl:ObjectProperty ;
    rdfs:label "has daily bar" ;
    rdfs:comment "Every daily bar for an instrument. The universal time-series edge and the substrate of every return calculation." ;
    rdfs:domain bsi:Equity ;
    rdfs:range bsi:Bar ;
    bsi:cardinality "1:N" ;
    bsi:gradedStatus "live" ;
    bsi:traversal "stock_ohlcv.symbol = stock_master.symbol" ;
    bsi:joinKey "symbol", "date" ;
    bsi:realizedBy bsis:stock_ohlcv, bsis:stock_master .

bsir:instrumentHasIntradayBar     rdf:type owl:ObjectProperty ;
    rdfs:label "has intraday bar" ;
    rdfs:comment "Sub-daily bars for an instrument, at a single interval over recent history." ;
    rdfs:domain bsi:Equity ;
    rdfs:range bsi:IntradayBar ;
    bsi:cardinality "1:N" ;
    bsi:gradedStatus "live" ;
    bsi:joinKey "symbol", "datetime" ;
    bsi:realizedBy bsis:intraday_ohlcv, bsis:stock_master .

bsir:instrumentHasDelivery     rdf:type owl:ObjectProperty ;
    rdfs:label "has delivery observation" ;
    rdfs:comment "Exchange delivery data per session: the ownership-behaviour edge, and one of the links the master report explicitly names as unquantified." ;
    rdfs:domain bsi:Equity ;
    rdfs:range bsi:DeliveryObservation ;
    bsi:cardinality "1:N" ;
    bsi:gradedStatus "research-candidate" ;
    bsi:evidence "Master report §6 marks delivery-to-swing-returns as an unquantified link; ungraded by factor_edge.py to date. The T+1 lag is why it is not usable same-session." ;
    bsi:joinKey "symbol", "date" ;
    bsi:realizedBy bsis:stock_delivery_data, bsis:stock_master .

bsir:instrumentHasCorporateAction     rdf:type owl:ObjectProperty ;
    rdfs:label "has corporate action" ;
    rdfs:comment "Capital-structure events with their ex-dates — the edge that governs price adjustment and event-aware risk filtering." ;
    rdfs:domain bsi:Equity ;
    rdfs:range bsi:CorporateAction ;
    bsi:cardinality "1:N" ;
    bsi:gradedStatus "live" ;
    bsi:joinKey "symbol", "ex_date" ;
    bsi:realizedBy bsis:corporate_actions, bsis:stock_master .

bsir:instrumentHasFundamentalSnapshot     rdf:type owl:ObjectProperty ;
    rdfs:label "has fundamental snapshot" ;
    rdfs:comment "Dated vendor fundamental snapshots. Lagging information: the edge is only point-in-time honest when filtered on the as-of date." ;
    rdfs:domain bsi:Equity ;
    rdfs:range bsi:FundamentalSnapshot ;
    bsi:cardinality "1:N" ;
    bsi:gradedStatus "measured" ;
    bsi:evidence "Book-to-price measured not significant on this platform; the edge is retained for conditioning rather than for a standalone reading." ;
    bsi:joinKey "symbol", "as_of_date" ;
    bsi:realizedBy bsis:fundamentals_history, bsis:stock_master .

bsir:instrumentHasAnalystEstimate     rdf:type owl:ObjectProperty ;
    rdfs:label "has analyst estimate" ;
    rdfs:comment "Consensus snapshots per as-of date — the leading edge in the fundamentals family." ;
    rdfs:domain bsi:Equity ;
    rdfs:range bsi:AnalystEstimate ;
    bsi:cardinality "1:N" ;
    bsi:gradedStatus "ungraded" ;
    bsi:evidence "The revision trio from this table is calendar-blocked to ~2026-10." ;
    bsi:joinKey "symbol", "as_of_date" ;
    bsi:realizedBy bsis:analyst_estimates_history, bsis:stock_master .

bsir:instrumentHasEarningsSurprise     rdf:type owl:ObjectProperty ;
    rdfs:label "has earnings surprise" ;
    rdfs:comment "Per-quarter actual-versus-estimate surprise. Join runs through the vendor scid map as well as the symbol." ;
    rdfs:domain bsi:Equity ;
    rdfs:range bsi:EarningsSurprise ;
    bsi:cardinality "1:N" ;
    bsi:gradedStatus "ungraded" ;
    bsi:joinKey "symbol", "quarter" ;
    bsi:realizedBy bsis:eps_surprise_history, bsis:mc_scid_map, bsis:stock_master .

bsir:instrumentHasInsiderTransaction     rdf:type owl:ObjectProperty ;
    rdfs:label "has insider transaction" ;
    rdfs:comment "Insider filings — graded weak standalone, so this edge feeds confluence rather than the ranker directly." ;
    rdfs:domain bsi:Equity ;
    rdfs:range bsi:InsiderTransaction ;
    bsi:cardinality "1:N" ;
    bsi:gradedStatus "measured" ;
    bsi:evidence "Net insider flow measured NOT SIGNIFICANT as a standalone factor; retained as a confluence input only." ;
    bsi:joinKey "symbol", "date" ;
    bsi:realizedBy bsis:insider_trades, bsis:stock_master .

bsir:instrumentHasBlockDeal     rdf:type owl:ObjectProperty ;
    rdfs:label "has block deal" ;
    rdfs:comment "Off-book transactions. Features derived from this edge exist downstream but carry no standalone reading." ;
    rdfs:domain bsi:Equity ;
    rdfs:range bsi:BlockDeal ;
    bsi:cardinality "1:N" ;
    bsi:gradedStatus "measured" ;
    bsi:joinKey "symbol", "date" ;
    bsi:realizedBy bsis:block_deals, bsis:stock_master .

bsir:instrumentHasMFHolding     rdf:type owl:ObjectProperty ;
    rdfs:label "has mutual-fund holding" ;
    rdfs:comment "Disclosure-grain mutual-fund ownership per instrument." ;
    rdfs:domain bsi:Equity ;
    rdfs:range bsi:MFHolding ;
    bsi:cardinality "1:N" ;
    bsi:gradedStatus "ungraded" ;
    bsi:joinKey "symbol", "date" ;
    bsi:realizedBy bsis:stock_mf_holdings, bsis:stock_master .

bsir:instrumentHasOptionChain     rdf:type owl:ObjectProperty ;
    rdfs:label "has option chain" ;
    rdfs:comment "Per-strike option grid for a stock. A grid, not a series: traversing it multiplies rows, so any aggregation must be explicit." ;
    rdfs:domain bsi:Equity ;
    rdfs:range bsi:OptionChainRow ;
    bsi:cardinality "1:N" ;
    bsi:gradedStatus "ungraded" ;
    bsi:joinKey "symbol", "date", "expiry", "strike" ;
    bsi:realizedBy bsis:so_option_chain, bsis:stock_master .

bsir:instrumentHasFuturesPositioning     rdf:type owl:ObjectProperty ;
    rdfs:label "has futures positioning" ;
    rdfs:comment "Stock-futures open interest and rollover state per expiry." ;
    rdfs:domain bsi:Equity ;
    rdfs:range bsi:FuturesPositioning ;
    bsi:cardinality "1:N" ;
    bsi:gradedStatus "low-data" ;
    bsi:evidence "~14 dates of stock-level panel. Master-report verdict: LOW-DATA. Any reading here is a calendar artefact." ;
    bsi:joinKey "symbol", "date", "expiry" ;
    bsi:realizedBy bsis:stock_futures_oi_history, bsis:fno_rollover, bsis:stock_master .

bsir:instrumentHasFeatureVector     rdf:type owl:ObjectProperty ;
    rdfs:label "has feature vector" ;
    rdfs:comment "The rolling feature panel per instrument and date — the training substrate." ;
    rdfs:domain bsi:Equity ;
    rdfs:range bsi:FeatureVector ;
    bsi:cardinality "1:N" ;
    bsi:gradedStatus "live" ;
    bsi:joinKey "symbol", "date" ;
    bsi:realizedBy bsis:feature_store, bsis:stock_master .

bsir:instrumentHasTechnicalSignal     rdf:type owl:ObjectProperty ;
    rdfs:label "has technical signal" ;
    rdfs:comment "The wide indicator panel per instrument and date, including the regime stamp." ;
    rdfs:domain bsi:Equity ;
    rdfs:range bsi:TechnicalSignal ;
    bsi:cardinality "1:N" ;
    bsi:gradedStatus "live" ;
    bsi:joinKey "symbol", "date" ;
    bsi:realizedBy bsis:technical_signals, bsis:stock_master .

bsir:instrumentServedRecommendation     rdf:type owl:ObjectProperty ;
    rdfs:label "was served a recommendation" ;
    rdfs:comment "Served trades per instrument, timeframe and computation instant." ;
    rdfs:domain bsi:Equity ;
    rdfs:range bsi:Recommendation ;
    bsi:cardinality "1:N" ;
    bsi:gradedStatus "live" ;
    bsi:joinKey "symbol", "computed_at", "timeframe" ;
    bsi:realizedBy bsis:unified_recommendations, bsis:unified_recommendations_history, bsis:stock_master .

bsir:signalResolvedToOutcome     rdf:type owl:ObjectProperty ;
    rdfs:label "resolved to outcome" ;
    rdfs:comment "A signal's resolved result. Traversal must also pin the horizon and the labelling rule, or outcomes from incompatible definitions get mixed together." ;
    rdfs:domain bsi:TechnicalSignal ;
    rdfs:range bsi:SignalOutcome ;
    bsi:cardinality "N:1" ;
    bsi:gradedStatus "live" ;
    bsi:joinKey "symbol", "signal_date", "horizon_days" ;
    bsi:realizedBy bsis:signal_outcomes, bsis:technical_signals .

bsir:outcomeHasExcursion     rdf:type owl:ObjectProperty ;
    rdfs:label "has excursion path" ;
    rdfs:comment "Intra-window path statistics for an outcome — what makes stop-placement studies possible at all." ;
    rdfs:domain bsi:SignalOutcome ;
    rdfs:range bsi:SignalExcursion ;
    bsi:cardinality "1:1" ;
    bsi:gradedStatus "live" ;
    bsi:joinKey "symbol", "signal_date", "horizon_days" ;
    bsi:realizedBy bsis:signal_excursions, bsis:signal_outcomes .

bsir:newsMentionsInstrument     rdf:type owl:ObjectProperty ;
    rdfs:label "mentions instrument" ;
    rdfs:comment "Article-to-symbol mentions, traversed through the link table rather than the JSON array on the news row." ;
    rdfs:domain bsi:NewsItem ;
    rdfs:range bsi:Equity ;
    bsi:cardinality "N:M" ;
    bsi:gradedStatus "measured" ;
    bsi:evidence "News-sentiment conditioning on movers measured a lift of ~0.13 (n=114, p=0.037) — a lead, not a result." ;
    bsi:joinKey "news_id", "symbol" ;
    bsi:realizedBy bsis:news_symbol_link, bsis:news_sentiment_items, bsis:stock_master .

bsir:instrumentHasEventTrigger     rdf:type owl:ObjectProperty ;
    rdfs:label "has event trigger" ;
    rdfs:comment "Detector output per instrument and date: which composite trigger classes fired." ;
    rdfs:domain bsi:Equity ;
    rdfs:range bsi:EventTrigger ;
    bsi:cardinality "1:N" ;
    bsi:gradedStatus "ungraded" ;
    bsi:joinKey "symbol", "date" ;
    bsi:realizedBy bsis:stock_event_triggers, bsis:stock_master .

bsir:instrumentHasMoverSnapshot     rdf:type owl:ObjectProperty ;
    rdfs:label "has mover snapshot" ;
    rdfs:comment "Vendor mover-list appearances per instrument and capture — the within-day event backbone the mover studies are built on." ;
    rdfs:domain bsi:Equity ;
    rdfs:range bsi:MoverSnapshot ;
    bsi:cardinality "1:N" ;
    bsi:gradedStatus "measured" ;
    bsi:evidence "Mover study re-run 2026-09-19 over ~359k events; relative-strength-versus-NIFTY lift measured at 2.05 on breakout movers (n=114)." ;
    bsi:joinKey "symbol", "trade_date" ;
    bsi:realizedBy bsis:mover_snapshots, bsis:stock_master .

bsir:screenerSurfacesInstrument     rdf:type owl:ObjectProperty ;
    rdfs:label "surfaces instrument" ;
    rdfs:comment "Live screener surfacing events: the platform's largest pre-labelled candidate stream." ;
    rdfs:domain bsi:Screener ;
    rdfs:range bsi:Equity ;
    bsi:cardinality "N:M" ;
    bsi:gradedStatus "live" ;
    bsi:joinKey "filter_key", "symbol" ;
    bsi:realizedBy bsis:live_screener_appearances, bsis:screener_master, bsis:stock_master .

bsir:appearanceHasOutcome     rdf:type owl:ObjectProperty ;
    rdfs:label "appearance has outcome" ;
    rdfs:comment "Forward returns pre-computed for a surfacing event at 1, 3 and 5 sessions." ;
    rdfs:domain bsi:ScreenerAppearance ;
    rdfs:range bsi:ScreenerOutcome ;
    bsi:cardinality "1:1" ;
    bsi:gradedStatus "live" ;
    bsi:joinKey "appearance_id", "symbol" ;
    bsi:realizedBy bsis:live_screener_outcomes, bsis:live_screener_appearances .

bsir:indexHasDerivativesSnapshot     rdf:type owl:ObjectProperty ;
    rdfs:label "has derivatives snapshot" ;
    rdfs:comment "Index-level positioning: PCR (intraday and EOD), max pain and aggregate open interest." ;
    rdfs:domain bsi:Index ;
    rdfs:range bsi:IndexDerivativesSnapshot ;
    bsi:cardinality "1:N" ;
    bsi:gradedStatus "ungraded" ;
    bsi:evidence "Deep index panel, but ungraded as a standalone signal — carried as a research candidate in the master report." ;
    bsi:joinKey "index_name", "date" ;
    bsi:realizedBy bsis:index_max_pain, bsis:nt_index_pcr_ts .

bsir:regimeConditionsBar     rdf:type owl:ObjectProperty ;
    rdfs:label "conditions bar" ;
    rdfs:comment "The regime attached to a session's bars. The regime's job here is to gate engine weights, so this is a conditioning path rather than a signal." ;
    rdfs:domain bsi:RegimeState ;
    rdfs:range bsi:Bar ;
    bsi:cardinality "1:N" ;
    bsi:gradedStatus "live" ;
    bsi:evidence "REGIME_WEIGHTS is a live gate in the ranker blend." ;
    bsi:joinKey "date" ;
    bsi:realizedBy bsis:market_regimes, bsis:stock_ohlcv .

bsir:regimeModulatesEngineWeight     rdf:type owl:ObjectProperty ;
    rdfs:label "modulates engine weight" ;
    rdfs:comment "The regime's effect on the engine blend for that session — the platform's only live use of regime state." ;
    rdfs:domain bsi:RegimeState ;
    rdfs:range bsi:EngineScore ;
    bsi:cardinality "1:N" ;
    bsi:gradedStatus "live" ;
    bsi:evidence "The per-regime engine edge table the master report asks for (regime_edge_status) is still to be built — so the gate is live but its calibration is not tracked." ;
    bsi:joinKey "date" ;
    bsi:realizedBy bsis:market_regimes, bsis:engine_composite_scores .

bsir:sectorRotationInformsInstrument     rdf:type owl:ObjectProperty ;
    rdfs:label "informs instrument relative strength" ;
    rdfs:comment "Sector rotation quadrant as an input to a stock's relative strength — explicitly an unquantified link." ;
    rdfs:domain bsi:SectorRotationPoint ;
    rdfs:range bsi:Equity ;
    bsi:cardinality "N:M" ;
    bsi:gradedStatus "research-candidate" ;
    bsi:evidence "Master report §6 lists sector-to-stock relative strength among the missing quantified links (Experiment 3)." ;
    bsi:joinKey "sector" ;
    bsi:realizedBy bsis:sector_rrg_history, bsis:technical_signals .

bsir:edgeReadingGatesModelInput     rdf:type owl:ObjectProperty ;
    rdfs:label "gates model input" ;
    rdfs:comment "A graded factor reading as the evidence behind promoting or dropping a model input." ;
    rdfs:domain bsi:EdgeReading ;
    rdfs:range bsi:ModelArtifact ;
    bsi:cardinality "N:1" ;
    bsi:gradedStatus "measured" ;
    bsi:joinKey "run_at" ;
    bsi:realizedBy bsis:factor_edge_history, bsis:model_registry .

bsir:modelProducesImportance     rdf:type owl:ObjectProperty ;
    rdfs:label "produces feature importance" ;
    rdfs:comment "Per-run feature importance for a registered model version." ;
    rdfs:domain bsi:ModelArtifact ;
    rdfs:range bsi:FeatureImportance ;
    bsi:cardinality "1:N" ;
    bsi:gradedStatus "live" ;
    bsi:joinKey "model_name" ;
    bsi:realizedBy bsis:feature_importance_log, bsis:model_registry .

bsir:endpointServesObservation     rdf:type owl:ObjectProperty ;
    rdfs:label "serves observation" ;
    rdfs:comment "Which discovered endpoint can populate which observation class — the sourcing map consulted when a provider route stops returning data." ;
    rdfs:domain bsi:Endpoint ;
    rdfs:range bsi:Observation ;
    bsi:cardinality "N:M" ;
    bsi:gradedStatus "live" ;
    bsi:evidence "Registry views v_working_market_endpoints / v_stock_screeners / v_fno_endpoints are the sanctioned alternate-lookup surface." ;
    bsi:joinKey "uid" ;
    bsi:realizedBy bsis:market_endpoint_registry, bsis:url_endpoints .

bsir:issuerIssuesInstrument     rdf:type owl:ObjectProperty ;
    rdfs:label "issues instrument" ;
    rdfs:comment "An issuer can issue multiple instruments; the canonical link is ISIN-aware and provisional identities are never name-merged." ;
    rdfs:domain bsi:Issuer ;
    rdfs:range bsi:Instrument ;
    bsi:cardinality "1:N" ;
    bsi:gradedStatus "live" ;
    bsi:joinKey "issuer_id" ;
    bsi:realizedBy bsis:market_issuer, bsis:market_instrument .

bsir:instrumentHasListing     rdf:type owl:ObjectProperty ;
    rdfs:label "has listing" ;
    rdfs:comment "An instrument can be listed on one or more exchanges/segments; symbol changes create listing intervals rather than changing instrument identity." ;
    rdfs:domain bsi:Instrument ;
    rdfs:range bsi:Listing ;
    bsi:cardinality "1:N" ;
    bsi:gradedStatus "live" ;
    bsi:joinKey "instrument_id" ;
    bsi:realizedBy bsis:market_instrument, bsis:market_listing .

bsir:instrumentHasProviderIdentifier     rdf:type owl:ObjectProperty ;
    rdfs:label "has provider identifier" ;
    rdfs:comment "Provider and scheme qualify every external identifier; ambiguous mappings remain explicit gaps." ;
    rdfs:domain bsi:Instrument ;
    rdfs:range bsi:ProviderIdentifier ;
    bsi:cardinality "1:N" ;
    bsi:gradedStatus "live" ;
    bsi:joinKey "instrument_id" ;
    bsi:realizedBy bsis:market_instrument, bsis:market_identifier, bsis:market_identifier_gap .

bsir:graphNodeConnects     rdf:type owl:ObjectProperty ;
    rdfs:label "connects to" ;
    rdfs:comment "Typed bitemporal assertions in the instance graph, including literal object values." ;
    rdfs:domain bsi:GraphNode ;
    rdfs:range bsi:GraphNode ;
    bsi:cardinality "1:N" ;
    bsi:gradedStatus "live" ;
    bsi:joinKey "from_node_id", "to_node_id" ;
    bsi:realizedBy bsis:market_graph_node, bsis:market_graph_edge .

bsir:evidenceSupportsClaim     rdf:type owl:ObjectProperty ;
    rdfs:label "supports claim" ;
    rdfs:comment "Source evidence is linked to a claim with supports, opposes, or context semantics; the link is not itself a causal proof." ;
    rdfs:domain bsi:EvidenceRecord ;
    rdfs:range bsi:MarketClaim ;
    bsi:cardinality "N:M" ;
    bsi:gradedStatus "ungraded" ;
    bsi:joinKey "evidence_key", "claim_key" ;
    bsi:realizedBy bsis:market_evidence, bsis:market_claim, bsis:market_claim_evidence .

bsir:decisionHasEvidence     rdf:type owl:ObjectProperty ;
    rdfs:label "has evidence" ;
    rdfs:comment "Structured support, contradiction, context, and veto evidence attached to an append-only decision event." ;
    rdfs:domain bsi:DecisionEvent ;
    rdfs:range bsi:EvidenceRecord ;
    bsi:cardinality "1:N" ;
    bsi:gradedStatus "live" ;
    bsi:joinKey "decision_key", "evidence_key" ;
    bsi:realizedBy bsis:market_decision_event, bsis:market_decision_evidence .

bsir:decisionHasOutcome     rdf:type owl:ObjectProperty ;
    rdfs:label "has outcome" ;
    rdfs:comment "Realized outcomes are attached under an explicit label definition and horizon." ;
    rdfs:domain bsi:DecisionEvent ;
    rdfs:range bsi:DecisionOutcome ;
    bsi:cardinality "1:N" ;
    bsi:gradedStatus "live" ;
    bsi:joinKey "decision_key", "label_definition", "horizon_days" ;
    bsi:realizedBy bsis:market_decision_event, bsis:market_decision_outcome .

bsir:contractDescribesFeature     rdf:type owl:ObjectProperty ;
    rdfs:label "describes feature" ;
    rdfs:comment "A data contract and materialized feature definition jointly constrain safe use." ;
    rdfs:domain bsi:DataContract ;
    rdfs:range bsi:FeatureDefinition ;
    bsi:cardinality "N:M" ;
    bsi:gradedStatus "live" ;
    bsi:joinKey "ontology_version", "version" ;
    bsi:realizedBy bsis:market_data_contract, bsis:semantic_feature_definition .

bsir:watermarkGatesDecision     rdf:type owl:ObjectProperty ;
    rdfs:label "gates decision" ;
    rdfs:comment "Completeness state is captured with a decision; freshness alone is not completeness." ;
    rdfs:domain bsi:DataWatermark ;
    rdfs:range bsi:DecisionEvent ;
    bsi:cardinality "1:N" ;
    bsi:gradedStatus "live" ;
    bsi:joinKey "dataset", "partition_key" ;
    bsi:realizedBy bsis:market_data_watermark, bsis:market_decision_event .

bsir:jobProducesOutput     rdf:type owl:ObjectProperty ;
    rdfs:label "produces output" ;
    rdfs:comment "Lineage from a scheduled job to the derived outputs it writes." ;
    rdfs:domain bsi:JobRun ;
    rdfs:range bsi:PlatformOutput ;
    bsi:cardinality "1:N" ;
    bsi:gradedStatus "live" ;
    bsi:joinKey "job_name" ;
    bsi:realizedBy bsis:job_heartbeat .

bsim:delivery_surprise_z     rdf:type bsim:Metric ;
    rdfs:label "Delivery surprise z-score" ;
    rdfs:comment "Today's NSE delivery percentage as a z-score against the symbol's own trailing 20-session history: unusual ownership behaviour on a session, the T+1-lag edge the master report names." ;
    bsim:entity bsi:Equity ;
    bsim:sql "WITH hist AS (\n    SELECT date AS d, delivery_pct AS dp\n    FROM stock_delivery_data\n    WHERE symbol = :symbol AND delivery_pct IS NOT NULL\n), stats AS (\n    SELECT d, dp,\n           avg(dp) OVER (ORDER BY d ROWS BETWEEN 20 PRECEDING AND 1 PRECEDING) AS mu,\n           stddev_samp(dp) OVER (ORDER BY d ROWS BETWEEN 20 PRECEDING AND 1 PRECEDING) AS sd\n    FROM hist\n)\nSELECT d AS as_of, dp AS delivery_pct,\n       CASE WHEN sd > 0 THEN (dp - mu) / sd ELSE 0.0 END AS delivery_surprise_z\nFROM stats\nWHERE d <= :as_of\nORDER BY d DESC\nLIMIT 1" ;
    bsim:params "symbol, as_of" ;
    bsim:grain "one row per symbol per as-of session" ;
    bsim:cadence "daily" ;
    bsim:timing "leading" ;
    bsim:derivation "derived" ;
    bsim:leakageRisk "none" ;
    bsim:gradedStatus "research-candidate" ;
    bsim:cheapToRun "true"^^xsd:boolean ;
    bsim:unit "z" ;
    bsim:derivedFrom bsis:stock_delivery_data ;
    bsim:caveat "Delivery data lands T+1: the z-score for session D is knowable only during session D+1, so any same-session use is a look-ahead.", "Self-referenced (vs the symbol's own history), not cross-sectional." ;
    skos:altLabel "delivery surprise z", "delivery surprise" .

bsim:close_price     rdf:type bsim:Metric ;
    rdfs:label "Closing price (basis-tagged)" ;
    rdfs:comment "The most recent clean closing price on or before an as-of date, excluding quarantined bars." ;
    bsim:entity bsi:Bar ;
    bsim:sql "SELECT o.close AS close_price, o.date AS as_of, o.adjustment_basis\nFROM stock_ohlcv o\nWHERE o.symbol = :symbol AND o.date <= :as_of AND o.is_suspect = 0\nORDER BY o.date DESC\nLIMIT 1" ;
    bsim:params "symbol, as_of" ;
    bsim:grain "(symbol, date)" ;
    bsim:cadence "per_session" ;
    bsim:timing "coincident" ;
    bsim:derivation "raw" ;
    bsim:leakageRisk "none" ;
    bsim:gradedStatus "live" ;
    bsim:cheapToRun "true"^^xsd:boolean ;
    bsim:unit "per_share_INR" ;
    bsim:derivedFrom bsis:stock_ohlcv ;
    bsim:caveat "The price is in whatever basis `adjustment_basis` names: mixing bases across a series is a silent backtest corruption.", "`is_suspect = 0` is applied — a quarantined bar is excluded, not corrected." ;
    skos:altLabel "close", "closing price", "last close", "price" .

bsim:delivery_pct_latest     rdf:type bsim:Metric ;
    rdfs:label "Latest delivery percentage" ;
    rdfs:comment "Delivered shares as a share of traded shares on the most recent session at or before the as-of date." ;
    bsim:entity bsi:DeliveryObservation ;
    bsim:sql "SELECT d.delivery_pct AS delivery_pct, d.date AS as_of\nFROM stock_delivery_data d\nWHERE d.symbol = :symbol AND d.date <= :as_of\nORDER BY d.date DESC\nLIMIT 1" ;
    bsim:params "symbol, as_of" ;
    bsim:grain "(symbol, date)" ;
    bsim:cadence "daily_t_plus_1" ;
    bsim:timing "lagging" ;
    bsim:derivation "raw" ;
    bsim:leakageRisk "none" ;
    bsim:gradedStatus "research-candidate" ;
    bsim:cheapToRun "true"^^xsd:boolean ;
    bsim:unit "percent" ;
    bsim:gradedEvidence "Delivery-to-swing-returns is an unquantified link (master report §6, Experiment 4) — not yet graded by factor_edge.py." ;
    bsim:derivedFrom bsis:stock_delivery_data ;
    bsim:caveat "T+1 by construction: this value was NOT knowable on the session it describes, so it cannot explain that session's move.", "A sibling table (`stock_delivery_volume`) reports the same concept per NSE series with different column names." ;
    skos:altLabel "delivery", "delivery percent", "delivery percentage", "deliv" .

bsim:delivery_pct_30d_average     rdf:type bsim:Metric ;
    rdfs:label "Delivery percentage, 30-session average" ;
    rdfs:comment "Mean delivery percentage over the trailing window ending at the as-of date — the baseline a delivery surprise is measured against." ;
    bsim:entity bsi:DeliveryObservation ;
    bsim:sql "SELECT avg(d.delivery_pct) AS delivery_avg, count(*) AS sessions\nFROM stock_delivery_data d\nWHERE d.symbol = :symbol AND d.date <= :as_of\n  AND d.date > ((:as_of)::date - 30)" ;
    bsim:params "symbol, as_of" ;
    bsim:grain "(symbol, trailing 30 sessions)" ;
    bsim:cadence "daily_t_plus_1" ;
    bsim:timing "lagging" ;
    bsim:derivation "platform" ;
    bsim:leakageRisk "none" ;
    bsim:gradedStatus "research-candidate" ;
    bsim:cheapToRun "true"^^xsd:boolean ;
    bsim:unit "percent" ;
    bsim:derivedFrom bsis:stock_delivery_data ;
    bsim:caveat "Session count, not calendar days: the window spans trading sessions.", "Returns NULL when the symbol has no delivery rows in the window — a coverage gap, not a zero." ;
    skos:altLabel "average delivery", "delivery baseline", "delivery trend" .

bsim:rsi_14_latest     rdf:type bsim:Metric ;
    rdfs:label "RSI (14), latest" ;
    rdfs:comment "Wilder RSI from the technical panel on the most recent date at or before the as-of date." ;
    bsim:entity bsi:TechnicalSignal ;
    bsim:sql "SELECT t.rsi AS rsi_14, t.date AS as_of\nFROM technical_signals t\nWHERE t.symbol = :symbol AND t.date <= :as_of\nORDER BY t.date DESC\nLIMIT 1" ;
    bsim:params "symbol, as_of" ;
    bsim:grain "(symbol, date)" ;
    bsim:cadence "daily" ;
    bsim:timing "coincident" ;
    bsim:derivation "platform" ;
    bsim:leakageRisk "none" ;
    bsim:gradedStatus "measured" ;
    bsim:cheapToRun "true"^^xsd:boolean ;
    bsim:unit "index_points" ;
    bsim:gradedEvidence "rsi_14 measured NEGATIVE rank-IC at 5 days: on this platform it is a mean-reversion input, not a momentum confirmation." ;
    bsim:derivedFrom bsis:technical_signals ;
    bsim:caveat "Graded as a mean-reversion input — a high RSI is not a buy signal here.", "RSI re-expresses price, so on its own it adds no information beyond the shape of the recent move." ;
    skos:altLabel "rsi", "relative strength index", "overbought", "oversold" .

bsim:signal_win_rate_5d     rdf:type bsim:Metric ;
    rdfs:label "Signal win rate, 5-day horizon" ;
    rdfs:comment "Share of resolved 5-day signals that ended in a win under a single labelling rule, with its sample size." ;
    bsim:entity bsi:SignalOutcome ;
    bsim:sql "SELECT avg(CASE WHEN s.outcome = 'WIN' THEN 1.0 ELSE 0.0 END) AS win_rate,\n       count(*) AS n\nFROM signal_outcomes s\nWHERE s.horizon_days = 5\n  AND s.label_definition = 'path_barrier'\n  AND s.outcome IN ('WIN', 'LOSS')\n  AND s.signal_date <= :as_of" ;
    bsim:params "as_of" ;
    bsim:grain "market-wide, 5-day horizon" ;
    bsim:cadence "daily" ;
    bsim:timing "target" ;
    bsim:derivation "platform" ;
    bsim:leakageRisk "high" ;
    bsim:gradedStatus "live" ;
    bsim:cheapToRun "true"^^xsd:boolean ;
    bsim:unit "probability" ;
    bsim:derivedFrom bsis:signal_outcomes ;
    bsim:caveat "LABEL-SHAPED. This measures the platform's own track record and is never a feature.", "`label_definition` is pinned to `path_barrier` deliberately: mixing it with `terminal_pct2` makes the rate meaningless.", "`PENDING` and `NEUTRAL` rows are excluded — the honest denominator, and it must be stated alongside any rate.", "No `signal_source` filter, so this blends technical and confluence signals." ;
    skos:altLabel "win rate", "hit rate", "accuracy", "success rate" .

bsim:usable_factor_readings_5d     rdf:type bsim:Metric ;
    rdfs:label "Usable factor readings at 5 days" ;
    rdfs:comment "How many graded factor readings at a 5-day horizon currently clear the power and independence guards." ;
    bsim:entity bsi:EdgeReading ;
    bsim:sql "SELECT count(*) AS usable_readings, max(f.eff_dates) AS max_eff_dates\nFROM factor_edge_history f\nWHERE f.horizon_days = 5 AND f.verdict = 'USABLE' AND f.run_at <= :as_of" ;
    bsim:params "as_of" ;
    bsim:grain "per grading run, 5-day horizon" ;
    bsim:cadence "on_grading" ;
    bsim:timing "context" ;
    bsim:derivation "platform" ;
    bsim:leakageRisk "none" ;
    bsim:gradedStatus "live" ;
    bsim:cheapToRun "true"^^xsd:boolean ;
    bsim:unit "count" ;
    bsim:derivedFrom bsis:factor_edge_history ;
    bsim:caveat "A reading is only readable alongside its `eff_dates`: overlapping forward windows inflate a correlation by roughly the horizon factor.", "`verdict` is matched exactly — the ledger stores `no edge` with a space and `n/a` alongside `USABLE` and `LOW-DATA`." ;
    skos:altLabel "usable factors", "factor edge", "graded factors", "rank ic count" .

bsim:unified_score_latest     rdf:type bsim:Metric ;
    rdfs:label "Unified score, latest served" ;
    rdfs:comment "The highest composite score served for a symbol at or before the as-of date, with its conviction bucket and timeframe." ;
    bsim:entity bsi:Recommendation ;
    bsim:sql "SELECT u.unified_score, u.conviction_level, u.classification, u.timeframe\nFROM unified_recommendations u\nWHERE u.symbol = :symbol AND u.computed_at <= :as_of\nORDER BY u.unified_score DESC\nLIMIT 1" ;
    bsim:params "symbol, as_of" ;
    bsim:grain "(symbol, computed_at, timeframe)" ;
    bsim:cadence "daily" ;
    bsim:timing "coincident" ;
    bsim:derivation "platform" ;
    bsim:leakageRisk "none" ;
    bsim:gradedStatus "live" ;
    bsim:cheapToRun "true"^^xsd:boolean ;
    bsim:unit "score_0_100" ;
    bsim:derivedFrom bsis:unified_recommendations ;
    bsim:caveat "`computed_at` is TEXT in this table — comparing it against a DATE elsewhere needs an explicit cast.", "The ranker's load-bearing input is the confluence engine, so a high unified score with a low engine-coverage count is weak evidence.", "Ordering by score across timeframes returns the best of INTRADAY / SWING / POSITIONAL / LONG_TERM rather than a comparable series — filter `timeframe` first when the horizon matters." ;
    skos:altLabel "unified score", "composite score", "conviction", "top pick", "ranking" .

bsim:confluence_score_latest     rdf:type bsim:Metric ;
    rdfs:label "Confluence score, latest" ;
    rdfs:comment "The most recent multi-engine agreement score with the number of screeners holding the name and the model probabilities behind it." ;
    bsim:entity bsi:EngineScore ;
    bsim:sql "SELECT c.confluence_score, c.active_screener_count, c.conviction_level,\n       c.ml_breakout_probability, c.computed_at\nFROM confluence_signals c\nWHERE c.symbol = :symbol AND c.computed_at <= :as_of\nORDER BY c.computed_at DESC\nLIMIT 1" ;
    bsim:params "symbol, as_of" ;
    bsim:grain "(symbol, computed_at)" ;
    bsim:cadence "every_15m" ;
    bsim:timing "coincident" ;
    bsim:derivation "platform" ;
    bsim:leakageRisk "none" ;
    bsim:gradedStatus "measured" ;
    bsim:cheapToRun "true"^^xsd:boolean ;
    bsim:unit "score_0_100" ;
    bsim:gradedEvidence "The only engine score on this platform with a growing positive graded reading, which is why it carries the ranker." ;
    bsim:derivedFrom bsis:confluence_signals ;
    bsim:caveat "`computed_at` is native TIMESTAMPTZ here but TEXT on `unified_recommendations` — cast across that join.", "`ml_breakout_probability` is a model output and must not be used as a feature elsewhere." ;
    skos:altLabel "confluence", "confluence score", "engine agreement" .

bsim:index_pcr_latest     rdf:type bsim:Metric ;
    rdfs:label "Index put-call ratio, latest" ;
    rdfs:comment "The most recent index PCR reading with the index close at the same instant." ;
    bsim:entity bsi:IndexDerivativesSnapshot ;
    bsim:sql "SELECT n.pcr, n.index_close, n.ts\nFROM nt_index_pcr_ts n\nWHERE n.index_name = 'NIFTY50' AND n.ts <= :as_of\nORDER BY n.ts DESC\nLIMIT 1" ;
    bsim:params "as_of" ;
    bsim:grain "(index, timestamp, expiry)" ;
    bsim:cadence "intraday" ;
    bsim:timing "leading" ;
    bsim:derivation "vendor" ;
    bsim:leakageRisk "none" ;
    bsim:gradedStatus "research-candidate" ;
    bsim:cheapToRun "false"^^xsd:boolean ;
    bsim:unit "ratio" ;
    bsim:gradedEvidence "Index positioning is classed as genuinely leading in the master report's taxonomy, but remains ungraded here (Experiment 6)." ;
    bsim:derivedFrom bsis:nt_index_pcr_ts ;
    bsim:caveat "Pinned to NIFTY50 deliberately: the index name is a dimension this metric does not parameterise.", "Three PCR variants exist in the source table (OI, volume, OI change) and they measure different things.", "Leading is not the same as profitable — this is ungraded." ;
    skos:altLabel "pcr", "put call ratio", "index pcr", "options positioning", "derivatives sentiment" .

bsim:rollover_pct_latest     rdf:type bsim:Metric ;
    rdfs:label "Futures rollover, latest" ;
    rdfs:comment "The latest rollover percentage and annualised cost of carry for a stock's futures, with its total open interest." ;
    bsim:entity bsi:FuturesPositioning ;
    bsim:sql "SELECT r.rollover_pct, r.cost_of_carry_ann, r.total_oi, r.date\nFROM fno_rollover r\nWHERE r.symbol = :symbol AND r.date <= :as_of\nORDER BY r.date DESC\nLIMIT 1" ;
    bsim:params "symbol, as_of" ;
    bsim:grain "(symbol, date)" ;
    bsim:cadence "daily" ;
    bsim:timing "leading" ;
    bsim:derivation "vendor" ;
    bsim:leakageRisk "none" ;
    bsim:gradedStatus "low-data" ;
    bsim:cheapToRun "true"^^xsd:boolean ;
    bsim:unit "percent" ;
    bsim:gradedEvidence "The stock-futures panel spans ~14 dates; the master report's verdict is LOW-DATA, so a reading from it is a calendar artefact." ;
    bsim:derivedFrom bsis:fno_rollover ;
    bsim:caveat "LOW-DATA panel: never treat a correlation computed on it as an edge.", "Rollover is only meaningful in the days before an expiry; outside that window the number is mostly noise." ;
    skos:altLabel "rollover", "rollover percent", "futures rollover", "cost of carry", "open interest" .

bsim:market_breadth_latest     rdf:type bsim:Metric ;
    rdfs:label "Market breadth, latest" ;
    rdfs:comment "Share of the universe above its 200-day average and the advance/decline ratio for the most recent session." ;
    bsim:entity bsi:BreadthObservation ;
    bsim:sql "SELECT b.pct_above_200dma, b.adv_decline_ratio, b.date\nFROM market_breadth b\nWHERE b.date <= :as_of\nORDER BY b.date DESC\nLIMIT 1" ;
    bsim:params "as_of" ;
    bsim:grain "per session" ;
    bsim:cadence "daily" ;
    bsim:timing "context" ;
    bsim:derivation "platform" ;
    bsim:leakageRisk "none" ;
    bsim:gradedStatus "ungraded" ;
    bsim:cheapToRun "true"^^xsd:boolean ;
    bsim:unit "percent" ;
    bsim:derivedFrom bsis:market_breadth ;
    bsim:caveat "Computed over this platform's own universe definition, so it is not comparable to a vendor's breadth series without re-basing.", "Classed as a FILTER on this platform, not as alpha." ;
    skos:altLabel "breadth", "advance decline", "participation", "market internals" .

bsim:current_regime     rdf:type bsim:Metric ;
    rdfs:label "Current market regime" ;
    rdfs:comment "The regime label and its posterior probability for the most recent session at or before the as-of date." ;
    bsim:entity bsi:RegimeState ;
    bsim:sql "SELECT m.regime, m.regime_prob, m.date\nFROM market_regimes m\nWHERE m.date <= :as_of\nORDER BY m.date DESC\nLIMIT 1" ;
    bsim:params "as_of" ;
    bsim:grain "per session" ;
    bsim:cadence "daily" ;
    bsim:timing "context" ;
    bsim:derivation "platform" ;
    bsim:leakageRisk "none" ;
    bsim:gradedStatus "live" ;
    bsim:cheapToRun "true"^^xsd:boolean ;
    bsim:derivedFrom bsis:market_regimes ;
    bsim:caveat "The regime is a WEIGHT GATE here, not a directional call: it re-blends engine weights, so reading it as a trade is a category error.", "`regime_prob` is an HMM posterior, not a calibrated probability of a market outcome." ;
    skos:altLabel "regime", "market regime", "bull", "bear", "sideways", "volatility state" .

bsim:asm_flag_latest     rdf:type bsim:Metric ;
    rdfs:label "Surveillance flag, latest" ;
    rdfs:comment "Whether the symbol is under exchange surveillance measures as of the most recent signal date." ;
    bsim:entity bsi:TechnicalSignal ;
    bsim:sql "SELECT t.asm_flag, t.date AS as_of\nFROM technical_signals t\nWHERE t.symbol = :symbol AND t.date <= :as_of\nORDER BY t.date DESC\nLIMIT 1" ;
    bsim:params "symbol, as_of" ;
    bsim:grain "(symbol, date)" ;
    bsim:cadence "daily" ;
    bsim:timing "coincident" ;
    bsim:derivation "vendor" ;
    bsim:leakageRisk "none" ;
    bsim:gradedStatus "live" ;
    bsim:cheapToRun "true"^^xsd:boolean ;
    bsim:derivedFrom bsis:technical_signals ;
    bsim:caveat "This is a TRADABILITY CONSTRAINT, not a signal: a name under surveillance can be untradeable in size regardless of how good the setup looks.", "It is stamped from a fetched list, so it lags the exchange's own announcement by however long the fetcher took." ;
    skos:altLabel "asm", "gsm", "surveillance", "tradability", "ban" .

bsim:analyst_consensus_latest     rdf:type bsim:Metric ;
    rdfs:label "Analyst consensus, latest" ;
    rdfs:comment "Mean analyst target, contributor count and consensus rating from the most recent snapshot at or before the as-of date." ;
    bsim:entity bsi:AnalystEstimate ;
    bsim:sql "SELECT a.target_mean, a.n_analysts, a.final_rating, a.as_of_date\nFROM analyst_estimates_history a\nWHERE a.symbol = :symbol AND a.as_of_date <= :as_of\nORDER BY a.as_of_date DESC\nLIMIT 1" ;
    bsim:params "symbol, as_of" ;
    bsim:grain "(symbol, as_of_date)" ;
    bsim:cadence "vendor_periodic" ;
    bsim:timing "leading" ;
    bsim:derivation "vendor" ;
    bsim:leakageRisk "none" ;
    bsim:gradedStatus "ungraded" ;
    bsim:cheapToRun "true"^^xsd:boolean ;
    bsim:unit "per_share_INR" ;
    bsim:gradedEvidence "Genuinely leading in the taxonomy, but the revision trio derived from it is calendar-blocked to ~2026-10." ;
    bsim:derivedFrom bsis:analyst_estimates_history ;
    bsim:caveat "`target_mean` is a per-share price in INR, not a return — it must be divided by a price to become an upside percentage.", "Snapshots are as-of-stamped: re-fetching later can return a different history than the one that was knowable." ;
    skos:altLabel "analyst", "consensus", "target price", "price target", "analyst rating", "estimates" .

bsim:screener_5d_forward_return     rdf:type bsim:Metric ;
    rdfs:label "Screener 5-day forward return" ;
    rdfs:comment "Average 5-session forward return across the times this symbol was surfaced by a live screener, with the sample size." ;
    bsim:entity bsi:ScreenerOutcome ;
    bsim:sql "SELECT avg(l.return_5d) AS avg_forward_5d, count(*) AS n\nFROM live_screener_outcomes l\nWHERE l.symbol = :symbol AND l.appeared_at <= :as_of AND l.return_5d IS NOT NULL" ;
    bsim:params "symbol, as_of" ;
    bsim:grain "(symbol, appearance)" ;
    bsim:cadence "every_15m" ;
    bsim:timing "target" ;
    bsim:derivation "platform" ;
    bsim:leakageRisk "high" ;
    bsim:gradedStatus "live" ;
    bsim:cheapToRun "true"^^xsd:boolean ;
    bsim:unit "percent" ;
    bsim:derivedFrom bsis:live_screener_outcomes ;
    bsim:caveat "This is a LABEL aggregate, not a feature: it measures how the screener family performed historically for this symbol.", "NULL `return_5d` rows are excluded, so recent appearances do not drag the average toward zero — but they do make `n` smaller than the appearance count.", "Attribution belongs to whichever screeners surfaced the name; averaging across all of them mixes unrelated strategies." ;
    skos:altLabel "screener performance", "screener forward return", "screener edge", "surfacing outcome" .

bsim:news_sentiment_5d     rdf:type bsim:Metric ;
    rdfs:label "News sentiment, trailing 5 sessions" ;
    rdfs:comment "Mean scored sentiment across news items mentioning the symbol in the five sessions up to the as-of date, with the mention count." ;
    bsim:entity bsi:NewsItem ;
    bsim:sql "SELECT avg(n.sentiment_score) AS avg_sentiment, count(*) AS mentions\nFROM news_symbol_link n\nWHERE n.symbol = :symbol AND n.published_at <= :as_of\n  AND n.published_at > ((:as_of)::date - 5)" ;
    bsim:params "symbol, as_of" ;
    bsim:grain "(symbol, trailing 5 sessions)" ;
    bsim:cadence "intraday" ;
    bsim:timing "leading" ;
    bsim:derivation "platform" ;
    bsim:leakageRisk "none" ;
    bsim:gradedStatus "measured" ;
    bsim:cheapToRun "true"^^xsd:boolean ;
    bsim:unit "score_minus1_1" ;
    bsim:gradedEvidence "News sentiment conditioning on movers measured a lift of ~0.13 (n=114, p=0.037) — a lead, not a result." ;
    bsim:derivedFrom bsis:news_symbol_link ;
    bsim:caveat "Counts MENTIONS, not articles: one widely covered item produces many rows and will dominate the average.", "`published_at` is the only knowable timestamp — filtering on the event date instead is a look-ahead bug.", "A mention is not a foreign key: this join must go through the link table, never through the JSON array on the news row.", "Scored sentiment comes from either the vendor or FinBERT depending on `ai_scored`; the two are not the same measurement." ;
    skos:altLabel "news sentiment", "sentiment", "headline sentiment", "news flow", "news count" .

bsim:excursion_path_5d     rdf:type bsim:Metric ;
    rdfs:label "Excursion path, 5-day horizon" ;
    rdfs:comment "Average maximum favourable and adverse excursion for resolved 5-day signals on a symbol, with the sample size." ;
    bsim:entity bsi:SignalExcursion ;
    bsim:sql "SELECT avg(e.mfe_pct) AS avg_mfe, avg(e.mae_pct) AS avg_mae,\n       count(*) AS n\nFROM signal_excursions e\nWHERE e.symbol = :symbol AND e.horizon_days = 5 AND e.signal_date <= :as_of" ;
    bsim:params "symbol, as_of" ;
    bsim:grain "(symbol, signal_date, horizon)" ;
    bsim:cadence "daily" ;
    bsim:timing "target" ;
    bsim:derivation "platform" ;
    bsim:leakageRisk "high" ;
    bsim:gradedStatus "live" ;
    bsim:cheapToRun "true"^^xsd:boolean ;
    bsim:unit "percent" ;
    bsim:derivedFrom bsis:signal_excursions ;
    bsim:caveat "LABEL-SHAPED. MFE/MAE describe what already happened; they are never inputs.", "The horizon is pinned to 5 sessions — a 1-day and a 20-day path are different distributions and must not be averaged together.", "Path statistics make stop placement answerable: the terminal return alone cannot say whether the trade was ever viable." ;
    skos:altLabel "mfe", "mae", "excursion", "drawdown", "stop loss study", "favourable excursion" .

bsiv:timeframe     rdf:type skos:ConceptScheme ;
    rdfs:comment "Trading horizon an engine or signal is expressed on. Uppercase in the canonical signal tables; `screener_master.inferred_timeframe` uses a lowercase subset — normalise before joining the two." ;
    bsiv:source "unified_recommendations.timeframe" ;
    bsiv:openEnded "false"^^xsd:boolean .

