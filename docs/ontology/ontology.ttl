    bsi:property bsip:is_suspect ;
    bsi:semanticType "flag" ;
    bsi:leakageRisk "none" .

_:col_stock_ohlcv_adjustment_basis     bsi:columnName "adjustment_basis" ;
    bsi:property bsip:adjustment_basis ;
    bsi:semanticType "enum" ;
    bsi:leakageRisk "none" .

_:col_stock_ohlcv_suspect_reason     bsi:columnName "suspect_reason" ;
    bsi:property bsip:suspect_reason ;
    bsi:semanticType "enum" ;
    bsi:leakageRisk "none" .

bsis:intraday_ohlcv     rdf:type bsi:Table ;
    rdfs:label "Intraday bars" ;
    rdfs:comment "Sub-daily OHLCV with VWAP for a single interval (15m) over recent history." ;
    bsi:realizes bsi:IntradayBar ;
    bsi:rowClass bsit:intraday_ohlcv ;
    bsi:grain "(symbol, datetime, interval)" ;
    bsi:cadence "intraday_15m" ;
    bsi:trainingUse "allowed" ;
    bsi:primaryKey "symbol", "datetime", "interval" ;
    bsi:freshnessColumn "datetime" ;
    bsi:expectedLagHours "0.5"^^xsd:decimal ;
    bsi:writtenBy "intraday_fetcher.py" ;
    bsi:caveat "History is shallow next to the daily panel — not a substitute for `stock_ohlcv` in any long-horizon study." ;
    bsi:hasColumn _:col_intraday_ohlcv_symbol, _:col_intraday_ohlcv_datetime, _:col_intraday_ohlcv_interval, _:col_intraday_ohlcv_open, _:col_intraday_ohlcv_high, _:col_intraday_ohlcv_low, _:col_intraday_ohlcv_close, _:col_intraday_ohlcv_volume, _:col_intraday_ohlcv_vwap .

