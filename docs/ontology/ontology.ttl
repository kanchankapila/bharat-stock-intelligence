bsiv:event_trigger_class     rdf:type skos:ConceptScheme ;
    rdfs:comment "Composite event-trigger classes. Stored as a comma-joined string with an inline threshold suffix (`r1.00`, `p90`) — parse the class token before the space, never the whole string." ;
    bsiv:source "stock_event_triggers.triggers" ;
    bsiv:openEnded "true"^^xsd:boolean ;
    bsiv:openEndedNote "Terms below were observed at capture time. The producer is open-ended, so absence from this list does NOT mean a value cannot occur." .

bsiv:event_trigger_class.screener-support-fading     rdf:type skos:Concept ;
    skos:inScheme bsiv:event_trigger_class ;
    skos:notation "SCREENER_SUPPORT_FADING" ;
    skos:prefLabel "Screener support fading" ;
    skos:definition "Screener-derived support ratio decaying; suffix r<ratio>." .

bsiv:event_trigger_class.crowded-news     rdf:type skos:Concept ;
    skos:inScheme bsiv:event_trigger_class ;
    skos:notation "CROWDED_NEWS" ;
    skos:prefLabel "Crowded news" ;
    skos:definition "News attention above a percentile; suffix p<percentile>." .

bsiv:provenance_quality     rdf:type skos:ConceptScheme ;
    rdfs:comment "Whether a row was rebuilt from source or carried over from vendor point-in-time data. Rows before the provenance boundary (`2026-08-12`, docs/measurement.md) are `inferred`." ;
    bsiv:source "authored (greenfield provenance model)" ;
    bsiv:openEnded "false"^^xsd:boolean .

bsiv:provenance_quality.observed     rdf:type skos:Concept ;
    skos:inScheme bsiv:provenance_quality ;
    skos:notation "observed" ;
    skos:prefLabel "Observed" ;
    skos:definition "Rebuilt from a replayable source (e.g. NSE bhavcopy)." .

bsiv:provenance_quality.inferred     rdf:type skos:Concept ;
    skos:inScheme bsiv:provenance_quality ;
    skos:notation "inferred" ;
    skos:prefLabel "Inferred" ;
    skos:definition "Carried over from vendor PIT data; cannot be re-fetched." .

bsis:stock_ohlcv     rdf:type bsi:Table ;
    rdfs:label "Daily OHLCV bars" ;
    rdfs:comment "One daily OHLCV bar per symbol per session. The platform's only self-owned source of truth and the basis of every return calculation." ;
    bsi:realizes bsi:Bar ;
    bsi:rowClass bsit:stock_ohlcv ;
    bsi:grain "(symbol, date)" ;
    bsi:cadence "per_session" ;
    bsi:trainingUse "caution" ;
    bsi:primaryKey "symbol", "date" ;
    bsi:freshnessColumn "date" ;
    bsi:expectedLagHours "5.0"^^xsd:decimal ;
    bsi:writtenBy "nse_bhavcopy_fetcher.py", "bse_bhavcopy_fetcher.py" ;
    bsi:forbiddenColumn "is_suspect" ;
    bsi:caveat "Price basis is per ROW, in `adjustment_basis` (nse_bhavcopy_raw / split_only / split_dividend). Mixing bases inside one series corrupts a backtest silently.", "Suspect bars are flagged, not deleted: filter `is_suspect = 0` before building a panel, and read `suspect_reason` rather than imputing." ;
    bsi:hasColumn _:col_stock_ohlcv_symbol, _:col_stock_ohlcv_date, _:col_stock_ohlcv_open, _:col_stock_ohlcv_high, _:col_stock_ohlcv_low, _:col_stock_ohlcv_close, _:col_stock_ohlcv_volume, _:col_stock_ohlcv_is_suspect, _:col_stock_ohlcv_adjustment_basis, _:col_stock_ohlcv_suspect_reason .

bsit:stock_ohlcv     rdf:type owl:Class ;
    rdfs:label "stock_ohlcv row" ;
    rdfs:comment "A row of stock_ohlcv. Grain: (symbol, date). Subclass of Bar; the physical contract (column set) lives in bsi:stock_ohlcvShape." ;
    rdfs:subClassOf bsi:Bar .

_:col_stock_ohlcv_symbol     bsi:columnName "symbol" ;
    bsi:property bsip:symbol ;
    bsi:semanticType "identifier" ;
    bsi:leakageRisk "none" .

