bsis:url_endpoints     rdf:type bsi:Table ;
    rdfs:label "Consolidated endpoint templates" ;
    rdfs:comment "830 consolidated endpoint templates carrying the feature targets each one can populate — the alternate-lookup index." ;
    bsi:realizes bsi:Endpoint ;
    bsi:rowClass bsit:url_endpoints ;
    bsi:grain "(id)" ;
