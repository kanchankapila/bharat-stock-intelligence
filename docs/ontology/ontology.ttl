bsis:intraday_recommendations     rdf:type bsi:Table ;
    rdfs:label "Intraday recommendations" ;
    rdfs:comment "Within-session picks with their intraday risk state, entry price and size." ;
    bsi:realizes bsi:Recommendation ;
    bsi:rowClass bsit:intraday_recommendations ;
    bsi:grain "(symbol, computed_at)" ;
    bsi:cadence "intraday" ;
    bsi:trainingUse "caution" ;
    bsi:primaryKey "symbol", "computed_at" ;
    bsi:freshnessColumn "computed_at" ;
    bsi:expectedLagHours "0.5"^^xsd:decimal ;
    bsi:writtenBy "intraday_ranker.py" ;
    bsi:forbiddenColumn "reasoning" ;
    bsi:caveat "Carries TWO timestamp columns (`computed_at` and `computed_ts`) that share one semantic property — pick one and state which.", "`reasoning` is generated text." ;
    bsi:hasColumn _:col_intraday_recommendations_symbol, _:col_intraday_recommendations_computed_at, _:col_intraday_recommendations_computed_ts, _:col_intraday_recommendations_intraday_regime, _:col_intraday_recommendations_conviction_level, _:col_intraday_recommendations_classification, _:col_intraday_recommendations_screener_score, _:col_intraday_recommendations_breakout_score, _:col_intraday_recommendations_bullish_count, _:col_intraday_recommendations_bearish_count, _:col_intraday_recommendations_cmp, _:col_intraday_recommendations_entry_price, _:col_intraday_recommendations_stop_loss, _:col_intraday_recommendations_target_1, _:col_intraday_recommendations_risk_reward, _:col_intraday_recommendations_position_size_pct, _:col_intraday_recommendations_reasoning, _:col_intraday_recommendations_news_sentiment .

