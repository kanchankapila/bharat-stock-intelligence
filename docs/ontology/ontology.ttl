    bsi:isLabel "false"^^xsd:boolean ;
    qudt:unit "percent" ;
    skos:altLabel "delivery_percentage", "deliv_pct" ;
    bsi:pointInTimeNote "NSE publishes delivery data after the session closes, so it is T+1 at best. A signal dated the same session cannot have used it." ;
    bsi:boundTo bsis:stock_delivery_data.delivery_pct, bsis:stock_delivery_volume.delivery_pct, bsis:technical_signals.delivery_pct .

bsip:change_pct     rdf:type owl:DatatypeProperty ;
