bsis:model_registry     rdf:type bsi:Table ;
    rdfs:label "Model registry" ;
    rdfs:comment "Every trained model version with its type, evaluation metrics, feature count, horizon and active flag." ;
    bsi:realizes bsi:ModelArtifact ;
    bsi:rowClass bsit:model_registry ;
    bsi:grain "(id)" ;
    bsi:cadence "on_training" ;
    bsi:trainingUse "forbidden" ;
    bsi:primaryKey "id" ;
    bsi:freshnessColumn "trained_at" ;
    bsi:writtenBy "ml_ensemble.py", "dl_engine.py", "online_learner.py" ;
    bsi:caveat "A registered model is not necessarily a serving one: promotion is gated on holdout error plus a margin.", "Metadata about a model, never a feature of the market." ;
    bsi:hasColumn _:col_model_registry_id, _:col_model_registry_model_name, _:col_model_registry_model_type, _:col_model_registry_trained_at, _:col_model_registry_horizon_days, _:col_model_registry_top_features_json .

