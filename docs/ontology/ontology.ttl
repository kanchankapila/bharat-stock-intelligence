    rdfs:comment "A row of stock_master. Grain: (symbol). Subclass of Equity; the physical contract (column set) lives in bsi:stock_masterShape." ;
    rdfs:subClassOf bsi:Equity .

_:col_stock_master_symbol     bsi:columnName "symbol" ;
    bsi:property bsip:symbol ;
