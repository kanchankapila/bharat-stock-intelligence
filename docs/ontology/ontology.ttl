bsip:category     rdf:type owl:DatatypeProperty ;
    rdfs:label "Category" ;
    rdfs:comment "Registry's category classification." ;
    rdfs:range xsd:string ;
    bsi:semanticType "dimension" ;
    bsi:timing "context" ;
