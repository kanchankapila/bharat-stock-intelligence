bsis:mover_snapshots     rdf:type bsi:Table ;
    rdfs:label "Mover snapshots" ;
    rdfs:comment "Ranked intraday mover lists from vendor feeds: the within-day event backbone behind the mover studies and breakout detectors." ;
    bsi:realizes bsi:MoverSnapshot ;
    bsi:rowClass bsit:mover_snapshots ;
    bsi:grain "(source, trade_date, symbol, rank)" ;
    bsi:cadence "intraday" ;
    bsi:trainingUse "allowed" ;
    bsi:primaryKey "source", "trade_date", "symbol", "rank" ;
    bsi:freshnessColumn "captured_at" ;
    bsi:expectedLagHours "0.5"^^xsd:decimal ;
    bsi:writtenBy "mover_screener_fetcher.py" ;
    bsi:caveat "`rank` is per source per capture — comparable only within one source and one instant.", "`metric_value` is source-specific in meaning; the raw body is retained in `payload_json` for the cases where it matters." ;
    bsi:hasColumn _:col_mover_snapshots_source, _:col_mover_snapshots_trade_date, _:col_mover_snapshots_symbol, _:col_mover_snapshots_rank, _:col_mover_snapshots_pct_change, _:col_mover_snapshots_payload_json, _:col_mover_snapshots_captured_at .

