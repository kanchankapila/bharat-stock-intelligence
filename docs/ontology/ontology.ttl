bsis:engine_composite_scores     rdf:type bsi:Table ;
    rdfs:label "Engine composite scores" ;
    rdfs:comment "The blended multi-engine composite per symbol and date with its engine-coverage count." ;
    bsi:realizes bsi:EngineScore ;
    bsi:rowClass bsit:engine_composite_scores ;
    bsi:grain "(symbol, date)" ;
    bsi:cadence "daily" ;
    bsi:trainingUse "allowed" ;
    bsi:primaryKey "symbol", "date" ;
    bsi:freshnessColumn "computed_at" ;
    bsi:writtenBy "unified_ranker.py" ;
    bsi:caveat "Coverage count matters as much as the score: a composite built from two engines is not comparable to one built from six." ;
    bsi:hasColumn _:col_engine_composite_scores_symbol, _:col_engine_composite_scores_date, _:col_engine_composite_scores_composite, _:col_engine_composite_scores_n_engines, _:col_engine_composite_scores_computed_at .

