bsis:unified_signal_outcomes     rdf:type bsi:Table ;
    rdfs:label "Unified signal outcomes" ;
    rdfs:comment "Outcomes for served signals with the exit reason that closed them — the forward-test surface for the ranker." ;
    bsi:realizes bsi:SignalOutcome ;
    bsi:rowClass bsit:unified_signal_outcomes ;
    bsi:grain "(symbol, signal_date, horizon_days)" ;
    bsi:cadence "daily" ;
    bsi:trainingUse "labels" ;
    bsi:primaryKey "symbol", "signal_date", "horizon_days" ;
    bsi:freshnessColumn "computed_at" ;
    bsi:writtenBy "outcome_resolver.py" ;
    bsi:forbiddenColumn "return_pct", "outcome", "exit_price", "check_date", "exit_reason" ;
    bsi:caveat "`exit_reason` separates rule exits from integrity exits: `NO_ENTRY_PRICE` and `SUSPECT_DATA` rows are not labels.", "`TIME_EXIT_PARTIAL` means the position did not close cleanly, so its return is not directly comparable to a full exit." ;
    bsi:hasColumn _:col_unified_signal_outcomes_unified_signal_id, _:col_unified_signal_outcomes_symbol, _:col_unified_signal_outcomes_signal_date, _:col_unified_signal_outcomes_signal_source, _:col_unified_signal_outcomes_horizon_days, _:col_unified_signal_outcomes_entry_price, _:col_unified_signal_outcomes_check_date, _:col_unified_signal_outcomes_exit_price, _:col_unified_signal_outcomes_return_pct, _:col_unified_signal_outcomes_outcome, _:col_unified_signal_outcomes_exit_reason, _:col_unified_signal_outcomes_signal_score, _:col_unified_signal_outcomes_computed_at .

bsit:unified_signal_outcomes     rdf:type owl:Class ;
    rdfs:label "unified_signal_outcomes row" ;
    rdfs:comment "A row of unified_signal_outcomes. Grain: (symbol, signal_date, horizon_days). Subclass of SignalOutcome; the physical contract (column set) lives in bsi:unified_signal_outcomesShape." ;
    rdfs:subClassOf bsi:SignalOutcome .

_:col_unified_signal_outcomes_unified_signal_id     bsi:columnName "unified_signal_id" ;
    bsi:property bsip:id ;
    bsi:semanticType "identifier" ;
    bsi:leakageRisk "none" ;
    bsi:note "FK to the served signal row; not stable across a rebuild." .

_:col_unified_signal_outcomes_symbol     bsi:columnName "symbol" ;
    bsi:property bsip:symbol ;
    bsi:semanticType "identifier" ;
    bsi:leakageRisk "none" .

_:col_unified_signal_outcomes_signal_date     bsi:columnName "signal_date" ;
    bsi:property bsip:signal_date ;
    bsi:semanticType "timestamp" ;
    bsi:leakageRisk "none" .

_:col_unified_signal_outcomes_signal_source     bsi:columnName "signal_source" ;
    bsi:property bsip:signal_source ;
    bsi:semanticType "enum" ;
    bsi:leakageRisk "none" .

_:col_unified_signal_outcomes_horizon_days     bsi:columnName "horizon_days" ;
    bsi:property bsip:horizon_days ;
    bsi:semanticType "count" ;
    bsi:leakageRisk "none" .

_:col_unified_signal_outcomes_entry_price     bsi:columnName "entry_price" ;
    bsi:property bsip:entry_price ;
    bsi:semanticType "measure" ;
    bsi:leakageRisk "low" .

_:col_unified_signal_outcomes_check_date     bsi:columnName "check_date" ;
    bsi:property bsip:check_date ;
    bsi:semanticType "timestamp" ;
    bsi:leakageRisk "high" .

_:col_unified_signal_outcomes_exit_price     bsi:columnName "exit_price" ;
    bsi:property bsip:exit_price ;
    bsi:semanticType "measure" ;
    bsi:leakageRisk "high" .

_:col_unified_signal_outcomes_return_pct     bsi:columnName "return_pct" ;
    bsi:property bsip:return_pct ;
    bsi:semanticType "label" ;
    bsi:leakageRisk "target" .

_:col_unified_signal_outcomes_outcome     bsi:columnName "outcome" ;
    bsi:property bsip:outcome ;
    bsi:semanticType "label" ;
    bsi:leakageRisk "target" .

_:col_unified_signal_outcomes_exit_reason     bsi:columnName "exit_reason" ;
    bsi:property bsip:exit_reason ;
    bsi:semanticType "label" ;
    bsi:leakageRisk "target" .

_:col_unified_signal_outcomes_signal_score     bsi:columnName "signal_score" ;
    bsi:property bsip:signal_score ;
    bsi:semanticType "score" ;
    bsi:leakageRisk "none" .

_:col_unified_signal_outcomes_computed_at     bsi:columnName "computed_at" ;
    bsi:property bsip:computed_at ;
    bsi:semanticType "timestamp" ;
    bsi:leakageRisk "none" .

bsis:signal_excursions     rdf:type bsi:Table ;
    rdfs:label "Signal excursions" ;
    rdfs:comment "MFE/MAE path statistics per signal and horizon, with days-to-each and whether the favourable move came first." ;
    bsi:realizes bsi:SignalExcursion ;
    bsi:rowClass bsit:signal_excursions ;
    bsi:grain "(symbol, signal_date, horizon_days)" ;
    bsi:cadence "daily" ;
    bsi:trainingUse "labels" ;
    bsi:primaryKey "symbol", "signal_date", "horizon_days" ;
    bsi:freshnessColumn "computed_at" ;
    bsi:writtenBy "outcome_resolver.py" ;
    bsi:forbiddenColumn "mfe_pct", "mae_pct" ;
    bsi:caveat "This is what makes a stop-loss or trailing-exit study possible: the terminal return alone cannot tell you whether the trade was ever viable.", "`tb_label` is a triple-barrier label sharing the label-definition property — it is not the same rule as `path_barrier`." ;
    bsi:hasColumn _:col_signal_excursions_symbol, _:col_signal_excursions_signal_date, _:col_signal_excursions_horizon_days, _:col_signal_excursions_entry_price, _:col_signal_excursions_mfe_pct, _:col_signal_excursions_mae_pct, _:col_signal_excursions_computed_at, _:col_signal_excursions_atr_pct, _:col_signal_excursions_tb_label .

bsit:signal_excursions     rdf:type owl:Class ;
    rdfs:label "signal_excursions row" ;
    rdfs:comment "A row of signal_excursions. Grain: (symbol, signal_date, horizon_days). Subclass of SignalExcursion; the physical contract (column set) lives in bsi:signal_excursionsShape." ;
    rdfs:subClassOf bsi:SignalExcursion .

_:col_signal_excursions_symbol     bsi:columnName "symbol" ;
    bsi:property bsip:symbol ;
    bsi:semanticType "identifier" ;
    bsi:leakageRisk "none" .

_:col_signal_excursions_signal_date     bsi:columnName "signal_date" ;
    bsi:property bsip:signal_date ;
    bsi:semanticType "timestamp" ;
    bsi:leakageRisk "none" .

_:col_signal_excursions_horizon_days     bsi:columnName "horizon_days" ;
    bsi:property bsip:horizon_days ;
    bsi:semanticType "count" ;
    bsi:leakageRisk "none" .

_:col_signal_excursions_entry_price     bsi:columnName "entry_price" ;
    bsi:property bsip:entry_price ;
    bsi:semanticType "measure" ;
    bsi:leakageRisk "low" .

_:col_signal_excursions_mfe_pct     bsi:columnName "mfe_pct" ;
    bsi:property bsip:mfe_pct ;
    bsi:semanticType "label" ;
    bsi:leakageRisk "target" .

_:col_signal_excursions_mae_pct     bsi:columnName "mae_pct" ;
    bsi:property bsip:mae_pct ;
    bsi:semanticType "label" ;
    bsi:leakageRisk "target" .

_:col_signal_excursions_computed_at     bsi:columnName "computed_at" ;
    bsi:property bsip:computed_at ;
    bsi:semanticType "timestamp" ;
    bsi:leakageRisk "none" .

_:col_signal_excursions_atr_pct     bsi:columnName "atr_pct" ;
    bsi:property bsip:atr ;
    bsi:semanticType "score" ;
    bsi:leakageRisk "none" ;
    bsi:note "ATR expressed as a percentage at signal time." .

_:col_signal_excursions_tb_label     bsi:columnName "tb_label" ;
    bsi:property bsip:label_definition ;
    bsi:semanticType "label" ;
    bsi:leakageRisk "target" ;
    bsi:note "Triple-barrier label." .

bsis:screener_master     rdf:type bsi:Table ;
    rdfs:label "Screener catalog" ;
    rdfs:comment "The catalog of vendor screeners with this platform's inferred sentiment, category, tier and classification confidence." ;
    bsi:realizes bsi:Screener ;
    bsi:rowClass bsit:screener_master ;
    bsi:grain "(scan_id)" ;
    bsi:cadence "on_change" ;
    bsi:trainingUse "caution" ;
    bsi:primaryKey "scan_id" ;
    bsi:freshnessColumn "last_updated" ;
    bsi:writtenBy "screener_catalog_enricher.py", "trendlyne_screener_discovery.py" ;
    bsi:caveat "Sentiment, category and tier are INFERRED by this platform: model output about a vendor product, not vendor metadata.", "A screener is a candidate generator, never evidence — the aggregate momentum score derived from these no longer clears the USABLE bar." ;
    bsi:hasColumn _:col_screener_master_scan_id, _:col_screener_master_name, _:col_screener_master_source, _:col_screener_master_inferred_sentiment, _:col_screener_master_inferred_category, _:col_screener_master_tier, _:col_screener_master_last_updated, _:col_screener_master_created_at .

bsit:screener_master     rdf:type owl:Class ;
    rdfs:label "screener_master row" ;
    rdfs:comment "A row of screener_master. Grain: (scan_id). Subclass of Screener; the physical contract (column set) lives in bsi:screener_masterShape." ;
    rdfs:subClassOf bsi:Screener .

_:col_screener_master_scan_id     bsi:columnName "scan_id" ;
    bsi:property bsip:id ;
    bsi:semanticType "identifier" ;
    bsi:leakageRisk "none" .

_:col_screener_master_name     bsi:columnName "name" ;
    bsi:property bsip:name ;
    bsi:semanticType "text" ;
    bsi:leakageRisk "none" .

_:col_screener_master_source     bsi:columnName "source" ;
    bsi:property bsip:source ;
    bsi:semanticType "dimension" ;
    bsi:leakageRisk "none" .

_:col_screener_master_inferred_sentiment     bsi:columnName "inferred_sentiment" ;
    bsi:property bsip:inferred_sentiment ;
    bsi:semanticType "enum" ;
    bsi:leakageRisk "none" .

_:col_screener_master_inferred_category     bsi:columnName "inferred_category" ;
    bsi:property bsip:inferred_category ;
    bsi:semanticType "enum" ;
    bsi:leakageRisk "none" .

_:col_screener_master_tier     bsi:columnName "tier" ;
    bsi:property bsip:tier ;
    bsi:semanticType "enum" ;
    bsi:leakageRisk "none" .

_:col_screener_master_last_updated     bsi:columnName "last_updated" ;
    bsi:property bsip:last_updated ;
    bsi:semanticType "timestamp" ;
    bsi:leakageRisk "none" .

_:col_screener_master_created_at     bsi:columnName "created_at" ;
    bsi:property bsip:computed_at ;
    bsi:semanticType "timestamp" ;
    bsi:leakageRisk "none" .

bsis:stock_scores     rdf:type bsi:Table ;
    rdfs:label "Domain scores" ;
    rdfs:comment "Per-domain score rows (technical, fundamental, ownership, ...) each with a classification and a confidence value." ;
    bsi:realizes bsi:EngineScore ;
    bsi:rowClass bsit:stock_scores ;
    bsi:grain "(symbol, timeframe)" ;
    bsi:cadence "on_write" ;
    bsi:trainingUse "caution" ;
    bsi:primaryKey "symbol", "timeframe" ;
    bsi:freshnessColumn "last_updated" ;
    bsi:writtenBy "scoring_engine.py" ;
    bsi:forbiddenColumn "confidence" ;
    bsi:caveat "Several rows per symbol — one per domain — so an ungrouped join multiplies the parent row count.", "`confidence` is a derived confidence value, not a calibrated probability, and not an input." ;
    bsi:hasColumn _:col_stock_scores_symbol, _:col_stock_scores_timeframe, _:col_stock_scores_score, _:col_stock_scores_confidence, _:col_stock_scores_classification, _:col_stock_scores_last_updated .

bsit:stock_scores     rdf:type owl:Class ;
    rdfs:label "stock_scores row" ;
    rdfs:comment "A row of stock_scores. Grain: (symbol, timeframe). Subclass of EngineScore; the physical contract (column set) lives in bsi:stock_scoresShape." ;
    rdfs:subClassOf bsi:EngineScore .

_:col_stock_scores_symbol     bsi:columnName "symbol" ;
    bsi:property bsip:symbol ;
    bsi:semanticType "identifier" ;
    bsi:leakageRisk "none" .

_:col_stock_scores_timeframe     bsi:columnName "timeframe" ;
    bsi:property bsip:timeframe ;
    bsi:semanticType "enum" ;
    bsi:leakageRisk "none" .

_:col_stock_scores_score     bsi:columnName "score" ;
    bsi:property bsip:composite ;
    bsi:semanticType "score" ;
    bsi:leakageRisk "none" ;
    bsi:note "Per-domain score in a multi-domain table." .

_:col_stock_scores_confidence     bsi:columnName "confidence" ;
    bsi:property bsip:win_probability ;
    bsi:semanticType "probability" ;
    bsi:leakageRisk "high" ;
    bsi:note "A confidence value, not a calibrated probability." .

_:col_stock_scores_classification     bsi:columnName "classification" ;
    bsi:property bsip:classification ;
    bsi:semanticType "enum" ;
    bsi:leakageRisk "none" .

_:col_stock_scores_last_updated     bsi:columnName "last_updated" ;
    bsi:property bsip:last_updated ;
    bsi:semanticType "timestamp" ;
    bsi:leakageRisk "none" .

bsis:live_screener_appearances     rdf:type bsi:Table ;
    rdfs:label "Live screener appearances" ;
    rdfs:comment "Every live surfacing event: which screener listed which symbol at which instant, with the price, change and volume at that moment." ;
    bsi:realizes bsi:ScreenerAppearance ;
    bsi:rowClass bsit:live_screener_appearances ;
    bsi:grain "(id)" ;
    bsi:cadence "every_15m" ;
    bsi:trainingUse "allowed" ;
    bsi:primaryKey "id" ;
    bsi:writtenBy "mover_screener_fetcher.py", "live_screener_ml_ranker.py" ;
    bsi:caveat "12.25M rows and growing: always bound a query by run_id or symbol.", "`price` is the snapshot at surfacing time, not a session close.", "There is no timestamp column on the row itself — time lives on the run, so a time filter must join through it." ;
    bsi:hasColumn _:col_live_screener_appearances_id, _:col_live_screener_appearances_run_id, _:col_live_screener_appearances_symbol, _:col_live_screener_appearances_filter_key, _:col_live_screener_appearances_price, _:col_live_screener_appearances_change_per, _:col_live_screener_appearances_volume .

bsit:live_screener_appearances     rdf:type owl:Class ;
    rdfs:label "live_screener_appearances row" ;
    rdfs:comment "A row of live_screener_appearances. Grain: (id). Subclass of ScreenerAppearance; the physical contract (column set) lives in bsi:live_screener_appearancesShape." ;
    rdfs:subClassOf bsi:ScreenerAppearance .

_:col_live_screener_appearances_id     bsi:columnName "id" ;
    bsi:property bsip:id ;
    bsi:semanticType "identifier" ;
    bsi:leakageRisk "none" .

_:col_live_screener_appearances_run_id     bsi:columnName "run_id" ;
    bsi:property bsip:id ;
    bsi:semanticType "identifier" ;
    bsi:leakageRisk "none" ;
    bsi:note "FK to the screener run." .

_:col_live_screener_appearances_symbol     bsi:columnName "symbol" ;
    bsi:property bsip:symbol ;
    bsi:semanticType "identifier" ;
    bsi:leakageRisk "none" .

_:col_live_screener_appearances_filter_key     bsi:columnName "filter_key" ;
    bsi:property bsip:name ;
    bsi:semanticType "text" ;
    bsi:leakageRisk "none" ;
    bsi:note "The screener that surfaced the name." .

_:col_live_screener_appearances_price     bsi:columnName "price" ;
    bsi:property bsip:cmp ;
    bsi:semanticType "measure" ;
    bsi:leakageRisk "none" ;
    bsi:note "Price at the moment of surfacing." .

_:col_live_screener_appearances_change_per     bsi:columnName "change_per" ;
    bsi:property bsip:change_pct ;
    bsi:semanticType "ratio" ;
    bsi:leakageRisk "none" .

_:col_live_screener_appearances_volume     bsi:columnName "volume" ;
    bsi:property bsip:volume ;
    bsi:semanticType "measure" ;
    bsi:leakageRisk "none" .

bsis:live_screener_outcomes     rdf:type bsi:Table ;
    rdfs:label "Live screener outcomes" ;
    rdfs:comment "Forward returns attached to each appearance at surfacing time: the platform's largest pre-labelled dataset." ;
    bsi:realizes bsi:ScreenerOutcome ;
    bsi:rowClass bsit:live_screener_outcomes ;
    bsi:grain "(appearance_id, symbol)" ;
    bsi:cadence "every_15m" ;
    bsi:trainingUse "labels" ;
    bsi:primaryKey "appearance_id", "symbol" ;
    bsi:freshnessColumn "appeared_at" ;
    bsi:writtenBy "live_screener_ml_ranker.py" ;
    bsi:forbiddenColumn "return_1d", "return_3d", "return_5d", "entry_price" ;
    bsi:caveat "LABELS ONLY — three horizons share one return property, distinguished by the column name; never average them together.", "The label is a forward return from the SURFACING price, so any attribution belongs to the screener that surfaced it, not to an engine that agreed.", "Coverage is per-appearance and pre-computed, which is why the 3d/5d columns are NULL for recent rows — those are not losses." ;
    bsi:hasColumn _:col_live_screener_outcomes_appearance_id, _:col_live_screener_outcomes_symbol, _:col_live_screener_outcomes_entry_price, _:col_live_screener_outcomes_return_1d, _:col_live_screener_outcomes_return_3d, _:col_live_screener_outcomes_return_5d, _:col_live_screener_outcomes_appeared_at .

bsit:live_screener_outcomes     rdf:type owl:Class ;
    rdfs:label "live_screener_outcomes row" ;
    rdfs:comment "A row of live_screener_outcomes. Grain: (appearance_id, symbol). Subclass of ScreenerOutcome; the physical contract (column set) lives in bsi:live_screener_outcomesShape." ;
    rdfs:subClassOf bsi:ScreenerOutcome .

_:col_live_screener_outcomes_appearance_id     bsi:columnName "appearance_id" ;
    bsi:property bsip:id ;
    bsi:semanticType "identifier" ;
    bsi:leakageRisk "none" ;
    bsi:note "FK to live_screener_appearances.id." .

_:col_live_screener_outcomes_symbol     bsi:columnName "symbol" ;
    bsi:property bsip:symbol ;
    bsi:semanticType "identifier" ;
    bsi:leakageRisk "none" .

_:col_live_screener_outcomes_entry_price     bsi:columnName "entry_price" ;
    bsi:property bsip:entry_price ;
    bsi:semanticType "measure" ;
    bsi:leakageRisk "low" .

_:col_live_screener_outcomes_return_1d     bsi:columnName "return_1d" ;
    bsi:property bsip:return_pct ;
    bsi:semanticType "label" ;
    bsi:leakageRisk "target" ;
    bsi:note "One-session forward return." .

_:col_live_screener_outcomes_return_3d     bsi:columnName "return_3d" ;
    bsi:property bsip:return_pct ;
    bsi:semanticType "label" ;
    bsi:leakageRisk "target" ;
    bsi:note "Three-session forward return." .

_:col_live_screener_outcomes_return_5d     bsi:columnName "return_5d" ;
    bsi:property bsip:return_pct ;
    bsi:semanticType "label" ;
    bsi:leakageRisk "target" ;
    bsi:note "Five-session forward return." .

_:col_live_screener_outcomes_appeared_at     bsi:columnName "appeared_at" ;
    bsi:property bsip:check_date ;
    bsi:semanticType "timestamp" ;
    bsi:leakageRisk "high" ;
    bsi:note "When the name was surfaced." .

bsis:job_heartbeat     rdf:type bsi:Table ;
    rdfs:label "Job heartbeats" ;
    rdfs:comment "Per-job last status, last success, last error and run/failure counts. The operational truth behind every freshness claim." ;
    bsi:realizes bsi:JobRun ;
    bsi:rowClass bsit:job_heartbeat ;
    bsi:grain "(job_name)" ;
    bsi:cadence "continuous" ;
    bsi:trainingUse "forbidden" ;
    bsi:primaryKey "job_name" ;
    bsi:freshnessColumn "last_success_at" ;
    bsi:writtenBy "jobHeartbeat.ts", "pythonRunner.ts" ;
    bsi:caveat "`last_run_at` is the last ATTEMPT and `last_success_at` the last SUCCESS — a job can run nightly, fail nightly, and still look alive by the first column. Judge freshness on the second.", "Operational metadata: useful for lineage, never a model feature." ;
    bsi:hasColumn _:col_job_heartbeat_job_name, _:col_job_heartbeat_last_status, _:col_job_heartbeat_last_run_at, _:col_job_heartbeat_last_success_at, _:col_job_heartbeat_last_error, _:col_job_heartbeat_run_count, _:col_job_heartbeat_fail_count .

bsit:job_heartbeat     rdf:type owl:Class ;
    rdfs:label "job_heartbeat row" ;
    rdfs:comment "A row of job_heartbeat. Grain: (job_name). Subclass of JobRun; the physical contract (column set) lives in bsi:job_heartbeatShape." ;
    rdfs:subClassOf bsi:JobRun .

_:col_job_heartbeat_job_name     bsi:columnName "job_name" ;
    bsi:property bsip:job_name ;
    bsi:semanticType "operational" ;
    bsi:leakageRisk "none" .

_:col_job_heartbeat_last_status     bsi:columnName "last_status" ;
    bsi:property bsip:last_status ;
    bsi:semanticType "operational" ;
    bsi:leakageRisk "none" .

_:col_job_heartbeat_last_run_at     bsi:columnName "last_run_at" ;
    bsi:property bsip:computed_at ;
    bsi:semanticType "timestamp" ;
    bsi:leakageRisk "none" .

_:col_job_heartbeat_last_success_at     bsi:columnName "last_success_at" ;
    bsi:property bsip:computed_at ;
    bsi:semanticType "timestamp" ;
    bsi:leakageRisk "none" ;
    bsi:note "Last SUCCESSFUL run, not last run." .

_:col_job_heartbeat_last_error     bsi:columnName "last_error" ;
    bsi:property bsip:last_error ;
    bsi:semanticType "text" ;
    bsi:leakageRisk "none" .

_:col_job_heartbeat_run_count     bsi:columnName "run_count" ;
    bsi:property bsip:run_count ;
    bsi:semanticType "operational" ;
    bsi:leakageRisk "none" .

_:col_job_heartbeat_fail_count     bsi:columnName "fail_count" ;
    bsi:property bsip:fail_count ;
    bsi:semanticType "operational" ;
    bsi:leakageRisk "none" .

bsis:data_quality_results     rdf:type bsi:Table ;
    rdfs:label "Data-quality results" ;
    rdfs:comment "The latest result of each named validation check with its category, criticality and a detail string." ;
    bsi:realizes bsi:DataQualityCheck ;
    bsi:rowClass bsit:data_quality_results ;
    bsi:grain "(check_id)" ;
    bsi:cadence "continuous" ;
    bsi:trainingUse "forbidden" ;
    bsi:primaryKey "check_id" ;
    bsi:freshnessColumn "checked_at" ;
    bsi:writtenBy "run_data_quality_checks.ts" ;
    bsi:caveat "`status` is stored lowercase (`pass`, `warn`), so a comparison against 'PASS' silently matches nothing.", "A `warn` here is a real signal that some upstream writer misbehaved — worth reading before trusting the affected table." ;
    bsi:hasColumn _:col_data_quality_results_check_id, _:col_data_quality_results_label, _:col_data_quality_results_category, _:col_data_quality_results_status, _:col_data_quality_results_detail, _:col_data_quality_results_checked_at .

bsit:data_quality_results     rdf:type owl:Class ;
    rdfs:label "data_quality_results row" ;
    rdfs:comment "A row of data_quality_results. Grain: (check_id). Subclass of DataQualityCheck; the physical contract (column set) lives in bsi:data_quality_resultsShape." ;
    rdfs:subClassOf bsi:DataQualityCheck .

_:col_data_quality_results_check_id     bsi:columnName "check_id" ;
    bsi:property bsip:check_id ;
