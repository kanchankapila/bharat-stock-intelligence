bsis:confluence_signals     rdf:type bsi:Table ;
    rdfs:label "Confluence signals" ;
    rdfs:comment "The multi-engine agreement score with the contributing screeners, their weights at scoring time, and the model probabilities that fed it." ;
    bsi:realizes bsi:EngineScore ;
    bsi:rowClass bsit:confluence_signals ;
    bsi:grain "(symbol, computed_at)" ;
    bsi:cadence "every_15m" ;
    bsi:trainingUse "caution" ;
    bsi:primaryKey "symbol", "computed_at" ;
    bsi:freshnessColumn "computed_at" ;
    bsi:expectedLagHours "0.5"^^xsd:decimal ;
    bsi:writtenBy "confluence_ml_engine.py" ;
    bsi:forbiddenColumn "trade_reasoning", "ai_conclusion" ;
    bsi:caveat "The only engine score with a growing positive graded reading on this platform — which is what makes it the ranker's load-bearing input.", "`computed_at` here is native TIMESTAMPTZ, unlike the TEXT `computed_at` on `unified_recommendations`: cast across the join.", "`ml_breakout_probability` / `ml_trend_probability` are model outputs.", "`screener_weights_json` records the weights AT SCORING TIME — applying today's weights to an old row is a look-ahead bug." ;
    bsi:hasColumn _:col_confluence_signals_symbol, _:col_confluence_signals_computed_at, _:col_confluence_signals_confluence_score, _:col_confluence_signals_conviction_level, _:col_confluence_signals_active_screener_count, _:col_confluence_signals_bullish_screener_count, _:col_confluence_signals_bearish_screener_count, _:col_confluence_signals_screener_ids_json, _:col_confluence_signals_screener_names_json, _:col_confluence_signals_screener_weights_json, _:col_confluence_signals_fundamental_score, _:col_confluence_signals_ml_breakout_probability, _:col_confluence_signals_ml_trend_probability, _:col_confluence_signals_entry_zone_low, _:col_confluence_signals_entry_zone_high, _:col_confluence_signals_stop_loss, _:col_confluence_signals_target_1, _:col_confluence_signals_target_2, _:col_confluence_signals_target_3, _:col_confluence_signals_risk_reward, _:col_confluence_signals_ai_conclusion, _:col_confluence_signals_trade_reasoning, _:col_confluence_signals_sector, _:col_confluence_signals_market_cap, _:col_confluence_signals_current_price, _:col_confluence_signals_current_volume, _:col_confluence_signals_rsi, _:col_confluence_signals_atr, _:col_confluence_signals_expires_at .

