    bsi:semanticType "measure" ;
    bsi:timing "coincident" ;
    bsi:derivation "raw" ;
    bsi:leakageRisk "high" ;
    bsi:usableAsFeature "false"^^xsd:boolean ;
    bsi:isLabel "false"^^xsd:boolean ;
    qudt:unit "per_share_INR" ;
    skos:altLabel "exit" ;
    bsi:pointInTimeNote "Outcome-side column: it exists only because the horizon has elapsed." ;
    bsi:boundTo bsis:signal_outcomes.exit_price, bsis:unified_signal_outcomes.exit_price, bsis:market_decision_outcome.exit_price .

bsip:open_interest     rdf:type owl:DatatypeProperty ;
    rdfs:label "Open interest" ;
    rdfs:comment "Outstanding contracts on a derivative." ;
