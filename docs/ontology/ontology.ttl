@prefix bsi: <https://bharat-stock-intelligence.dev/ontology/market#> .
@prefix bsip: <https://bharat-stock-intelligence.dev/ontology/property#> .
@prefix bsir: <https://bharat-stock-intelligence.dev/ontology/relation#> .
@prefix bsim: <https://bharat-stock-intelligence.dev/ontology/metric#> .
@prefix bsiv: <https://bharat-stock-intelligence.dev/ontology/vocab#> .
@prefix bsis: <https://bharat-stock-intelligence.dev/ontology/source#> .
@prefix bsit: <https://bharat-stock-intelligence.dev/ontology/table#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix fibo-sec-eq-eq: <https://spec.edmcouncil.org/fibo/ontology/SEC/Equities/EquityInstruments/> .
@prefix fibo-sec-sec-id: <https://spec.edmcouncil.org/fibo/ontology/SEC/Securities/SecuritiesIdentification/> .
@prefix fibo-sec-sec-lst: <https://spec.edmcouncil.org/fibo/ontology/SEC/Securities/SecuritiesListings/> .
@prefix fibo-fbc-fi-fi: <https://spec.edmcouncil.org/fibo/ontology/FBC/FinancialInstruments/FinancialInstruments/> .
@prefix fibo-fbc-fct-mkt: <https://spec.edmcouncil.org/fibo/ontology/FBC/FunctionalEntities/Markets/> .
@prefix fibo-fnd-acc-cur: <https://spec.edmcouncil.org/fibo/ontology/FND/Accounting/CurrencyAmount/> .
@prefix fibo-ind-mkt-bas: <https://spec.edmcouncil.org/fibo/ontology/IND/MarketIndices/BasketIndices/> .
@prefix fibo-cae-ce-ca: <https://spec.edmcouncil.org/fibo/ontology/CAE/CorporateEvents/CorporateActions/> .
@prefix fibo-sec-sec-iss: <https://spec.edmcouncil.org/fibo/ontology/SEC/Securities/SecuritiesIssuance/> .
@prefix fibo-der-der-futures: <https://spec.edmcouncil.org/fibo/ontology/DER/DerivativesContracts/FuturesAndForwards/> .
@prefix cmns-id: <https://www.omg.org/spec/Commons/Identifiers/> .
@prefix cmns-dt: <https://www.omg.org/spec/Commons/DatesAndTimes/> .
@prefix cmns-qtu: <https://www.omg.org/spec/Commons/QuantitiesAndUnits/> .
@prefix cmns-cds: <https://www.omg.org/spec/Commons/CodesAndCodeSets/> .

bsi:Ontology     rdf:type owl:Ontology ;
    dct:title "Bharat Stock Intelligence — market knowledge graph" ;
    owl:versionInfo "1.1.0" ;
    dct:description "A semantic layer over the bharat_intel Postgres database: entity types, properties with timing/leakage semantics, typed relations, executable metrics, controlled vocabularies and table-level data cards." ;
    dct:license "Repository has no LICENSE file; the layer itself is published under the terms of that repository. Aligned external standards keep their own licenses — see standards.txt." .

bsi:Guardrails     rdf:type bsi:GuardrailSet ;
    rdfs:comment "Rules that must travel with any prompt or feature set built from this ontology." ;
    bsi:rule "Columns with leakage_risk 'high' or 'target' are NEVER features. Columns whose semantic_type is 'label' ARE the target.", "`technical_signals`, `feature_store`, score-typed columns and the recommendation tables are platform OUTPUTS: a model may predict something else from them, but feeding an engine score back in as a feature leaks that engine into its own inputs.", "Point-in-time: entry is the NEXT session's open after `signal_date`. A feature must have been knowable before that open.", "Labels are not comparable across `label_definition` values (`path_barrier` vs `terminal_pct2`). Filter it before aggregating any accuracy number.", "`PENDING` outcome rows have not elapsed yet and are not negative examples.", "Mixing `adjustment_basis` values inside one price series invalidates every result derived from it.", "`screener_*` tables are vendor OPINIONS used to surface candidates. They are never ground truth, and their aggregate score no longer clears the USABLE bar.", "Read `eff_dates` before any rank-IC reading: overlapping forward windows inflate a correlation by roughly the horizon factor.", "Every historical read is an as-of read: a feature value must come from rows whose data was knowable at or before entry — never from today's state projected back.", "Nothing in this layer is investment advice or a solicitation to trade; it describes data semantics only, and any output built from it is not financial advice." .

bsi:Instrument     rdf:type owl:Class ;
    rdfs:label "Instrument"^^xsd:string ;
    rdfs:comment "Anything that is quoted and traded. The canonical instrument identity is table-backed in `market_instrument`; legacy observation tables still key on the exchange ticker."^^xsd:string ;
    bsi:layer "identity" ;
    bsi:realization "table" ;
    bsi:grain "instrument_key" ;
    bsi:keyProperty bsip:instrument_key ;
    bsi:realizedBy bsis:market_instrument ;
    skos:closeMatch fibo-fbc-fi-fi:FinancialInstrument ;
    bsi:alignmentRationale "[fibo-fbc-fi-fi:FinancialInstrument] FIBO's root of the instrument hierarchy. Our hierarchy is shallower: one class per physical table rather than per contractual concept." ;
    bsi:verifiedFrom "https://github.com/edmcouncil/fibo (published prefix declarations) + FIBO IRI space under spec.edmcouncil.org; class symbols cross-checked against declared FIBO type stereotypes. Fetched 2026-09-21." .

bsi:Issuer     rdf:type owl:Class ;
    rdfs:label "Issuer"^^xsd:string ;
    rdfs:comment "The legal issuer behind one or more instruments. ISIN issuer-prefix keys are authoritative when a checksum-valid ISIN is available; symbol-only rows remain explicitly provisional."^^xsd:string ;
    bsi:layer "identity" ;
    bsi:realization "table" ;
    bsi:grain "issuer_key" ;
    bsi:keyProperty bsip:issuer_key ;
    bsi:realizedBy bsis:market_issuer .

bsi:Listing     rdf:type owl:Class ;
    rdfs:label "Listing"^^xsd:string ;
    rdfs:comment "One tradable exchange/segment/symbol representation of an instrument."^^xsd:string ;
    bsi:layer "identity" ;
    bsi:realization "table" ;
    bsi:grain "listing_key" ;
    rdfs:subClassOf bsi:Instrument ;
    bsi:keyProperty bsip:listing_key ;
    bsi:realizedBy bsis:market_listing .

bsi:ProviderIdentifier     rdf:type owl:Class ;
    rdfs:label "Provider identifier"^^xsd:string ;
    rdfs:comment "A provider-qualified identifier for an instrument. Provider and scheme are part of the identity; collisions are recorded rather than resolved by row order."^^xsd:string ;
    bsi:layer "identity" ;
    bsi:realization "table" ;
    bsi:grain "(provider, scheme, identifier_value)" ;
    bsi:keyProperty bsip:provider, bsip:scheme, bsip:identifier_value ;
    bsi:realizedBy bsis:market_identifier, bsis:market_identifier_gap .

bsi:Equity     rdf:type owl:Class ;
    rdfs:label "Equity"^^xsd:string ;
    rdfs:comment "A listed equity, one row per exchange ticker. This is the platform's universal join key and the subject of every other class."^^xsd:string ;
    bsi:layer "identity" ;
    bsi:realization "table" ;
    bsi:grain "one row per exchange ticker in `stock_master`" ;
    rdfs:subClassOf bsi:Instrument ;
    bsi:keyProperty bsip:symbol, bsip:isin ;
    bsi:caveat "Keyed on ticker, not ISIN: a company listed on both NSE and BSE is two rows here and one instrument in any ISIN-first model (see alignment.py).", "`stock_master.sector` was EMPTY for every row as of 2026-09-21; sector is populated downstream (technical_signals.sector, unified_recommendations.sector)." ;
    bsi:realizedBy bsis:stock_master, bsis:nse_stocks ;
    skos:closeMatch fibo-sec-eq-eq:Equity, fibo-sec-sec-lst:ListedSecurity ;
    bsi:alignmentRationale "[fibo-sec-eq-eq:Equity] CAUTION — GRANULARITY MISMATCH, and the most useful finding of this alignment. FIBO separates Equity (instrument), Share (ownership unit) and Listing (admission to an exchange). `stock_master` is keyed on the exchange ticker (`symbol`), so our `Equity` is really a *Listing*: one row per (instrument, exchange). A mapping that ignores this duplicates a company listed on both NSE and BSE. FIBO's ISIN-first keying is why the platform's ISIN coverage is a prerequisite for any real instrument master.", "[fibo-sec-sec-lst:ListedSecurity] The closer of the two FIBO classes to what `stock_master` actually stores, because row identity is the exchange ticker, not the instrument." ;
    bsi:verifiedFrom "https://github.com/edmcouncil/fibo (published prefix declarations) + FIBO IRI space under spec.edmcouncil.org; class symbols cross-checked against declared FIBO type stereotypes. Fetched 2026-09-21.", "https://github.com/edmcouncil/fibo (published prefix declarations) + FIBO IRI space under spec.edmcouncil.org; class symbols cross-checked against declared FIBO type stereotypes. Fetched 2026-09-21." .

bsi:Index     rdf:type owl:Class ;
    rdfs:label "Index"^^xsd:string ;
    rdfs:comment "A market index used as a benchmark or as a derivatives underlying (NIFTY 50, BANK NIFTY, SENSEX, INDIA VIX, GIFT NIFTY, ...)."^^xsd:string ;
    bsi:layer "identity" ;
    bsi:realization "reference" ;
    bsi:grain "one row per index" ;
    bsi:keyProperty bsip:index_name ;
    bsi:caveat "A *reference* class: the index exists only as a column value on `nt_index_pcr_ts`, `index_ohlcv`, `nt_fno_expiry` and the option tables. `stock_master` carries no index master, so an index is whatever a fetcher wrote — normalise case before joining across tables." ;
    skos:closeMatch fibo-ind-mkt-bas:MarketIndex ;
    bsi:alignmentRationale "[fibo-ind-mkt-bas:MarketIndex] NIFTY 50 / BANK NIFTY / SENSEX. `fibo-ind-mkt-bas` (BasketIndices) is confirmed as the right module for index concepts." ;
    bsi:verifiedFrom "https://github.com/edmcouncil/fibo (published prefix declarations) + FIBO IRI space under spec.edmcouncil.org; class symbols cross-checked against declared FIBO type stereotypes. Fetched 2026-09-21." .

bsi:Sector     rdf:type owl:Class ;
    rdfs:label "Sector"^^xsd:string ;
    rdfs:comment "An industry grouping used for relative-strength and rotation analysis. Stored as free text across several tables rather than resolved to a scheme."^^xsd:string ;
    bsi:layer "identity" ;
    bsi:realization "reference" ;
    bsi:grain "one row per label, no canonical table" ;
    bsi:keyProperty bsip:sector ;
    bsi:caveat "A *reference* class with no master table: the label comes from whichever fetcher wrote the row (`technical_signals.sector`, `unified_recommendations.sector`), so cross-table sector joins can silently lose or double-count names. Resolve to a spelling before aggregating." .

bsi:Exchange     rdf:type owl:Class ;
    rdfs:label "Exchange"^^xsd:string ;
    rdfs:comment "The venue an instrument is admitted to. A two-value dimension (NSE / BSE): usually encoded inside `symbol`, but carried as its own column in seven tables (nse_stocks, market_holidays, nt_fno_expiry, stock_earnings_dates, institutional_deal_signals, mc_advance_decline, mc_chart_patterns)."^^xsd:string ;
    bsi:layer "identity" ;
    bsi:realization "reference" ;
    bsi:grain "dimension" ;
    bsi:keyProperty bsip:exchange ;
    bsi:caveat "A *reference* class: it has no card because no single table is the exchange. `nse_stocks.exchange` is the canonical column and the other six are pass-through copies written by different fetchers." ;
    skos:closeMatch fibo-fbc-fct-mkt:Exchange ;
    bsi:alignmentRationale "[fibo-fbc-fct-mkt:Exchange] NSE / BSE. FIBO's Exchange is a market operator; ours is a two-value dimension column, so the alignment is nominal." ;
    bsi:verifiedFrom "https://github.com/edmcouncil/fibo (published prefix declarations) + FIBO IRI space under spec.edmcouncil.org; class symbols cross-checked against declared FIBO type stereotypes. Fetched 2026-09-21." .

bsi:ScripCodeMapping     rdf:type owl:Class ;
    rdfs:label "Vendor scrip-code mapping"^^xsd:string ;
    rdfs:comment "The vendor's private scid mapped onto the platform symbol and issuer name — the only sanctioned route from one to the other."^^xsd:string ;
    bsi:layer "identity" ;
    bsi:realization "table" ;
    bsi:grain "(scid, symbol)" ;
    bsi:keyProperty bsip:scid, bsip:symbol ;
    bsi:caveat "Not enforced as unique: after a vendor scrip merge, one symbol can appear under more than one scid, so a symbol->scid join can fan out." ;
    bsi:realizedBy bsis:mc_scid_map .

bsi:CompanyProfile     rdf:type owl:Class ;
    rdfs:label "CompanyProfile"^^xsd:string ;
    rdfs:comment "Narrative and high-level attributes about the issuer behind a ticker."^^xsd:string ;
    bsi:layer "identity" ;
    bsi:realization "table" ;
    bsi:grain "one row per symbol" ;
    rdfs:subClassOf bsi:Instrument ;
    bsi:keyProperty bsip:symbol ;
    bsi:caveat "Description text is vendor-authored and free-form; `growth_score` and `ai_analysis` are derived, not observed." ;
    bsi:realizedBy bsis:company_profiles ;
    skos:closeMatch fibo-fbc-fi-fi:Issuer ;
    bsi:alignmentRationale "[fibo-fbc-fi-fi:Issuer] The legal person behind the listing. Our description is free text; FIBO would carry structured legal-entity attributes." ;
    bsi:verifiedFrom "https://github.com/edmcouncil/fibo (published prefix declarations) + FIBO IRI space under spec.edmcouncil.org; class symbols cross-checked against declared FIBO type stereotypes. Fetched 2026-09-21." .

bsi:Observation     rdf:type owl:Class ;
    rdfs:label "Observation"^^xsd:string ;
    rdfs:comment "Abstract parent for anything measured at a point in time without the platform adding an opinion to it. Raw or vendor-supplied; never a label."^^xsd:string ;
    bsi:layer "observation" ;
    bsi:realization "abstract" ;
    bsi:keyProperty bsip:symbol .

bsi:Bar     rdf:type owl:Class ;
    rdfs:label "Daily bar"^^xsd:string ;
    rdfs:comment "One daily OHLCV bar per symbol per trading session — the platform's only self-owned source of truth."^^xsd:string ;
    bsi:layer "observation" ;
    bsi:realization "table" ;
    bsi:grain "(symbol, date)" ;
    rdfs:subClassOf bsi:Observation ;
    bsi:keyProperty bsip:symbol, bsip:date ;
    bsi:caveat "Price basis is recorded per row in `adjustment_basis` (nse_bhavcopy_raw | split_only | split_dividend). Mixing bases inside one series corrupts any backtest silently — this is a documented recurring bug class in this repo.", "Quarantined bars are flagged, not deleted: filter `is_suspect = 0` before building a training panel. `suspect_reason` names the cause." ;
    bsi:realizedBy bsis:stock_ohlcv .

bsi:IntradayBar     rdf:type owl:Class ;
    rdfs:label "Intraday bar"^^xsd:string ;
    rdfs:comment "Sub-daily OHLCV with VWAP. Currently a single interval (15m) of recent history."^^xsd:string ;
    bsi:layer "observation" ;
    bsi:realization "table" ;
    bsi:grain "(symbol, datetime, series)" ;
    rdfs:subClassOf bsi:Observation ;
    bsi:keyProperty bsip:symbol, bsip:datetime, bsip:series ;
    bsi:caveat "Shallow history relative to the daily panel; not a substitute for `stock_ohlcv` in any long-horizon study.", "The key's `series` property is the bar interval (`15m`), NOT an NSE series symbol — the same `series` property is overloaded across the schema (see its bindings), so a join must qualify the table too.", "3.88M rows are stored in a single `datetime` column that mixes the exchange date and the clock time; it is a TIMESTAMP, not a trading-date column, so it does not join to `stock_ohlcv.date` without a cast." ;
    bsi:realizedBy bsis:intraday_ohlcv .

bsi:DeliveryObservation     rdf:type owl:Class ;
    rdfs:label "Delivery observation"^^xsd:string ;
    rdfs:comment "The deliverable-to-traded quantity ratio — the highest-frequency ownership-behaviour proxy the platform owns, and a T+1 lag by construction."^^xsd:string ;
    bsi:layer "observation" ;
    bsi:realization "table" ;
    bsi:grain "(symbol, date)" ;
    rdfs:subClassOf bsi:Observation ;
    bsi:keyProperty bsip:symbol, bsip:date ;
    bsi:caveat "Two writers exist (`stock_delivery_data`, `stock_delivery_volume`) with different column names and different series coverage — check which one a study used." ;
    bsi:realizedBy bsis:stock_delivery_data, bsis:stock_delivery_volume .

bsi:CorporateAction     rdf:type owl:Class ;
    rdfs:label "Corporate action"^^xsd:string ;
    rdfs:comment "A capital-structure event with a price consequence (dividend, split, bonus, rights) plus the record/ex dates that make it usable point-in-time."^^xsd:string ;
    bsi:layer "observation" ;
    bsi:realization "table" ;
    bsi:grain "(symbol, ex_date, action_type)" ;
    rdfs:subClassOf bsi:Observation ;
    bsi:keyProperty bsip:symbol, bsip:ex_date, bsip:action_type ;
    bsi:caveat "The same table also carries `Quarterly Results` rows, which are not capital actions at all — filter `action_type` before computing an adjustment factor." ;
    bsi:realizedBy bsis:corporate_actions ;
    skos:closeMatch fibo-cae-ce-ca:CorporateAction ;
    bsi:alignmentRationale "[fibo-cae-ce-ca:CorporateAction] Our `action_type` is a flat vocabulary (DIVIDEND, SPLIT, BONUS, ...). FIBO expresses the same distinctions as an explicit subclass hierarchy with mandatory dates and ratios — adequate for price adjustment, insufficient for contractual reporting." ;
    bsi:verifiedFrom "https://github.com/edmcouncil/fibo (published prefix declarations) + FIBO IRI space under spec.edmcouncil.org; class symbols cross-checked against declared FIBO type stereotypes. Fetched 2026-09-21." .

bsi:FundamentalSnapshot     rdf:type owl:Class ;
    rdfs:label "Fundamental snapshot"^^xsd:string ;
    rdfs:comment "Vendor-supplied accounting ratios and market-cap for a symbol, captured with an as-of date. Lagging information: the publication delay is the point-in-time risk."^^xsd:string ;
    bsi:layer "observation" ;
    bsi:realization "table" ;
    bsi:grain "(symbol, as_of_date)" ;
    rdfs:subClassOf bsi:Observation ;
    bsi:keyProperty bsip:symbol, bsip:as_of_date ;
    bsi:caveat "Vendor restatements make re-fetched history differ from what was known at the time; only the as-of-captured row is point-in-time honest." ;
    bsi:realizedBy bsis:fundamentals_history .

bsi:AnalystEstimate     rdf:type owl:Class ;
    rdfs:label "Analyst estimate"^^xsd:string ;
    rdfs:comment "Consensus ratings, target prices and next-period estimates captured as a dated snapshot. Genuinely leading information; short panel relative to the news table."^^xsd:string ;
    bsi:layer "observation" ;
    bsi:realization "table" ;
    bsi:grain "(symbol, as_of_date)" ;
    rdfs:subClassOf bsi:Observation ;
    bsi:keyProperty bsip:symbol, bsip:as_of_date ;
    bsi:caveat "The revision trio (eps/target revision, analyst-count change) is carried downstream into `technical_signals` and is not yet graded." ;
    bsi:realizedBy bsis:analyst_estimates_history .

bsi:EarningsSurprise     rdf:type owl:Class ;
    rdfs:label "Earnings surprise"^^xsd:string ;
    rdfs:comment "Actual versus estimated net profit and revenue for a quarter, with the surprise computed per line. Coincident for the print, leading for the drift after it."^^xsd:string ;
    bsi:layer "observation" ;
    bsi:realization "table" ;
    bsi:grain "(symbol, quarter)" ;
    rdfs:subClassOf bsi:Observation ;
    bsi:keyProperty bsip:symbol, bsip:series ;
    bsi:caveat "Keyed by vendor `scid` in the source table while every other table keys on `symbol` — the join runs through `mc_scid_map`.", "The `quarter` column is MISNAMED: it holds a result DATE rendered as free text (`'May 30, 2026'`), not a fiscal-quarter label, so it will not sort lexicographically and will not parse as an ISO date. Cast at read time.", "`scid` is stored as TEXT, so the symbol join is a string match, not a numeric one." ;
    bsi:realizedBy bsis:eps_surprise_history .

bsi:InsiderTransaction     rdf:type owl:Class ;
    rdfs:label "Insider transaction"^^xsd:string ;
    rdfs:comment "A promoter/insider buy or sell filing. Leading in principle; graded weak as a standalone signal on this platform and kept as a confluence input."^^xsd:string ;
    bsi:layer "observation" ;
    bsi:realization "table" ;
    bsi:grain "(symbol, date, acquirer, transaction)" ;
    rdfs:subClassOf bsi:Observation ;
    bsi:keyProperty bsip:symbol, bsip:date, bsip:company_name, bsip:trade_type ;
    bsi:caveat "Filed with a lag; treat the filing date as the earliest knowable time, not the trade date.", "`acquirerName` is vendor free text, NOT a foreign key to `stock_master` — it cannot be joined to a symbol and must be matched by name at best.", "`valueInr` is rupees as a bare number with no currency or unit column, unlike `block_deals.value_cr` which is crores. Same semantic field, two different multipliers; do not union them without normalising." ;
    bsi:realizedBy bsis:insider_trades ;
    bsi:noExternalCounterpart "unconfirmed: Insider/regulatory transaction reporting is outside FIBO's confirmed scope; a regulatory-reporting vocabulary would be the better target." .

bsi:BlockDeal     rdf:type owl:Class ;
    rdfs:label "Block / bulk deal"^^xsd:string ;
    rdfs:comment "An off-book or bulk transaction with quantity, price and value. Value is stored in CRORES as a bare number, with no currency or unit term attached."^^xsd:string ;
    bsi:layer "observation" ;
    bsi:realization "table" ;
    bsi:grain "(symbol, date, deal)" ;
    rdfs:subClassOf bsi:Observation ;
    bsi:keyProperty bsip:symbol, bsip:date, bsip:id ;
    bsi:caveat "`trade_type` is stored in mixed case by different fetchers — normalise with UPPER() before aggregating buys and sells." ;
    bsi:realizedBy bsis:block_deals ;
    bsi:noExternalCounterpart "unconfirmed: Securities transactions may exist in a FIBO module not checked this session. Left unaligned rather than asserted from memory." .

bsi:MFHolding     rdf:type owl:Class ;
    rdfs:label "Mutual-fund holding"^^xsd:string ;
    rdfs:comment "Aggregate mutual-fund ownership of a symbol: holding percentage, fund count and the change versus the previous disclosure."^^xsd:string ;
    bsi:layer "observation" ;
    bsi:realization "table" ;
    bsi:grain "(symbol, disclosure date)" ;
    rdfs:subClassOf bsi:Observation ;
    bsi:keyProperty bsip:symbol, bsip:date ;
    bsi:realizedBy bsis:stock_mf_holdings .

bsi:NewsItem     rdf:type owl:Class ;
    rdfs:label "News item"^^xsd:string ;
    rdfs:comment "A news article or exchange announcement with vendor sentiment, a FinBERT tone ensemble, an impact bucket and the symbols it mentions. 15 years deep — the only panel here that supports a real event study."^^xsd:string ;
    bsi:layer "observation" ;
    bsi:realization "table" ;
    bsi:grain "one row per article/announcement" ;
    rdfs:subClassOf bsi:Observation ;
    bsi:keyProperty bsip:id ;
    bsi:caveat "Two sentiment sources coexist (`sentiment` from the vendor, `tone_*` from FinBERT) and can disagree; `sentiment_conflict` flags it. Whichever one a study used must be stated.", "`symbols_json` is a JSON array — a mention is NOT a foreign key. Join through `news_symbol_link` or the JSON expansion, never by string match." ;
    bsi:realizedBy bsis:news_sentiment_items, bsis:news_symbol_link ;
    bsi:noExternalCounterpart "out_of_scope: News sentiment belongs to a news/NLP vocabulary. FIBO's agent classes do not model sentiment scores." .

bsi:OptionChainRow     rdf:type owl:Class ;
    rdfs:label "Option chain row"^^xsd:string ;
    rdfs:comment "One strike, one expiry, one session: call and put leg premium, volume, open interest, IV and greeks. A grid, not a time series."^^xsd:string ;
    bsi:layer "observation" ;
    bsi:realization "table" ;
    bsi:grain "(symbol, date, expiry, strike)" ;
    rdfs:subClassOf bsi:Observation ;
    bsi:keyProperty bsip:symbol, bsip:date, bsip:expiry, bsip:strike ;
    bsi:caveat "Index panels are deep; STOCK option panels are shallow. Any stock-level derivatives study inherits that shallow panel." ;
    bsi:realizedBy bsis:so_option_chain .

bsi:FuturesPositioning     rdf:type owl:Class ;
    rdfs:label "Futures positioning"^^xsd:string ;
    rdfs:comment "Stock-futures open interest, buildup label, rollover percentage, basis and cost of carry for one expiry and session."^^xsd:string ;
    bsi:layer "observation" ;
    bsi:realization "table" ;
    bsi:grain "(symbol, date, expiry)" ;
    rdfs:subClassOf bsi:Observation ;
    bsi:keyProperty bsip:symbol, bsip:date, bsip:expiry ;
    bsi:caveat "LOW-DATA: the stock-futures panel covers roughly two weeks of dates. Any 'measured' claim built on it is a calendar artefact, not an edge — this is the specific finding the master report's LOW-DATA verdict records." ;
    bsi:realizedBy bsis:stock_futures_oi_history, bsis:fno_rollover .

bsi:IndexDerivativesSnapshot     rdf:type owl:Class ;
    rdfs:label "Index derivatives snapshot"^^xsd:string ;
    rdfs:comment "Index-level positioning: PCR (single-strike time series and EOD), max pain, and aggregate call/put open interest."^^xsd:string ;
    bsi:layer "observation" ;
    bsi:realization "table" ;
    bsi:grain "(index_name, date, expiry)" ;
    rdfs:subClassOf bsi:Observation ;
    bsi:keyProperty bsip:index_name, bsip:date, bsip:expiry ;
    bsi:caveat "The index panel is far deeper than the stock panel but remains ungraded as a standalone signal — treated here as a research candidate." ;
    bsi:realizedBy bsis:index_max_pain, bsis:nt_index_pcr_ts .

bsi:MoverSnapshot     rdf:type owl:Class ;
    rdfs:label "Mover snapshot"^^xsd:string ;
    rdfs:comment "A ranked intraday mover list entry from a vendor feed: the platform's within-day event backbone alongside the event triggers."^^xsd:string ;
    bsi:layer "observation" ;
    bsi:realization "table" ;
    bsi:grain "(source, trade_date, symbol, rank)" ;
    rdfs:subClassOf bsi:Observation ;
    bsi:keyProperty bsip:source, bsip:date, bsip:symbol, bsip:rank_position ;
    bsi:caveat "Rank is per source per capture, so a rank is only comparable within one source and one instant." ;
    bsi:realizedBy bsis:mover_snapshots .

bsi:RegimeState     rdf:type owl:Class ;
    rdfs:label "Regime state"^^xsd:string ;
    rdfs:comment "The macro regime for a session, with its posterior probability and the decoded HMM path. Also covers the intraday regime panel."^^xsd:string ;
    bsi:layer "context" ;
    bsi:realization "table" ;
    bsi:grain "one row per date" ;
    bsi:keyProperty bsip:date ;
    bsi:caveat "This is a weight GATE on this platform — it re-blends engine weights — not a directional signal. Treating a regime label as alpha inverts its role." ;
    bsi:realizedBy bsis:market_regimes, bsis:intraday_regime_history ;
    bsi:noExternalCounterpart "platform_specific: HMM state plus a weight-gate role: derived market state on this platform, not an externally-defined regime." .

bsi:BreadthObservation     rdf:type owl:Class ;
    rdfs:label "Breadth observation"^^xsd:string ;
    rdfs:comment "Market-wide participation statistics: share of the universe above its 200-day average, advance/decline ratio, net highs minus lows."^^xsd:string ;
    bsi:layer "context" ;
    bsi:realization "table" ;
    bsi:grain "one row per date" ;
    bsi:keyProperty bsip:date ;
    bsi:caveat "Computed over this platform's own universe definition, so the numbers are not comparable to a vendor's breadth series without re-basing." ;
    bsi:realizedBy bsis:market_breadth ;
    bsi:noExternalCounterpart "platform_specific: Breadth statistics are context filters computed over this platform's own universe definition." .

bsi:SectorRotationPoint     rdf:type owl:Class ;
    rdfs:label "Sector rotation point"^^xsd:string ;
    rdfs:comment "Weekly relative-rotation coordinates and quadrant per sector — the intended input to sector-plus-stock relative strength."^^xsd:string ;
    bsi:layer "context" ;
    bsi:realization "table" ;
    bsi:grain "(sector, week_date)" ;
    bsi:keyProperty bsip:sector, bsip:week_date ;
    bsi:caveat "The sector-to-stock relative-strength link is a RESEARCH CANDIDATE: the master report names it as an experiment, not an established edge." ;
    bsi:realizedBy bsis:sector_rrg_history .

bsi:PlatformOutput     rdf:type owl:Class ;
    rdfs:label "Platform output"^^xsd:string ;
    rdfs:comment "Abstract parent for anything this platform computes and serves. Every subclass is an OPINION of this system, not an observation of the market."^^xsd:string ;
    bsi:layer "derived" ;
    bsi:realization "abstract" ;
    bsi:keyProperty bsip:symbol .

bsi:FeatureVector     rdf:type owl:Class ;
    rdfs:label "Feature vector"^^xsd:string ;
    rdfs:comment "The rolling per-symbol, per-date feature panel the models train on. Features, not information: they re-express price, flow and vendor data."^^xsd:string ;
    bsi:layer "derived" ;
    bsi:realization "table" ;
    bsi:grain "(symbol, date, timeframe)" ;
    rdfs:subClassOf bsi:PlatformOutput ;
    bsi:keyProperty bsip:symbol, bsip:date, bsip:timeframe ;
    bsi:caveat "A feature's meaning is defined by `feature_engineering.py` at a specific commit, not by this ontology. Cite the feature version when a result depends on it.", "Pre-rebuild rows are not comparable with post-rebuild rows." ;
    bsi:realizedBy bsis:feature_store ;
    bsi:noExternalCounterpart "platform_specific: `feature_store` columns are re-expressed price and vendor data — features, not financial concepts. Mapping them outward would create false semantic weight and invite a model to treat a derived column as an observed fact." .

bsi:TechnicalSignal     rdf:type owl:Class ;
    rdfs:label "Technical signal"^^xsd:string ;
    rdfs:comment "The wide per-symbol, per-date technical panel: indicators, regime stamp, flow and fundamental context columns, plus the model's probability outputs."^^xsd:string ;
    bsi:layer "derived" ;
    bsi:realization "table" ;
    bsi:grain "(symbol, date)" ;
    rdfs:subClassOf bsi:PlatformOutput ;
    bsi:keyProperty bsip:symbol, bsip:date ;
    bsi:caveat "Over 300 columns of mixed provenance: raw indicators, vendor opinions (ext_* / mc_* / tl_* prefixes) and model outputs sit side by side. The binding table marks which is which.", "`win_probability` and `calibrated_win_probability` are model OUTPUTS and must not be fed back in as features." ;
    bsi:realizedBy bsis:technical_signals .

bsi:EngineScore     rdf:type owl:Class ;
    rdfs:label "Engine score"^^xsd:string ;
    rdfs:comment "A single engine's, or the multi-engine composite's, score for a symbol and date with its engine-coverage count."^^xsd:string ;
    bsi:layer "derived" ;
    bsi:realization "table" ;
    bsi:grain "(symbol, date)" ;
    rdfs:subClassOf bsi:PlatformOutput ;
    bsi:keyProperty bsip:symbol, bsip:date ;
    bsi:caveat "Engine contributions are measured here, not assumed: only the confluence engine carries a growing positive reading, the ML ensemble adds roughly +0.02, and the DL / cross-sectional / smart-money engines measured 0.0 across all regimes." ;
    bsi:realizedBy bsis:confluence_signals, bsis:engine_composite_scores, bsis:stock_scores .

bsi:Recommendation     rdf:type owl:Class ;
    rdfs:label "Recommendation"^^xsd:string ;
    rdfs:comment "The served trade: composite score, conviction bucket, action label, entry zone, stop, targets, risk/reward and position size for one symbol, date and timeframe."^^xsd:string ;
    bsi:layer "derived" ;
    bsi:realization "table" ;
    bsi:grain "(symbol, computed_at, timeframe)" ;
    rdfs:subClassOf bsi:PlatformOutput ;
    bsi:keyProperty bsip:symbol, bsip:computed_at, bsip:timeframe ;
    bsi:caveat "`computed_at` is TEXT here and native TIMESTAMPTZ in `confluence_signals` — cast before joining the two.", "`trade_reasoning` is generated text: an explanation, never evidence.", "The history table carries the raw meta-label behind `position_size_pct`, which the serving table does not." ;
    bsi:realizedBy bsis:unified_recommendations, bsis:unified_recommendations_history, bsis:intraday_recommendations ;
    bsi:noExternalCounterpart "platform_specific: `unified_score` is a composite of this platform's engines with a tracked per-engine track record. FIBO's nearest analogue is a research recommendation — a different object with a different lifecycle and no track record." .

bsi:ModelArtifact     rdf:type owl:Class ;
    rdfs:label "Model artifact"^^xsd:string ;
    rdfs:comment "A registered trained model: type, version, evaluation metrics, feature count, horizon and active flag."^^xsd:string ;
    bsi:layer "derived" ;
    bsi:realization "table" ;
    bsi:grain "one row per version" ;
    rdfs:subClassOf bsi:PlatformOutput ;
    bsi:keyProperty bsip:id ;
    bsi:caveat "Promotion is gated on holdout error plus a margin; a row existing does not mean the model is serving." ;
    bsi:realizedBy bsis:model_registry .

bsi:FeatureImportance     rdf:type owl:Class ;
    rdfs:label "Feature importance"^^xsd:string ;
    rdfs:comment "Per-model, per-run feature importance with rank — the audit trail behind which inputs a model actually used."^^xsd:string ;
    bsi:layer "derived" ;
    bsi:realization "table" ;
    bsi:grain "(model, run, feature)" ;
    rdfs:subClassOf bsi:PlatformOutput ;
    bsi:keyProperty bsip:id ;
    bsi:realizedBy bsis:feature_importance_log .

bsi:OutcomeRecord     rdf:type owl:Class ;
    rdfs:label "Outcome record"^^xsd:string ;
    rdfs:comment "Abstract parent for resolved results. Labels live here and nowhere else: nothing in this branch may ever appear on the input side of a model."^^xsd:string ;
    bsi:layer "outcome" ;
    bsi:realization "abstract" ;
    bsi:keyProperty bsip:symbol, bsip:signal_date .

bsi:EdgeReading     rdf:type owl:Class ;
    rdfs:label "Edge reading"^^xsd:string ;
    rdfs:comment "One factor-grading result: rank-IC and hit-AUC for a table/column, per regime and horizon, with the effective-date count and a verdict."^^xsd:string ;
    bsi:layer "outcome" ;
    bsi:realization "table" ;
    bsi:grain "(run_at, table_name, score_col, horizon_days, regime)" ;
    rdfs:subClassOf bsi:OutcomeRecord ;
    bsi:keyProperty bsip:source, bsip:name, bsip:horizon_days, bsip:verdict ;
    bsi:caveat "Read `eff_dates` BEFORE the reading. Overlapping forward windows inflate a correlation by roughly the horizon factor, and the effective-date count is the guard that exposes it — too few effective dates makes a reading a calendar artefact rather than an edge." ;
    bsi:realizedBy bsis:factor_edge_history ;
    bsi:noExternalCounterpart "platform_specific: `factor_edge_history` is this platform's own measurement ledger — rank-IC and AUC per factor, regime and horizon, with an independent-observation guard. FIBO has no concept of evidence quality over a date panel." .

bsi:SignalOutcome     rdf:type owl:Class ;
    rdfs:label "Signal outcome"^^xsd:string ;
    rdfs:comment "The resolved result of a signal: entry, exit, horizon, return and the outcome label, under one of two possibly-different labelling rules."^^xsd:string ;
    bsi:layer "outcome" ;
    bsi:realization "table" ;
    bsi:grain "(symbol, signal_date, horizon_days, signal_source)" ;
    rdfs:subClassOf bsi:OutcomeRecord ;
    bsi:keyProperty bsip:symbol, bsip:signal_date, bsip:horizon_days ;
    bsi:caveat "Labels are NOT comparable across `label_definition` (`path_barrier` vs `terminal_pct2`). Always filter on it before aggregating accuracy.", "`PENDING` rows have not elapsed — they are not negative examples.", "`NO_ENTRY_PRICE` / `SUSPECT_DATA` are integrity exits, not labels." ;
    bsi:realizedBy bsis:signal_outcomes, bsis:unified_signal_outcomes ;
    bsi:noExternalCounterpart "platform_specific: Our labels come from two non-comparable rules (`path_barrier` vs `terminal_pct2`). That distinction is internal and load-bearing; no external vocabulary carries it." .

bsi:SignalExcursion     rdf:type owl:Class ;
    rdfs:label "Signal excursion"^^xsd:string ;
    rdfs:comment "Path statistics inside the evaluation window: maximum favourable and adverse excursion, days to each, and whether MFE preceded MAE."^^xsd:string ;
    bsi:layer "outcome" ;
    bsi:realization "table" ;
    bsi:grain "(symbol, signal_date, horizon_days)" ;
    rdfs:subClassOf bsi:OutcomeRecord ;
    bsi:keyProperty bsip:symbol, bsip:signal_date, bsip:horizon_days ;
    bsi:caveat "This is what makes a stop-loss study possible: the terminal return alone cannot tell you whether the trade was ever viable." ;
    bsi:realizedBy bsis:signal_excursions .

bsi:CandidateRecord     rdf:type owl:Class ;
    rdfs:label "Candidate record"^^xsd:string ;
    rdfs:comment "Abstract parent for vendor-opinion streams. These SURFACE candidates; they are never ground truth."^^xsd:string ;
    bsi:layer "candidate" ;
    bsi:realization "abstract" ;
    bsi:keyProperty bsip:symbol .

bsi:Screener     rdf:type owl:Class ;
    rdfs:label "Screener"^^xsd:string ;
    rdfs:comment "A vendor screener definition with its inferred sentiment, category, reliability tier and classification confidence."^^xsd:string ;
    bsi:layer "candidate" ;
    bsi:realization "table" ;
    bsi:grain "one row per screener" ;
    bsi:keyProperty bsip:id ;
    bsi:caveat "Sentiment, category and tier are INFERRED by this platform, not supplied by the vendor: they are model output about a vendor product.", "A screener is a candidate generator, never evidence — its aggregate momentum score no longer clears the USABLE bar." ;
    bsi:realizedBy bsis:screener_master .

bsi:ScreenerAppearance     rdf:type owl:Class ;
    rdfs:label "Screener appearance"^^xsd:string ;
    rdfs:comment "A single surfacing event: this screener listed this symbol at this instant, with the price, change and volume at that moment."^^xsd:string ;
    bsi:layer "candidate" ;
    bsi:realization "table" ;
    bsi:grain "(run_id, symbol, filter_key)" ;
    rdfs:subClassOf bsi:CandidateRecord ;
    bsi:keyProperty bsip:id ;
    bsi:caveat "12.25M rows and growing: always bound a query by run_id or symbol.", "Surfacing time is the only knowable time; the screener's internal logic is not visible." ;
    bsi:realizedBy bsis:live_screener_appearances ;
    bsi:noExternalCounterpart "platform_specific: A vendor screener's membership stream with forward outcomes pre-tracked at surfacing time. A data-vendor artifact, not a financial concept." .

bsi:ScreenerOutcome     rdf:type owl:Class ;
    rdfs:label "Screener outcome"^^xsd:string ;
    rdfs:comment "Forward returns pre-tracked and attached to an appearance at surfacing time."^^xsd:string ;
    bsi:layer "outcome" ;
    bsi:realization "table" ;
    bsi:grain "(appearance_id, symbol)" ;
    rdfs:subClassOf bsi:OutcomeRecord ;
    bsi:keyProperty bsip:id, bsip:symbol ;
    bsi:caveat "The platform's largest pre-labelled dataset (9.2M outcomes) and the reason screener research is worth doing — but the labels are forward returns from the surfacing price, so any attribution belongs to the SCREENER, not to an engine that happened to agree with it." ;
    bsi:realizedBy bsis:live_screener_outcomes ;
    bsi:noExternalCounterpart "platform_specific: The pre-tracked forward returns attached to those appearances (9.2M rows). No external ontology models 'what happened after a screener surfaced a name'." .

bsi:EventTrigger     rdf:type owl:Class ;
    rdfs:label "Event trigger"^^xsd:string ;
    rdfs:comment "Detector output: which composite trigger classes fired for a symbol on a date, with news counts and bullish-tenure state."^^xsd:string ;
    bsi:layer "candidate" ;
    bsi:realization "table" ;
    bsi:grain "(symbol, date)" ;
    rdfs:subClassOf bsi:CandidateRecord ;
    bsi:keyProperty bsip:symbol, bsip:date ;
    bsi:caveat "`triggers` is a comma-joined string carrying inline thresholds (`CROWDED_NEWS p90`) — parse the class token, never the whole value." ;
    bsi:realizedBy bsis:stock_event_triggers ;
    bsi:noExternalCounterpart "platform_specific: Composite trigger classes (SCREENER_SUPPORT_FADING, CROWDED_NEWS) are internal detector output with inline thresholds." .

bsi:GovernanceRecord     rdf:type owl:Class ;
    rdfs:label "Governance record"^^xsd:string ;
    rdfs:comment "Abstract parent for operational metadata. These answer 'when was this true and who wrote it', which on this platform is the difference between a usable value and a guess."^^xsd:string ;
    bsi:layer "governance" ;
    bsi:realization "abstract" ;
    bsi:keyProperty bsip:id .

bsi:Endpoint     rdf:type owl:Class ;
    rdfs:label "Data endpoint"^^xsd:string ;
    rdfs:comment "A discovered, verified market-data endpoint: provider, domain, scope, update frequency and the template to call it. The platform's data-sourcing registry."^^xsd:string ;
    bsi:layer "governance" ;
    bsi:realization "table" ;
    bsi:grain "one row per endpoint" ;
    rdfs:subClassOf bsi:GovernanceRecord ;
    bsi:keyProperty bsip:id ;
    bsi:caveat "This registry is the mandatory first stop when a source stops returning data — 3,408 verified endpoints exist here and a 'dead vendor' conclusion is not admissible until they have been checked." ;
    bsi:realizedBy bsis:market_endpoint_registry, bsis:url_endpoints ;
    bsi:noExternalCounterpart "out_of_scope: The 3,408-row discovery registry is a scraping/provenance asset; DCAT or an API-description vocabulary fits, FIBO does not." .

bsi:JobRun     rdf:type owl:Class ;
    rdfs:label "Job run"^^xsd:string ;
    rdfs:comment "Per-job heartbeat: last status, last success, last error and run/failure counts."^^xsd:string ;
    bsi:layer "governance" ;
    bsi:realization "table" ;
    bsi:grain "one row per job" ;
    rdfs:subClassOf bsi:GovernanceRecord ;
    bsi:keyProperty bsip:job_name ;
    bsi:caveat "`last_run_at` is the last ATTEMPT; `last_success_at` is what freshness should be judged against. A job that runs and fails updates the former only.", "A step exiting 0 is not evidence that data was written; this repo treats 'data not successfully written' as an error regardless of log level." ;
    bsi:realizedBy bsis:job_heartbeat ;
    bsi:noExternalCounterpart "out_of_scope: Operational provenance — PROV-O is the right family (already in this ontology's namespace map), not FIBO." .

bsi:DataQualityCheck     rdf:type owl:Class ;
    rdfs:label "Data-quality check"^^xsd:string ;
    rdfs:comment "The result of one named validation check: category, criticality, status and a detail string."^^xsd:string ;
    bsi:layer "governance" ;
    bsi:realization "table" ;
    bsi:grain "(check_id, checked_at)" ;
    rdfs:subClassOf bsi:GovernanceRecord ;
    bsi:keyProperty bsip:check_id ;
    bsi:caveat "Status is stored lowercase (`pass` / `warn`), so a case-sensitive comparison against 'PASS' matches nothing." ;
    bsi:realizedBy bsis:data_quality_results ;
    bsi:noExternalCounterpart "out_of_scope: Data-governance concept, not a financial one." .

bsi:DataContract     rdf:type owl:Class ;
    rdfs:label "Data contract"^^xsd:string ;
    rdfs:comment "A versioned machine-readable contract describing one dataset's grain, timing, source, training use, and physical lineage."^^xsd:string ;
    bsi:layer "governance" ;
    bsi:realization "table" ;
    bsi:grain "contract_key" ;
    rdfs:subClassOf bsi:GovernanceRecord ;
    bsi:keyProperty bsip:contract_key ;
    bsi:realizedBy bsis:market_data_contract .

bsi:FeatureDefinition     rdf:type owl:Class ;
    rdfs:label "Semantic feature definition"^^xsd:string ;
    rdfs:comment "A versioned authored definition of a model-facing property, including leakage and feature-use constraints."^^xsd:string ;
    bsi:layer "governance" ;
    bsi:realization "table" ;
    bsi:grain "feature_key" ;
    rdfs:subClassOf bsi:GovernanceRecord ;
    bsi:keyProperty bsip:feature_key ;
    bsi:realizedBy bsis:semantic_feature_definition .

bsi:DataWatermark     rdf:type owl:Class ;
    rdfs:label "Data completeness watermark"^^xsd:string ;
    rdfs:comment "Producer-published completeness and input/output boundary for a dataset partition."^^xsd:string ;
    bsi:layer "governance" ;
    bsi:realization "table" ;
    bsi:grain "(dataset, partition_key)" ;
    rdfs:subClassOf bsi:GovernanceRecord ;
    bsi:keyProperty bsip:dataset, bsip:partition_key ;
    bsi:realizedBy bsis:market_data_watermark .

bsi:GraphNode     rdf:type owl:Class ;
    rdfs:label "Instance graph node"^^xsd:string ;
    rdfs:comment "A canonical entity projected into the bitemporal market graph."^^xsd:string ;
    bsi:layer "governance" ;
    bsi:realization "table" ;
    bsi:grain "node_key" ;
    rdfs:subClassOf bsi:GovernanceRecord ;
    bsi:keyProperty bsip:node_key ;
    bsi:realizedBy bsis:market_graph_node .

bsi:GraphEdge     rdf:type owl:Class ;
    rdfs:label "Instance graph edge"^^xsd:string ;
    rdfs:comment "A typed, bitemporal assertion between graph nodes or a literal object value."^^xsd:string ;
    bsi:layer "governance" ;
    bsi:realization "table" ;
    bsi:grain "assertion_key" ;
    rdfs:subClassOf bsi:GovernanceRecord ;
    bsi:keyProperty bsip:assertion_key ;
    bsi:realizedBy bsis:market_graph_edge .

bsi:EvidenceRecord     rdf:type owl:Class ;
    rdfs:label "Evidence record"^^xsd:string ;
    rdfs:comment "Source material retained separately from the claim extracted or inferred from it."^^xsd:string ;
    bsi:layer "governance" ;
    bsi:realization "table" ;
    bsi:grain "evidence_key" ;
    rdfs:subClassOf bsi:GovernanceRecord ;
    bsi:keyProperty bsip:evidence_key ;
    bsi:realizedBy bsis:market_evidence, bsis:market_claim_evidence .

bsi:MarketClaim     rdf:type owl:Class ;
    rdfs:label "Market claim"^^xsd:string ;
    rdfs:comment "An explicit, status-bearing assertion about a market entity, separate from raw evidence."^^xsd:string ;
    bsi:layer "derived" ;
    bsi:realization "table" ;
    bsi:grain "claim_key" ;
    bsi:keyProperty bsip:claim_key ;
    bsi:realizedBy bsis:market_claim .

bsi:DecisionEvent     rdf:type owl:Class ;
    rdfs:label "Decision event"^^xsd:string ;
    rdfs:comment "An append-only, reconstructable decision record with cutoff, versions, quality, and structured supporting or contradictory evidence."^^xsd:string ;
    bsi:layer "derived" ;
    bsi:realization "table" ;
    bsi:grain "decision_key" ;
    bsi:keyProperty bsip:decision_key ;
    bsi:realizedBy bsis:market_decision_event, bsis:market_decision_evidence .

bsi:DecisionOutcome     rdf:type owl:Class ;
    rdfs:label "Decision outcome"^^xsd:string ;
    rdfs:comment "A realized outcome attached to a decision under an explicit label definition and horizon."^^xsd:string ;
    bsi:layer "outcome" ;
    bsi:realization "table" ;
    bsi:grain "(decision_key, label_definition, horizon_days)" ;
    bsi:keyProperty bsip:decision_key, bsip:label_definition, bsip:horizon_days ;
    bsi:realizedBy bsis:market_decision_outcome .

bsip:symbol     rdf:type owl:DatatypeProperty ;
    rdfs:label "Symbol" ;
    rdfs:comment "Exchange ticker, NSE/BSE convention embedded in the string. The platform's universal join key across ~40 tables." ;
    rdfs:range xsd:string ;
    bsi:semanticType "identifier" ;
    bsi:timing "context" ;
    bsi:derivation "raw" ;
    bsi:leakageRisk "none" ;
    bsi:usableAsFeature "false"^^xsd:boolean ;
    bsi:isLabel "false"^^xsd:boolean ;
    bsi:boundTo bsis:stock_ohlcv.symbol, bsis:intraday_ohlcv.symbol, bsis:stock_delivery_data.symbol, bsis:stock_delivery_volume.symbol, bsis:stock_master.symbol, bsis:company_profiles.symbol, bsis:corporate_actions.symbol, bsis:fundamentals_history.symbol, bsis:analyst_estimates_history.symbol, bsis:eps_surprise_history.symbol, bsis:insider_trades.symbol, bsis:block_deals.symbol, bsis:stock_mf_holdings.symbol, bsis:news_symbol_link.symbol, bsis:so_option_chain.symbol, bsis:stock_futures_oi_history.symbol, bsis:fno_rollover.symbol, bsis:mover_snapshots.symbol, bsis:stock_event_triggers.symbol, bsis:technical_signals.symbol, bsis:feature_store.symbol, bsis:unified_recommendations.symbol, bsis:unified_recommendations_history.symbol, bsis:intraday_recommendations.symbol, bsis:confluence_signals.symbol, bsis:engine_composite_scores.symbol, bsis:stock_scores.symbol, bsis:signal_outcomes.symbol, bsis:unified_signal_outcomes.symbol, bsis:signal_excursions.symbol, bsis:live_screener_appearances.symbol, bsis:live_screener_outcomes.symbol, bsis:nse_stocks.symbol, bsis:mc_scid_map.symbol, bsis:market_listing.symbol, bsis:market_graph_node.canonical_symbol, bsis:market_decision_event.symbol ;
    skos:closeMatch fibo-sec-sec-id:TickerSymbol ;
    bsi:alignmentRationale "[fibo-sec-sec-id:TickerSymbol] Ours is simultaneously the ticker AND the platform's primary join key across ~40 tables. FIBO treats a ticker as one identifier among several on a listing, which is why FIBO-correct joins key on the instrument rather than the ticker." ;
    bsi:verifiedFrom "https://github.com/edmcouncil/fibo (published prefix declarations) + FIBO IRI space under spec.edmcouncil.org; class symbols cross-checked against declared FIBO type stereotypes. Fetched 2026-09-21." .

bsip:isin     rdf:type owl:DatatypeProperty ;
    rdfs:label "ISIN" ;
    rdfs:comment "ISO 6166 identifier. The only globally-unique key here; coverage is partial, which makes an ISIN-first instrument master a project, not a rename." ;
    rdfs:range xsd:string ;
    bsi:semanticType "identifier" ;
    bsi:timing "context" ;
    bsi:derivation "raw" ;
    bsi:leakageRisk "none" ;
    bsi:usableAsFeature "false"^^xsd:boolean ;
    bsi:isLabel "false"^^xsd:boolean ;
    bsi:boundTo bsis:stock_master.isin, bsis:nse_stocks.isin, bsis:market_instrument.isin .

bsip:scid     rdf:type owl:DatatypeProperty ;
    rdfs:label "MoneyControl scid" ;
    rdfs:comment "Vendor-private MoneyControl id. Reachable from `symbol` only through `mc_scid_map`, and comparable to no other vendor's id." ;
    rdfs:range xsd:string ;
    bsi:semanticType "identifier" ;
    bsi:timing "context" ;
    bsi:derivation "raw" ;
    bsi:leakageRisk "none" ;
    bsi:usableAsFeature "false"^^xsd:boolean ;
    bsi:isLabel "false"^^xsd:boolean ;
    bsi:boundTo bsis:eps_surprise_history.scid, bsis:mc_scid_map.scid .

bsip:company_name     rdf:type owl:DatatypeProperty ;
    rdfs:label "Company name" ;
    rdfs:comment "Issuer name as supplied by the writer. Free text: one company can appear under two names across tables." ;
    rdfs:range xsd:string ;
    bsi:semanticType "identifier" ;
    bsi:timing "context" ;
