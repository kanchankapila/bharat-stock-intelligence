bsis:factor_edge_history     rdf:type bsi:Table ;
    rdfs:label "Factor edge ledger" ;
    rdfs:comment "The platform's own measurement ledger: rank-IC and hit-AUC per factor, regime and horizon, with the independent-observation count and a verdict." ;
    bsi:realizes bsi:EdgeReading ;
    bsi:rowClass bsit:factor_edge_history ;
    bsi:grain "(run_at, table_name, score_col, horizon_days)" ;
    bsi:cadence "on_grading" ;
    bsi:trainingUse "forbidden" ;
    bsi:primaryKey "run_at", "table_name", "score_col", "horizon_days" ;
    bsi:freshnessColumn "run_at" ;
    bsi:writtenBy "factor_edge.py" ;
    bsi:caveat "READ `eff_dates` BEFORE the reading. Overlapping forward windows inflate a correlation by roughly the horizon factor, and effective dates are the guard that exposes it.", "`verdict` values include the literal string `no edge` with a space, and `n/a` — match them exactly.", "`table_name` and `score_col` reuse the generic source/name properties: this row is describing a COLUMN, not a table." ;
    bsi:hasColumn _:col_factor_edge_history_run_at, _:col_factor_edge_history_table_name, _:col_factor_edge_history_score_col, _:col_factor_edge_history_horizon_days, _:col_factor_edge_history_rank_ic, _:col_factor_edge_history_hit_auc, _:col_factor_edge_history_eff_dates, _:col_factor_edge_history_verdict .

bsit:factor_edge_history     rdf:type owl:Class ;
    rdfs:label "factor_edge_history row" ;
    rdfs:comment "A row of factor_edge_history. Grain: (run_at, table_name, score_col, horizon_days). Subclass of EdgeReading; the physical contract (column set) lives in bsi:factor_edge_historyShape." ;
    rdfs:subClassOf bsi:EdgeReading .

_:col_factor_edge_history_run_at     bsi:columnName "run_at" ;
    bsi:property bsip:computed_at ;
    bsi:semanticType "timestamp" ;
    bsi:leakageRisk "none" .

_:col_factor_edge_history_table_name     bsi:columnName "table_name" ;
    bsi:property bsip:source ;
    bsi:semanticType "dimension" ;
    bsi:leakageRisk "none" ;
    bsi:note "The table whose factor was graded." .

_:col_factor_edge_history_score_col     bsi:columnName "score_col" ;
    bsi:property bsip:name ;
    bsi:semanticType "text" ;
    bsi:leakageRisk "none" ;
    bsi:note "The graded column." .

_:col_factor_edge_history_horizon_days     bsi:columnName "horizon_days" ;
    bsi:property bsip:horizon_days ;
    bsi:semanticType "count" ;
    bsi:leakageRisk "none" .

_:col_factor_edge_history_rank_ic     bsi:columnName "rank_ic" ;
    bsi:property bsip:rank_ic ;
    bsi:semanticType "ratio" ;
    bsi:leakageRisk "none" .

_:col_factor_edge_history_hit_auc     bsi:columnName "hit_auc" ;
    bsi:property bsip:hit_auc ;
    bsi:semanticType "ratio" ;
    bsi:leakageRisk "none" .

_:col_factor_edge_history_eff_dates     bsi:columnName "eff_dates" ;
    bsi:property bsip:eff_dates ;
    bsi:semanticType "count" ;
    bsi:leakageRisk "none" .

_:col_factor_edge_history_verdict     bsi:columnName "verdict" ;
    bsi:property bsip:verdict ;
    bsi:semanticType "enum" ;
    bsi:leakageRisk "none" .

bsis:market_endpoint_registry     rdf:type bsi:Table ;
    rdfs:label "Endpoint discovery registry" ;
    rdfs:comment "3,408 verified market-data endpoints with provider, domain, scope, update frequency, required params and the template to call each one." ;
    bsi:realizes bsi:Endpoint ;
    bsi:rowClass bsit:market_endpoint_registry ;
