bsip:scope     rdf:type owl:DatatypeProperty ;
    rdfs:label "Scope" ;
    rdfs:comment "Whether an endpoint is per-symbol or whole-market." ;
    rdfs:range xsd:string ;
    bsi:semanticType "dimension" ;
    bsi:timing "context" ;
    bsi:derivation "vendor" ;
    bsi:leakageRisk "none" ;
    bsi:usableAsFeature "true"^^xsd:boolean ;
    bsi:isLabel "false"^^xsd:boolean ;
    bsi:boundTo bsis:market_endpoint_registry.scope .

bsip:url_template     rdf:type owl:DatatypeProperty ;
    rdfs:label "URL template" ;
    rdfs:comment "Parameterized endpoint URL." ;
    rdfs:range xsd:string ;
    bsi:semanticType "dimension" ;
    bsi:timing "context" ;
