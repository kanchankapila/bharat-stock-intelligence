bsis:nse_stocks     rdf:type bsi:Table ;
    rdfs:label "NSE listing snapshot" ;
    rdfs:comment "One row per NSE ticker carrying ISIN, sector, industry, venue, index-membership flags, lot size and the vendor id cross-references (mcsymbol, trendlyne, tickertape, fincode, scripcode). The richest identity table in the database." ;
    bsi:realizes bsi:Equity ;
    bsi:rowClass bsit:nse_stocks ;
    bsi:grain "(symbol)" ;
    bsi:cadence "daily" ;
    bsi:trainingUse "context" ;
    bsi:primaryKey "symbol" ;
    bsi:freshnessColumn "last_updated" ;
    bsi:writtenBy "scripts/syncAllStockMappings.ts", "scripts/sync_mc_scid_map.py" ;
    bsi:caveat "NO SINGLE WRITER OWNS A ROW: the vendor-id columns, the sector/industry columns, the surveillance flags and the index-membership flags are each patched by a different job, each with its own `*_updated_at` stamp, so a row is a merge of several ages.", "`market_cap` is vendor-computed and its unit is NOT declared in the schema (`market_cap` records `INR_or_crore_UNDECLARED`).", "`is_asm`, `gsm_stage` and every `is_nifty*`/`is_midcap*` flag is a 0/1 INTEGER, not a boolean.", "Index-membership flags are current snapshots, not survivorship-free history: they cannot reconstruct a past universe." ;
    bsi:hasColumn _:col_nse_stocks_symbol, _:col_nse_stocks_name, _:col_nse_stocks_isin, _:col_nse_stocks_sector, _:col_nse_stocks_industry, _:col_nse_stocks_exchange, _:col_nse_stocks_market_cap, _:col_nse_stocks_lot_size, _:col_nse_stocks_is_asm, _:col_nse_stocks_last_updated .

bsit:nse_stocks     rdf:type owl:Class ;
    rdfs:label "nse_stocks row" ;
    rdfs:comment "A row of nse_stocks. Grain: (symbol). Subclass of Equity; the physical contract (column set) lives in bsi:nse_stocksShape." ;
    rdfs:subClassOf bsi:Equity .

_:col_nse_stocks_symbol     bsi:columnName "symbol" ;
    bsi:property bsip:symbol ;
    bsi:semanticType "identifier" ;
    bsi:leakageRisk "none" .

_:col_nse_stocks_name     bsi:columnName "name" ;
    bsi:property bsip:company_name ;
    bsi:semanticType "identifier" ;
    bsi:leakageRisk "none" .

_:col_nse_stocks_isin     bsi:columnName "isin" ;
    bsi:property bsip:isin ;
    bsi:semanticType "identifier" ;
    bsi:leakageRisk "none" .

_:col_nse_stocks_sector     bsi:columnName "sector" ;
    bsi:property bsip:sector ;
    bsi:semanticType "dimension" ;
    bsi:leakageRisk "none" .

_:col_nse_stocks_industry     bsi:columnName "industry" ;
    bsi:property bsip:industry ;
    bsi:semanticType "dimension" ;
    bsi:leakageRisk "none" .

_:col_nse_stocks_exchange     bsi:columnName "exchange" ;
    bsi:property bsip:exchange ;
    bsi:semanticType "dimension" ;
    bsi:leakageRisk "none" ;
    bsi:note "The canonical venue column — see the Exchange class caveat." .

_:col_nse_stocks_market_cap     bsi:columnName "market_cap" ;
    bsi:property bsip:market_cap ;
    bsi:semanticType "measure" ;
    bsi:leakageRisk "none" ;
    bsi:note "Unit undeclared in the schema; do not aggregate without confirming it." .

_:col_nse_stocks_lot_size     bsi:columnName "lot_size" ;
    bsi:property bsip:lot_size ;
    bsi:semanticType "measure" ;
    bsi:leakageRisk "none" .

_:col_nse_stocks_is_asm     bsi:columnName "is_asm" ;
    bsi:property bsip:asm_flag ;
    bsi:semanticType "flag" ;
    bsi:leakageRisk "none" ;
    bsi:note "Stored as 0/1 bigint, not boolean." .

_:col_nse_stocks_last_updated     bsi:columnName "last_updated" ;
    bsi:property bsip:last_updated ;
    bsi:semanticType "timestamp" ;
    bsi:leakageRisk "none" .

bsis:mc_scid_map     rdf:type bsi:Table ;
    rdfs:label "Vendor scrip-code crosswalk" ;
    rdfs:comment "Maps the vendor's private scid to the platform symbol and issuer name. Vendor tables reachable only by scid are joined through here." ;
    bsi:realizes bsi:ScripCodeMapping ;
    bsi:rowClass bsit:mc_scid_map ;
    bsi:grain "(scid, symbol)" ;
    bsi:cadence "on_discovery" ;
    bsi:trainingUse "context" ;
    bsi:primaryKey "scid", "symbol" ;
    bsi:writtenBy "scripts/sync_mc_scid_map.py" ;
    bsi:caveat "`resolved_at` records when the mapping was created, not when it was last verified, so a mapping that has silently gone stale is indistinguishable from a fresh one.", "Uniqueness is not enforced (see the class caveat): a symbol->scid join can fan out after a vendor scrip merge." ;
    bsi:hasColumn _:col_mc_scid_map_scid, _:col_mc_scid_map_symbol, _:col_mc_scid_map_stock_name .

bsit:mc_scid_map     rdf:type owl:Class ;
    rdfs:label "mc_scid_map row" ;
    rdfs:comment "A row of mc_scid_map. Grain: (scid, symbol). Subclass of ScripCodeMapping; the physical contract (column set) lives in bsi:mc_scid_mapShape." ;
    rdfs:subClassOf bsi:ScripCodeMapping .

_:col_mc_scid_map_scid     bsi:columnName "scid" ;
    bsi:property bsip:scid ;
    bsi:semanticType "identifier" ;
    bsi:leakageRisk "none" .

_:col_mc_scid_map_symbol     bsi:columnName "symbol" ;
    bsi:property bsip:symbol ;
    bsi:semanticType "identifier" ;
    bsi:leakageRisk "none" .

_:col_mc_scid_map_stock_name     bsi:columnName "stock_name" ;
    bsi:property bsip:company_name ;
    bsi:semanticType "identifier" ;
    bsi:leakageRisk "none" .

bsis:market_issuer     rdf:type bsi:Table ;
    rdfs:label "Canonical issuer" ;
    rdfs:comment "Issuer identity keyed by a verified seven-character Indian ISIN issuer prefix when available, otherwise by an explicitly provisional exchange/symbol key." ;
    bsi:realizes bsi:Issuer ;
    bsi:rowClass bsit:market_issuer ;
    bsi:grain "(issuer_key)" ;
    bsi:cadence "on_change" ;
    bsi:trainingUse "context" ;
    bsi:primaryKey "issuer_key" ;
    bsi:freshnessColumn "recorded_at" ;
