bsip:delivery_pct     rdf:type owl:DatatypeProperty ;
    rdfs:label "Delivery percentage" ;
    rdfs:comment "Delivered shares as a share of traded shares. T+1 by construction, underexploited here, and the platform's best high-frequency ownership proxy." ;
    rdfs:range xsd:decimal ;
    bsi:semanticType "ratio" ;
    bsi:timing "lagging" ;
    bsi:derivation "raw" ;
    bsi:leakageRisk "none" ;
