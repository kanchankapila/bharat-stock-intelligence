    bsi:isLabel "false"^^xsd:boolean ;
    qudt:unit "per_share_INR" ;
    bsi:boundTo bsis:stock_ohlcv.low, bsis:intraday_ohlcv.low .

bsip:close     rdf:type owl:DatatypeProperty ;
    rdfs:label "Close" ;
    rdfs:comment "Session close. The reference price for almost every downstream calculation." ;
    rdfs:range xsd:decimal ;
    bsi:semanticType "measure" ;
    bsi:timing "coincident" ;
    bsi:derivation "raw" ;
    bsi:leakageRisk "none" ;
    bsi:usableAsFeature "true"^^xsd:boolean ;
    bsi:isLabel "false"^^xsd:boolean ;
    qudt:unit "per_share_INR" ;
    bsi:boundTo bsis:stock_ohlcv.close, bsis:intraday_ohlcv.close, bsis:block_deals.price, bsis:fno_rollover.near_close, bsis:nt_index_pcr_ts.index_close ;
    skos:closeMatch fibo-sec-eq-eq:PricePerShare ;
    bsi:alignmentRationale "[fibo-sec-eq-eq:PricePerShare] Per-share closing price. The gap that matters: FIBO's price carries a currency; ours carries an implicit INR plus a separate `adjustment_basis` column (nse_bhavcopy_raw | split_only | split_dividend). FIBO has no property-level raw-vs-adjusted distinction, so `adjustment_basis` is a local extension this alignment cannot supply — and the basis trap is a live bug class in this repo." ;
    bsi:verifiedFrom "https://github.com/edmcouncil/fibo (published prefix declarations) + FIBO IRI space under spec.edmcouncil.org; class symbols cross-checked against declared FIBO type stereotypes. Fetched 2026-09-21." .

bsip:vwap     rdf:type owl:DatatypeProperty ;
    rdfs:label "VWAP" ;
    rdfs:comment "Volume-weighted average price; present on intraday bars only." ;
    rdfs:range xsd:decimal ;
    bsi:semanticType "measure" ;
    bsi:timing "coincident" ;
    bsi:derivation "raw" ;
    bsi:leakageRisk "none" ;
    bsi:usableAsFeature "true"^^xsd:boolean ;
    bsi:isLabel "false"^^xsd:boolean ;
    qudt:unit "per_share_INR" ;
    bsi:boundTo bsis:intraday_ohlcv.vwap, bsis:feature_store.vwap .

bsip:volume     rdf:type owl:DatatypeProperty ;
    rdfs:label "Volume" ;
    rdfs:comment "Shares traded in the session." ;
    rdfs:range xsd:decimal ;
    bsi:semanticType "measure" ;
    bsi:timing "coincident" ;
    bsi:derivation "raw" ;
    bsi:leakageRisk "none" ;
    bsi:usableAsFeature "true"^^xsd:boolean ;
    bsi:isLabel "false"^^xsd:boolean ;
    bsi:boundTo bsis:stock_ohlcv.volume, bsis:intraday_ohlcv.volume, bsis:stock_futures_oi_history.futures_volume, bsis:live_screener_appearances.volume .

bsip:cmp     rdf:type owl:DatatypeProperty ;
    rdfs:label "Current market price" ;
    rdfs:comment "Last traded price at the moment the row was written — a point-in-time snapshot, not a session close. Do not substitute it for `close`." ;
    rdfs:range xsd:decimal ;
    bsi:semanticType "measure" ;
    bsi:timing "coincident" ;
    bsi:derivation "raw" ;
    bsi:leakageRisk "none" ;
    bsi:usableAsFeature "true"^^xsd:boolean ;
    bsi:isLabel "false"^^xsd:boolean ;
    qudt:unit "per_share_INR" ;
    skos:altLabel "ltp", "last price" ;
    bsi:boundTo bsis:technical_signals.cmp, bsis:intraday_recommendations.cmp, bsis:live_screener_appearances.price .

bsip:entry_price     rdf:type owl:DatatypeProperty ;
    rdfs:label "Entry price" ;
    rdfs:comment "Assumed or realised entry fill used by an outcome calculation." ;
    rdfs:range xsd:decimal ;
    bsi:semanticType "measure" ;
    bsi:timing "coincident" ;
    bsi:derivation "raw" ;
    bsi:leakageRisk "low" ;
    bsi:usableAsFeature "true"^^xsd:boolean ;
    bsi:isLabel "false"^^xsd:boolean ;
    qudt:unit "per_share_INR" ;
    bsi:boundTo bsis:intraday_recommendations.entry_price, bsis:signal_outcomes.entry_price, bsis:unified_signal_outcomes.entry_price, bsis:signal_excursions.entry_price, bsis:live_screener_outcomes.entry_price, bsis:market_decision_outcome.entry_price .

bsip:exit_price     rdf:type owl:DatatypeProperty ;
    rdfs:label "Exit price" ;
    rdfs:comment "Realised exit fill; only exists on resolved outcomes." ;
