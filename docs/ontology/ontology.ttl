    rdfs:label "intraday_ohlcv row" ;
    rdfs:comment "A row of intraday_ohlcv. Grain: (symbol, datetime, interval). Subclass of IntradayBar; the physical contract (column set) lives in bsi:intraday_ohlcvShape." ;
    rdfs:subClassOf bsi:IntradayBar .

