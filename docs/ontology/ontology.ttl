    bsi:leakageRisk "none" .

_:col_stock_ohlcv_close     bsi:columnName "close" ;
    bsi:property bsip:close ;
    bsi:semanticType "measure" ;
    bsi:leakageRisk "none" .

_:col_stock_ohlcv_volume     bsi:columnName "volume" ;
    bsi:property bsip:volume ;
    bsi:semanticType "measure" ;
    bsi:leakageRisk "none" .

