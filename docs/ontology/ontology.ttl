    bsi:timing "lagging" ;
    bsi:derivation "raw" ;
    bsi:leakageRisk "none" ;
    bsi:usableAsFeature "true"^^xsd:boolean ;
    bsi:isLabel "false"^^xsd:boolean ;
    qudt:unit "shares" ;
    bsi:pointInTimeNote "Same T+1 publication lag as `delivery_pct`." ;
    bsi:boundTo bsis:stock_delivery_data.delivery_qty .

bsip:traded_qty     rdf:type owl:DatatypeProperty ;
    rdfs:label "Traded quantity" ;
