    bsi:property bsip:series ;
    bsi:semanticType "dimension" ;
    bsi:leakageRisk "none" .

_:col_stock_delivery_volume_qty_traded     bsi:columnName "qty_traded" ;
    bsi:property bsip:traded_qty ;
    bsi:semanticType "measure" ;
    bsi:leakageRisk "none" .

_:col_stock_delivery_volume_deliverable_qty     bsi:columnName "deliverable_qty" ;
    bsi:property bsip:deliverable_qty ;
    bsi:semanticType "measure" ;
    bsi:leakageRisk "none" .

_:col_stock_delivery_volume_delivery_pct     bsi:columnName "delivery_pct" ;
    bsi:property bsip:delivery_pct ;
