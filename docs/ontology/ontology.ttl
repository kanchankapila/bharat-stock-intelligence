bsis:sector_rrg_history     rdf:type bsi:Table ;
    rdfs:label "Sector rotation history" ;
    rdfs:comment "Weekly relative-rotation coordinates and quadrant per sector — the intended input to sector-plus-stock relative strength." ;
    bsi:realizes bsi:SectorRotationPoint ;
    bsi:rowClass bsit:sector_rrg_history ;
    bsi:grain "(sector, week_date)" ;
    bsi:cadence "weekly" ;
    bsi:trainingUse "context" ;
    bsi:primaryKey "sector", "week_date" ;
    bsi:freshnessColumn "fetched_at" ;
    bsi:writtenBy "trendlyne_sector_rotation_fetcher.py" ;
    bsi:caveat "The sector-to-stock relative-strength link is a RESEARCH CANDIDATE: named in the master report as an experiment, not an established edge.", "Weekly cadence against a daily stock panel means any sector feature is carried forward within the week — the carry rule must be stated." ;
    bsi:hasColumn _:col_sector_rrg_history_sector, _:col_sector_rrg_history_week_date, _:col_sector_rrg_history_quadrant, _:col_sector_rrg_history_sector_return, _:col_sector_rrg_history_stocks_count, _:col_sector_rrg_history_source, _:col_sector_rrg_history_fetched_at .

