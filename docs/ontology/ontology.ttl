bsis:unified_recommendations_history     rdf:type bsi:Table ;
    rdfs:label "Recommendation history" ;
    rdfs:comment "The accumulating record of every served recommendation with its raw win-probability meta-label — the substrate for forward testing the ranker." ;
    bsi:realizes bsi:Recommendation ;
    bsi:rowClass bsit:unified_recommendations_history ;
    bsi:grain "(symbol, computed_at)" ;
    bsi:cadence "daily" ;
    bsi:trainingUse "caution" ;
    bsi:primaryKey "symbol", "computed_at" ;
    bsi:freshnessColumn "computed_at" ;
    bsi:writtenBy "unified_ranker.py" ;
    bsi:forbiddenColumn "win_probability" ;
    bsi:caveat "`win_probability` here is the raw meta-label behind `position_size_pct`: a model output, not an input.", "Kept separately from the serving table so backtests need not reconstruct history from a table that is truncated by design." ;
