    bsi:caveat "This is the MANDATORY FIRST STOP when a source stops returning data: a 'dead vendor' conclusion is not admissible until these endpoints have been checked for an alternate route to the same information.", "The registry is populated entirely outside this repository — grep-based reasoning about it will come up empty." ;
    bsi:hasColumn _:col_market_endpoint_registry_uid, _:col_market_endpoint_registry_endpoint_name, _:col_market_endpoint_registry_provider, _:col_market_endpoint_registry_data_domain, _:col_market_endpoint_registry_category, _:col_market_endpoint_registry_scope, _:col_market_endpoint_registry_update_frequency, _:col_market_endpoint_registry_use_case, _:col_market_endpoint_registry_http_method, _:col_market_endpoint_registry_target_url, _:col_market_endpoint_registry_url_template, _:col_market_endpoint_registry_auth_type, _:col_market_endpoint_registry_output_fields, _:col_market_endpoint_registry_validated_at .

