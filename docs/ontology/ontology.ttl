bsis:market_regimes     rdf:type bsi:Table ;
    rdfs:label "Market regimes" ;
    rdfs:comment "The macro regime label per session with its posterior probability, the HMM state path and the model's input features." ;
    bsi:realizes bsi:RegimeState ;
    bsi:rowClass bsit:market_regimes ;
    bsi:grain "(date)" ;
    bsi:cadence "daily" ;
    bsi:trainingUse "context" ;
    bsi:primaryKey "date" ;
    bsi:freshnessColumn "computed_at" ;
    bsi:writtenBy "regime_detector.py" ;
    bsi:caveat "This is a WEIGHT GATE, not a signal: it re-blends engine weights. Treating a regime label as alpha inverts its role.", "Regime history is short relative to price history, so per-regime splits lose power fast — always report the per-regime n." ;
    bsi:hasColumn _:col_market_regimes_date, _:col_market_regimes_regime, _:col_market_regimes_regime_prob, _:col_market_regimes_features_json, _:col_market_regimes_viterbi_path_json, _:col_market_regimes_computed_at .

bsit:market_regimes     rdf:type owl:Class ;
    rdfs:label "market_regimes row" ;
    rdfs:comment "A row of market_regimes. Grain: (date). Subclass of RegimeState; the physical contract (column set) lives in bsi:market_regimesShape." ;
    rdfs:subClassOf bsi:RegimeState .

_:col_market_regimes_date     bsi:columnName "date" ;
    bsi:property bsip:date ;
    bsi:semanticType "timestamp" ;
    bsi:leakageRisk "none" .

_:col_market_regimes_regime     bsi:columnName "regime" ;
    bsi:property bsip:regime ;
    bsi:semanticType "enum" ;
    bsi:leakageRisk "none" .

_:col_market_regimes_regime_prob     bsi:columnName "regime_prob" ;
    bsi:property bsip:regime_prob ;
    bsi:semanticType "probability" ;
    bsi:leakageRisk "high" .

_:col_market_regimes_features_json     bsi:columnName "features_json" ;
    bsi:property bsip:features_json ;
    bsi:semanticType "json" ;
    bsi:leakageRisk "none" .

_:col_market_regimes_viterbi_path_json     bsi:columnName "viterbi_path_json" ;
    bsi:property bsip:viterbi_path_json ;
    bsi:semanticType "json" ;
    bsi:leakageRisk "none" .

_:col_market_regimes_computed_at     bsi:columnName "computed_at" ;
    bsi:property bsip:computed_at ;
    bsi:semanticType "timestamp" ;
    bsi:leakageRisk "none" .

bsis:market_breadth     rdf:type bsi:Table ;
