    bsi:expectedLagHours "1.0"^^xsd:decimal ;
    bsi:writtenBy "news_fetcher.py" ;
    bsi:caveat "One article yields many rows, so counting rows counts MENTIONS, not articles — the two differ and the difference is usually the signal." ;
