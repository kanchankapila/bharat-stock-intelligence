bsis:feature_store     rdf:type bsi:Table ;
    rdfs:label "Feature store" ;
    rdfs:comment "The rolling feature panel the models train on: returns, moving averages, oscillators, volatility, volume and flow families." ;
    bsi:realizes bsi:FeatureVector ;
    bsi:rowClass bsit:feature_store ;
    bsi:grain "(symbol, date, timeframe)" ;
    bsi:cadence "daily" ;
    bsi:trainingUse "caution" ;
    bsi:primaryKey "symbol", "date", "timeframe" ;
    bsi:freshnessColumn "date" ;
    bsi:expectedLagHours "5.0"^^xsd:decimal ;
    bsi:writtenBy "feature_engineering.py" ;
    bsi:caveat "Values are the engineering layer's own output, so their meaning is set by `feature_engineering.py` at a specific commit — cite the feature version when a result depends on it.", "Pre-rebuild rows are not comparable with post-rebuild rows.", "Fast-growing hypertable, so compression and retention apply and deep history may be compressed away." ;
    bsi:hasColumn _:col_feature_store_symbol, _:col_feature_store_date, _:col_feature_store_timeframe, _:col_feature_store_sma50, _:col_feature_store_sma200, _:col_feature_store_above_sma200, _:col_feature_store_macd, _:col_feature_store_adx, _:col_feature_store_bb_width, _:col_feature_store_vwap, _:col_feature_store_rsi_14, _:col_feature_store_atr_14, _:col_feature_store_volume_ratio_20d .

