bsis:signal_outcomes     rdf:type bsi:Table ;
    rdfs:label "Signal outcomes" ;
    rdfs:comment "The resolved result of each technical or confluence signal: entry, exit, horizon, return and label." ;
    bsi:realizes bsi:SignalOutcome ;
    bsi:rowClass bsit:signal_outcomes ;
    bsi:grain "(symbol, signal_date, horizon_days, signal_source)" ;
    bsi:cadence "daily" ;
    bsi:trainingUse "labels" ;
    bsi:primaryKey "symbol", "signal_date", "horizon_days", "signal_source" ;
    bsi:freshnessColumn "computed_at" ;
    bsi:writtenBy "outcome_resolver.py" ;
    bsi:forbiddenColumn "return_pct", "outcome", "exit_price", "max_return_pct", "check_date" ;
    bsi:caveat "LABELS ONLY. Two labelling rules coexist (`path_barrier`, `terminal_pct2`): filter on `label_definition` before aggregating accuracy — mixing them makes every rate meaningless.", "`PENDING` rows have not elapsed and are not negative examples.", "`is_suspect` flags rows whose underlying data was quarantined." ;
    bsi:hasColumn _:col_signal_outcomes_symbol, _:col_signal_outcomes_signal_date, _:col_signal_outcomes_horizon_days, _:col_signal_outcomes_entry_price, _:col_signal_outcomes_check_date, _:col_signal_outcomes_exit_price, _:col_signal_outcomes_return_pct, _:col_signal_outcomes_outcome, _:col_signal_outcomes_signal_score, _:col_signal_outcomes_signals_json, _:col_signal_outcomes_computed_at, _:col_signal_outcomes_max_return_pct, _:col_signal_outcomes_label_definition, _:col_signal_outcomes_is_suspect, _:col_signal_outcomes_signal_source .

