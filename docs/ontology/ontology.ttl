bsis:stock_delivery_data     rdf:type bsi:Table ;
    rdfs:label "Daily delivery data" ;
    rdfs:comment "Deliverable quantity as a share of traded quantity: the platform's highest-frequency ownership proxy, published T+1 by the exchange." ;
    bsi:realizes bsi:DeliveryObservation ;
    bsi:rowClass bsit:stock_delivery_data ;
    bsi:grain "(symbol, date)" ;
    bsi:cadence "daily_t_plus_1" ;
    bsi:trainingUse "allowed" ;
    bsi:primaryKey "symbol", "date" ;
    bsi:freshnessColumn "updated_at" ;
    bsi:expectedLagHours "24.0"^^xsd:decimal ;
    bsi:writtenBy "stock_delivery_fetcher.py" ;
    bsi:caveat "T+1 by construction: no signal dated the same session can have used it.", "A sibling table (`stock_delivery_volume`) carries the same concept with different column names and different series coverage." ;
    bsi:hasColumn _:col_stock_delivery_data_symbol, _:col_stock_delivery_data_date, _:col_stock_delivery_data_delivery_pct, _:col_stock_delivery_data_delivery_qty, _:col_stock_delivery_data_traded_qty, _:col_stock_delivery_data_updated_at .

bsit:stock_delivery_data     rdf:type owl:Class ;
    rdfs:label "stock_delivery_data row" ;
    rdfs:comment "A row of stock_delivery_data. Grain: (symbol, date). Subclass of DeliveryObservation; the physical contract (column set) lives in bsi:stock_delivery_dataShape." ;
    rdfs:subClassOf bsi:DeliveryObservation .

_:col_stock_delivery_data_symbol     bsi:columnName "symbol" ;
    bsi:property bsip:symbol ;
    bsi:semanticType "identifier" ;
    bsi:leakageRisk "none" .

_:col_stock_delivery_data_date     bsi:columnName "date" ;
    bsi:property bsip:date ;
    bsi:semanticType "timestamp" ;
    bsi:leakageRisk "none" .

_:col_stock_delivery_data_delivery_pct     bsi:columnName "delivery_pct" ;
    bsi:property bsip:delivery_pct ;
    bsi:semanticType "ratio" ;
    bsi:leakageRisk "none" .

_:col_stock_delivery_data_delivery_qty     bsi:columnName "delivery_qty" ;
    bsi:property bsip:delivery_qty ;
    bsi:semanticType "measure" ;
    bsi:leakageRisk "none" .

_:col_stock_delivery_data_traded_qty     bsi:columnName "traded_qty" ;
    bsi:property bsip:traded_qty ;
    bsi:semanticType "measure" ;
    bsi:leakageRisk "none" .

_:col_stock_delivery_data_updated_at     bsi:columnName "updated_at" ;
    bsi:property bsip:fetched_at ;
    bsi:semanticType "timestamp" ;
    bsi:leakageRisk "none" .

bsis:stock_delivery_volume     rdf:type bsi:Table ;
    rdfs:label "Delivery volume (series-level)" ;
    rdfs:comment "Delivery and traded quantity broken out by NSE trading series." ;
    bsi:realizes bsi:DeliveryObservation ;
    bsi:rowClass bsit:stock_delivery_volume ;
    bsi:grain "(symbol, date, series)" ;
    bsi:cadence "daily_t_plus_1" ;
    bsi:trainingUse "caution" ;
    bsi:primaryKey "symbol", "date", "series" ;
    bsi:freshnessColumn "fetched_at" ;
    bsi:expectedLagHours "24.0"^^xsd:decimal ;
    bsi:writtenBy "stock_delivery_fetcher.py" ;
    bsi:caveat "Series-level grain: summing across series double-counts a symbol that trades in more than one." ;
    bsi:hasColumn _:col_stock_delivery_volume_symbol, _:col_stock_delivery_volume_date, _:col_stock_delivery_volume_series, _:col_stock_delivery_volume_qty_traded, _:col_stock_delivery_volume_deliverable_qty, _:col_stock_delivery_volume_delivery_pct, _:col_stock_delivery_volume_fetched_at .

