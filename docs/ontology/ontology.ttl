    bsi:writtenBy "nt_pcr_ts_fetcher.py" ;
    bsi:caveat "Three PCR columns share one property; they measure different things (OI, volume, OI change) and are not interchangeable." ;
    bsi:hasColumn _:col_nt_index_pcr_ts_index_name, _:col_nt_index_pcr_ts_ts, _:col_nt_index_pcr_ts_expiry, _:col_nt_index_pcr_ts_pcr, _:col_nt_index_pcr_ts_volume_pcr, _:col_nt_index_pcr_ts_change_oi_pcr, _:col_nt_index_pcr_ts_index_close, _:col_nt_index_pcr_ts_fetched_at .

