    bsi:isLabel "true"^^xsd:boolean ;
    qudt:unit "percent" ;
    skos:altLabel "forward_return_pct", "fwd_return" ;
    bsi:boundTo bsis:sector_rrg_history.sector_return, bsis:signal_outcomes.return_pct, bsis:unified_signal_outcomes.return_pct, bsis:live_screener_outcomes.return_1d, bsis:live_screener_outcomes.return_3d, bsis:live_screener_outcomes.return_5d, bsis:market_decision_outcome.return_pct .

