bsis:news_sentiment_items     rdf:type bsi:Table ;
    rdfs:label "News and announcements" ;
    rdfs:comment "Scored news articles and exchange announcements across 15 years — the only panel here deep enough for a real event study." ;
    bsi:realizes bsi:NewsItem ;
    bsi:rowClass bsit:news_sentiment_items ;
    bsi:grain "(id)" ;
