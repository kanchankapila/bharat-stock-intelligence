    bsi:property bsip:week_date ;
    bsi:semanticType "timestamp" ;
    bsi:leakageRisk "none" .

_:col_sector_rrg_history_quadrant     bsi:columnName "quadrant" ;
    bsi:property bsip:quadrant ;
    bsi:semanticType "enum" ;
    bsi:leakageRisk "none" .

_:col_sector_rrg_history_sector_return     bsi:columnName "sector_return" ;
    bsi:property bsip:return_pct ;
    bsi:semanticType "label" ;
    bsi:leakageRisk "target" ;
    bsi:note "Weekly sector return." .

_:col_sector_rrg_history_stocks_count     bsi:columnName "stocks_count" ;
    bsi:property bsip:stocks_count ;
    bsi:semanticType "count" ;
    bsi:leakageRisk "none" .

