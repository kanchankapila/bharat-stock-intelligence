bsip:market_cap     rdf:type owl:DatatypeProperty ;
    rdfs:label "Market capitalisation" ;
    rdfs:comment "Vendor-computed market cap. The stored unit is NOT declared anywhere in the schema — confirm it before aggregating across tables." ;
    rdfs:range xsd:decimal ;
    bsi:semanticType "measure" ;
    bsi:timing "lagging" ;
    bsi:derivation "raw" ;
    bsi:leakageRisk "none" ;
    bsi:usableAsFeature "true"^^xsd:boolean ;
    bsi:isLabel "false"^^xsd:boolean ;
    qudt:unit "INR_or_crore_UNDECLARED" ;
    skos:altLabel "mcap", "market capitalization" ;
    bsi:pointInTimeNote "The stored unit is declared nowhere in the schema. Do not aggregate this column across tables without establishing the scale first." ;
    bsi:boundTo bsis:fundamentals_history.market_cap, bsis:confluence_signals.market_cap, bsis:nse_stocks.market_cap ;
    skos:closeMatch fibo-ind-mkt-bas:MarketCapitalization ;
    bsi:alignmentRationale "[fibo-ind-mkt-bas:MarketCapitalization] Highest-confidence mapping in the file. The stored unit is declared nowhere in the schema; FIBO would force an explicit MonetaryAmount with a currency." ;
    bsi:verifiedFrom "https://github.com/edmcouncil/fibo (published prefix declarations) + FIBO IRI space under spec.edmcouncil.org; class symbols cross-checked against declared FIBO type stereotypes. Fetched 2026-09-21." .

bsip:quantity     rdf:type owl:DatatypeProperty ;
