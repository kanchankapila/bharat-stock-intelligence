bsis:technical_signals     rdf:type bsi:Table ;
    rdfs:label "Technical signal panel" ;
    rdfs:comment "The wide per-symbol, per-date technical panel: indicators, regime stamp, flow and fundamental context columns, plus model probability outputs." ;
    bsi:realizes bsi:TechnicalSignal ;
    bsi:rowClass bsit:technical_signals ;
    bsi:grain "(symbol, date)" ;
    bsi:cadence "daily" ;
    bsi:trainingUse "caution" ;
    bsi:primaryKey "symbol", "date" ;
    bsi:freshnessColumn "computed_at" ;
    bsi:expectedLagHours "5.0"^^xsd:decimal ;
    bsi:writtenBy "technical_analysis_engine.py", "feature_engineering.py" ;
    bsi:forbiddenColumn "win_probability", "calibrated_win_probability", "ai_insight" ;
    bsi:caveat "Over 300 columns of MIXED provenance: raw indicators, vendor opinions (ext_* / mc_* / tl_* prefixes) and model outputs sit side by side. Use the binding table to tell them apart.", "`win_probability` and `calibrated_win_probability` are model OUTPUTS — feeding them back in leaks the model into its own inputs.", "`ai_insight` is generated text." ;
    bsi:hasColumn _:col_technical_signals_symbol, _:col_technical_signals_date, _:col_technical_signals_signal_score, _:col_technical_signals_rsi, _:col_technical_signals_sma50, _:col_technical_signals_sma200, _:col_technical_signals_macd, _:col_technical_signals_adx, _:col_technical_signals_bb_width, _:col_technical_signals_volume_ratio, _:col_technical_signals_above_sma200, _:col_technical_signals_cmp, _:col_technical_signals_change_pct, _:col_technical_signals_ai_insight, _:col_technical_signals_stop_loss, _:col_technical_signals_time_horizon, _:col_technical_signals_computed_at, _:col_technical_signals_delivery_pct, _:col_technical_signals_fii_3d_net, _:col_technical_signals_dii_3d_net, _:col_technical_signals_win_probability, _:col_technical_signals_calibrated_win_probability, _:col_technical_signals_iv_rank, _:col_technical_signals_cs_score, _:col_technical_signals_oi_net_change_pct, _:col_technical_signals_rollover_pct, _:col_technical_signals_cost_of_carry_ann, _:col_technical_signals_mf_holding_pct, _:col_technical_signals_block_deal_value_cr, _:col_technical_signals_roe_annual, _:col_technical_signals_ebitda_margin, _:col_technical_signals_np_margin, _:col_technical_signals_pledge_pct, _:col_technical_signals_analyst_count, _:col_technical_signals_pcr_oi, _:col_technical_signals_asm_flag, _:col_technical_signals_fcf_positive, _:col_technical_signals_signals_json, _:col_technical_signals_news_sentiment_score, _:col_technical_signals_nifty_regime, _:col_technical_signals_iv_hv_ratio .

