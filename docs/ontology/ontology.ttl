bsis:feature_importance_log     rdf:type bsi:Table ;
    rdfs:label "Feature importance log" ;
    rdfs:comment "Per-model, per-run feature importance with rank — the audit trail behind which inputs a model actually used." ;
    bsi:realizes bsi:FeatureImportance ;
    bsi:rowClass bsit:feature_importance_log ;
    bsi:grain "(id)" ;
    bsi:cadence "on_training" ;
    bsi:trainingUse "forbidden" ;
    bsi:primaryKey "id" ;
    bsi:freshnessColumn "computed_at" ;
    bsi:writtenBy "ml_ensemble.py" ;
    bsi:caveat "Two name columns exist (`model_name` and `feature_name`) that share one property; read them by position, not by assumption.", "Importance is model-internal: it is not a measure of market edge and must not be used as a feature." ;
    bsi:hasColumn _:col_feature_importance_log_id, _:col_feature_importance_log_model_name, _:col_feature_importance_log_computed_at, _:col_feature_importance_log_feature_name, _:col_feature_importance_log_importance, _:col_feature_importance_log_rank_position .

