    bsi:hasColumn _:col_market_breadth_date, _:col_market_breadth_pct_above_200dma, _:col_market_breadth_adv_decline_ratio, _:col_market_breadth_computed_at .

bsit:market_breadth     rdf:type owl:Class ;
