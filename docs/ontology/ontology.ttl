bsis:stock_event_triggers     rdf:type bsi:Table ;
    rdfs:label "Stock event triggers" ;
    rdfs:comment "Detector output per symbol and date: which composite trigger classes fired, with news counts and bullish-tenure state." ;
    bsi:realizes bsi:EventTrigger ;
    bsi:rowClass bsit:stock_event_triggers ;
    bsi:grain "(date, symbol)" ;
    bsi:cadence "daily" ;
    bsi:trainingUse "allowed" ;
    bsi:primaryKey "date", "symbol" ;
    bsi:freshnessColumn "computed_at" ;
    bsi:writtenBy "event_triggers.py" ;
    bsi:caveat "`triggers` is a comma-joined string with inline thresholds (`CROWDED_NEWS p90`) — parse the class token, never the whole value." ;
    bsi:hasColumn _:col_stock_event_triggers_date, _:col_stock_event_triggers_symbol, _:col_stock_event_triggers_news_count_5d, _:col_stock_event_triggers_news_sent_5d, _:col_stock_event_triggers_triggers, _:col_stock_event_triggers_computed_at .

