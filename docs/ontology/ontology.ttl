bsis:corporate_actions     rdf:type bsi:Table ;
    rdfs:label "Corporate actions" ;
    rdfs:comment "Dividends, splits, bonuses and rights with their ex/record dates — the anchor for price adjustment and event-aware risk filtering." ;
    bsi:realizes bsi:CorporateAction ;
    bsi:rowClass bsit:corporate_actions ;
    bsi:grain "(symbol, ex_date, action_type)" ;
    bsi:cadence "event_driven" ;
    bsi:trainingUse "allowed" ;
    bsi:primaryKey "symbol", "ex_date", "action_type" ;
    bsi:freshnessColumn "ingested_at" ;
    bsi:writtenBy "mc_corporate_actions_fetcher.py", "investsights_corporate_actions_fetcher.py" ;
    bsi:caveat "The table also carries `Quarterly Results` rows, which are not capital actions at all — filter `action_type` before computing an adjustment factor or an event count." ;
    bsi:hasColumn _:col_corporate_actions_symbol, _:col_corporate_actions_ex_date, _:col_corporate_actions_action_type, _:col_corporate_actions_amount, _:col_corporate_actions_source, _:col_corporate_actions_ingested_at .

bsit:corporate_actions     rdf:type owl:Class ;
    rdfs:label "corporate_actions row" ;
    rdfs:comment "A row of corporate_actions. Grain: (symbol, ex_date, action_type). Subclass of CorporateAction; the physical contract (column set) lives in bsi:corporate_actionsShape." ;
    rdfs:subClassOf bsi:CorporateAction .

_:col_corporate_actions_symbol     bsi:columnName "symbol" ;
    bsi:property bsip:symbol ;
    bsi:semanticType "identifier" ;
    bsi:leakageRisk "none" .

