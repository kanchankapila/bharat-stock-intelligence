bsis:unified_recommendations     rdf:type bsi:Table ;
    rdfs:label "Served recommendations" ;
    rdfs:comment "The authoritative served signal: composite score, conviction bucket, action, entry zone, stop, targets, risk/reward and position size per timeframe." ;
    bsi:realizes bsi:Recommendation ;
    bsi:rowClass bsit:unified_recommendations ;
