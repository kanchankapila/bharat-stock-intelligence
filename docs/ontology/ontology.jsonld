    {
      "@id": "bsi:OutcomeRecord",
      "rdf:type": {
        "@id": "owl:Class"
      },
      "rdfs:label": "Outcome record",
      "rdfs:comment": "Abstract parent for resolved results. Labels live here and nowhere else: nothing in this branch may ever appear on the input side of a model.",
      "bsi:layer": "outcome",
      "bsi:realization": "abstract",
      "bsi:keyProperty": [
        {
          "@id": "bsip:symbol"
        },
        {
          "@id": "bsip:signal_date"
        }
      ]
    },
    {
      "@id": "bsi:EdgeReading",
      "rdf:type": {
        "@id": "owl:Class"
      },
      "rdfs:label": "Edge reading",
      "rdfs:comment": "One factor-grading result: rank-IC and hit-AUC for a table/column, per regime and horizon, with the effective-date count and a verdict.",
      "bsi:layer": "outcome",
      "bsi:realization": "table",
      "bsi:grain": "(run_at, table_name, score_col, horizon_days, regime)",
      "rdfs:subClassOf": {
        "@id": "bsi:OutcomeRecord"
      },
      "bsi:keyProperty": [
        {
          "@id": "bsip:source"
        },
        {
          "@id": "bsip:name"
        },
        {
          "@id": "bsip:horizon_days"
        },
        {
          "@id": "bsip:verdict"
        }
      ],
      "bsi:caveat": "Read `eff_dates` BEFORE the reading. Overlapping forward windows inflate a correlation by roughly the horizon factor, and the effective-date count is the guard that exposes it — too few effective dates makes a reading a calendar artefact rather than an edge.",
      "bsi:realizedBy": {
        "@id": "bsis:factor_edge_history"
      },
      "bsi:noExternalCounterpart": "platform_specific: `factor_edge_history` is this platform's own measurement ledger — rank-IC and AUC per factor, regime and horizon, with an independent-observation guard. FIBO has no concept of evidence quality over a date panel."
    },
    {
      "@id": "bsi:SignalOutcome",
      "rdf:type": {
        "@id": "owl:Class"
      },
      "rdfs:label": "Signal outcome",
      "rdfs:comment": "The resolved result of a signal: entry, exit, horizon, return and the outcome label, under one of two possibly-different labelling rules.",
      "bsi:layer": "outcome",
      "bsi:realization": "table",
      "bsi:grain": "(symbol, signal_date, horizon_days, signal_source)",
      "rdfs:subClassOf": {
        "@id": "bsi:OutcomeRecord"
      },
      "bsi:keyProperty": [
        {
          "@id": "bsip:symbol"
        },
        {
          "@id": "bsip:signal_date"
        },
        {
          "@id": "bsip:horizon_days"
        }
      ],
      "bsi:caveat": [
        "Labels are NOT comparable across `label_definition` (`path_barrier` vs `terminal_pct2`). Always filter on it before aggregating accuracy.",
        "`PENDING` rows have not elapsed — they are not negative examples.",
        "`NO_ENTRY_PRICE` / `SUSPECT_DATA` are integrity exits, not labels."
      ],
      "bsi:realizedBy": [
        {
          "@id": "bsis:signal_outcomes"
        },
        {
          "@id": "bsis:unified_signal_outcomes"
        }
      ],
      "bsi:noExternalCounterpart": "platform_specific: Our labels come from two non-comparable rules (`path_barrier` vs `terminal_pct2`). That distinction is internal and load-bearing; no external vocabulary carries it."
    },
    {
      "@id": "bsi:SignalExcursion",
      "rdf:type": {
        "@id": "owl:Class"
      },
      "rdfs:label": "Signal excursion",
      "rdfs:comment": "Path statistics inside the evaluation window: maximum favourable and adverse excursion, days to each, and whether MFE preceded MAE.",
      "bsi:layer": "outcome",
      "bsi:realization": "table",
      "bsi:grain": "(symbol, signal_date, horizon_days)",
      "rdfs:subClassOf": {
        "@id": "bsi:OutcomeRecord"
      },
      "bsi:keyProperty": [
        {
          "@id": "bsip:symbol"
        },
        {
          "@id": "bsip:signal_date"
        },
        {
          "@id": "bsip:horizon_days"
        }
      ],
      "bsi:caveat": "This is what makes a stop-loss study possible: the terminal return alone cannot tell you whether the trade was ever viable.",
      "bsi:realizedBy": {
        "@id": "bsis:signal_excursions"
      }
    },
    {
      "@id": "bsi:CandidateRecord",
      "rdf:type": {
        "@id": "owl:Class"
      },
      "rdfs:label": "Candidate record",
      "rdfs:comment": "Abstract parent for vendor-opinion streams. These SURFACE candidates; they are never ground truth.",
      "bsi:layer": "candidate",
      "bsi:realization": "abstract",
      "bsi:keyProperty": {
        "@id": "bsip:symbol"
      }
    },
    {
      "@id": "bsi:Screener",
      "rdf:type": {
        "@id": "owl:Class"
      },
      "rdfs:label": "Screener",
      "rdfs:comment": "A vendor screener definition with its inferred sentiment, category, reliability tier and classification confidence.",
      "bsi:layer": "candidate",
      "bsi:realization": "table",
      "bsi:grain": "one row per screener",
      "bsi:keyProperty": {
        "@id": "bsip:id"
      },
      "bsi:caveat": [
        "Sentiment, category and tier are INFERRED by this platform, not supplied by the vendor: they are model output about a vendor product.",
        "A screener is a candidate generator, never evidence — its aggregate momentum score no longer clears the USABLE bar."
      ],
      "bsi:realizedBy": {
        "@id": "bsis:screener_master"
      }
    },
    {
      "@id": "bsi:ScreenerAppearance",
      "rdf:type": {
        "@id": "owl:Class"
      },
      "rdfs:label": "Screener appearance",
      "rdfs:comment": "A single surfacing event: this screener listed this symbol at this instant, with the price, change and volume at that moment.",
      "bsi:layer": "candidate",
      "bsi:realization": "table",
      "bsi:grain": "(run_id, symbol, filter_key)",
      "rdfs:subClassOf": {
        "@id": "bsi:CandidateRecord"
      },
      "bsi:keyProperty": {
        "@id": "bsip:id"
      },
      "bsi:caveat": [
        "12.25M rows and growing: always bound a query by run_id or symbol.",
        "Surfacing time is the only knowable time; the screener's internal logic is not visible."
      ],
      "bsi:realizedBy": {
        "@id": "bsis:live_screener_appearances"
      },
      "bsi:noExternalCounterpart": "platform_specific: A vendor screener's membership stream with forward outcomes pre-tracked at surfacing time. A data-vendor artifact, not a financial concept."
    },
    {
      "@id": "bsi:ScreenerOutcome",
      "rdf:type": {
        "@id": "owl:Class"
      },
      "rdfs:label": "Screener outcome",
      "rdfs:comment": "Forward returns pre-tracked and attached to an appearance at surfacing time.",
      "bsi:layer": "outcome",
      "bsi:realization": "table",
      "bsi:grain": "(appearance_id, symbol)",
      "rdfs:subClassOf": {
        "@id": "bsi:OutcomeRecord"
      },
      "bsi:keyProperty": [
        {
          "@id": "bsip:id"
        },
        {
          "@id": "bsip:symbol"
        }
      ],
      "bsi:caveat": "The platform's largest pre-labelled dataset (9.2M outcomes) and the reason screener research is worth doing — but the labels are forward returns from the surfacing price, so any attribution belongs to the SCREENER, not to an engine that happened to agree with it.",
      "bsi:realizedBy": {
        "@id": "bsis:live_screener_outcomes"
      },
      "bsi:noExternalCounterpart": "platform_specific: The pre-tracked forward returns attached to those appearances (9.2M rows). No external ontology models 'what happened after a screener surfaced a name'."
    },
    {
      "@id": "bsi:EventTrigger",
      "rdf:type": {
        "@id": "owl:Class"
      },
      "rdfs:label": "Event trigger",
      "rdfs:comment": "Detector output: which composite trigger classes fired for a symbol on a date, with news counts and bullish-tenure state.",
      "bsi:layer": "candidate",
      "bsi:realization": "table",
      "bsi:grain": "(symbol, date)",
      "rdfs:subClassOf": {
        "@id": "bsi:CandidateRecord"
      },
      "bsi:keyProperty": [
        {
          "@id": "bsip:symbol"
        },
        {
          "@id": "bsip:date"
        }
      ],
      "bsi:caveat": "`triggers` is a comma-joined string carrying inline thresholds (`CROWDED_NEWS p90`) — parse the class token, never the whole value.",
      "bsi:realizedBy": {
        "@id": "bsis:stock_event_triggers"
      },
      "bsi:noExternalCounterpart": "platform_specific: Composite trigger classes (SCREENER_SUPPORT_FADING, CROWDED_NEWS) are internal detector output with inline thresholds."
    },
    {
      "@id": "bsi:GovernanceRecord",
      "rdf:type": {
        "@id": "owl:Class"
      },
      "rdfs:label": "Governance record",
      "rdfs:comment": "Abstract parent for operational metadata. These answer 'when was this true and who wrote it', which on this platform is the difference between a usable value and a guess.",
      "bsi:layer": "governance",
      "bsi:realization": "abstract",
      "bsi:keyProperty": {
        "@id": "bsip:id"
      }
    },
    {
      "@id": "bsi:Endpoint",
      "rdf:type": {
        "@id": "owl:Class"
      },
      "rdfs:label": "Data endpoint",
      "rdfs:comment": "A discovered, verified market-data endpoint: provider, domain, scope, update frequency and the template to call it. The platform's data-sourcing registry.",
      "bsi:layer": "governance",
      "bsi:realization": "table",
      "bsi:grain": "one row per endpoint",
      "rdfs:subClassOf": {
        "@id": "bsi:GovernanceRecord"
      },
      "bsi:keyProperty": {
        "@id": "bsip:id"
      },
      "bsi:caveat": "This registry is the mandatory first stop when a source stops returning data — 3,408 verified endpoints exist here and a 'dead vendor' conclusion is not admissible until they have been checked.",
      "bsi:realizedBy": [
        {
          "@id": "bsis:market_endpoint_registry"
        },
        {
          "@id": "bsis:url_endpoints"
        }
      ],
      "bsi:noExternalCounterpart": "out_of_scope: The 3,408-row discovery registry is a scraping/provenance asset; DCAT or an API-description vocabulary fits, FIBO does not."
    },
    {
      "@id": "bsi:JobRun",
      "rdf:type": {
        "@id": "owl:Class"
      },
      "rdfs:label": "Job run",
      "rdfs:comment": "Per-job heartbeat: last status, last success, last error and run/failure counts.",
      "bsi:layer": "governance",
      "bsi:realization": "table",
      "bsi:grain": "one row per job",
      "rdfs:subClassOf": {
        "@id": "bsi:GovernanceRecord"
      },
      "bsi:keyProperty": {
        "@id": "bsip:job_name"
      },
      "bsi:caveat": [
        "`last_run_at` is the last ATTEMPT; `last_success_at` is what freshness should be judged against. A job that runs and fails updates the former only.",
        "A step exiting 0 is not evidence that data was written; this repo treats 'data not successfully written' as an error regardless of log level."
      ],
      "bsi:realizedBy": {
        "@id": "bsis:job_heartbeat"
      },
      "bsi:noExternalCounterpart": "out_of_scope: Operational provenance — PROV-O is the right family (already in this ontology's namespace map), not FIBO."
    },
    {
      "@id": "bsi:DataQualityCheck",
      "rdf:type": {
        "@id": "owl:Class"
      },
      "rdfs:label": "Data-quality check",
      "rdfs:comment": "The result of one named validation check: category, criticality, status and a detail string.",
      "bsi:layer": "governance",
      "bsi:realization": "table",
      "bsi:grain": "(check_id, checked_at)",
      "rdfs:subClassOf": {
        "@id": "bsi:GovernanceRecord"
      },
      "bsi:keyProperty": {
        "@id": "bsip:check_id"
      },
      "bsi:caveat": "Status is stored lowercase (`pass` / `warn`), so a case-sensitive comparison against 'PASS' matches nothing.",
      "bsi:realizedBy": {
        "@id": "bsis:data_quality_results"
      },
      "bsi:noExternalCounterpart": "out_of_scope: Data-governance concept, not a financial one."
    },
