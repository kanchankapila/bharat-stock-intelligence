    {
      "@id": "bsis:unified_signal_outcomes",
      "rdf:type": {
        "@id": "bsi:Table"
      },
      "rdfs:label": "Unified signal outcomes",
      "rdfs:comment": "Outcomes for served signals with the exit reason that closed them — the forward-test surface for the ranker.",
      "bsi:realizes": {
        "@id": "bsi:SignalOutcome"
      },
      "bsi:rowClass": {
        "@id": "bsit:unified_signal_outcomes"
      },
      "bsi:grain": "(symbol, signal_date, horizon_days)",
      "bsi:cadence": "daily",
      "bsi:trainingUse": "labels",
      "bsi:primaryKey": [
        "symbol",
        "signal_date",
        "horizon_days"
      ],
      "bsi:freshnessColumn": "computed_at",
      "bsi:writtenBy": "outcome_resolver.py",
      "bsi:forbiddenColumn": [
        "return_pct",
        "outcome",
        "exit_price",
        "check_date",
        "exit_reason"
      ],
      "bsi:caveat": [
        "`exit_reason` separates rule exits from integrity exits: `NO_ENTRY_PRICE` and `SUSPECT_DATA` rows are not labels.",
        "`TIME_EXIT_PARTIAL` means the position did not close cleanly, so its return is not directly comparable to a full exit."
      ],
      "bsi:hasColumn": [
        {
          "@id": "_:col_unified_signal_outcomes_unified_signal_id"
        },
        {
          "@id": "_:col_unified_signal_outcomes_symbol"
        },
        {
          "@id": "_:col_unified_signal_outcomes_signal_date"
        },
        {
          "@id": "_:col_unified_signal_outcomes_signal_source"
        },
        {
          "@id": "_:col_unified_signal_outcomes_horizon_days"
        },
        {
          "@id": "_:col_unified_signal_outcomes_entry_price"
        },
        {
          "@id": "_:col_unified_signal_outcomes_check_date"
        },
        {
          "@id": "_:col_unified_signal_outcomes_exit_price"
        },
        {
          "@id": "_:col_unified_signal_outcomes_return_pct"
        },
        {
          "@id": "_:col_unified_signal_outcomes_outcome"
        },
        {
          "@id": "_:col_unified_signal_outcomes_exit_reason"
        },
        {
          "@id": "_:col_unified_signal_outcomes_signal_score"
        },
        {
          "@id": "_:col_unified_signal_outcomes_computed_at"
        }
      ]
