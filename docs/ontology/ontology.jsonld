        "@id": "bsip:name"
      },
      "bsi:semanticType": "text",
      "bsi:leakageRisk": "none",
      "bsi:note": "The screener that surfaced the name."
    },
    {
      "@id": "_:col_live_screener_appearances_price",
      "bsi:columnName": "price",
      "bsi:property": {
        "@id": "bsip:cmp"
      },
      "bsi:semanticType": "measure",
      "bsi:leakageRisk": "none",
      "bsi:note": "Price at the moment of surfacing."
    },
    {
      "@id": "_:col_live_screener_appearances_change_per",
      "bsi:columnName": "change_per",
      "bsi:property": {
        "@id": "bsip:change_pct"
      },
      "bsi:semanticType": "ratio",
      "bsi:leakageRisk": "none"
    },
    {
