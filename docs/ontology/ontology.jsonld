    {
      "@id": "bsis:confluence_signals",
      "rdf:type": {
        "@id": "bsi:Table"
      },
      "rdfs:label": "Confluence signals",
      "rdfs:comment": "The multi-engine agreement score with the contributing screeners, their weights at scoring time, and the model probabilities that fed it.",
      "bsi:realizes": {
        "@id": "bsi:EngineScore"
      },
      "bsi:rowClass": {
        "@id": "bsit:confluence_signals"
      },
      "bsi:grain": "(symbol, computed_at)",
      "bsi:cadence": "every_15m",
      "bsi:trainingUse": "caution",
      "bsi:primaryKey": [
        "symbol",
        "computed_at"
      ],
      "bsi:freshnessColumn": "computed_at",
      "bsi:expectedLagHours": {
        "@value": "0.5",
        "@type": "xsd:decimal"
      },
      "bsi:writtenBy": "confluence_ml_engine.py",
      "bsi:forbiddenColumn": [
        "trade_reasoning",
        "ai_conclusion"
      ],
      "bsi:caveat": [
        "The only engine score with a growing positive graded reading on this platform — which is what makes it the ranker's load-bearing input.",
        "`computed_at` here is native TIMESTAMPTZ, unlike the TEXT `computed_at` on `unified_recommendations`: cast across the join.",
        "`ml_breakout_probability` / `ml_trend_probability` are model outputs.",
        "`screener_weights_json` records the weights AT SCORING TIME — applying today's weights to an old row is a look-ahead bug."
      ],
      "bsi:hasColumn": [
        {
          "@id": "_:col_confluence_signals_symbol"
        },
        {
          "@id": "_:col_confluence_signals_computed_at"
        },
        {
          "@id": "_:col_confluence_signals_confluence_score"
        },
        {
          "@id": "_:col_confluence_signals_conviction_level"
        },
        {
          "@id": "_:col_confluence_signals_active_screener_count"
        },
        {
          "@id": "_:col_confluence_signals_bullish_screener_count"
        },
        {
          "@id": "_:col_confluence_signals_bearish_screener_count"
        },
        {
          "@id": "_:col_confluence_signals_screener_ids_json"
        },
        {
          "@id": "_:col_confluence_signals_screener_names_json"
        },
        {
          "@id": "_:col_confluence_signals_screener_weights_json"
        },
        {
          "@id": "_:col_confluence_signals_fundamental_score"
        },
        {
          "@id": "_:col_confluence_signals_ml_breakout_probability"
        },
        {
          "@id": "_:col_confluence_signals_ml_trend_probability"
        },
        {
          "@id": "_:col_confluence_signals_entry_zone_low"
        },
        {
          "@id": "_:col_confluence_signals_entry_zone_high"
        },
        {
          "@id": "_:col_confluence_signals_stop_loss"
        },
        {
          "@id": "_:col_confluence_signals_target_1"
        },
        {
          "@id": "_:col_confluence_signals_target_2"
        },
        {
          "@id": "_:col_confluence_signals_target_3"
        },
        {
          "@id": "_:col_confluence_signals_risk_reward"
        },
        {
          "@id": "_:col_confluence_signals_ai_conclusion"
        },
        {
          "@id": "_:col_confluence_signals_trade_reasoning"
        },
        {
          "@id": "_:col_confluence_signals_sector"
        },
        {
          "@id": "_:col_confluence_signals_market_cap"
        },
        {
          "@id": "_:col_confluence_signals_current_price"
