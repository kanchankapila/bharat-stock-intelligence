    {
      "@id": "bsis:live_screener_appearances",
      "rdf:type": {
        "@id": "bsi:Table"
      },
      "rdfs:label": "Live screener appearances",
      "rdfs:comment": "Every live surfacing event: which screener listed which symbol at which instant, with the price, change and volume at that moment.",
      "bsi:realizes": {
        "@id": "bsi:ScreenerAppearance"
      },
      "bsi:rowClass": {
        "@id": "bsit:live_screener_appearances"
      },
      "bsi:grain": "(id)",
      "bsi:cadence": "every_15m",
      "bsi:trainingUse": "allowed",
      "bsi:primaryKey": "id",
      "bsi:writtenBy": [
        "mover_screener_fetcher.py",
        "live_screener_ml_ranker.py"
      ],
      "bsi:caveat": [
        "12.25M rows and growing: always bound a query by run_id or symbol.",
        "`price` is the snapshot at surfacing time, not a session close.",
        "There is no timestamp column on the row itself — time lives on the run, so a time filter must join through it."
      ],
      "bsi:hasColumn": [
        {
          "@id": "_:col_live_screener_appearances_id"
        },
        {
          "@id": "_:col_live_screener_appearances_run_id"
        },
        {
          "@id": "_:col_live_screener_appearances_symbol"
        },
        {
          "@id": "_:col_live_screener_appearances_filter_key"
        },
        {
          "@id": "_:col_live_screener_appearances_price"
        },
        {
          "@id": "_:col_live_screener_appearances_change_per"
        },
        {
          "@id": "_:col_live_screener_appearances_volume"
        }
      ]
    },
    {
      "@id": "bsit:live_screener_appearances",
      "rdf:type": {
        "@id": "owl:Class"
      },
      "rdfs:label": "live_screener_appearances row",
      "rdfs:comment": "A row of live_screener_appearances. Grain: (id). Subclass of ScreenerAppearance; the physical contract (column set) lives in bsi:live_screener_appearancesShape.",
      "rdfs:subClassOf": {
        "@id": "bsi:ScreenerAppearance"
      }
    },
    {
      "@id": "_:col_live_screener_appearances_id",
