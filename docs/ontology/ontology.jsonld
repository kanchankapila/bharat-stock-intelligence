    {
      "@id": "bsim:delivery_surprise_z",
      "rdf:type": {
        "@id": "bsim:Metric"
      },
      "rdfs:label": "Delivery surprise z-score",
      "rdfs:comment": "Today's NSE delivery percentage as a z-score against the symbol's own trailing 20-session history: unusual ownership behaviour on a session, the T+1-lag edge the master report names.",
      "bsim:entity": {
        "@id": "bsi:Equity"
      },
      "bsim:sql": "WITH hist AS (\n    SELECT date AS d, delivery_pct AS dp\n    FROM stock_delivery_data\n    WHERE symbol = :symbol AND delivery_pct IS NOT NULL\n), stats AS (\n    SELECT d, dp,\n           avg(dp) OVER (ORDER BY d ROWS BETWEEN 20 PRECEDING AND 1 PRECEDING) AS mu,\n           stddev_samp(dp) OVER (ORDER BY d ROWS BETWEEN 20 PRECEDING AND 1 PRECEDING) AS sd\n    FROM hist\n)\nSELECT d AS as_of, dp AS delivery_pct,\n       CASE WHEN sd > 0 THEN (dp - mu) / sd ELSE 0.0 END AS delivery_surprise_z\nFROM stats\nWHERE d <= :as_of\nORDER BY d DESC\nLIMIT 1",
      "bsim:params": "symbol, as_of",
      "bsim:grain": "one row per symbol per as-of session",
      "bsim:cadence": "daily",
      "bsim:timing": "leading",
      "bsim:derivation": "derived",
      "bsim:leakageRisk": "none",
      "bsim:gradedStatus": "research-candidate",
      "bsim:cheapToRun": {
        "@value": "true",
        "@type": "xsd:boolean"
      },
      "bsim:unit": "z",
      "bsim:derivedFrom": {
        "@id": "bsis:stock_delivery_data"
      },
      "bsim:caveat": [
        "Delivery data lands T+1: the z-score for session D is knowable only during session D+1, so any same-session use is a look-ahead.",
        "Self-referenced (vs the symbol's own history), not cross-sectional."
      ],
      "skos:altLabel": [
        "delivery surprise z",
        "delivery surprise"
      ]
    },
    {
      "@id": "bsim:close_price",
      "rdf:type": {
        "@id": "bsim:Metric"
      },
      "rdfs:label": "Closing price (basis-tagged)",
      "rdfs:comment": "The most recent clean closing price on or before an as-of date, excluding quarantined bars.",
      "bsim:entity": {
        "@id": "bsi:Bar"
      },
      "bsim:sql": "SELECT o.close AS close_price, o.date AS as_of, o.adjustment_basis\nFROM stock_ohlcv o\nWHERE o.symbol = :symbol AND o.date <= :as_of AND o.is_suspect = 0\nORDER BY o.date DESC\nLIMIT 1",
      "bsim:params": "symbol, as_of",
      "bsim:grain": "(symbol, date)",
      "bsim:cadence": "per_session",
      "bsim:timing": "coincident",
      "bsim:derivation": "raw",
      "bsim:leakageRisk": "none",
      "bsim:gradedStatus": "live",
      "bsim:cheapToRun": {
        "@value": "true",
        "@type": "xsd:boolean"
      },
      "bsim:unit": "per_share_INR",
      "bsim:derivedFrom": {
        "@id": "bsis:stock_ohlcv"
      },
      "bsim:caveat": [
        "The price is in whatever basis `adjustment_basis` names: mixing bases across a series is a silent backtest corruption.",
        "`is_suspect = 0` is applied — a quarantined bar is excluded, not corrected."
      ],
      "skos:altLabel": [
        "close",
        "closing price",
        "last close",
        "price"
      ]
    },
    {
      "@id": "bsim:delivery_pct_latest",
      "rdf:type": {
        "@id": "bsim:Metric"
      },
      "rdfs:label": "Latest delivery percentage",
      "rdfs:comment": "Delivered shares as a share of traded shares on the most recent session at or before the as-of date.",
      "bsim:entity": {
        "@id": "bsi:DeliveryObservation"
      },
      "bsim:sql": "SELECT d.delivery_pct AS delivery_pct, d.date AS as_of\nFROM stock_delivery_data d\nWHERE d.symbol = :symbol AND d.date <= :as_of\nORDER BY d.date DESC\nLIMIT 1",
      "bsim:params": "symbol, as_of",
      "bsim:grain": "(symbol, date)",
      "bsim:cadence": "daily_t_plus_1",
      "bsim:timing": "lagging",
      "bsim:derivation": "raw",
      "bsim:leakageRisk": "none",
      "bsim:gradedStatus": "research-candidate",
      "bsim:cheapToRun": {
        "@value": "true",
        "@type": "xsd:boolean"
      },
      "bsim:unit": "percent",
      "bsim:gradedEvidence": "Delivery-to-swing-returns is an unquantified link (master report §6, Experiment 4) — not yet graded by factor_edge.py.",
      "bsim:derivedFrom": {
        "@id": "bsis:stock_delivery_data"
      },
      "bsim:caveat": [
        "T+1 by construction: this value was NOT knowable on the session it describes, so it cannot explain that session's move.",
        "A sibling table (`stock_delivery_volume`) reports the same concept per NSE series with different column names."
      ],
      "skos:altLabel": [
        "delivery",
        "delivery percent",
        "delivery percentage",
        "deliv"
      ]
    },
    {
      "@id": "bsim:delivery_pct_30d_average",
      "rdf:type": {
        "@id": "bsim:Metric"
      },
      "rdfs:label": "Delivery percentage, 30-session average",
      "rdfs:comment": "Mean delivery percentage over the trailing window ending at the as-of date — the baseline a delivery surprise is measured against.",
      "bsim:entity": {
        "@id": "bsi:DeliveryObservation"
      },
      "bsim:sql": "SELECT avg(d.delivery_pct) AS delivery_avg, count(*) AS sessions\nFROM stock_delivery_data d\nWHERE d.symbol = :symbol AND d.date <= :as_of\n  AND d.date > ((:as_of)::date - 30)",
      "bsim:params": "symbol, as_of",
      "bsim:grain": "(symbol, trailing 30 sessions)",
      "bsim:cadence": "daily_t_plus_1",
      "bsim:timing": "lagging",
      "bsim:derivation": "platform",
      "bsim:leakageRisk": "none",
      "bsim:gradedStatus": "research-candidate",
      "bsim:cheapToRun": {
        "@value": "true",
        "@type": "xsd:boolean"
      },
      "bsim:unit": "percent",
      "bsim:derivedFrom": {
        "@id": "bsis:stock_delivery_data"
      },
      "bsim:caveat": [
        "Session count, not calendar days: the window spans trading sessions.",
        "Returns NULL when the symbol has no delivery rows in the window — a coverage gap, not a zero."
      ],
      "skos:altLabel": [
        "average delivery",
        "delivery baseline",
        "delivery trend"
      ]
    },
    {
      "@id": "bsim:rsi_14_latest",
      "rdf:type": {
        "@id": "bsim:Metric"
      },
      "rdfs:label": "RSI (14), latest",
      "rdfs:comment": "Wilder RSI from the technical panel on the most recent date at or before the as-of date.",
      "bsim:entity": {
        "@id": "bsi:TechnicalSignal"
      },
      "bsim:sql": "SELECT t.rsi AS rsi_14, t.date AS as_of\nFROM technical_signals t\nWHERE t.symbol = :symbol AND t.date <= :as_of\nORDER BY t.date DESC\nLIMIT 1",
      "bsim:params": "symbol, as_of",
      "bsim:grain": "(symbol, date)",
      "bsim:cadence": "daily",
      "bsim:timing": "coincident",
      "bsim:derivation": "platform",
      "bsim:leakageRisk": "none",
      "bsim:gradedStatus": "measured",
      "bsim:cheapToRun": {
        "@value": "true",
        "@type": "xsd:boolean"
      },
      "bsim:unit": "index_points",
      "bsim:gradedEvidence": "rsi_14 measured NEGATIVE rank-IC at 5 days: on this platform it is a mean-reversion input, not a momentum confirmation.",
      "bsim:derivedFrom": {
        "@id": "bsis:technical_signals"
      },
      "bsim:caveat": [
        "Graded as a mean-reversion input — a high RSI is not a buy signal here.",
        "RSI re-expresses price, so on its own it adds no information beyond the shape of the recent move."
      ],
      "skos:altLabel": [
        "rsi",
        "relative strength index",
        "overbought",
        "oversold"
      ]
    },
    {
      "@id": "bsim:signal_win_rate_5d",
      "rdf:type": {
        "@id": "bsim:Metric"
      },
      "rdfs:label": "Signal win rate, 5-day horizon",
      "rdfs:comment": "Share of resolved 5-day signals that ended in a win under a single labelling rule, with its sample size.",
      "bsim:entity": {
        "@id": "bsi:SignalOutcome"
      },
      "bsim:sql": "SELECT avg(CASE WHEN s.outcome = 'WIN' THEN 1.0 ELSE 0.0 END) AS win_rate,\n       count(*) AS n\nFROM signal_outcomes s\nWHERE s.horizon_days = 5\n  AND s.label_definition = 'path_barrier'\n  AND s.outcome IN ('WIN', 'LOSS')\n  AND s.signal_date <= :as_of",
      "bsim:params": "as_of",
      "bsim:grain": "market-wide, 5-day horizon",
      "bsim:cadence": "daily",
      "bsim:timing": "target",
      "bsim:derivation": "platform",
      "bsim:leakageRisk": "high",
      "bsim:gradedStatus": "live",
      "bsim:cheapToRun": {
        "@value": "true",
        "@type": "xsd:boolean"
      },
      "bsim:unit": "probability",
      "bsim:derivedFrom": {
        "@id": "bsis:signal_outcomes"
      },
      "bsim:caveat": [
        "LABEL-SHAPED. This measures the platform's own track record and is never a feature.",
        "`label_definition` is pinned to `path_barrier` deliberately: mixing it with `terminal_pct2` makes the rate meaningless.",
        "`PENDING` and `NEUTRAL` rows are excluded — the honest denominator, and it must be stated alongside any rate.",
        "No `signal_source` filter, so this blends technical and confluence signals."
      ],
      "skos:altLabel": [
        "win rate",
        "hit rate",
        "accuracy",
        "success rate"
      ]
    },
    {
      "@id": "bsim:usable_factor_readings_5d",
      "rdf:type": {
        "@id": "bsim:Metric"
      },
      "rdfs:label": "Usable factor readings at 5 days",
      "rdfs:comment": "How many graded factor readings at a 5-day horizon currently clear the power and independence guards.",
      "bsim:entity": {
        "@id": "bsi:EdgeReading"
      },
      "bsim:sql": "SELECT count(*) AS usable_readings, max(f.eff_dates) AS max_eff_dates\nFROM factor_edge_history f\nWHERE f.horizon_days = 5 AND f.verdict = 'USABLE' AND f.run_at <= :as_of",
      "bsim:params": "as_of",
      "bsim:grain": "per grading run, 5-day horizon",
      "bsim:cadence": "on_grading",
      "bsim:timing": "context",
      "bsim:derivation": "platform",
      "bsim:leakageRisk": "none",
      "bsim:gradedStatus": "live",
      "bsim:cheapToRun": {
        "@value": "true",
        "@type": "xsd:boolean"
      },
      "bsim:unit": "count",
      "bsim:derivedFrom": {
        "@id": "bsis:factor_edge_history"
      },
      "bsim:caveat": [
        "A reading is only readable alongside its `eff_dates`: overlapping forward windows inflate a correlation by roughly the horizon factor.",
        "`verdict` is matched exactly — the ledger stores `no edge` with a space and `n/a` alongside `USABLE` and `LOW-DATA`."
      ],
      "skos:altLabel": [
        "usable factors",
        "factor edge",
        "graded factors",
        "rank ic count"
      ]
    },
    {
      "@id": "bsim:unified_score_latest",
      "rdf:type": {
        "@id": "bsim:Metric"
      },
      "rdfs:label": "Unified score, latest served",
      "rdfs:comment": "The highest composite score served for a symbol at or before the as-of date, with its conviction bucket and timeframe.",
      "bsim:entity": {
        "@id": "bsi:Recommendation"
      },
      "bsim:sql": "SELECT u.unified_score, u.conviction_level, u.classification, u.timeframe\nFROM unified_recommendations u\nWHERE u.symbol = :symbol AND u.computed_at <= :as_of\nORDER BY u.unified_score DESC\nLIMIT 1",
      "bsim:params": "symbol, as_of",
      "bsim:grain": "(symbol, computed_at, timeframe)",
      "bsim:cadence": "daily",
      "bsim:timing": "coincident",
      "bsim:derivation": "platform",
      "bsim:leakageRisk": "none",
      "bsim:gradedStatus": "live",
      "bsim:cheapToRun": {
        "@value": "true",
        "@type": "xsd:boolean"
      },
      "bsim:unit": "score_0_100",
      "bsim:derivedFrom": {
        "@id": "bsis:unified_recommendations"
      },
      "bsim:caveat": [
        "`computed_at` is TEXT in this table — comparing it against a DATE elsewhere needs an explicit cast.",
        "The ranker's load-bearing input is the confluence engine, so a high unified score with a low engine-coverage count is weak evidence.",
        "Ordering by score across timeframes returns the best of INTRADAY / SWING / POSITIONAL / LONG_TERM rather than a comparable series — filter `timeframe` first when the horizon matters."
      ],
      "skos:altLabel": [
        "unified score",
        "composite score",
        "conviction",
        "top pick",
        "ranking"
      ]
    },
    {
      "@id": "bsim:confluence_score_latest",
      "rdf:type": {
        "@id": "bsim:Metric"
      },
      "rdfs:label": "Confluence score, latest",
      "rdfs:comment": "The most recent multi-engine agreement score with the number of screeners holding the name and the model probabilities behind it.",
      "bsim:entity": {
        "@id": "bsi:EngineScore"
      },
      "bsim:sql": "SELECT c.confluence_score, c.active_screener_count, c.conviction_level,\n       c.ml_breakout_probability, c.computed_at\nFROM confluence_signals c\nWHERE c.symbol = :symbol AND c.computed_at <= :as_of\nORDER BY c.computed_at DESC\nLIMIT 1",
      "bsim:params": "symbol, as_of",
      "bsim:grain": "(symbol, computed_at)",
      "bsim:cadence": "every_15m",
      "bsim:timing": "coincident",
      "bsim:derivation": "platform",
      "bsim:leakageRisk": "none",
      "bsim:gradedStatus": "measured",
      "bsim:cheapToRun": {
        "@value": "true",
        "@type": "xsd:boolean"
      },
      "bsim:unit": "score_0_100",
      "bsim:gradedEvidence": "The only engine score on this platform with a growing positive graded reading, which is why it carries the ranker.",
      "bsim:derivedFrom": {
        "@id": "bsis:confluence_signals"
      },
      "bsim:caveat": [
        "`computed_at` is native TIMESTAMPTZ here but TEXT on `unified_recommendations` — cast across that join.",
        "`ml_breakout_probability` is a model output and must not be used as a feature elsewhere."
      ],
      "skos:altLabel": [
        "confluence",
        "confluence score",
        "engine agreement"
      ]
    },
    {
      "@id": "bsim:index_pcr_latest",
      "rdf:type": {
        "@id": "bsim:Metric"
      },
      "rdfs:label": "Index put-call ratio, latest",
      "rdfs:comment": "The most recent index PCR reading with the index close at the same instant.",
      "bsim:entity": {
        "@id": "bsi:IndexDerivativesSnapshot"
      },
      "bsim:sql": "SELECT n.pcr, n.index_close, n.ts\nFROM nt_index_pcr_ts n\nWHERE n.index_name = 'NIFTY50' AND n.ts <= :as_of\nORDER BY n.ts DESC\nLIMIT 1",
      "bsim:params": "as_of",
      "bsim:grain": "(index, timestamp, expiry)",
      "bsim:cadence": "intraday",
      "bsim:timing": "leading",
      "bsim:derivation": "vendor",
      "bsim:leakageRisk": "none",
      "bsim:gradedStatus": "research-candidate",
      "bsim:cheapToRun": {
        "@value": "false",
        "@type": "xsd:boolean"
      },
      "bsim:unit": "ratio",
      "bsim:gradedEvidence": "Index positioning is classed as genuinely leading in the master report's taxonomy, but remains ungraded here (Experiment 6).",
      "bsim:derivedFrom": {
        "@id": "bsis:nt_index_pcr_ts"
      },
      "bsim:caveat": [
        "Pinned to NIFTY50 deliberately: the index name is a dimension this metric does not parameterise.",
        "Three PCR variants exist in the source table (OI, volume, OI change) and they measure different things.",
        "Leading is not the same as profitable — this is ungraded."
      ],
      "skos:altLabel": [
        "pcr",
        "put call ratio",
        "index pcr",
        "options positioning",
        "derivatives sentiment"
      ]
    },
    {
      "@id": "bsim:rollover_pct_latest",
      "rdf:type": {
        "@id": "bsim:Metric"
      },
      "rdfs:label": "Futures rollover, latest",
      "rdfs:comment": "The latest rollover percentage and annualised cost of carry for a stock's futures, with its total open interest.",
      "bsim:entity": {
        "@id": "bsi:FuturesPositioning"
      },
      "bsim:sql": "SELECT r.rollover_pct, r.cost_of_carry_ann, r.total_oi, r.date\nFROM fno_rollover r\nWHERE r.symbol = :symbol AND r.date <= :as_of\nORDER BY r.date DESC\nLIMIT 1",
      "bsim:params": "symbol, as_of",
      "bsim:grain": "(symbol, date)",
      "bsim:cadence": "daily",
      "bsim:timing": "leading",
      "bsim:derivation": "vendor",
      "bsim:leakageRisk": "none",
      "bsim:gradedStatus": "low-data",
      "bsim:cheapToRun": {
        "@value": "true",
        "@type": "xsd:boolean"
      },
      "bsim:unit": "percent",
      "bsim:gradedEvidence": "The stock-futures panel spans ~14 dates; the master report's verdict is LOW-DATA, so a reading from it is a calendar artefact.",
      "bsim:derivedFrom": {
        "@id": "bsis:fno_rollover"
      },
      "bsim:caveat": [
        "LOW-DATA panel: never treat a correlation computed on it as an edge.",
        "Rollover is only meaningful in the days before an expiry; outside that window the number is mostly noise."
      ],
      "skos:altLabel": [
        "rollover",
        "rollover percent",
        "futures rollover",
        "cost of carry",
        "open interest"
      ]
    },
    {
      "@id": "bsim:market_breadth_latest",
      "rdf:type": {
        "@id": "bsim:Metric"
      },
      "rdfs:label": "Market breadth, latest",
      "rdfs:comment": "Share of the universe above its 200-day average and the advance/decline ratio for the most recent session.",
      "bsim:entity": {
        "@id": "bsi:BreadthObservation"
      },
      "bsim:sql": "SELECT b.pct_above_200dma, b.adv_decline_ratio, b.date\nFROM market_breadth b\nWHERE b.date <= :as_of\nORDER BY b.date DESC\nLIMIT 1",
      "bsim:params": "as_of",
      "bsim:grain": "per session",
      "bsim:cadence": "daily",
      "bsim:timing": "context",
      "bsim:derivation": "platform",
      "bsim:leakageRisk": "none",
      "bsim:gradedStatus": "ungraded",
      "bsim:cheapToRun": {
        "@value": "true",
        "@type": "xsd:boolean"
      },
      "bsim:unit": "percent",
      "bsim:derivedFrom": {
        "@id": "bsis:market_breadth"
      },
      "bsim:caveat": [
        "Computed over this platform's own universe definition, so it is not comparable to a vendor's breadth series without re-basing.",
        "Classed as a FILTER on this platform, not as alpha."
      ],
      "skos:altLabel": [
        "breadth",
        "advance decline",
        "participation",
        "market internals"
      ]
    },
    {
      "@id": "bsim:current_regime",
      "rdf:type": {
        "@id": "bsim:Metric"
      },
      "rdfs:label": "Current market regime",
      "rdfs:comment": "The regime label and its posterior probability for the most recent session at or before the as-of date.",
      "bsim:entity": {
        "@id": "bsi:RegimeState"
      },
      "bsim:sql": "SELECT m.regime, m.regime_prob, m.date\nFROM market_regimes m\nWHERE m.date <= :as_of\nORDER BY m.date DESC\nLIMIT 1",
      "bsim:params": "as_of",
      "bsim:grain": "per session",
      "bsim:cadence": "daily",
      "bsim:timing": "context",
      "bsim:derivation": "platform",
      "bsim:leakageRisk": "none",
      "bsim:gradedStatus": "live",
      "bsim:cheapToRun": {
        "@value": "true",
        "@type": "xsd:boolean"
      },
      "bsim:derivedFrom": {
        "@id": "bsis:market_regimes"
      },
      "bsim:caveat": [
        "The regime is a WEIGHT GATE here, not a directional call: it re-blends engine weights, so reading it as a trade is a category error.",
        "`regime_prob` is an HMM posterior, not a calibrated probability of a market outcome."
      ],
      "skos:altLabel": [
        "regime",
        "market regime",
        "bull",
        "bear",
        "sideways",
        "volatility state"
      ]
    },
    {
      "@id": "bsim:asm_flag_latest",
      "rdf:type": {
        "@id": "bsim:Metric"
      },
      "rdfs:label": "Surveillance flag, latest",
      "rdfs:comment": "Whether the symbol is under exchange surveillance measures as of the most recent signal date.",
      "bsim:entity": {
        "@id": "bsi:TechnicalSignal"
      },
      "bsim:sql": "SELECT t.asm_flag, t.date AS as_of\nFROM technical_signals t\nWHERE t.symbol = :symbol AND t.date <= :as_of\nORDER BY t.date DESC\nLIMIT 1",
      "bsim:params": "symbol, as_of",
      "bsim:grain": "(symbol, date)",
      "bsim:cadence": "daily",
      "bsim:timing": "coincident",
      "bsim:derivation": "vendor",
      "bsim:leakageRisk": "none",
      "bsim:gradedStatus": "live",
      "bsim:cheapToRun": {
        "@value": "true",
        "@type": "xsd:boolean"
      },
      "bsim:derivedFrom": {
        "@id": "bsis:technical_signals"
      },
      "bsim:caveat": [
        "This is a TRADABILITY CONSTRAINT, not a signal: a name under surveillance can be untradeable in size regardless of how good the setup looks.",
        "It is stamped from a fetched list, so it lags the exchange's own announcement by however long the fetcher took."
      ],
      "skos:altLabel": [
        "asm",
        "gsm",
        "surveillance",
        "tradability",
        "ban"
      ]
    },
    {
      "@id": "bsim:analyst_consensus_latest",
      "rdf:type": {
        "@id": "bsim:Metric"
      },
      "rdfs:label": "Analyst consensus, latest",
      "rdfs:comment": "Mean analyst target, contributor count and consensus rating from the most recent snapshot at or before the as-of date.",
      "bsim:entity": {
        "@id": "bsi:AnalystEstimate"
      },
      "bsim:sql": "SELECT a.target_mean, a.n_analysts, a.final_rating, a.as_of_date\nFROM analyst_estimates_history a\nWHERE a.symbol = :symbol AND a.as_of_date <= :as_of\nORDER BY a.as_of_date DESC\nLIMIT 1",
      "bsim:params": "symbol, as_of",
      "bsim:grain": "(symbol, as_of_date)",
      "bsim:cadence": "vendor_periodic",
      "bsim:timing": "leading",
      "bsim:derivation": "vendor",
      "bsim:leakageRisk": "none",
      "bsim:gradedStatus": "ungraded",
      "bsim:cheapToRun": {
        "@value": "true",
        "@type": "xsd:boolean"
      },
      "bsim:unit": "per_share_INR",
      "bsim:gradedEvidence": "Genuinely leading in the taxonomy, but the revision trio derived from it is calendar-blocked to ~2026-10.",
      "bsim:derivedFrom": {
        "@id": "bsis:analyst_estimates_history"
      },
      "bsim:caveat": [
        "`target_mean` is a per-share price in INR, not a return — it must be divided by a price to become an upside percentage.",
        "Snapshots are as-of-stamped: re-fetching later can return a different history than the one that was knowable."
      ],
      "skos:altLabel": [
        "analyst",
        "consensus",
        "target price",
        "price target",
        "analyst rating",
        "estimates"
      ]
    },
    {
      "@id": "bsim:screener_5d_forward_return",
      "rdf:type": {
        "@id": "bsim:Metric"
      },
      "rdfs:label": "Screener 5-day forward return",
      "rdfs:comment": "Average 5-session forward return across the times this symbol was surfaced by a live screener, with the sample size.",
      "bsim:entity": {
        "@id": "bsi:ScreenerOutcome"
      },
      "bsim:sql": "SELECT avg(l.return_5d) AS avg_forward_5d, count(*) AS n\nFROM live_screener_outcomes l\nWHERE l.symbol = :symbol AND l.appeared_at <= :as_of AND l.return_5d IS NOT NULL",
      "bsim:params": "symbol, as_of",
      "bsim:grain": "(symbol, appearance)",
      "bsim:cadence": "every_15m",
      "bsim:timing": "target",
      "bsim:derivation": "platform",
      "bsim:leakageRisk": "high",
      "bsim:gradedStatus": "live",
      "bsim:cheapToRun": {
        "@value": "true",
        "@type": "xsd:boolean"
      },
      "bsim:unit": "percent",
      "bsim:derivedFrom": {
        "@id": "bsis:live_screener_outcomes"
      },
      "bsim:caveat": [
        "This is a LABEL aggregate, not a feature: it measures how the screener family performed historically for this symbol.",
        "NULL `return_5d` rows are excluded, so recent appearances do not drag the average toward zero — but they do make `n` smaller than the appearance count.",
        "Attribution belongs to whichever screeners surfaced the name; averaging across all of them mixes unrelated strategies."
      ],
      "skos:altLabel": [
        "screener performance",
        "screener forward return",
        "screener edge",
        "surfacing outcome"
      ]
    },
    {
      "@id": "bsim:news_sentiment_5d",
      "rdf:type": {
        "@id": "bsim:Metric"
      },
      "rdfs:label": "News sentiment, trailing 5 sessions",
      "rdfs:comment": "Mean scored sentiment across news items mentioning the symbol in the five sessions up to the as-of date, with the mention count.",
      "bsim:entity": {
        "@id": "bsi:NewsItem"
      },
      "bsim:sql": "SELECT avg(n.sentiment_score) AS avg_sentiment, count(*) AS mentions\nFROM news_symbol_link n\nWHERE n.symbol = :symbol AND n.published_at <= :as_of\n  AND n.published_at > ((:as_of)::date - 5)",
      "bsim:params": "symbol, as_of",
      "bsim:grain": "(symbol, trailing 5 sessions)",
      "bsim:cadence": "intraday",
      "bsim:timing": "leading",
      "bsim:derivation": "platform",
      "bsim:leakageRisk": "none",
      "bsim:gradedStatus": "measured",
      "bsim:cheapToRun": {
        "@value": "true",
        "@type": "xsd:boolean"
      },
      "bsim:unit": "score_minus1_1",
      "bsim:gradedEvidence": "News sentiment conditioning on movers measured a lift of ~0.13 (n=114, p=0.037) — a lead, not a result.",
      "bsim:derivedFrom": {
        "@id": "bsis:news_symbol_link"
      },
      "bsim:caveat": [
        "Counts MENTIONS, not articles: one widely covered item produces many rows and will dominate the average.",
        "`published_at` is the only knowable timestamp — filtering on the event date instead is a look-ahead bug.",
        "A mention is not a foreign key: this join must go through the link table, never through the JSON array on the news row.",
        "Scored sentiment comes from either the vendor or FinBERT depending on `ai_scored`; the two are not the same measurement."
      ],
      "skos:altLabel": [
        "news sentiment",
        "sentiment",
        "headline sentiment",
        "news flow",
        "news count"
      ]
    },
    {
      "@id": "bsim:excursion_path_5d",
      "rdf:type": {
        "@id": "bsim:Metric"
      },
      "rdfs:label": "Excursion path, 5-day horizon",
      "rdfs:comment": "Average maximum favourable and adverse excursion for resolved 5-day signals on a symbol, with the sample size.",
      "bsim:entity": {
        "@id": "bsi:SignalExcursion"
      },
      "bsim:sql": "SELECT avg(e.mfe_pct) AS avg_mfe, avg(e.mae_pct) AS avg_mae,\n       count(*) AS n\nFROM signal_excursions e\nWHERE e.symbol = :symbol AND e.horizon_days = 5 AND e.signal_date <= :as_of",
      "bsim:params": "symbol, as_of",
      "bsim:grain": "(symbol, signal_date, horizon)",
      "bsim:cadence": "daily",
      "bsim:timing": "target",
      "bsim:derivation": "platform",
      "bsim:leakageRisk": "high",
      "bsim:gradedStatus": "live",
      "bsim:cheapToRun": {
        "@value": "true",
        "@type": "xsd:boolean"
      },
      "bsim:unit": "percent",
      "bsim:derivedFrom": {
        "@id": "bsis:signal_excursions"
      },
      "bsim:caveat": [
        "LABEL-SHAPED. MFE/MAE describe what already happened; they are never inputs.",
        "The horizon is pinned to 5 sessions — a 1-day and a 20-day path are different distributions and must not be averaged together.",
        "Path statistics make stop placement answerable: the terminal return alone cannot say whether the trade was ever viable."
      ],
      "skos:altLabel": [
        "mfe",
        "mae",
        "excursion",
        "drawdown",
        "stop loss study",
        "favourable excursion"
      ]
    },
    {
      "@id": "bsiv:timeframe",
      "rdf:type": {
        "@id": "skos:ConceptScheme"
      },
      "rdfs:comment": "Trading horizon an engine or signal is expressed on. Uppercase in the canonical signal tables; `screener_master.inferred_timeframe` uses a lowercase subset — normalise before joining the two.",
      "bsiv:source": "unified_recommendations.timeframe",
      "bsiv:openEnded": {
        "@value": "false",
        "@type": "xsd:boolean"
      }
    },
    {
      "@id": "bsiv:timeframe.intraday",
      "rdf:type": {
        "@id": "skos:Concept"
      },
      "skos:inScheme": {
        "@id": "bsiv:timeframe"
      },
      "skos:notation": "INTRADAY",
      "skos:prefLabel": "Intraday",
      "skos:definition": "Entered and exited within one session."
    },
    {
      "@id": "bsiv:timeframe.swing",
      "rdf:type": {
        "@id": "skos:Concept"
      },
      "skos:inScheme": {
        "@id": "bsiv:timeframe"
      },
      "skos:notation": "SWING",
      "skos:prefLabel": "Swing",
      "skos:definition": "Sessions to a few weeks. The best-powered graded horizon is 5 days."
    },
    {
      "@id": "bsiv:timeframe.positional",
      "rdf:type": {
