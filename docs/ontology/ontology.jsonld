    {
      "@id": "bsis:market_endpoint_registry",
      "rdf:type": {
        "@id": "bsi:Table"
      },
      "rdfs:label": "Endpoint discovery registry",
      "rdfs:comment": "3,408 verified market-data endpoints with provider, domain, scope, update frequency, required params and the template to call each one.",
      "bsi:realizes": {
        "@id": "bsi:Endpoint"
      },
      "bsi:rowClass": {
        "@id": "bsit:market_endpoint_registry"
      },
