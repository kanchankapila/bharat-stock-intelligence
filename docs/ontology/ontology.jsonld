      },
      "bsi:isLabel": {
        "@value": "false",
        "@type": "xsd:boolean"
      },
      "bsi:pointInTimeNote": "CRORES as a bare number. Multiplying by 1e7 gives rupees, but nothing in the schema says so — the assumption must be stated by any consumer.",
