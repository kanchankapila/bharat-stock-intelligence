        "@id": "owl:DatatypeProperty"
      },
      "rdfs:label": "Check date",
      "rdfs:comment": "Session an outcome was resolved on; with `signal_date` it bounds the window.",
      "rdfs:range": {
        "@id": "xsd:date"
      },
      "bsi:semanticType": "timestamp",
      "bsi:timing": "context",
      "bsi:derivation": "raw",
      "bsi:leakageRisk": "high",
