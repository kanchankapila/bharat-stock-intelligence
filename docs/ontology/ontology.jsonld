        "@id": "owl:Class"
      },
      "rdfs:label": "Mutual-fund holding",
      "rdfs:comment": "Aggregate mutual-fund ownership of a symbol: holding percentage, fund count and the change versus the previous disclosure.",
      "bsi:layer": "observation",
      "bsi:realization": "table",
      "bsi:grain": "(symbol, disclosure date)",
      "rdfs:subClassOf": {
        "@id": "bsi:Observation"
      },
      "bsi:keyProperty": [
        {
          "@id": "bsip:symbol"
        },
        {
          "@id": "bsip:date"
        }
