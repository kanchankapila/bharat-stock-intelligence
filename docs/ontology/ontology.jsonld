        "@id": "bsi:Table"
      },
      "rdfs:label": "Engine composite scores",
      "rdfs:comment": "The blended multi-engine composite per symbol and date with its engine-coverage count.",
      "bsi:realizes": {
        "@id": "bsi:EngineScore"
      },
      "bsi:rowClass": {
        "@id": "bsit:engine_composite_scores"
      },
