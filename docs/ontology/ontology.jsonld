{
  "@context": {
    "bsi": "https://bharat-stock-intelligence.dev/ontology/market#",
    "bsip": "https://bharat-stock-intelligence.dev/ontology/property#",
    "bsir": "https://bharat-stock-intelligence.dev/ontology/relation#",
    "bsim": "https://bharat-stock-intelligence.dev/ontology/metric#",
    "bsiv": "https://bharat-stock-intelligence.dev/ontology/vocab#",
    "bsis": "https://bharat-stock-intelligence.dev/ontology/source#",
    "bsit": "https://bharat-stock-intelligence.dev/ontology/table#",
    "rdf": "http://www.w3.org/1999/02/22-rdf-syntax-ns#",
    "rdfs": "http://www.w3.org/2000/01/rdf-schema#",
    "owl": "http://www.w3.org/2002/07/owl#",
    "xsd": "http://www.w3.org/2001/XMLSchema#",
    "skos": "http://www.w3.org/2004/02/skos/core#",
    "prov": "http://www.w3.org/ns/prov#",
    "schema": "https://schema.org/",
    "sh": "http://www.w3.org/ns/shacl#",
    "dct": "http://purl.org/dc/terms/",
    "dcat": "http://www.w3.org/ns/dcat#",
    "qudt": "http://qudt.org/schema/qudt/",
    "unit": "http://qudt.org/vocab/unit/",
    "fibo-sec-eq-eq": "https://spec.edmcouncil.org/fibo/ontology/SEC/Equities/EquityInstruments/",
    "fibo-sec-sec-id": "https://spec.edmcouncil.org/fibo/ontology/SEC/Securities/SecuritiesIdentification/",
    "fibo-sec-sec-iss": "https://spec.edmcouncil.org/fibo/ontology/SEC/Securities/SecuritiesIssuance/",
    "fibo-sec-sec-lst": "https://spec.edmcouncil.org/fibo/ontology/SEC/Securities/SecuritiesListings/",
    "fibo-fbc-fi-fi": "https://spec.edmcouncil.org/fibo/ontology/FBC/FinancialInstruments/FinancialInstruments/",
    "fibo-fbc-fct-mkt": "https://spec.edmcouncil.org/fibo/ontology/FBC/FunctionalEntities/Markets/",
    "fibo-fnd-acc-cur": "https://spec.edmcouncil.org/fibo/ontology/FND/Accounting/CurrencyAmount/",
    "fibo-ind-mkt-bas": "https://spec.edmcouncil.org/fibo/ontology/IND/MarketIndices/BasketIndices/",
    "fibo-cae-ce-ca": "https://spec.edmcouncil.org/fibo/ontology/CAE/CorporateEvents/CorporateActions/",
    "fibo-der-der-futures": "https://spec.edmcouncil.org/fibo/ontology/DER/DerivativesContracts/FuturesAndForwards/",
    "cmns-id": "https://www.omg.org/spec/Commons/Identifiers/",
    "cmns-dt": "https://www.omg.org/spec/Commons/DatesAndTimes/",
    "cmns-qtu": "https://www.omg.org/spec/Commons/QuantitiesAndUnits/",
    "cmns-cds": "https://www.omg.org/spec/Commons/CodesAndCodeSets/",
    "@vocab": "https://bharat-stock-intelligence.dev/ontology/market#"
  },
  "@graph": [
    {
      "@id": "bsi:Ontology",
      "rdf:type": {
        "@id": "owl:Ontology"
      },
      "dct:title": "Bharat Stock Intelligence — market knowledge graph",
      "owl:versionInfo": "1.1.0",
      "dct:description": "A semantic layer over the bharat_intel Postgres database: entity types, properties with timing/leakage semantics, typed relations, executable metrics, controlled vocabularies and table-level data cards.",
      "dct:license": "Repository has no LICENSE file; the layer itself is published under the terms of that repository. Aligned external standards keep their own licenses — see standards.txt."
    },
    {
      "@id": "bsi:Guardrails",
      "rdf:type": {
        "@id": "bsi:GuardrailSet"
      },
      "rdfs:comment": "Rules that must travel with any prompt or feature set built from this ontology.",
      "bsi:rule": [
        "Columns with leakage_risk 'high' or 'target' are NEVER features. Columns whose semantic_type is 'label' ARE the target.",
        "`technical_signals`, `feature_store`, score-typed columns and the recommendation tables are platform OUTPUTS: a model may predict something else from them, but feeding an engine score back in as a feature leaks that engine into its own inputs.",
        "Point-in-time: entry is the NEXT session's open after `signal_date`. A feature must have been knowable before that open.",
        "Labels are not comparable across `label_definition` values (`path_barrier` vs `terminal_pct2`). Filter it before aggregating any accuracy number.",
        "`PENDING` outcome rows have not elapsed yet and are not negative examples.",
        "Mixing `adjustment_basis` values inside one price series invalidates every result derived from it.",
        "`screener_*` tables are vendor OPINIONS used to surface candidates. They are never ground truth, and their aggregate score no longer clears the USABLE bar.",
        "Read `eff_dates` before any rank-IC reading: overlapping forward windows inflate a correlation by roughly the horizon factor.",
        "Every historical read is an as-of read: a feature value must come from rows whose data was knowable at or before entry — never from today's state projected back.",
        "Nothing in this layer is investment advice or a solicitation to trade; it describes data semantics only, and any output built from it is not financial advice."
      ]
    },
    {
      "@id": "bsi:Instrument",
      "rdf:type": {
        "@id": "owl:Class"
      },
      "rdfs:label": "Instrument",
      "rdfs:comment": "Anything that is quoted and traded. The canonical instrument identity is table-backed in `market_instrument`; legacy observation tables still key on the exchange ticker.",
      "bsi:layer": "identity",
      "bsi:realization": "table",
      "bsi:grain": "instrument_key",
      "bsi:keyProperty": {
        "@id": "bsip:instrument_key"
      },
      "bsi:realizedBy": {
        "@id": "bsis:market_instrument"
      },
      "skos:closeMatch": {
        "@id": "fibo-fbc-fi-fi:FinancialInstrument"
      },
      "bsi:alignmentRationale": "[fibo-fbc-fi-fi:FinancialInstrument] FIBO's root of the instrument hierarchy. Our hierarchy is shallower: one class per physical table rather than per contractual concept.",
      "bsi:verifiedFrom": "https://github.com/edmcouncil/fibo (published prefix declarations) + FIBO IRI space under spec.edmcouncil.org; class symbols cross-checked against declared FIBO type stereotypes. Fetched 2026-09-21."
    },
    {
      "@id": "bsi:Issuer",
      "rdf:type": {
        "@id": "owl:Class"
      },
      "rdfs:label": "Issuer",
      "rdfs:comment": "The legal issuer behind one or more instruments. ISIN issuer-prefix keys are authoritative when a checksum-valid ISIN is available; symbol-only rows remain explicitly provisional.",
      "bsi:layer": "identity",
      "bsi:realization": "table",
      "bsi:grain": "issuer_key",
      "bsi:keyProperty": {
        "@id": "bsip:issuer_key"
      },
      "bsi:realizedBy": {
        "@id": "bsis:market_issuer"
      }
    },
    {
      "@id": "bsi:Listing",
      "rdf:type": {
        "@id": "owl:Class"
      },
      "rdfs:label": "Listing",
      "rdfs:comment": "One tradable exchange/segment/symbol representation of an instrument.",
      "bsi:layer": "identity",
      "bsi:realization": "table",
      "bsi:grain": "listing_key",
      "rdfs:subClassOf": {
        "@id": "bsi:Instrument"
      },
      "bsi:keyProperty": {
        "@id": "bsip:listing_key"
      },
      "bsi:realizedBy": {
        "@id": "bsis:market_listing"
      }
    },
    {
      "@id": "bsi:ProviderIdentifier",
      "rdf:type": {
        "@id": "owl:Class"
      },
      "rdfs:label": "Provider identifier",
      "rdfs:comment": "A provider-qualified identifier for an instrument. Provider and scheme are part of the identity; collisions are recorded rather than resolved by row order.",
      "bsi:layer": "identity",
      "bsi:realization": "table",
      "bsi:grain": "(provider, scheme, identifier_value)",
      "bsi:keyProperty": [
        {
          "@id": "bsip:provider"
        },
        {
          "@id": "bsip:scheme"
        },
        {
          "@id": "bsip:identifier_value"
        }
      ],
      "bsi:realizedBy": [
        {
          "@id": "bsis:market_identifier"
        },
        {
          "@id": "bsis:market_identifier_gap"
        }
      ]
    },
    {
      "@id": "bsi:Equity",
      "rdf:type": {
        "@id": "owl:Class"
      },
      "rdfs:label": "Equity",
      "rdfs:comment": "A listed equity, one row per exchange ticker. This is the platform's universal join key and the subject of every other class.",
      "bsi:layer": "identity",
      "bsi:realization": "table",
      "bsi:grain": "one row per exchange ticker in `stock_master`",
      "rdfs:subClassOf": {
        "@id": "bsi:Instrument"
      },
      "bsi:keyProperty": [
        {
          "@id": "bsip:symbol"
        },
        {
          "@id": "bsip:isin"
        }
      ],
      "bsi:caveat": [
        "Keyed on ticker, not ISIN: a company listed on both NSE and BSE is two rows here and one instrument in any ISIN-first model (see alignment.py).",
        "`stock_master.sector` was EMPTY for every row as of 2026-09-21; sector is populated downstream (technical_signals.sector, unified_recommendations.sector)."
      ],
      "bsi:realizedBy": [
        {
          "@id": "bsis:stock_master"
        },
        {
          "@id": "bsis:nse_stocks"
        }
      ],
      "skos:closeMatch": [
        {
          "@id": "fibo-sec-eq-eq:Equity"
        },
        {
          "@id": "fibo-sec-sec-lst:ListedSecurity"
        }
      ],
      "bsi:alignmentRationale": [
        "[fibo-sec-eq-eq:Equity] CAUTION — GRANULARITY MISMATCH, and the most useful finding of this alignment. FIBO separates Equity (instrument), Share (ownership unit) and Listing (admission to an exchange). `stock_master` is keyed on the exchange ticker (`symbol`), so our `Equity` is really a *Listing*: one row per (instrument, exchange). A mapping that ignores this duplicates a company listed on both NSE and BSE. FIBO's ISIN-first keying is why the platform's ISIN coverage is a prerequisite for any real instrument master.",
        "[fibo-sec-sec-lst:ListedSecurity] The closer of the two FIBO classes to what `stock_master` actually stores, because row identity is the exchange ticker, not the instrument."
      ],
      "bsi:verifiedFrom": [
        "https://github.com/edmcouncil/fibo (published prefix declarations) + FIBO IRI space under spec.edmcouncil.org; class symbols cross-checked against declared FIBO type stereotypes. Fetched 2026-09-21.",
        "https://github.com/edmcouncil/fibo (published prefix declarations) + FIBO IRI space under spec.edmcouncil.org; class symbols cross-checked against declared FIBO type stereotypes. Fetched 2026-09-21."
      ]
    },
    {
      "@id": "bsi:Index",
      "rdf:type": {
        "@id": "owl:Class"
      },
      "rdfs:label": "Index",
      "rdfs:comment": "A market index used as a benchmark or as a derivatives underlying (NIFTY 50, BANK NIFTY, SENSEX, INDIA VIX, GIFT NIFTY, ...).",
      "bsi:layer": "identity",
      "bsi:realization": "reference",
      "bsi:grain": "one row per index",
      "bsi:keyProperty": {
        "@id": "bsip:index_name"
      },
      "bsi:caveat": "A *reference* class: the index exists only as a column value on `nt_index_pcr_ts`, `index_ohlcv`, `nt_fno_expiry` and the option tables. `stock_master` carries no index master, so an index is whatever a fetcher wrote — normalise case before joining across tables.",
      "skos:closeMatch": {
        "@id": "fibo-ind-mkt-bas:MarketIndex"
      },
      "bsi:alignmentRationale": "[fibo-ind-mkt-bas:MarketIndex] NIFTY 50 / BANK NIFTY / SENSEX. `fibo-ind-mkt-bas` (BasketIndices) is confirmed as the right module for index concepts.",
      "bsi:verifiedFrom": "https://github.com/edmcouncil/fibo (published prefix declarations) + FIBO IRI space under spec.edmcouncil.org; class symbols cross-checked against declared FIBO type stereotypes. Fetched 2026-09-21."
    },
    {
      "@id": "bsi:Sector",
      "rdf:type": {
        "@id": "owl:Class"
      },
      "rdfs:label": "Sector",
      "rdfs:comment": "An industry grouping used for relative-strength and rotation analysis. Stored as free text across several tables rather than resolved to a scheme.",
      "bsi:layer": "identity",
      "bsi:realization": "reference",
      "bsi:grain": "one row per label, no canonical table",
      "bsi:keyProperty": {
        "@id": "bsip:sector"
      },
      "bsi:caveat": "A *reference* class with no master table: the label comes from whichever fetcher wrote the row (`technical_signals.sector`, `unified_recommendations.sector`), so cross-table sector joins can silently lose or double-count names. Resolve to a spelling before aggregating."
    },
    {
      "@id": "bsi:Exchange",
      "rdf:type": {
        "@id": "owl:Class"
      },
      "rdfs:label": "Exchange",
      "rdfs:comment": "The venue an instrument is admitted to. A two-value dimension (NSE / BSE): usually encoded inside `symbol`, but carried as its own column in seven tables (nse_stocks, market_holidays, nt_fno_expiry, stock_earnings_dates, institutional_deal_signals, mc_advance_decline, mc_chart_patterns).",
      "bsi:layer": "identity",
      "bsi:realization": "reference",
      "bsi:grain": "dimension",
      "bsi:keyProperty": {
        "@id": "bsip:exchange"
      },
      "bsi:caveat": "A *reference* class: it has no card because no single table is the exchange. `nse_stocks.exchange` is the canonical column and the other six are pass-through copies written by different fetchers.",
      "skos:closeMatch": {
        "@id": "fibo-fbc-fct-mkt:Exchange"
      },
      "bsi:alignmentRationale": "[fibo-fbc-fct-mkt:Exchange] NSE / BSE. FIBO's Exchange is a market operator; ours is a two-value dimension column, so the alignment is nominal.",
      "bsi:verifiedFrom": "https://github.com/edmcouncil/fibo (published prefix declarations) + FIBO IRI space under spec.edmcouncil.org; class symbols cross-checked against declared FIBO type stereotypes. Fetched 2026-09-21."
    },
    {
      "@id": "bsi:ScripCodeMapping",
      "rdf:type": {
        "@id": "owl:Class"
      },
      "rdfs:label": "Vendor scrip-code mapping",
      "rdfs:comment": "The vendor's private scid mapped onto the platform symbol and issuer name — the only sanctioned route from one to the other.",
      "bsi:layer": "identity",
      "bsi:realization": "table",
      "bsi:grain": "(scid, symbol)",
      "bsi:keyProperty": [
        {
          "@id": "bsip:scid"
        },
        {
          "@id": "bsip:symbol"
        }
      ],
      "bsi:caveat": "Not enforced as unique: after a vendor scrip merge, one symbol can appear under more than one scid, so a symbol->scid join can fan out.",
      "bsi:realizedBy": {
        "@id": "bsis:mc_scid_map"
      }
    },
    {
      "@id": "bsi:CompanyProfile",
      "rdf:type": {
        "@id": "owl:Class"
      },
      "rdfs:label": "CompanyProfile",
      "rdfs:comment": "Narrative and high-level attributes about the issuer behind a ticker.",
      "bsi:layer": "identity",
      "bsi:realization": "table",
      "bsi:grain": "one row per symbol",
      "rdfs:subClassOf": {
        "@id": "bsi:Instrument"
      },
      "bsi:keyProperty": {
        "@id": "bsip:symbol"
      },
      "bsi:caveat": "Description text is vendor-authored and free-form; `growth_score` and `ai_analysis` are derived, not observed.",
      "bsi:realizedBy": {
        "@id": "bsis:company_profiles"
      },
      "skos:closeMatch": {
        "@id": "fibo-fbc-fi-fi:Issuer"
      },
      "bsi:alignmentRationale": "[fibo-fbc-fi-fi:Issuer] The legal person behind the listing. Our description is free text; FIBO would carry structured legal-entity attributes.",
      "bsi:verifiedFrom": "https://github.com/edmcouncil/fibo (published prefix declarations) + FIBO IRI space under spec.edmcouncil.org; class symbols cross-checked against declared FIBO type stereotypes. Fetched 2026-09-21."
    },
    {
      "@id": "bsi:Observation",
      "rdf:type": {
        "@id": "owl:Class"
      },
      "rdfs:label": "Observation",
      "rdfs:comment": "Abstract parent for anything measured at a point in time without the platform adding an opinion to it. Raw or vendor-supplied; never a label.",
      "bsi:layer": "observation",
      "bsi:realization": "abstract",
      "bsi:keyProperty": {
        "@id": "bsip:symbol"
      }
    },
    {
      "@id": "bsi:Bar",
      "rdf:type": {
        "@id": "owl:Class"
      },
      "rdfs:label": "Daily bar",
      "rdfs:comment": "One daily OHLCV bar per symbol per trading session — the platform's only self-owned source of truth.",
      "bsi:layer": "observation",
      "bsi:realization": "table",
      "bsi:grain": "(symbol, date)",
      "rdfs:subClassOf": {
        "@id": "bsi:Observation"
      },
      "bsi:keyProperty": [
        {
          "@id": "bsip:symbol"
        },
        {
          "@id": "bsip:date"
        }
      ],
      "bsi:caveat": [
        "Price basis is recorded per row in `adjustment_basis` (nse_bhavcopy_raw | split_only | split_dividend). Mixing bases inside one series corrupts any backtest silently — this is a documented recurring bug class in this repo.",
        "Quarantined bars are flagged, not deleted: filter `is_suspect = 0` before building a training panel. `suspect_reason` names the cause."
      ],
      "bsi:realizedBy": {
        "@id": "bsis:stock_ohlcv"
      }
    },
    {
      "@id": "bsi:IntradayBar",
      "rdf:type": {
        "@id": "owl:Class"
      },
      "rdfs:label": "Intraday bar",
      "rdfs:comment": "Sub-daily OHLCV with VWAP. Currently a single interval (15m) of recent history.",
      "bsi:layer": "observation",
      "bsi:realization": "table",
      "bsi:grain": "(symbol, datetime, series)",
      "rdfs:subClassOf": {
        "@id": "bsi:Observation"
      },
      "bsi:keyProperty": [
        {
          "@id": "bsip:symbol"
        },
        {
          "@id": "bsip:datetime"
        },
        {
          "@id": "bsip:series"
        }
      ],
      "bsi:caveat": [
        "Shallow history relative to the daily panel; not a substitute for `stock_ohlcv` in any long-horizon study.",
        "The key's `series` property is the bar interval (`15m`), NOT an NSE series symbol — the same `series` property is overloaded across the schema (see its bindings), so a join must qualify the table too.",
        "3.88M rows are stored in a single `datetime` column that mixes the exchange date and the clock time; it is a TIMESTAMP, not a trading-date column, so it does not join to `stock_ohlcv.date` without a cast."
      ],
      "bsi:realizedBy": {
        "@id": "bsis:intraday_ohlcv"
      }
    },
    {
      "@id": "bsi:DeliveryObservation",
      "rdf:type": {
        "@id": "owl:Class"
      },
      "rdfs:label": "Delivery observation",
      "rdfs:comment": "The deliverable-to-traded quantity ratio — the highest-frequency ownership-behaviour proxy the platform owns, and a T+1 lag by construction.",
      "bsi:layer": "observation",
      "bsi:realization": "table",
      "bsi:grain": "(symbol, date)",
      "rdfs:subClassOf": {
        "@id": "bsi:Observation"
      },
      "bsi:keyProperty": [
        {
          "@id": "bsip:symbol"
        },
        {
          "@id": "bsip:date"
        }
      ],
      "bsi:caveat": "Two writers exist (`stock_delivery_data`, `stock_delivery_volume`) with different column names and different series coverage — check which one a study used.",
      "bsi:realizedBy": [
        {
          "@id": "bsis:stock_delivery_data"
        },
        {
          "@id": "bsis:stock_delivery_volume"
        }
      ]
    },
    {
      "@id": "bsi:CorporateAction",
      "rdf:type": {
        "@id": "owl:Class"
      },
      "rdfs:label": "Corporate action",
      "rdfs:comment": "A capital-structure event with a price consequence (dividend, split, bonus, rights) plus the record/ex dates that make it usable point-in-time.",
      "bsi:layer": "observation",
      "bsi:realization": "table",
      "bsi:grain": "(symbol, ex_date, action_type)",
      "rdfs:subClassOf": {
        "@id": "bsi:Observation"
      },
      "bsi:keyProperty": [
        {
          "@id": "bsip:symbol"
        },
        {
          "@id": "bsip:ex_date"
        },
        {
          "@id": "bsip:action_type"
        }
      ],
      "bsi:caveat": "The same table also carries `Quarterly Results` rows, which are not capital actions at all — filter `action_type` before computing an adjustment factor.",
      "bsi:realizedBy": {
        "@id": "bsis:corporate_actions"
      },
      "skos:closeMatch": {
        "@id": "fibo-cae-ce-ca:CorporateAction"
      },
      "bsi:alignmentRationale": "[fibo-cae-ce-ca:CorporateAction] Our `action_type` is a flat vocabulary (DIVIDEND, SPLIT, BONUS, ...). FIBO expresses the same distinctions as an explicit subclass hierarchy with mandatory dates and ratios — adequate for price adjustment, insufficient for contractual reporting.",
      "bsi:verifiedFrom": "https://github.com/edmcouncil/fibo (published prefix declarations) + FIBO IRI space under spec.edmcouncil.org; class symbols cross-checked against declared FIBO type stereotypes. Fetched 2026-09-21."
    },
    {
      "@id": "bsi:FundamentalSnapshot",
      "rdf:type": {
        "@id": "owl:Class"
      },
      "rdfs:label": "Fundamental snapshot",
      "rdfs:comment": "Vendor-supplied accounting ratios and market-cap for a symbol, captured with an as-of date. Lagging information: the publication delay is the point-in-time risk.",
      "bsi:layer": "observation",
      "bsi:realization": "table",
      "bsi:grain": "(symbol, as_of_date)",
      "rdfs:subClassOf": {
        "@id": "bsi:Observation"
      },
      "bsi:keyProperty": [
        {
          "@id": "bsip:symbol"
        },
        {
          "@id": "bsip:as_of_date"
        }
      ],
      "bsi:caveat": "Vendor restatements make re-fetched history differ from what was known at the time; only the as-of-captured row is point-in-time honest.",
      "bsi:realizedBy": {
        "@id": "bsis:fundamentals_history"
      }
    },
    {
      "@id": "bsi:AnalystEstimate",
      "rdf:type": {
        "@id": "owl:Class"
      },
      "rdfs:label": "Analyst estimate",
      "rdfs:comment": "Consensus ratings, target prices and next-period estimates captured as a dated snapshot. Genuinely leading information; short panel relative to the news table.",
      "bsi:layer": "observation",
      "bsi:realization": "table",
      "bsi:grain": "(symbol, as_of_date)",
      "rdfs:subClassOf": {
        "@id": "bsi:Observation"
      },
      "bsi:keyProperty": [
        {
          "@id": "bsip:symbol"
        },
        {
          "@id": "bsip:as_of_date"
        }
      ],
      "bsi:caveat": "The revision trio (eps/target revision, analyst-count change) is carried downstream into `technical_signals` and is not yet graded.",
      "bsi:realizedBy": {
        "@id": "bsis:analyst_estimates_history"
      }
    },
    {
      "@id": "bsi:EarningsSurprise",
      "rdf:type": {
        "@id": "owl:Class"
      },
      "rdfs:label": "Earnings surprise",
      "rdfs:comment": "Actual versus estimated net profit and revenue for a quarter, with the surprise computed per line. Coincident for the print, leading for the drift after it.",
      "bsi:layer": "observation",
      "bsi:realization": "table",
      "bsi:grain": "(symbol, quarter)",
      "rdfs:subClassOf": {
        "@id": "bsi:Observation"
      },
      "bsi:keyProperty": [
        {
          "@id": "bsip:symbol"
        },
        {
          "@id": "bsip:series"
        }
      ],
      "bsi:caveat": [
        "Keyed by vendor `scid` in the source table while every other table keys on `symbol` — the join runs through `mc_scid_map`.",
        "The `quarter` column is MISNAMED: it holds a result DATE rendered as free text (`'May 30, 2026'`), not a fiscal-quarter label, so it will not sort lexicographically and will not parse as an ISO date. Cast at read time.",
        "`scid` is stored as TEXT, so the symbol join is a string match, not a numeric one."
      ],
      "bsi:realizedBy": {
        "@id": "bsis:eps_surprise_history"
      }
    },
    {
      "@id": "bsi:InsiderTransaction",
      "rdf:type": {
        "@id": "owl:Class"
      },
      "rdfs:label": "Insider transaction",
      "rdfs:comment": "A promoter/insider buy or sell filing. Leading in principle; graded weak as a standalone signal on this platform and kept as a confluence input.",
      "bsi:layer": "observation",
      "bsi:realization": "table",
      "bsi:grain": "(symbol, date, acquirer, transaction)",
      "rdfs:subClassOf": {
        "@id": "bsi:Observation"
      },
      "bsi:keyProperty": [
        {
          "@id": "bsip:symbol"
        },
        {
          "@id": "bsip:date"
        },
        {
          "@id": "bsip:company_name"
        },
        {
          "@id": "bsip:trade_type"
        }
      ],
      "bsi:caveat": [
        "Filed with a lag; treat the filing date as the earliest knowable time, not the trade date.",
        "`acquirerName` is vendor free text, NOT a foreign key to `stock_master` — it cannot be joined to a symbol and must be matched by name at best.",
        "`valueInr` is rupees as a bare number with no currency or unit column, unlike `block_deals.value_cr` which is crores. Same semantic field, two different multipliers; do not union them without normalising."
      ],
      "bsi:realizedBy": {
        "@id": "bsis:insider_trades"
      },
      "bsi:noExternalCounterpart": "unconfirmed: Insider/regulatory transaction reporting is outside FIBO's confirmed scope; a regulatory-reporting vocabulary would be the better target."
    },
    {
      "@id": "bsi:BlockDeal",
      "rdf:type": {
        "@id": "owl:Class"
      },
      "rdfs:label": "Block / bulk deal",
      "rdfs:comment": "An off-book or bulk transaction with quantity, price and value. Value is stored in CRORES as a bare number, with no currency or unit term attached.",
      "bsi:layer": "observation",
      "bsi:realization": "table",
      "bsi:grain": "(symbol, date, deal)",
      "rdfs:subClassOf": {
        "@id": "bsi:Observation"
      },
      "bsi:keyProperty": [
        {
          "@id": "bsip:symbol"
        },
        {
          "@id": "bsip:date"
        },
        {
          "@id": "bsip:id"
        }
      ],
      "bsi:caveat": "`trade_type` is stored in mixed case by different fetchers — normalise with UPPER() before aggregating buys and sells.",
      "bsi:realizedBy": {
        "@id": "bsis:block_deals"
      },
      "bsi:noExternalCounterpart": "unconfirmed: Securities transactions may exist in a FIBO module not checked this session. Left unaligned rather than asserted from memory."
    },
    {
      "@id": "bsi:MFHolding",
