      "bsi:primaryKey": "job_name",
      "bsi:freshnessColumn": "last_success_at",
      "bsi:writtenBy": [
        "jobHeartbeat.ts",
        "pythonRunner.ts"
      ],
      "bsi:caveat": [
        "`last_run_at` is the last ATTEMPT and `last_success_at` the last SUCCESS — a job can run nightly, fail nightly, and still look alive by the first column. Judge freshness on the second.",
        "Operational metadata: useful for lineage, never a model feature."
      ],
      "bsi:hasColumn": [
        {
          "@id": "_:col_job_heartbeat_job_name"
        },
        {
          "@id": "_:col_job_heartbeat_last_status"
        },
        {
          "@id": "_:col_job_heartbeat_last_run_at"
        },
        {
          "@id": "_:col_job_heartbeat_last_success_at"
        },
        {
          "@id": "_:col_job_heartbeat_last_error"
        },
        {
          "@id": "_:col_job_heartbeat_run_count"
        },
        {
          "@id": "_:col_job_heartbeat_fail_count"
        }
      ]
    },
