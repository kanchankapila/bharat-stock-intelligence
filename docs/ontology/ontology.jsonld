      "bsi:usableAsFeature": {
        "@value": "false",
        "@type": "xsd:boolean"
      },
      "bsi:isLabel": {
        "@value": "false",
        "@type": "xsd:boolean"
      },
      "qudt:unit": "calendar_day",
      "bsi:pointInTimeNote": "Entry is taken at the NEXT session's open. A feature dated on `signal_date` must have been knowable before that open.",
      "bsi:boundTo": [
        {
          "@id": "bsis:signal_outcomes.signal_date"
        },
        {
          "@id": "bsis:unified_signal_outcomes.signal_date"
