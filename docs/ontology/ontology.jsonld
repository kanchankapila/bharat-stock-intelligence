        },
        {
          "@id": "bsis:nt_index_pcr_ts"
        }
      ]
    },
    {
      "@id": "bsi:MoverSnapshot",
      "rdf:type": {
        "@id": "owl:Class"
      },
      "rdfs:label": "Mover snapshot",
      "rdfs:comment": "A ranked intraday mover list entry from a vendor feed: the platform's within-day event backbone alongside the event triggers.",
      "bsi:layer": "observation",
      "bsi:realization": "table",
      "bsi:grain": "(source, trade_date, symbol, rank)",
      "rdfs:subClassOf": {
