      "bsi:property": {
        "@id": "bsip:id"
      },
      "bsi:semanticType": "identifier",
      "bsi:leakageRisk": "none",
      "bsi:note": "FK to the screener run."
    },
    {
      "@id": "_:col_live_screener_appearances_symbol",
      "bsi:columnName": "symbol",
      "bsi:property": {
        "@id": "bsip:symbol"
      },
      "bsi:semanticType": "identifier",
      "bsi:leakageRisk": "none"
    },
    {
