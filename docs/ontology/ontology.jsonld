      "bsi:leakageRisk": "none"
    },
    {
      "@id": "bsis:live_screener_outcomes",
      "rdf:type": {
        "@id": "bsi:Table"
      },
      "rdfs:label": "Live screener outcomes",
      "rdfs:comment": "Forward returns attached to each appearance at surfacing time: the platform's largest pre-labelled dataset.",
      "bsi:realizes": {
        "@id": "bsi:ScreenerOutcome"
      },
      "bsi:rowClass": {
        "@id": "bsit:live_screener_outcomes"
      },
      "bsi:grain": "(appearance_id, symbol)",
      "bsi:cadence": "every_15m",
      "bsi:trainingUse": "labels",
      "bsi:primaryKey": [
        "appearance_id",
        "symbol"
      ],
      "bsi:freshnessColumn": "appeared_at",
      "bsi:writtenBy": "live_screener_ml_ranker.py",
      "bsi:forbiddenColumn": [
        "return_1d",
        "return_3d",
        "return_5d",
        "entry_price"
      ],
      "bsi:caveat": [
        "LABELS ONLY — three horizons share one return property, distinguished by the column name; never average them together.",
        "The label is a forward return from the SURFACING price, so any attribution belongs to the screener that surfaced it, not to an engine that agreed.",
        "Coverage is per-appearance and pre-computed, which is why the 3d/5d columns are NULL for recent rows — those are not losses."
      ],
      "bsi:hasColumn": [
        {
          "@id": "_:col_live_screener_outcomes_appearance_id"
        },
        {
          "@id": "_:col_live_screener_outcomes_symbol"
        },
        {
          "@id": "_:col_live_screener_outcomes_entry_price"
        },
        {
          "@id": "_:col_live_screener_outcomes_return_1d"
        },
        {
          "@id": "_:col_live_screener_outcomes_return_3d"
        },
        {
          "@id": "_:col_live_screener_outcomes_return_5d"
        },
        {
          "@id": "_:col_live_screener_outcomes_appeared_at"
        }
      ]
    },
    {
      "@id": "bsit:live_screener_outcomes",
      "rdf:type": {
        "@id": "owl:Class"
