    {
      "@id": "bsis:factor_edge_history",
      "rdf:type": {
        "@id": "bsi:Table"
      },
      "rdfs:label": "Factor edge ledger",
      "rdfs:comment": "The platform's own measurement ledger: rank-IC and hit-AUC per factor, regime and horizon, with the independent-observation count and a verdict.",
      "bsi:realizes": {
        "@id": "bsi:EdgeReading"
      },
      "bsi:rowClass": {
        "@id": "bsit:factor_edge_history"
      },
      "bsi:grain": "(run_at, table_name, score_col, horizon_days)",
      "bsi:cadence": "on_grading",
      "bsi:trainingUse": "forbidden",
      "bsi:primaryKey": [
        "run_at",
        "table_name",
        "score_col",
        "horizon_days"
      ],
      "bsi:freshnessColumn": "run_at",
      "bsi:writtenBy": "factor_edge.py",
      "bsi:caveat": [
        "READ `eff_dates` BEFORE the reading. Overlapping forward windows inflate a correlation by roughly the horizon factor, and effective dates are the guard that exposes it.",
        "`verdict` values include the literal string `no edge` with a space, and `n/a` — match them exactly.",
        "`table_name` and `score_col` reuse the generic source/name properties: this row is describing a COLUMN, not a table."
      ],
      "bsi:hasColumn": [
        {
          "@id": "_:col_factor_edge_history_run_at"
        },
        {
          "@id": "_:col_factor_edge_history_table_name"
        },
        {
          "@id": "_:col_factor_edge_history_score_col"
        },
        {
          "@id": "_:col_factor_edge_history_horizon_days"
        },
        {
          "@id": "_:col_factor_edge_history_rank_ic"
        },
        {
          "@id": "_:col_factor_edge_history_hit_auc"
        },
        {
          "@id": "_:col_factor_edge_history_eff_dates"
        },
        {
          "@id": "_:col_factor_edge_history_verdict"
        }
      ]
    },
