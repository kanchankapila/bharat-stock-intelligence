    {
      "@id": "bsis:stock_ohlcv",
      "rdf:type": {
        "@id": "bsi:Table"
      },
      "rdfs:label": "Daily OHLCV bars",
      "rdfs:comment": "One daily OHLCV bar per symbol per session. The platform's only self-owned source of truth and the basis of every return calculation.",
      "bsi:realizes": {
        "@id": "bsi:Bar"
      },
      "bsi:rowClass": {
        "@id": "bsit:stock_ohlcv"
      },
      "bsi:grain": "(symbol, date)",
      "bsi:cadence": "per_session",
      "bsi:trainingUse": "caution",
      "bsi:primaryKey": [
        "symbol",
        "date"
      ],
      "bsi:freshnessColumn": "date",
      "bsi:expectedLagHours": {
        "@value": "5.0",
        "@type": "xsd:decimal"
      },
      "bsi:writtenBy": [
        "nse_bhavcopy_fetcher.py",
        "bse_bhavcopy_fetcher.py"
      ],
      "bsi:forbiddenColumn": "is_suspect",
      "bsi:caveat": [
        "Price basis is per ROW, in `adjustment_basis` (nse_bhavcopy_raw / split_only / split_dividend). Mixing bases inside one series corrupts a backtest silently.",
        "Suspect bars are flagged, not deleted: filter `is_suspect = 0` before building a panel, and read `suspect_reason` rather than imputing."
      ],
      "bsi:hasColumn": [
        {
          "@id": "_:col_stock_ohlcv_symbol"
        },
        {
          "@id": "_:col_stock_ohlcv_date"
        },
        {
          "@id": "_:col_stock_ohlcv_open"
        },
        {
          "@id": "_:col_stock_ohlcv_high"
