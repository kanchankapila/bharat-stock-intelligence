    {
      "@id": "bsip:signal_date",
      "rdf:type": {
        "@id": "owl:DatatypeProperty"
      },
      "rdfs:label": "Signal date",
      "rdfs:comment": "Session a signal was generated for. Entry happens at the NEXT session's open — the most common off-by-one in this repo.",
      "rdfs:range": {
        "@id": "xsd:date"
      },
      "bsi:semanticType": "timestamp",
      "bsi:timing": "context",
      "bsi:derivation": "raw",
