      }
    },
    {
      "@id": "bsi:RegimeState",
      "rdf:type": {
        "@id": "owl:Class"
      },
      "rdfs:label": "Regime state",
      "rdfs:comment": "The macro regime for a session, with its posterior probability and the decoded HMM path. Also covers the intraday regime panel.",
      "bsi:layer": "context",
      "bsi:realization": "table",
      "bsi:grain": "one row per date",
      "bsi:keyProperty": {
        "@id": "bsip:date"
      },
      "bsi:caveat": "This is a weight GATE on this platform — it re-blends engine weights — not a directional signal. Treating a regime label as alpha inverts its role.",
      "bsi:realizedBy": [
