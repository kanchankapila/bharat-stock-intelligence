        "symbol",
        "timeframe"
      ],
      "bsi:freshnessColumn": "last_updated",
      "bsi:writtenBy": "scoring_engine.py",
      "bsi:forbiddenColumn": "confidence",
      "bsi:caveat": [
        "Several rows per symbol — one per domain — so an ungrouped join multiplies the parent row count.",
        "`confidence` is a derived confidence value, not a calibrated probability, and not an input."
      ],
      "bsi:hasColumn": [
