@prefix bsi: <https://bharat-stock-intelligence.dev/ontology/market#> .
@prefix bsip: <https://bharat-stock-intelligence.dev/ontology/property#> .
@prefix bsiv: <https://bharat-stock-intelligence.dev/ontology/vocab#> .
@prefix bsis: <https://bharat-stock-intelligence.dev/ontology/source#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .

bsi:InstrumentShape     rdf:type sh:NodeShape ;
    sh:targetClass bsi:Instrument ;
    sh:name "Instrument" ;
    sh:description "Anything that is quoted and traded. The canonical instrument identity is table-backed in `market_instrument`; legacy observation tables still key on the exchange ticker." ;
    bsi:grain "instrument_key" ;
    sh:property _:Instrument_id_prop, _:Instrument_instrument_key_prop, _:Instrument_name_prop, _:Instrument_instrument_type_prop, _:Instrument_isin_prop, _:Instrument_identity_basis_prop, _:Instrument_confidence_prop, _:Instrument_attributes_prop, _:Instrument_valid_from_prop, _:Instrument_valid_to_prop, _:Instrument_available_at_prop, _:Instrument_recorded_at_prop, _:Instrument_source_prop, _:Instrument_source_ref_prop .

_:Instrument_id_prop     sh:path bsip:id ;
    sh:name "Row id" ;
    sh:description "Surrogate key that is NOT stable across a re-fetch or backfill. Never join on this across runs — use the table's natural key." ;
    sh:datatype xsd:string ;
    sh:order "1"^^xsd:integer .

_:Instrument_instrument_key_prop     sh:path bsip:instrument_key ;
    sh:name "Instrument key" ;
    sh:description "Stable internal instrument key, normally derived from the full ISIN rather than a ticker." ;
    sh:datatype xsd:string ;
    sh:order "2"^^xsd:integer ;
    sh:minCount "1"^^xsd:integer .

_:Instrument_name_prop     sh:path bsip:name ;
    sh:name "Name" ;
    sh:description "Display name of the entity (screener name, index name, ...)." ;
    sh:datatype xsd:string ;
    sh:order "3"^^xsd:integer .

_:Instrument_instrument_type_prop     sh:path bsip:instrument_type ;
    sh:name "Instrument type" ;
    sh:description "Kind of instrument represented by the canonical identity row." ;
    sh:datatype xsd:string ;
    sh:order "4"^^xsd:integer .

_:Instrument_isin_prop     sh:path bsip:isin ;
    sh:name "ISIN" ;
    sh:description "ISO 6166 identifier. The only globally-unique key here; coverage is partial, which makes an ISIN-first instrument master a project, not a rename." ;
    sh:datatype xsd:string ;
    sh:order "5"^^xsd:integer .

_:Instrument_identity_basis_prop     sh:path bsip:identity_basis ;
    sh:name "Identity basis" ;
    sh:description "Evidence used to construct an issuer or instrument identity." ;
    sh:datatype xsd:string ;
    sh:order "6"^^xsd:integer .

_:Instrument_confidence_prop     sh:path bsip:confidence ;
    sh:name "Identity or evidence confidence" ;
    sh:description "Explicit confidence assigned to identity or evidence metadata." ;
    sh:datatype xsd:decimal ;
    sh:order "7"^^xsd:integer ;
    bsi:unit "probability" .

_:Instrument_attributes_prop     sh:path bsip:attributes ;
    sh:name "Semantic attributes" ;
    sh:description "Structured attributes attached to a canonical identity or graph node." ;
    sh:datatype rdf:JSON ;
    sh:order "8"^^xsd:integer .

_:Instrument_valid_from_prop     sh:path bsip:valid_from ;
    sh:name "Valid from" ;
    sh:description "Start of the interval in which an assertion is valid." ;
    sh:datatype xsd:dateTime ;
    sh:order "9"^^xsd:integer .

_:Instrument_valid_to_prop     sh:path bsip:valid_to ;
    sh:name "Valid to" ;
    sh:description "End of the interval in which an assertion is valid." ;
    sh:datatype xsd:dateTime ;
    sh:order "10"^^xsd:integer .

_:Instrument_available_at_prop     sh:path bsip:available_at ;
    sh:name "Available at" ;
    sh:description "Earliest time the platform could know the assertion." ;
    sh:datatype xsd:dateTime ;
    sh:order "11"^^xsd:integer .

_:Instrument_recorded_at_prop     sh:path bsip:recorded_at ;
    sh:name "Recorded at" ;
    sh:description "Time the platform recorded the assertion." ;
    sh:datatype xsd:dateTime ;
    sh:order "12"^^xsd:integer .

_:Instrument_source_prop     sh:path bsip:source ;
    sh:name "Source" ;
    sh:description "Which provider or fetcher wrote the row. Provenance is per-row on this platform, so this is the first column to check before trusting a value." ;
    sh:datatype xsd:string ;
    sh:order "13"^^xsd:integer .

_:Instrument_source_ref_prop     sh:path bsip:source_ref ;
    sh:name "Source reference" ;
    sh:description "Provider or source-row reference for a semantic assertion." ;
    sh:datatype xsd:string ;
    sh:order "14"^^xsd:integer .

bsi:IssuerShape     rdf:type sh:NodeShape ;
    sh:targetClass bsi:Issuer ;
    sh:name "Issuer" ;
    sh:description "The legal issuer behind one or more instruments. ISIN issuer-prefix keys are authoritative when a checksum-valid ISIN is available; symbol-only rows remain explicitly provisional." ;
    bsi:grain "issuer_key" ;
    sh:property _:Issuer_id_prop, _:Issuer_issuer_key_prop, _:Issuer_legal_name_prop, _:Issuer_identity_basis_prop, _:Issuer_confidence_prop, _:Issuer_attributes_prop, _:Issuer_valid_from_prop, _:Issuer_valid_to_prop, _:Issuer_available_at_prop, _:Issuer_recorded_at_prop, _:Issuer_source_prop, _:Issuer_source_ref_prop .

_:Issuer_id_prop     sh:path bsip:id ;
    sh:name "Row id" ;
    sh:description "Surrogate key that is NOT stable across a re-fetch or backfill. Never join on this across runs — use the table's natural key." ;
    sh:datatype xsd:string ;
    sh:order "1"^^xsd:integer .

_:Issuer_issuer_key_prop     sh:path bsip:issuer_key ;
    sh:name "Issuer key" ;
    sh:description "Stable internal issuer key. ISIN issuer-prefix keys are authoritative; provisional symbol keys are explicitly low-confidence." ;
    sh:datatype xsd:string ;
    sh:order "2"^^xsd:integer ;
    sh:minCount "1"^^xsd:integer .

_:Issuer_legal_name_prop     sh:path bsip:legal_name ;
    sh:name "Legal name" ;
    sh:description "Canonical issuer legal name." ;
    sh:datatype xsd:string ;
    sh:order "3"^^xsd:integer .

_:Issuer_identity_basis_prop     sh:path bsip:identity_basis ;
    sh:name "Identity basis" ;
    sh:description "Evidence used to construct an issuer or instrument identity." ;
    sh:datatype xsd:string ;
    sh:order "4"^^xsd:integer .

_:Issuer_confidence_prop     sh:path bsip:confidence ;
    sh:name "Identity or evidence confidence" ;
    sh:description "Explicit confidence assigned to identity or evidence metadata." ;
    sh:datatype xsd:decimal ;
    sh:order "5"^^xsd:integer ;
    bsi:unit "probability" .

_:Issuer_attributes_prop     sh:path bsip:attributes ;
    sh:name "Semantic attributes" ;
    sh:description "Structured attributes attached to a canonical identity or graph node." ;
    sh:datatype rdf:JSON ;
    sh:order "6"^^xsd:integer .

_:Issuer_valid_from_prop     sh:path bsip:valid_from ;
    sh:name "Valid from" ;
    sh:description "Start of the interval in which an assertion is valid." ;
    sh:datatype xsd:dateTime ;
    sh:order "7"^^xsd:integer .

_:Issuer_valid_to_prop     sh:path bsip:valid_to ;
    sh:name "Valid to" ;
    sh:description "End of the interval in which an assertion is valid." ;
    sh:datatype xsd:dateTime ;
    sh:order "8"^^xsd:integer .

_:Issuer_available_at_prop     sh:path bsip:available_at ;
    sh:name "Available at" ;
    sh:description "Earliest time the platform could know the assertion." ;
    sh:datatype xsd:dateTime ;
    sh:order "9"^^xsd:integer .

_:Issuer_recorded_at_prop     sh:path bsip:recorded_at ;
    sh:name "Recorded at" ;
    sh:description "Time the platform recorded the assertion." ;
    sh:datatype xsd:dateTime ;
    sh:order "10"^^xsd:integer .

_:Issuer_source_prop     sh:path bsip:source ;
    sh:name "Source" ;
    sh:description "Which provider or fetcher wrote the row. Provenance is per-row on this platform, so this is the first column to check before trusting a value." ;
    sh:datatype xsd:string ;
    sh:order "11"^^xsd:integer .

_:Issuer_source_ref_prop     sh:path bsip:source_ref ;
    sh:name "Source reference" ;
    sh:description "Provider or source-row reference for a semantic assertion." ;
    sh:datatype xsd:string ;
    sh:order "12"^^xsd:integer .

bsi:ListingShape     rdf:type sh:NodeShape ;
    sh:targetClass bsi:Listing ;
    sh:name "Listing" ;
    sh:description "One tradable exchange/segment/symbol representation of an instrument." ;
    bsi:grain "listing_key" ;
    sh:property _:Listing_id_prop, _:Listing_listing_key_prop, _:Listing_exchange_prop, _:Listing_market_segment_prop, _:Listing_symbol_prop, _:Listing_listing_status_prop, _:Listing_date_prop, _:Listing_attributes_prop, _:Listing_valid_from_prop, _:Listing_valid_to_prop, _:Listing_available_at_prop, _:Listing_recorded_at_prop, _:Listing_source_prop, _:Listing_source_ref_prop .

_:Listing_id_prop     sh:path bsip:id ;
    sh:name "Row id" ;
    sh:description "Surrogate key that is NOT stable across a re-fetch or backfill. Never join on this across runs — use the table's natural key." ;
    sh:datatype xsd:string ;
    sh:order "1"^^xsd:integer .

_:Listing_listing_key_prop     sh:path bsip:listing_key ;
    sh:name "Listing key" ;
    sh:description "Exchange/segment/symbol identity for one tradable listing." ;
    sh:datatype xsd:string ;
    sh:order "2"^^xsd:integer ;
    sh:minCount "1"^^xsd:integer .

_:Listing_exchange_prop     sh:path bsip:exchange ;
    sh:name "Exchange" ;
    sh:description "Venue: NSE or BSE. Usually encoded inside `symbol`, but carried as its own column in seven tables — `nse_stocks.exchange` is the canonical one. That column-count is the reason `Exchange` is modelled as a reference class rather than a table." ;
    sh:datatype xsd:string ;
    sh:order "3"^^xsd:integer .

_:Listing_market_segment_prop     sh:path bsip:market_segment ;
    sh:name "Market segment" ;
    sh:description "Exchange segment such as equity." ;
    sh:datatype xsd:string ;
    sh:order "4"^^xsd:integer .

_:Listing_symbol_prop     sh:path bsip:symbol ;
    sh:name "Symbol" ;
    sh:description "Exchange ticker, NSE/BSE convention embedded in the string. The platform's universal join key across ~40 tables." ;
    sh:datatype xsd:string ;
    sh:order "5"^^xsd:integer .

_:Listing_listing_status_prop     sh:path bsip:listing_status ;
    sh:name "Listing status" ;
    sh:description "Current or historical state of a listing." ;
    sh:datatype xsd:string ;
    sh:order "6"^^xsd:integer .

_:Listing_date_prop     sh:path bsip:date ;
    sh:name "Date" ;
    sh:description "Trading-session date. Day cuts are Asia/Kolkata: a date column is a session, not a midnight-to-midnight instant." ;
    sh:datatype xsd:date ;
    sh:order "7"^^xsd:integer ;
    bsi:unit "calendar_day" .

_:Listing_attributes_prop     sh:path bsip:attributes ;
    sh:name "Semantic attributes" ;
    sh:description "Structured attributes attached to a canonical identity or graph node." ;
    sh:datatype rdf:JSON ;
    sh:order "8"^^xsd:integer .

_:Listing_valid_from_prop     sh:path bsip:valid_from ;
    sh:name "Valid from" ;
    sh:description "Start of the interval in which an assertion is valid." ;
    sh:datatype xsd:dateTime ;
    sh:order "9"^^xsd:integer .

_:Listing_valid_to_prop     sh:path bsip:valid_to ;
    sh:name "Valid to" ;
    sh:description "End of the interval in which an assertion is valid." ;
    sh:datatype xsd:dateTime ;
    sh:order "10"^^xsd:integer .

_:Listing_available_at_prop     sh:path bsip:available_at ;
    sh:name "Available at" ;
    sh:description "Earliest time the platform could know the assertion." ;
    sh:datatype xsd:dateTime ;
    sh:order "11"^^xsd:integer .

_:Listing_recorded_at_prop     sh:path bsip:recorded_at ;
    sh:name "Recorded at" ;
    sh:description "Time the platform recorded the assertion." ;
    sh:datatype xsd:dateTime ;
    sh:order "12"^^xsd:integer .

_:Listing_source_prop     sh:path bsip:source ;
    sh:name "Source" ;
    sh:description "Which provider or fetcher wrote the row. Provenance is per-row on this platform, so this is the first column to check before trusting a value." ;
    sh:datatype xsd:string ;
    sh:order "13"^^xsd:integer .

_:Listing_source_ref_prop     sh:path bsip:source_ref ;
    sh:name "Source reference" ;
    sh:description "Provider or source-row reference for a semantic assertion." ;
    sh:datatype xsd:string ;
    sh:order "14"^^xsd:integer .

bsi:ProviderIdentifierShape     rdf:type sh:NodeShape ;
    sh:targetClass bsi:ProviderIdentifier ;
    sh:name "Provider identifier" ;
    sh:description "A provider-qualified identifier for an instrument. Provider and scheme are part of the identity; collisions are recorded rather than resolved by row order." ;
    bsi:grain "(provider, scheme, identifier_value)" ;
    sh:property _:ProviderIdentifier_id_prop, _:ProviderIdentifier_mapping_key_prop, _:ProviderIdentifier_provider_prop, _:ProviderIdentifier_scheme_prop, _:ProviderIdentifier_identifier_value_prop, _:ProviderIdentifier_mapping_status_prop, _:ProviderIdentifier_confidence_prop, _:ProviderIdentifier_valid_from_prop, _:ProviderIdentifier_valid_to_prop, _:ProviderIdentifier_available_at_prop, _:ProviderIdentifier_recorded_at_prop, _:ProviderIdentifier_source_prop, _:ProviderIdentifier_source_ref_prop, _:ProviderIdentifier_reason_prop, _:ProviderIdentifier_candidate_instrument_ids_prop, _:ProviderIdentifier_first_seen_prop, _:ProviderIdentifier_last_seen_prop, _:ProviderIdentifier_attempts_prop .

_:ProviderIdentifier_id_prop     sh:path bsip:id ;
    sh:name "Row id" ;
    sh:description "Surrogate key that is NOT stable across a re-fetch or backfill. Never join on this across runs — use the table's natural key." ;
    sh:datatype xsd:string ;
    sh:order "1"^^xsd:integer .

_:ProviderIdentifier_mapping_key_prop     sh:path bsip:mapping_key ;
    sh:name "Mapping key" ;
    sh:description "Stable key for one provider-qualified identifier mapping." ;
    sh:datatype xsd:string ;
    sh:order "2"^^xsd:integer .

_:ProviderIdentifier_provider_prop     sh:path bsip:provider ;
    sh:name "Provider" ;
    sh:description "Namespace that owns a private identifier. Provider is always part of an identifier key." ;
    sh:datatype xsd:string ;
    sh:order "3"^^xsd:integer ;
    sh:minCount "1"^^xsd:integer .

_:ProviderIdentifier_scheme_prop     sh:path bsip:scheme ;
    sh:name "Identifier scheme" ;
    sh:description "Meaning of a provider identifier, such as ticker, scrip_code or company_id." ;
    sh:datatype xsd:string ;
    sh:order "4"^^xsd:integer ;
    sh:minCount "1"^^xsd:integer .

_:ProviderIdentifier_identifier_value_prop     sh:path bsip:identifier_value ;
    sh:name "Identifier value" ;
    sh:description "Provider-issued identifier value; comparable only within the same provider and scheme." ;
    sh:datatype xsd:string ;
    sh:order "5"^^xsd:integer ;
    sh:minCount "1"^^xsd:integer .

_:ProviderIdentifier_mapping_status_prop     sh:path bsip:mapping_status ;
    sh:name "Mapping status" ;
    sh:description "Whether an identifier mapping is verified, ambiguous, unresolved or rejected." ;
    sh:datatype xsd:string ;
    sh:order "6"^^xsd:integer .

_:ProviderIdentifier_confidence_prop     sh:path bsip:confidence ;
    sh:name "Identity or evidence confidence" ;
    sh:description "Explicit confidence assigned to identity or evidence metadata." ;
    sh:datatype xsd:decimal ;
    sh:order "7"^^xsd:integer ;
    bsi:unit "probability" .

_:ProviderIdentifier_valid_from_prop     sh:path bsip:valid_from ;
    sh:name "Valid from" ;
    sh:description "Start of the interval in which an assertion is valid." ;
    sh:datatype xsd:dateTime ;
    sh:order "8"^^xsd:integer .

_:ProviderIdentifier_valid_to_prop     sh:path bsip:valid_to ;
    sh:name "Valid to" ;
    sh:description "End of the interval in which an assertion is valid." ;
    sh:datatype xsd:dateTime ;
    sh:order "9"^^xsd:integer .

_:ProviderIdentifier_available_at_prop     sh:path bsip:available_at ;
    sh:name "Available at" ;
    sh:description "Earliest time the platform could know the assertion." ;
    sh:datatype xsd:dateTime ;
    sh:order "10"^^xsd:integer .

_:ProviderIdentifier_recorded_at_prop     sh:path bsip:recorded_at ;
    sh:name "Recorded at" ;
    sh:description "Time the platform recorded the assertion." ;
    sh:datatype xsd:dateTime ;
    sh:order "11"^^xsd:integer .

_:ProviderIdentifier_source_prop     sh:path bsip:source ;
    sh:name "Source" ;
    sh:description "Which provider or fetcher wrote the row. Provenance is per-row on this platform, so this is the first column to check before trusting a value." ;
    sh:datatype xsd:string ;
    sh:order "12"^^xsd:integer .

_:ProviderIdentifier_source_ref_prop     sh:path bsip:source_ref ;
    sh:name "Source reference" ;
    sh:description "Provider or source-row reference for a semantic assertion." ;
    sh:datatype xsd:string ;
    sh:order "13"^^xsd:integer .

_:ProviderIdentifier_reason_prop     sh:path bsip:reason ;
    sh:name "Reason" ;
    sh:description "Reason a mapping is ambiguous, unresolved, or rejected." ;
    sh:datatype xsd:string ;
    sh:order "14"^^xsd:integer .

_:ProviderIdentifier_candidate_instrument_ids_prop     sh:path bsip:candidate_instrument_ids ;
    sh:name "Candidate instrument ids" ;
    sh:description "Candidate identities for an ambiguous mapping." ;
    sh:datatype rdf:JSON ;
    sh:order "15"^^xsd:integer .

_:ProviderIdentifier_first_seen_prop     sh:path bsip:first_seen ;
    sh:name "First seen" ;
    sh:description "First time a mapping gap was observed." ;
    sh:datatype xsd:dateTime ;
    sh:order "16"^^xsd:integer .

_:ProviderIdentifier_last_seen_prop     sh:path bsip:last_seen ;
    sh:name "Last seen" ;
    sh:description "Most recent time a mapping gap was observed." ;
    sh:datatype xsd:dateTime ;
    sh:order "17"^^xsd:integer .

_:ProviderIdentifier_attempts_prop     sh:path bsip:attempts ;
    sh:name "Attempts" ;
    sh:description "Number of observed mapping attempts." ;
    sh:datatype xsd:integer ;
    sh:order "18"^^xsd:integer ;
    bsi:unit "count" .

bsi:EquityShape     rdf:type sh:NodeShape ;
    sh:targetClass bsi:Equity ;
    sh:name "Equity" ;
    sh:description "A listed equity, one row per exchange ticker. This is the platform's universal join key and the subject of every other class." ;
    bsi:grain "one row per exchange ticker in `stock_master`" ;
    sh:property _:Equity_symbol_prop, _:Equity_isin_prop, _:Equity_company_name_prop, _:Equity_id_prop, _:Equity_last_updated_prop, _:Equity_industry_prop, _:Equity_sector_prop, _:Equity_exchange_prop, _:Equity_market_cap_prop, _:Equity_lot_size_prop, _:Equity_asm_flag_prop .

_:Equity_symbol_prop     sh:path bsip:symbol ;
    sh:name "Symbol" ;
    sh:description "Exchange ticker, NSE/BSE convention embedded in the string. The platform's universal join key across ~40 tables." ;
    sh:datatype xsd:string ;
    sh:order "1"^^xsd:integer ;
    sh:minCount "1"^^xsd:integer .

_:Equity_isin_prop     sh:path bsip:isin ;
    sh:name "ISIN" ;
    sh:description "ISO 6166 identifier. The only globally-unique key here; coverage is partial, which makes an ISIN-first instrument master a project, not a rename." ;
    sh:datatype xsd:string ;
    sh:order "2"^^xsd:integer ;
    sh:minCount "1"^^xsd:integer .

_:Equity_company_name_prop     sh:path bsip:company_name ;
    sh:name "Company name" ;
    sh:description "Issuer name as supplied by the writer. Free text: one company can appear under two names across tables." ;
    sh:datatype xsd:string ;
    sh:order "3"^^xsd:integer .

_:Equity_id_prop     sh:path bsip:id ;
    sh:name "Row id" ;
    sh:description "Surrogate key that is NOT stable across a re-fetch or backfill. Never join on this across runs — use the table's natural key." ;
    sh:datatype xsd:string ;
    sh:order "4"^^xsd:integer .

_:Equity_last_updated_prop     sh:path bsip:last_updated ;
    sh:name "Last updated" ;
    sh:description "Writer-supplied modification stamp. Trust it only when the writer is known to set it on every write." ;
    sh:datatype xsd:dateTime ;
    sh:order "5"^^xsd:integer .

_:Equity_industry_prop     sh:path bsip:industry ;
    sh:name "Industry" ;
    sh:description "Finer-grained grouping than sector, same provenance caveat. Carried as its own column only in `stock_master` and `nse_stocks`." ;
    sh:datatype xsd:string ;
    sh:order "6"^^xsd:integer .

_:Equity_sector_prop     sh:path bsip:sector ;
    sh:name "Sector" ;
    sh:description "Industry grouping label as supplied by the writing fetcher. No canonical table backs it, so a cross-table sector join can silently lose names." ;
    sh:datatype xsd:string ;
    sh:order "7"^^xsd:integer .

_:Equity_exchange_prop     sh:path bsip:exchange ;
    sh:name "Exchange" ;
    sh:description "Venue: NSE or BSE. Usually encoded inside `symbol`, but carried as its own column in seven tables — `nse_stocks.exchange` is the canonical one. That column-count is the reason `Exchange` is modelled as a reference class rather than a table." ;
    sh:datatype xsd:string ;
    sh:order "8"^^xsd:integer .

_:Equity_market_cap_prop     sh:path bsip:market_cap ;
    sh:name "Market capitalisation" ;
    sh:description "Vendor-computed market cap. The stored unit is NOT declared anywhere in the schema — confirm it before aggregating across tables." ;
    sh:datatype xsd:decimal ;
    sh:order "9"^^xsd:integer ;
    bsi:unit "INR_or_crore_UNDECLARED" .

_:Equity_lot_size_prop     sh:path bsip:lot_size ;
    sh:name "Lot size" ;
    sh:description "Contract multiplier — required to convert a price move into a rupee P&L." ;
    sh:datatype xsd:decimal ;
    sh:order "10"^^xsd:integer ;
    bsi:unit "shares" .

_:Equity_asm_flag_prop     sh:path bsip:asm_flag ;
    sh:name "ASM flag" ;
    sh:description "Exchange surveillance listing — a tradability constraint, not a signal." ;
    sh:datatype xsd:boolean ;
    sh:order "11"^^xsd:integer .

bsi:IndexShape     rdf:type sh:NodeShape ;
    sh:targetClass bsi:Index ;
    sh:name "Index" ;
    sh:description "A market index used as a benchmark or as a derivatives underlying (NIFTY 50, BANK NIFTY, SENSEX, INDIA VIX, GIFT NIFTY, ...)." ;
    bsi:grain "one row per index" .

bsi:SectorShape     rdf:type sh:NodeShape ;
    sh:targetClass bsi:Sector ;
    sh:name "Sector" ;
    sh:description "An industry grouping used for relative-strength and rotation analysis. Stored as free text across several tables rather than resolved to a scheme." ;
    bsi:grain "one row per label, no canonical table" .

bsi:ExchangeShape     rdf:type sh:NodeShape ;
    sh:targetClass bsi:Exchange ;
    sh:name "Exchange" ;
    sh:description "The venue an instrument is admitted to. A two-value dimension (NSE / BSE): usually encoded inside `symbol`, but carried as its own column in seven tables (nse_stocks, market_holidays, nt_fno_expiry, stock_earnings_dates, institutional_deal_signals, mc_advance_decline, mc_chart_patterns)." ;
    bsi:grain "dimension" .

bsi:ScripCodeMappingShape     rdf:type sh:NodeShape ;
    sh:targetClass bsi:ScripCodeMapping ;
    sh:name "Vendor scrip-code mapping" ;
    sh:description "The vendor's private scid mapped onto the platform symbol and issuer name — the only sanctioned route from one to the other." ;
    bsi:grain "(scid, symbol)" ;
    sh:property _:ScripCodeMapping_scid_prop, _:ScripCodeMapping_symbol_prop, _:ScripCodeMapping_company_name_prop .

_:ScripCodeMapping_scid_prop     sh:path bsip:scid ;
    sh:name "MoneyControl scid" ;
    sh:description "Vendor-private MoneyControl id. Reachable from `symbol` only through `mc_scid_map`, and comparable to no other vendor's id." ;
    sh:datatype xsd:string ;
    sh:order "1"^^xsd:integer ;
    sh:minCount "1"^^xsd:integer .

_:ScripCodeMapping_symbol_prop     sh:path bsip:symbol ;
    sh:name "Symbol" ;
    sh:description "Exchange ticker, NSE/BSE convention embedded in the string. The platform's universal join key across ~40 tables." ;
    sh:datatype xsd:string ;
    sh:order "2"^^xsd:integer ;
    sh:minCount "1"^^xsd:integer .

_:ScripCodeMapping_company_name_prop     sh:path bsip:company_name ;
    sh:name "Company name" ;
    sh:description "Issuer name as supplied by the writer. Free text: one company can appear under two names across tables." ;
    sh:datatype xsd:string ;
    sh:order "3"^^xsd:integer .

bsi:CompanyProfileShape     rdf:type sh:NodeShape ;
    sh:targetClass bsi:CompanyProfile ;
    sh:name "CompanyProfile" ;
    sh:description "Narrative and high-level attributes about the issuer behind a ticker." ;
    bsi:grain "one row per symbol" ;
    sh:property _:CompanyProfile_symbol_prop, _:CompanyProfile_company_name_prop, _:CompanyProfile_description_prop, _:CompanyProfile_high_growth_scope_prop, _:CompanyProfile_last_updated_prop, _:CompanyProfile_fundamental_score_prop .

_:CompanyProfile_symbol_prop     sh:path bsip:symbol ;
    sh:name "Symbol" ;
    sh:description "Exchange ticker, NSE/BSE convention embedded in the string. The platform's universal join key across ~40 tables." ;
    sh:datatype xsd:string ;
    sh:order "1"^^xsd:integer ;
    sh:minCount "1"^^xsd:integer .

_:CompanyProfile_company_name_prop     sh:path bsip:company_name ;
    sh:name "Company name" ;
    sh:description "Issuer name as supplied by the writer. Free text: one company can appear under two names across tables." ;
    sh:datatype xsd:string ;
    sh:order "2"^^xsd:integer .

_:CompanyProfile_description_prop     sh:path bsip:description ;
    sh:name "Description" ;
    sh:description "Free-form narrative field." ;
    sh:datatype xsd:string ;
    sh:order "3"^^xsd:integer .

_:CompanyProfile_high_growth_scope_prop     sh:path bsip:high_growth_scope ;
    sh:name "High growth scope" ;
    sh:description "Vendor narrative flag on the profile." ;
    sh:datatype xsd:boolean ;
    sh:order "4"^^xsd:integer .

_:CompanyProfile_last_updated_prop     sh:path bsip:last_updated ;
    sh:name "Last updated" ;
    sh:description "Writer-supplied modification stamp. Trust it only when the writer is known to set it on every write." ;
    sh:datatype xsd:dateTime ;
    sh:order "5"^^xsd:integer .

_:CompanyProfile_fundamental_score_prop     sh:path bsip:fundamental_score ;
    sh:name "Fundamental score" ;
    sh:description "Vendor-derived fundamental composite." ;
    sh:datatype xsd:decimal ;
    sh:order "6"^^xsd:integer ;
    bsi:unit "score_0_100" .

bsi:ObservationShape     rdf:type sh:NodeShape ;
    sh:targetClass bsi:Observation ;
    sh:name "Observation" ;
    sh:description "Abstract parent for anything measured at a point in time without the platform adding an opinion to it. Raw or vendor-supplied; never a label." .

bsi:BarShape     rdf:type sh:NodeShape ;
    sh:targetClass bsi:Bar ;
    sh:name "Daily bar" ;
    sh:description "One daily OHLCV bar per symbol per trading session — the platform's only self-owned source of truth." ;
    bsi:grain "(symbol, date)" ;
    sh:property _:Bar_symbol_prop, _:Bar_date_prop, _:Bar_open_prop, _:Bar_high_prop, _:Bar_low_prop, _:Bar_close_prop, _:Bar_volume_prop, _:Bar_is_suspect_prop, _:Bar_adjustment_basis_prop, _:Bar_suspect_reason_prop .

_:Bar_symbol_prop     sh:path bsip:symbol ;
    sh:name "Symbol" ;
    sh:description "Exchange ticker, NSE/BSE convention embedded in the string. The platform's universal join key across ~40 tables." ;
    sh:datatype xsd:string ;
    sh:order "1"^^xsd:integer ;
    sh:minCount "1"^^xsd:integer .

_:Bar_date_prop     sh:path bsip:date ;
    sh:name "Date" ;
    sh:description "Trading-session date. Day cuts are Asia/Kolkata: a date column is a session, not a midnight-to-midnight instant." ;
    sh:datatype xsd:date ;
    sh:order "2"^^xsd:integer ;
    sh:minCount "1"^^xsd:integer ;
    bsi:unit "calendar_day" .

_:Bar_open_prop     sh:path bsip:open ;
    sh:name "Open" ;
    sh:description "Session open, in the row's recorded price basis." ;
    sh:datatype xsd:decimal ;
    sh:order "3"^^xsd:integer ;
    bsi:unit "per_share_INR" .

_:Bar_high_prop     sh:path bsip:high ;
    sh:name "High" ;
    sh:description "Session high." ;
    sh:datatype xsd:decimal ;
    sh:order "4"^^xsd:integer ;
    bsi:unit "per_share_INR" .

_:Bar_low_prop     sh:path bsip:low ;
    sh:name "Low" ;
    sh:description "Session low." ;
    sh:datatype xsd:decimal ;
    sh:order "5"^^xsd:integer ;
    bsi:unit "per_share_INR" .

_:Bar_close_prop     sh:path bsip:close ;
    sh:name "Close" ;
    sh:description "Session close. The reference price for almost every downstream calculation." ;
    sh:datatype xsd:decimal ;
    sh:order "6"^^xsd:integer ;
    bsi:unit "per_share_INR" .

_:Bar_volume_prop     sh:path bsip:volume ;
    sh:name "Volume" ;
    sh:description "Shares traded in the session." ;
    sh:datatype xsd:decimal ;
    sh:order "7"^^xsd:integer .

_:Bar_is_suspect_prop     sh:path bsip:is_suspect ;
    sh:name "Suspect row" ;
    sh:description "Quarantined by a data-quality rule. Filter it OUT of any training panel; never impute over it silently." ;
    sh:datatype xsd:boolean ;
    sh:order "8"^^xsd:integer .

_:Bar_adjustment_basis_prop     sh:path bsip:adjustment_basis ;
    sh:name "Adjustment basis" ;
    sh:description "Whether the stored price series is raw, split-adjusted or fully adjusted. Mixing bases in one series silently corrupts a backtest." ;
    sh:datatype xsd:string ;
    sh:order "9"^^xsd:integer ;
    bsi:vocabulary bsiv:adjustment_basis ;
    bsi:openEndedVocabulary "stock_ohlcv.adjustment_basis" .

_:Bar_suspect_reason_prop     sh:path bsip:suspect_reason ;
    sh:name "Suspect reason" ;
    sh:description "Why a bar was quarantined." ;
    sh:datatype xsd:string ;
    sh:order "10"^^xsd:integer ;
    bsi:vocabulary bsiv:suspect_reason ;
    bsi:openEndedVocabulary "stock_ohlcv.suspect_reason" .

bsi:IntradayBarShape     rdf:type sh:NodeShape ;
    sh:targetClass bsi:IntradayBar ;
    sh:name "Intraday bar" ;
    sh:description "Sub-daily OHLCV with VWAP. Currently a single interval (15m) of recent history." ;
    bsi:grain "(symbol, datetime, series)" ;
    sh:property _:IntradayBar_symbol_prop, _:IntradayBar_datetime_prop, _:IntradayBar_series_prop, _:IntradayBar_open_prop, _:IntradayBar_high_prop, _:IntradayBar_low_prop, _:IntradayBar_close_prop, _:IntradayBar_volume_prop, _:IntradayBar_vwap_prop .

_:IntradayBar_symbol_prop     sh:path bsip:symbol ;
    sh:name "Symbol" ;
    sh:description "Exchange ticker, NSE/BSE convention embedded in the string. The platform's universal join key across ~40 tables." ;
    sh:datatype xsd:string ;
    sh:order "1"^^xsd:integer ;
    sh:minCount "1"^^xsd:integer .

_:IntradayBar_datetime_prop     sh:path bsip:datetime ;
    sh:name "Timestamp" ;
    sh:description "Intraday bar timestamp, Asia/Kolkata." ;
    sh:datatype xsd:dateTime ;
    sh:order "2"^^xsd:integer ;
    sh:minCount "1"^^xsd:integer .

_:IntradayBar_series_prop     sh:path bsip:series ;
    sh:name "Series" ;
    sh:description "NSE trading series (EQ, BE, BZ, ...). Distinguishes liquidity tiers; mixing them silently changes a universe." ;
    sh:datatype xsd:string ;
    sh:order "3"^^xsd:integer ;
    sh:minCount "1"^^xsd:integer .

_:IntradayBar_open_prop     sh:path bsip:open ;
    sh:name "Open" ;
    sh:description "Session open, in the row's recorded price basis." ;
    sh:datatype xsd:decimal ;
    sh:order "4"^^xsd:integer ;
    bsi:unit "per_share_INR" .

_:IntradayBar_high_prop     sh:path bsip:high ;
    sh:name "High" ;
    sh:description "Session high." ;
    sh:datatype xsd:decimal ;
    sh:order "5"^^xsd:integer ;
    bsi:unit "per_share_INR" .

_:IntradayBar_low_prop     sh:path bsip:low ;
    sh:name "Low" ;
    sh:description "Session low." ;
    sh:datatype xsd:decimal ;
    sh:order "6"^^xsd:integer ;
    bsi:unit "per_share_INR" .

_:IntradayBar_close_prop     sh:path bsip:close ;
    sh:name "Close" ;
    sh:description "Session close. The reference price for almost every downstream calculation." ;
    sh:datatype xsd:decimal ;
    sh:order "7"^^xsd:integer ;
    bsi:unit "per_share_INR" .

_:IntradayBar_volume_prop     sh:path bsip:volume ;
    sh:name "Volume" ;
    sh:description "Shares traded in the session." ;
    sh:datatype xsd:decimal ;
    sh:order "8"^^xsd:integer .

_:IntradayBar_vwap_prop     sh:path bsip:vwap ;
    sh:name "VWAP" ;
    sh:description "Volume-weighted average price; present on intraday bars only." ;
    sh:datatype xsd:decimal ;
    sh:order "9"^^xsd:integer ;
    bsi:unit "per_share_INR" .

bsi:DeliveryObservationShape     rdf:type sh:NodeShape ;
    sh:targetClass bsi:DeliveryObservation ;
    sh:name "Delivery observation" ;
    sh:description "The deliverable-to-traded quantity ratio — the highest-frequency ownership-behaviour proxy the platform owns, and a T+1 lag by construction." ;
    bsi:grain "(symbol, date)" ;
    sh:property _:DeliveryObservation_symbol_prop, _:DeliveryObservation_date_prop, _:DeliveryObservation_delivery_pct_prop, _:DeliveryObservation_delivery_qty_prop, _:DeliveryObservation_traded_qty_prop, _:DeliveryObservation_fetched_at_prop, _:DeliveryObservation_series_prop, _:DeliveryObservation_deliverable_qty_prop .

_:DeliveryObservation_symbol_prop     sh:path bsip:symbol ;
    sh:name "Symbol" ;
    sh:description "Exchange ticker, NSE/BSE convention embedded in the string. The platform's universal join key across ~40 tables." ;
    sh:datatype xsd:string ;
    sh:order "1"^^xsd:integer ;
    sh:minCount "1"^^xsd:integer .

_:DeliveryObservation_date_prop     sh:path bsip:date ;
    sh:name "Date" ;
    sh:description "Trading-session date. Day cuts are Asia/Kolkata: a date column is a session, not a midnight-to-midnight instant." ;
    sh:datatype xsd:date ;
    sh:order "2"^^xsd:integer ;
    sh:minCount "1"^^xsd:integer ;
    bsi:unit "calendar_day" .

_:DeliveryObservation_delivery_pct_prop     sh:path bsip:delivery_pct ;
    sh:name "Delivery percentage" ;
    sh:description "Delivered shares as a share of traded shares. T+1 by construction, underexploited here, and the platform's best high-frequency ownership proxy." ;
    sh:datatype xsd:decimal ;
    sh:order "3"^^xsd:integer ;
    bsi:unit "percent" .

_:DeliveryObservation_delivery_qty_prop     sh:path bsip:delivery_qty ;
    sh:name "Delivered quantity" ;
    sh:description "Shares actually delivered." ;
    sh:datatype xsd:decimal ;
    sh:order "4"^^xsd:integer ;
    bsi:unit "shares" .

_:DeliveryObservation_traded_qty_prop     sh:path bsip:traded_qty ;
    sh:name "Traded quantity" ;
    sh:description "Total shares traded." ;
    sh:datatype xsd:decimal ;
    sh:order "5"^^xsd:integer ;
    bsi:unit "shares" .

_:DeliveryObservation_fetched_at_prop     sh:path bsip:fetched_at ;
    sh:name "Fetched at" ;
    sh:description "When the provider response was received — distinct from the date the observation refers to." ;
    sh:datatype xsd:dateTime ;
    sh:order "6"^^xsd:integer .

_:DeliveryObservation_series_prop     sh:path bsip:series ;
    sh:name "Series" ;
    sh:description "NSE trading series (EQ, BE, BZ, ...). Distinguishes liquidity tiers; mixing them silently changes a universe." ;
    sh:datatype xsd:string ;
    sh:order "7"^^xsd:integer .

_:DeliveryObservation_deliverable_qty_prop     sh:path bsip:deliverable_qty ;
    sh:name "Deliverable quantity" ;
    sh:description "Shares eligible for delivery." ;
    sh:datatype xsd:decimal ;
    sh:order "8"^^xsd:integer ;
    bsi:unit "shares" .

bsi:CorporateActionShape     rdf:type sh:NodeShape ;
    sh:targetClass bsi:CorporateAction ;
    sh:name "Corporate action" ;
    sh:description "A capital-structure event with a price consequence (dividend, split, bonus, rights) plus the record/ex dates that make it usable point-in-time." ;
    bsi:grain "(symbol, ex_date, action_type)" ;
    sh:property _:CorporateAction_symbol_prop, _:CorporateAction_ex_date_prop, _:CorporateAction_action_type_prop, _:CorporateAction_value_inr_prop, _:CorporateAction_source_prop, _:CorporateAction_fetched_at_prop .

_:CorporateAction_symbol_prop     sh:path bsip:symbol ;
    sh:name "Symbol" ;
    sh:description "Exchange ticker, NSE/BSE convention embedded in the string. The platform's universal join key across ~40 tables." ;
    sh:datatype xsd:string ;
    sh:order "1"^^xsd:integer ;
    sh:minCount "1"^^xsd:integer .

_:CorporateAction_ex_date_prop     sh:path bsip:ex_date ;
    sh:name "Ex-date" ;
    sh:description "First session on which a symbol trades without the benefit of a corporate action. The anchor for every price adjustment." ;
    sh:datatype xsd:date ;
    sh:order "2"^^xsd:integer ;
    sh:minCount "1"^^xsd:integer ;
    bsi:unit "calendar_day" .

_:CorporateAction_action_type_prop     sh:path bsip:action_type ;
    sh:name "Action type" ;
    sh:description "Kind of corporate event recorded." ;
    sh:datatype xsd:string ;
    sh:order "3"^^xsd:integer ;
    sh:minCount "1"^^xsd:integer ;
    bsi:vocabulary bsiv:corporate_action_type ;
    bsi:openEndedVocabulary "corporate_actions.action_type" .

_:CorporateAction_value_inr_prop     sh:path bsip:value_inr ;
    sh:name "Value (INR)" ;
    sh:description "Transaction value in rupees, as a bare number." ;
    sh:datatype xsd:decimal ;
    sh:order "4"^^xsd:integer .

_:CorporateAction_source_prop     sh:path bsip:source ;
    sh:name "Source" ;
    sh:description "Which provider or fetcher wrote the row. Provenance is per-row on this platform, so this is the first column to check before trusting a value." ;
    sh:datatype xsd:string ;
    sh:order "5"^^xsd:integer .

_:CorporateAction_fetched_at_prop     sh:path bsip:fetched_at ;
    sh:name "Fetched at" ;
    sh:description "When the provider response was received — distinct from the date the observation refers to." ;
    sh:datatype xsd:dateTime ;
    sh:order "6"^^xsd:integer .

bsi:FundamentalSnapshotShape     rdf:type sh:NodeShape ;
    sh:targetClass bsi:FundamentalSnapshot ;
    sh:name "Fundamental snapshot" ;
    sh:description "Vendor-supplied accounting ratios and market-cap for a symbol, captured with an as-of date. Lagging information: the publication delay is the point-in-time risk." ;
    bsi:grain "(symbol, as_of_date)" ;
    sh:property _:FundamentalSnapshot_symbol_prop, _:FundamentalSnapshot_as_of_date_prop, _:FundamentalSnapshot_market_cap_prop, _:FundamentalSnapshot_return_on_equity_prop, _:FundamentalSnapshot_debt_to_equity_prop, _:FundamentalSnapshot_operating_margins_prop, _:FundamentalSnapshot_revenue_growth_prop, _:FundamentalSnapshot_earnings_growth_prop, _:FundamentalSnapshot_price_to_book_prop, _:FundamentalSnapshot_piotroski_f_score_prop, _:FundamentalSnapshot_pledge_pct_prop, _:FundamentalSnapshot_captured_at_prop .

_:FundamentalSnapshot_symbol_prop     sh:path bsip:symbol ;
    sh:name "Symbol" ;
    sh:description "Exchange ticker, NSE/BSE convention embedded in the string. The platform's universal join key across ~40 tables." ;
    sh:datatype xsd:string ;
    sh:order "1"^^xsd:integer ;
    sh:minCount "1"^^xsd:integer .

_:FundamentalSnapshot_as_of_date_prop     sh:path bsip:as_of_date ;
    sh:name "As-of date" ;
    sh:description "Point-in-time stamp on vendor snapshots: the value is knowable only from this date, whatever period it describes." ;
    sh:datatype xsd:date ;
    sh:order "2"^^xsd:integer ;
    sh:minCount "1"^^xsd:integer ;
    bsi:unit "calendar_day" .

_:FundamentalSnapshot_market_cap_prop     sh:path bsip:market_cap ;
    sh:name "Market capitalisation" ;
    sh:description "Vendor-computed market cap. The stored unit is NOT declared anywhere in the schema — confirm it before aggregating across tables." ;
    sh:datatype xsd:decimal ;
    sh:order "3"^^xsd:integer ;
    bsi:unit "INR_or_crore_UNDECLARED" .

_:FundamentalSnapshot_return_on_equity_prop     sh:path bsip:return_on_equity ;
    sh:name "Return on equity" ;
    sh:description "Vendor-computed ROE." ;
    sh:datatype xsd:decimal ;
    sh:order "4"^^xsd:integer ;
    bsi:unit "percent" .

_:FundamentalSnapshot_debt_to_equity_prop     sh:path bsip:debt_to_equity ;
    sh:name "Debt to equity" ;
    sh:description "Vendor-computed leverage ratio." ;
    sh:datatype xsd:decimal ;
    sh:order "5"^^xsd:integer ;
    bsi:unit "percent" .

_:FundamentalSnapshot_operating_margins_prop     sh:path bsip:operating_margins ;
    sh:name "Operating margin" ;
    sh:description "Vendor-computed operating margin." ;
    sh:datatype xsd:decimal ;
    sh:order "6"^^xsd:integer ;
    bsi:unit "percent" .

_:FundamentalSnapshot_revenue_growth_prop     sh:path bsip:revenue_growth ;
    sh:name "Revenue growth" ;
    sh:description "Vendor-computed revenue growth." ;
    sh:datatype xsd:decimal ;
    sh:order "7"^^xsd:integer ;
    bsi:unit "percent" .

_:FundamentalSnapshot_earnings_growth_prop     sh:path bsip:earnings_growth ;
    sh:name "Earnings growth" ;
    sh:description "Vendor-computed earnings growth." ;
    sh:datatype xsd:decimal ;
    sh:order "8"^^xsd:integer ;
    bsi:unit "percent" .

_:FundamentalSnapshot_price_to_book_prop     sh:path bsip:price_to_book ;
    sh:name "Price to book" ;
    sh:description "Vendor-computed P/B." ;
    sh:datatype xsd:decimal ;
    sh:order "9"^^xsd:integer ;
    bsi:unit "percent" .

_:FundamentalSnapshot_piotroski_f_score_prop     sh:path bsip:piotroski_f_score ;
    sh:name "Piotroski F-score" ;
    sh:description "Vendor-computed 0-9 accounting quality score." ;
    sh:datatype xsd:decimal ;
    sh:order "10"^^xsd:integer ;
    bsi:unit "score_0_100" .

_:FundamentalSnapshot_pledge_pct_prop     sh:path bsip:pledge_pct ;
    sh:name "Pledged percent" ;
    sh:description "Promoter shares pledged as collateral." ;
    sh:datatype xsd:decimal ;
    sh:order "11"^^xsd:integer ;
    bsi:unit "percent" .

_:FundamentalSnapshot_captured_at_prop     sh:path bsip:captured_at ;
    sh:name "Captured at" ;
    sh:description "Snapshot capture time for vendor grids that are otherwise undated." ;
    sh:datatype xsd:dateTime ;
    sh:order "12"^^xsd:integer .

bsi:AnalystEstimateShape     rdf:type sh:NodeShape ;
    sh:targetClass bsi:AnalystEstimate ;
    sh:name "Analyst estimate" ;
    sh:description "Consensus ratings, target prices and next-period estimates captured as a dated snapshot. Genuinely leading information; short panel relative to the news table." ;
    bsi:grain "(symbol, as_of_date)" ;
    sh:property _:AnalystEstimate_symbol_prop, _:AnalystEstimate_as_of_date_prop, _:AnalystEstimate_n_analysts_prop, _:AnalystEstimate_target_mean_prop, _:AnalystEstimate_classification_prop, _:AnalystEstimate_bullish_screener_count_prop, _:AnalystEstimate_bearish_screener_count_prop, _:AnalystEstimate_captured_at_prop .

_:AnalystEstimate_symbol_prop     sh:path bsip:symbol ;
    sh:name "Symbol" ;
    sh:description "Exchange ticker, NSE/BSE convention embedded in the string. The platform's universal join key across ~40 tables." ;
    sh:datatype xsd:string ;
    sh:order "1"^^xsd:integer ;
    sh:minCount "1"^^xsd:integer .

_:AnalystEstimate_as_of_date_prop     sh:path bsip:as_of_date ;
    sh:name "As-of date" ;
    sh:description "Point-in-time stamp on vendor snapshots: the value is knowable only from this date, whatever period it describes." ;
    sh:datatype xsd:date ;
    sh:order "2"^^xsd:integer ;
    sh:minCount "1"^^xsd:integer ;
    bsi:unit "calendar_day" .

_:AnalystEstimate_n_analysts_prop     sh:path bsip:n_analysts ;
    sh:name "Analyst count" ;
    sh:description "Contributing analysts in the consensus snapshot." ;
    sh:datatype xsd:integer ;
    sh:order "3"^^xsd:integer ;
    bsi:unit "count" .

_:AnalystEstimate_target_mean_prop     sh:path bsip:target_mean ;
    sh:name "Mean target price" ;
    sh:description "Consensus mean analyst target." ;
    sh:datatype xsd:decimal ;
    sh:order "4"^^xsd:integer ;
    bsi:unit "per_share_INR" .

_:AnalystEstimate_classification_prop     sh:path bsip:classification ;
    sh:name "Classification" ;
    sh:description "Human-readable action label." ;
    sh:datatype xsd:string ;
    sh:order "5"^^xsd:integer ;
    bsi:vocabulary bsiv:recommendation_classification ;
    sh:in _:AnalystEstimate_classification_in0 .

_:AnalystEstimate_classification_in0     rdf:first "Strong Buy" ;
    rdf:rest _:AnalystEstimate_classification_in1 .

_:AnalystEstimate_classification_in1     rdf:first "Buy" ;
    rdf:rest _:AnalystEstimate_classification_in2 .

_:AnalystEstimate_classification_in2     rdf:first "Hold" ;
    rdf:rest _:AnalystEstimate_classification_in3 .

_:AnalystEstimate_classification_in3     rdf:first "Sell" ;
    rdf:rest _:AnalystEstimate_classification_in4 .

_:AnalystEstimate_classification_in4     rdf:first "Strong Sell" ;
    rdf:rest rdf:nil .

_:AnalystEstimate_bullish_screener_count_prop     sh:path bsip:bullish_screener_count ;
    sh:name "Bullish screener count" ;
    sh:description "Screener appearances with an inferred bullish bias." ;
    sh:datatype xsd:integer ;
    sh:order "6"^^xsd:integer ;
    bsi:unit "count" .

_:AnalystEstimate_bearish_screener_count_prop     sh:path bsip:bearish_screener_count ;
    sh:name "Bearish screener count" ;
    sh:description "Screener appearances with an inferred bearish bias." ;
    sh:datatype xsd:integer ;
    sh:order "7"^^xsd:integer ;
    bsi:unit "count" .

_:AnalystEstimate_captured_at_prop     sh:path bsip:captured_at ;
    sh:name "Captured at" ;
    sh:description "Snapshot capture time for vendor grids that are otherwise undated." ;
    sh:datatype xsd:dateTime ;
    sh:order "8"^^xsd:integer .

bsi:EarningsSurpriseShape     rdf:type sh:NodeShape ;
    sh:targetClass bsi:EarningsSurprise ;
    sh:name "Earnings surprise" ;
    sh:description "Actual versus estimated net profit and revenue for a quarter, with the surprise computed per line. Coincident for the print, leading for the drift after it." ;
    bsi:grain "(symbol, quarter)" ;
    sh:property _:EarningsSurprise_scid_prop, _:EarningsSurprise_symbol_prop, _:EarningsSurprise_series_prop, _:EarningsSurprise_eps_actual_prop, _:EarningsSurprise_eps_estimate_prop, _:EarningsSurprise_eps_surprise_prop, _:EarningsSurprise_np_surprise_prop, _:EarningsSurprise_fetched_at_prop .

_:EarningsSurprise_scid_prop     sh:path bsip:scid ;
    sh:name "MoneyControl scid" ;
    sh:description "Vendor-private MoneyControl id. Reachable from `symbol` only through `mc_scid_map`, and comparable to no other vendor's id." ;
    sh:datatype xsd:string ;
    sh:order "1"^^xsd:integer .

_:EarningsSurprise_symbol_prop     sh:path bsip:symbol ;
    sh:name "Symbol" ;
    sh:description "Exchange ticker, NSE/BSE convention embedded in the string. The platform's universal join key across ~40 tables." ;
    sh:datatype xsd:string ;
    sh:order "2"^^xsd:integer ;
    sh:minCount "1"^^xsd:integer .

_:EarningsSurprise_series_prop     sh:path bsip:series ;
    sh:name "Series" ;
    sh:description "NSE trading series (EQ, BE, BZ, ...). Distinguishes liquidity tiers; mixing them silently changes a universe." ;
    sh:datatype xsd:string ;
    sh:order "3"^^xsd:integer ;
    sh:minCount "1"^^xsd:integer .

_:EarningsSurprise_eps_actual_prop     sh:path bsip:eps_actual ;
    sh:name "EPS actual" ;
    sh:description "Reported EPS for the quarter." ;
    sh:datatype xsd:decimal ;
    sh:order "4"^^xsd:integer ;
    bsi:unit "per_share_INR" .

_:EarningsSurprise_eps_estimate_prop     sh:path bsip:eps_estimate ;
    sh:name "EPS estimate" ;
    sh:description "Consensus EPS estimate for the quarter." ;
    sh:datatype xsd:decimal ;
    sh:order "5"^^xsd:integer ;
    bsi:unit "per_share_INR" .

_:EarningsSurprise_eps_surprise_prop     sh:path bsip:eps_surprise ;
    sh:name "EPS surprise" ;
    sh:description "Actual minus estimate for EPS." ;
    sh:datatype xsd:decimal ;
    sh:order "6"^^xsd:integer ;
    bsi:unit "per_share_INR" .

_:EarningsSurprise_np_surprise_prop     sh:path bsip:np_surprise ;
    sh:name "Net-profit surprise" ;
    sh:description "Actual minus estimate for net profit." ;
    sh:datatype xsd:decimal ;
    sh:order "7"^^xsd:integer ;
    bsi:unit "crore_INR" .

_:EarningsSurprise_fetched_at_prop     sh:path bsip:fetched_at ;
    sh:name "Fetched at" ;
    sh:description "When the provider response was received — distinct from the date the observation refers to." ;
    sh:datatype xsd:dateTime ;
    sh:order "8"^^xsd:integer .

bsi:InsiderTransactionShape     rdf:type sh:NodeShape ;
    sh:targetClass bsi:InsiderTransaction ;
    sh:name "Insider transaction" ;
    sh:description "A promoter/insider buy or sell filing. Leading in principle; graded weak as a standalone signal on this platform and kept as a confluence input." ;
    bsi:grain "(symbol, date, acquirer, transaction)" ;
    sh:property _:InsiderTransaction_symbol_prop, _:InsiderTransaction_company_name_prop, _:InsiderTransaction_category_prop, _:InsiderTransaction_trade_type_prop, _:InsiderTransaction_quantity_prop, _:InsiderTransaction_value_inr_prop, _:InsiderTransaction_date_prop, _:InsiderTransaction_pct_transacted_prop, _:InsiderTransaction_source_prop .

_:InsiderTransaction_symbol_prop     sh:path bsip:symbol ;
    sh:name "Symbol" ;
    sh:description "Exchange ticker, NSE/BSE convention embedded in the string. The platform's universal join key across ~40 tables." ;
    sh:datatype xsd:string ;
    sh:order "1"^^xsd:integer ;
    sh:minCount "1"^^xsd:integer .

_:InsiderTransaction_company_name_prop     sh:path bsip:company_name ;
    sh:name "Company name" ;
    sh:description "Issuer name as supplied by the writer. Free text: one company can appear under two names across tables." ;
    sh:datatype xsd:string ;
    sh:order "2"^^xsd:integer ;
    sh:minCount "1"^^xsd:integer .

_:InsiderTransaction_category_prop     sh:path bsip:category ;
    sh:name "Category" ;
    sh:description "Registry's category classification." ;
    sh:datatype xsd:string ;
    sh:order "3"^^xsd:integer .

_:InsiderTransaction_trade_type_prop     sh:path bsip:trade_type ;
    sh:name "Trade side" ;
    sh:description "Buy or sell side of a deal." ;
    sh:datatype xsd:string ;
    sh:order "4"^^xsd:integer ;
    sh:minCount "1"^^xsd:integer ;
    bsi:vocabulary bsiv:trade_type ;
    bsi:openEndedVocabulary "block_deals.trade_type" .

_:InsiderTransaction_quantity_prop     sh:path bsip:quantity ;
    sh:name "Quantity" ;
    sh:description "Shares transacted in an insider or bulk transaction." ;
    sh:datatype xsd:decimal ;
    sh:order "5"^^xsd:integer .

_:InsiderTransaction_value_inr_prop     sh:path bsip:value_inr ;
    sh:name "Value (INR)" ;
    sh:description "Transaction value in rupees, as a bare number." ;
    sh:datatype xsd:decimal ;
    sh:order "6"^^xsd:integer .

_:InsiderTransaction_date_prop     sh:path bsip:date ;
    sh:name "Date" ;
    sh:description "Trading-session date. Day cuts are Asia/Kolkata: a date column is a session, not a midnight-to-midnight instant." ;
    sh:datatype xsd:date ;
    sh:order "7"^^xsd:integer ;
    sh:minCount "1"^^xsd:integer ;
    bsi:unit "calendar_day" .

_:InsiderTransaction_pct_transacted_prop     sh:path bsip:pct_transacted ;
    sh:name "Percent transacted" ;
    sh:description "Transacted shares as a share of the float or of outstanding capital, depending on the writer." ;
    sh:datatype xsd:decimal ;
    sh:order "8"^^xsd:integer ;
    bsi:unit "percent" .

_:InsiderTransaction_source_prop     sh:path bsip:source ;
    sh:name "Source" ;
    sh:description "Which provider or fetcher wrote the row. Provenance is per-row on this platform, so this is the first column to check before trusting a value." ;
    sh:datatype xsd:string ;
    sh:order "9"^^xsd:integer .

bsi:BlockDealShape     rdf:type sh:NodeShape ;
    sh:targetClass bsi:BlockDeal ;
    sh:name "Block / bulk deal" ;
    sh:description "An off-book or bulk transaction with quantity, price and value. Value is stored in CRORES as a bare number, with no currency or unit term attached." ;
    bsi:grain "(symbol, date, deal)" ;
    sh:property _:BlockDeal_symbol_prop, _:BlockDeal_date_prop, _:BlockDeal_session_prop, _:BlockDeal_quantity_prop, _:BlockDeal_close_prop, _:BlockDeal_value_cr_prop, _:BlockDeal_client_name_prop, _:BlockDeal_trade_type_prop, _:BlockDeal_category_prop, _:BlockDeal_source_prop, _:BlockDeal_fetched_at_prop, _:BlockDeal_id_prop .

_:BlockDeal_symbol_prop     sh:path bsip:symbol ;
    sh:name "Symbol" ;
    sh:description "Exchange ticker, NSE/BSE convention embedded in the string. The platform's universal join key across ~40 tables." ;
    sh:datatype xsd:string ;
    sh:order "1"^^xsd:integer ;
    sh:minCount "1"^^xsd:integer .

_:BlockDeal_date_prop     sh:path bsip:date ;
    sh:name "Date" ;
    sh:description "Trading-session date. Day cuts are Asia/Kolkata: a date column is a session, not a midnight-to-midnight instant." ;
    sh:datatype xsd:date ;
    sh:order "2"^^xsd:integer ;
    sh:minCount "1"^^xsd:integer ;
    bsi:unit "calendar_day" .

_:BlockDeal_session_prop     sh:path bsip:session ;
    sh:name "Session" ;
    sh:description "Trading-session segment a row belongs to (block deals carry this)." ;
    sh:datatype xsd:string ;
    sh:order "3"^^xsd:integer .

_:BlockDeal_quantity_prop     sh:path bsip:quantity ;
    sh:name "Quantity" ;
    sh:description "Shares transacted in an insider or bulk transaction." ;
    sh:datatype xsd:decimal ;
    sh:order "4"^^xsd:integer .

_:BlockDeal_close_prop     sh:path bsip:close ;
    sh:name "Close" ;
    sh:description "Session close. The reference price for almost every downstream calculation." ;
    sh:datatype xsd:decimal ;
    sh:order "5"^^xsd:integer ;
    bsi:unit "per_share_INR" .

_:BlockDeal_value_cr_prop     sh:path bsip:value_cr ;
    sh:name "Value (crore)" ;
    sh:description "Transaction value in CRORES, as a bare number. The multiplier is not declared anywhere in the schema — see alignment.py." ;
    sh:datatype xsd:decimal ;
    sh:order "6"^^xsd:integer .

_:BlockDeal_client_name_prop     sh:path bsip:client_name ;
    sh:name "Client name" ;
    sh:description "Counterparty as reported on a deal." ;
    sh:datatype xsd:string ;
    sh:order "7"^^xsd:integer .

_:BlockDeal_trade_type_prop     sh:path bsip:trade_type ;
    sh:name "Trade side" ;
    sh:description "Buy or sell side of a deal." ;
    sh:datatype xsd:string ;
    sh:order "8"^^xsd:integer ;
    bsi:vocabulary bsiv:trade_type ;
    bsi:openEndedVocabulary "block_deals.trade_type" .

_:BlockDeal_category_prop     sh:path bsip:category ;
    sh:name "Category" ;
    sh:description "Registry's category classification." ;
    sh:datatype xsd:string ;
    sh:order "9"^^xsd:integer .

_:BlockDeal_source_prop     sh:path bsip:source ;
    sh:name "Source" ;
    sh:description "Which provider or fetcher wrote the row. Provenance is per-row on this platform, so this is the first column to check before trusting a value." ;
    sh:datatype xsd:string ;
    sh:order "10"^^xsd:integer .

_:BlockDeal_fetched_at_prop     sh:path bsip:fetched_at ;
    sh:name "Fetched at" ;
    sh:description "When the provider response was received — distinct from the date the observation refers to." ;
    sh:datatype xsd:dateTime ;
    sh:order "11"^^xsd:integer .

_:BlockDeal_id_prop     sh:path bsip:id ;
    sh:name "Row id" ;
    sh:description "Surrogate key that is NOT stable across a re-fetch or backfill. Never join on this across runs — use the table's natural key." ;
    sh:datatype xsd:string ;
    sh:order "12"^^xsd:integer ;
    sh:minCount "1"^^xsd:integer .

bsi:MFHoldingShape     rdf:type sh:NodeShape ;
    sh:targetClass bsi:MFHolding ;
    sh:name "Mutual-fund holding" ;
    sh:description "Aggregate mutual-fund ownership of a symbol: holding percentage, fund count and the change versus the previous disclosure." ;
    bsi:grain "(symbol, disclosure date)" ;
    sh:property _:MFHolding_symbol_prop, _:MFHolding_date_prop, _:MFHolding_mf_holding_pct_prop, _:MFHolding_num_funds_prop, _:MFHolding_fetched_at_prop .

_:MFHolding_symbol_prop     sh:path bsip:symbol ;
    sh:name "Symbol" ;
    sh:description "Exchange ticker, NSE/BSE convention embedded in the string. The platform's universal join key across ~40 tables." ;
    sh:datatype xsd:string ;
    sh:order "1"^^xsd:integer ;
    sh:minCount "1"^^xsd:integer .

_:MFHolding_date_prop     sh:path bsip:date ;
    sh:name "Date" ;
    sh:description "Trading-session date. Day cuts are Asia/Kolkata: a date column is a session, not a midnight-to-midnight instant." ;
    sh:datatype xsd:date ;
    sh:order "2"^^xsd:integer ;
    sh:minCount "1"^^xsd:integer ;
    bsi:unit "calendar_day" .

_:MFHolding_mf_holding_pct_prop     sh:path bsip:mf_holding_pct ;
    sh:name "Mutual-fund holding percent" ;
    sh:description "Aggregate mutual-fund ownership of the symbol." ;
    sh:datatype xsd:decimal ;
    sh:order "3"^^xsd:integer ;
    bsi:unit "percent" .

_:MFHolding_num_funds_prop     sh:path bsip:num_funds ;
    sh:name "Fund count" ;
    sh:description "Mutual funds holding the symbol." ;
    sh:datatype xsd:integer ;
    sh:order "4"^^xsd:integer ;
    bsi:unit "count" .

_:MFHolding_fetched_at_prop     sh:path bsip:fetched_at ;
    sh:name "Fetched at" ;
    sh:description "When the provider response was received — distinct from the date the observation refers to." ;
    sh:datatype xsd:dateTime ;
    sh:order "5"^^xsd:integer .

bsi:NewsItemShape     rdf:type sh:NodeShape ;
    sh:targetClass bsi:NewsItem ;
    sh:name "News item" ;
    sh:description "A news article or exchange announcement with vendor sentiment, a FinBERT tone ensemble, an impact bucket and the symbols it mentions. 15 years deep — the only panel here that supports a real event study." ;
    bsi:grain "one row per article/announcement" ;
    sh:property _:NewsItem_id_prop, _:NewsItem_title_prop, _:NewsItem_summary_prop, _:NewsItem_source_prop, _:NewsItem_category_prop, _:NewsItem_url_prop, _:NewsItem_published_at_prop, _:NewsItem_sentiment_prop, _:NewsItem_sentiment_score_prop, _:NewsItem_impact_prop, _:NewsItem_symbols_json_prop, _:NewsItem_sector_prop, _:NewsItem_ai_scored_prop, _:NewsItem_tone_label_prop, _:NewsItem_tone_score_prop, _:NewsItem_sentiment_conflict_prop, _:NewsItem_symbol_prop .

_:NewsItem_id_prop     sh:path bsip:id ;
    sh:name "Row id" ;
    sh:description "Surrogate key that is NOT stable across a re-fetch or backfill. Never join on this across runs — use the table's natural key." ;
    sh:datatype xsd:string ;
    sh:order "1"^^xsd:integer ;
    sh:minCount "1"^^xsd:integer .

_:NewsItem_title_prop     sh:path bsip:title ;
    sh:name "Title" ;
    sh:description "Headline text." ;
    sh:datatype xsd:string ;
    sh:order "2"^^xsd:integer .

_:NewsItem_summary_prop     sh:path bsip:summary ;
    sh:name "Summary" ;
    sh:description "Article or announcement summary." ;
    sh:datatype xsd:string ;
    sh:order "3"^^xsd:integer .

_:NewsItem_source_prop     sh:path bsip:source ;
    sh:name "Source" ;
    sh:description "Which provider or fetcher wrote the row. Provenance is per-row on this platform, so this is the first column to check before trusting a value." ;
    sh:datatype xsd:string ;
    sh:order "4"^^xsd:integer .

_:NewsItem_category_prop     sh:path bsip:category ;
    sh:name "Category" ;
    sh:description "Registry's category classification." ;
    sh:datatype xsd:string ;
    sh:order "5"^^xsd:integer .

_:NewsItem_url_prop     sh:path bsip:url ;
    sh:name "URL" ;
    sh:description "Source URL of the item." ;
    sh:datatype xsd:string ;
    sh:order "6"^^xsd:integer .

_:NewsItem_published_at_prop     sh:path bsip:published_at ;
    sh:name "Published at" ;
    sh:description "Publication time of a news item or announcement. Such an item is knowable only from this instant, never from the event it describes." ;
    sh:datatype xsd:dateTime ;
    sh:order "7"^^xsd:integer .

_:NewsItem_sentiment_prop     sh:path bsip:sentiment ;
    sh:name "Vendor sentiment" ;
    sh:description "Vendor's directional sentiment class." ;
    sh:datatype xsd:string ;
    sh:order "8"^^xsd:integer ;
    bsi:vocabulary bsiv:news_sentiment ;
    bsi:openEndedVocabulary "news_sentiment_items.sentiment" .

_:NewsItem_sentiment_score_prop     sh:path bsip:sentiment_score ;
    sh:name "Vendor sentiment score" ;
    sh:description "Vendor's numeric sentiment." ;
    sh:datatype xsd:decimal ;
    sh:order "9"^^xsd:integer ;
    bsi:unit "score_minus1_1" .

_:NewsItem_impact_prop     sh:path bsip:impact ;
    sh:name "Impact" ;
    sh:description "Expected market impact bucket of a news item." ;
    sh:datatype xsd:string ;
    sh:order "10"^^xsd:integer ;
    bsi:vocabulary bsiv:news_impact ;
    bsi:openEndedVocabulary "news_sentiment_items.impact" .

_:NewsItem_symbols_json_prop     sh:path bsip:symbols_json ;
    sh:name "Mentioned symbols" ;
    sh:description "JSON array of symbols a news item mentions. A mention is not a foreign key." ;
    sh:datatype rdf:JSON ;
    sh:order "11"^^xsd:integer .

_:NewsItem_sector_prop     sh:path bsip:sector ;
    sh:name "Sector" ;
    sh:description "Industry grouping label as supplied by the writing fetcher. No canonical table backs it, so a cross-table sector join can silently lose names." ;
    sh:datatype xsd:string ;
    sh:order "12"^^xsd:integer .

_:NewsItem_ai_scored_prop     sh:path bsip:ai_scored ;
    sh:name "AI scored" ;
    sh:description "Scored by the NLP model rather than carrying vendor sentiment only." ;
    sh:datatype xsd:boolean ;
    sh:order "13"^^xsd:integer .

_:NewsItem_tone_label_prop     sh:path bsip:tone_label ;
    sh:name "FinBERT tone" ;
    sh:description "Tone class from the FinBERT ensemble." ;
    sh:datatype xsd:string ;
    sh:order "14"^^xsd:integer ;
    bsi:vocabulary bsiv:news_tone_label ;
    bsi:openEndedVocabulary "news_sentiment_items.tone_label" .

_:NewsItem_tone_score_prop     sh:path bsip:tone_score ;
    sh:name "FinBERT tone score" ;
    sh:description "Ensemble tone score from the NLP model." ;
    sh:datatype xsd:decimal ;
    sh:order "15"^^xsd:integer ;
    bsi:unit "score_minus1_1" .

_:NewsItem_sentiment_conflict_prop     sh:path bsip:sentiment_conflict ;
    sh:name "Sentiment conflict" ;
    sh:description "Vendor sentiment and FinBERT tone disagree on the same item." ;
    sh:datatype xsd:boolean ;
    sh:order "16"^^xsd:integer .

_:NewsItem_symbol_prop     sh:path bsip:symbol ;
    sh:name "Symbol" ;
    sh:description "Exchange ticker, NSE/BSE convention embedded in the string. The platform's universal join key across ~40 tables." ;
    sh:datatype xsd:string ;
    sh:order "17"^^xsd:integer .

bsi:OptionChainRowShape     rdf:type sh:NodeShape ;
    sh:targetClass bsi:OptionChainRow ;
    sh:name "Option chain row" ;
    sh:description "One strike, one expiry, one session: call and put leg premium, volume, open interest, IV and greeks. A grid, not a time series." ;
    bsi:grain "(symbol, date, expiry, strike)" ;
    sh:property _:OptionChainRow_symbol_prop, _:OptionChainRow_date_prop, _:OptionChainRow_expiry_prop, _:OptionChainRow_strike_prop, _:OptionChainRow_option_premium_prop, _:OptionChainRow_option_volume_prop, _:OptionChainRow_option_oi_prop, _:OptionChainRow_option_oi_chg_pct_prop, _:OptionChainRow_option_iv_prop, _:OptionChainRow_option_buildup_prop, _:OptionChainRow_fetched_at_prop .

_:OptionChainRow_symbol_prop     sh:path bsip:symbol ;
    sh:name "Symbol" ;
    sh:description "Exchange ticker, NSE/BSE convention embedded in the string. The platform's universal join key across ~40 tables." ;
    sh:datatype xsd:string ;
    sh:order "1"^^xsd:integer ;
    sh:minCount "1"^^xsd:integer .

_:OptionChainRow_date_prop     sh:path bsip:date ;
    sh:name "Date" ;
    sh:description "Trading-session date. Day cuts are Asia/Kolkata: a date column is a session, not a midnight-to-midnight instant." ;
    sh:datatype xsd:date ;
    sh:order "2"^^xsd:integer ;
    sh:minCount "1"^^xsd:integer ;
    bsi:unit "calendar_day" .

_:OptionChainRow_expiry_prop     sh:path bsip:expiry ;
    sh:name "Expiry" ;
    sh:description "Derivative contract expiry. Several expiries coexist per symbol per date." ;
    sh:datatype xsd:date ;
    sh:order "3"^^xsd:integer ;
    sh:minCount "1"^^xsd:integer ;
    bsi:unit "calendar_day" .

_:OptionChainRow_strike_prop     sh:path bsip:strike ;
    sh:name "Strike" ;
    sh:description "Option contract strike price." ;
    sh:datatype xsd:decimal ;
    sh:order "4"^^xsd:integer ;
    sh:minCount "1"^^xsd:integer ;
    bsi:unit "per_share_INR" .

_:OptionChainRow_option_premium_prop     sh:path bsip:option_premium ;
    sh:name "Option premium" ;
    sh:description "Premium of an option leg (call or put)." ;
    sh:datatype xsd:decimal ;
    sh:order "5"^^xsd:integer ;
    bsi:unit "per_share_INR" .

_:OptionChainRow_option_volume_prop     sh:path bsip:option_volume ;
    sh:name "Option volume" ;
    sh:description "Contracts traded on that leg." ;
    sh:datatype xsd:decimal ;
    sh:order "6"^^xsd:integer ;
    bsi:unit "per_share_INR" .

_:OptionChainRow_option_oi_prop     sh:path bsip:option_oi ;
    sh:name "Option open interest" ;
    sh:description "Open interest on that leg." ;
    sh:datatype xsd:decimal ;
    sh:order "7"^^xsd:integer ;
    bsi:unit "per_share_INR" .

_:OptionChainRow_option_oi_chg_pct_prop     sh:path bsip:option_oi_chg_pct ;
    sh:name "Option OI change percent" ;
    sh:description "Session-over-session OI change for that leg." ;
    sh:datatype xsd:decimal ;
    sh:order "8"^^xsd:integer ;
    bsi:unit "per_share_INR" .

_:OptionChainRow_option_iv_prop     sh:path bsip:option_iv ;
    sh:name "Option implied volatility" ;
    sh:description "Implied volatility of that leg." ;
    sh:datatype xsd:decimal ;
    sh:order "9"^^xsd:integer ;
    bsi:unit "per_share_INR" .

_:OptionChainRow_option_buildup_prop     sh:path bsip:option_buildup ;
    sh:name "Option buildup" ;
    sh:description "Leg-level positioning label." ;
    sh:datatype xsd:string ;
    sh:order "10"^^xsd:integer ;
    bsi:vocabulary bsiv:option_buildup ;
    bsi:openEndedVocabulary "so_option_chain.ce_buildup / so_option_chain.pe_buildup" .

_:OptionChainRow_fetched_at_prop     sh:path bsip:fetched_at ;
    sh:name "Fetched at" ;
    sh:description "When the provider response was received — distinct from the date the observation refers to." ;
    sh:datatype xsd:dateTime ;
    sh:order "11"^^xsd:integer .

bsi:FuturesPositioningShape     rdf:type sh:NodeShape ;
    sh:targetClass bsi:FuturesPositioning ;
    sh:name "Futures positioning" ;
    sh:description "Stock-futures open interest, buildup label, rollover percentage, basis and cost of carry for one expiry and session." ;
