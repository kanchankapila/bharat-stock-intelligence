    bsi:grain "claim_key" ;
    sh:property _:MarketClaim_claim_key_prop, _:MarketClaim_id_prop, _:MarketClaim_predicate_prop, _:MarketClaim_object_value_prop, _:MarketClaim_horizon_prop, _:MarketClaim_stance_prop, _:MarketClaim_claim_status_prop, _:MarketClaim_method_prop, _:MarketClaim_available_at_prop, _:MarketClaim_recorded_at_prop, _:MarketClaim_superseded_by_prop .

_:MarketClaim_claim_key_prop     sh:path bsip:claim_key ;
    sh:name "Claim key" ;
    sh:description "Stable key for an explicit market claim." ;
    sh:datatype xsd:string ;
    sh:order "1"^^xsd:integer ;
    sh:minCount "1"^^xsd:integer .

_:MarketClaim_id_prop     sh:path bsip:id ;
    sh:name "Row id" ;
    sh:description "Surrogate key that is NOT stable across a re-fetch or backfill. Never join on this across runs — use the table's natural key." ;
    sh:datatype xsd:string ;
    sh:order "2"^^xsd:integer .

_:MarketClaim_predicate_prop     sh:path bsip:predicate ;
    sh:name "Predicate" ;
    sh:description "Typed relationship label in the instance graph." ;
    sh:datatype xsd:string ;
    sh:order "3"^^xsd:integer .

_:MarketClaim_object_value_prop     sh:path bsip:object_value ;
    sh:name "Object value" ;
    sh:description "Typed object value carried by a graph assertion or claim." ;
    sh:datatype rdf:JSON ;
    sh:order "4"^^xsd:integer .

_:MarketClaim_horizon_prop     sh:path bsip:horizon ;
    sh:name "Claim horizon" ;
    sh:description "Time horizon attached to a claim." ;
    sh:datatype xsd:string ;
    sh:order "5"^^xsd:integer .

_:MarketClaim_stance_prop     sh:path bsip:stance ;
    sh:name "Claim stance" ;
    sh:description "Directional interpretation of a claim, if any." ;
    sh:datatype xsd:string ;
    sh:order "6"^^xsd:integer .

_:MarketClaim_claim_status_prop     sh:path bsip:claim_status ;
    sh:name "Claim status" ;
    sh:description "Observed, inferred, measured, contradicted, or rejected state." ;
    sh:datatype xsd:string ;
    sh:order "7"^^xsd:integer .

_:MarketClaim_method_prop     sh:path bsip:method ;
    sh:name "HTTP method" ;
    sh:description "Request method a registry endpoint requires." ;
    sh:datatype xsd:string ;
    sh:order "8"^^xsd:integer .

_:MarketClaim_available_at_prop     sh:path bsip:available_at ;
    sh:name "Available at" ;
    sh:description "Earliest time the platform could know the assertion." ;
    sh:datatype xsd:dateTime ;
    sh:order "9"^^xsd:integer .

_:MarketClaim_recorded_at_prop     sh:path bsip:recorded_at ;
    sh:name "Recorded at" ;
    sh:description "Time the platform recorded the assertion." ;
    sh:datatype xsd:dateTime ;
    sh:order "10"^^xsd:integer .

_:MarketClaim_superseded_by_prop     sh:path bsip:superseded_by ;
    sh:name "Superseded by" ;
    sh:description "Key of a later claim that replaces this claim." ;
    sh:datatype xsd:string ;
    sh:order "11"^^xsd:integer .

bsi:DecisionEventShape     rdf:type sh:NodeShape ;
    sh:targetClass bsi:DecisionEvent ;
    sh:name "Decision event" ;
    sh:description "An append-only, reconstructable decision record with cutoff, versions, quality, and structured supporting or contradictory evidence." ;
    bsi:grain "decision_key" ;
    sh:property _:DecisionEvent_decision_key_prop, _:DecisionEvent_symbol_prop, _:DecisionEvent_computed_at_prop, _:DecisionEvent_generated_at_prop, _:DecisionEvent_knowledge_cutoff_prop, _:DecisionEvent_knowledge_cutoff_kind_prop, _:DecisionEvent_source_table_prop, _:DecisionEvent_source_key_prop, _:DecisionEvent_ranker_policy_version_prop, _:DecisionEvent_feature_set_version_prop, _:DecisionEvent_model_versions_prop, _:DecisionEvent_unified_score_prop, _:DecisionEvent_classification_prop, _:DecisionEvent_timeframe_prop, _:DecisionEvent_decision_status_prop, _:DecisionEvent_quality_snapshot_prop, _:DecisionEvent_data_watermarks_prop, _:DecisionEvent_veto_reasons_prop, _:DecisionEvent_guardrails_prop, _:DecisionEvent_created_at_prop, _:DecisionEvent_evidence_key_prop, _:DecisionEvent_relation_prop, _:DecisionEvent_evidence_type_prop, _:DecisionEvent_metric_prop, _:DecisionEvent_value_json_prop, _:DecisionEvent_source_ref_prop, _:DecisionEvent_observed_at_prop, _:DecisionEvent_available_at_prop, _:DecisionEvent_confidence_kind_prop, _:DecisionEvent_note_prop .

_:DecisionEvent_decision_key_prop     sh:path bsip:decision_key ;
    sh:name "Decision key" ;
    sh:description "Stable key for a served decision event." ;
    sh:datatype xsd:string ;
    sh:order "1"^^xsd:integer ;
    sh:minCount "1"^^xsd:integer .

_:DecisionEvent_symbol_prop     sh:path bsip:symbol ;
    sh:name "Symbol" ;
    sh:description "Exchange ticker, NSE/BSE convention embedded in the string. The platform's universal join key across ~40 tables." ;
    sh:datatype xsd:string ;
    sh:order "2"^^xsd:integer .

_:DecisionEvent_computed_at_prop     sh:path bsip:computed_at ;
    sh:name "Computed at" ;
    sh:description "When the platform produced the row. NOT uniform across tables: TEXT in `unified_recommendations`, native TIMESTAMPTZ in `confluence_signals`. Cast before comparing the two." ;
    sh:datatype xsd:dateTime ;
    sh:order "3"^^xsd:integer .

_:DecisionEvent_generated_at_prop     sh:path bsip:generated_at ;
    sh:name "Generated at" ;
    sh:description "Time a decision or derived artifact was generated." ;
    sh:datatype xsd:dateTime ;
    sh:order "4"^^xsd:integer .

_:DecisionEvent_knowledge_cutoff_prop     sh:path bsip:knowledge_cutoff ;
    sh:name "Knowledge cutoff" ;
    sh:description "Upper bound on information knowable to a decision." ;
    sh:datatype xsd:dateTime ;
    sh:order "5"^^xsd:integer .

_:DecisionEvent_knowledge_cutoff_kind_prop     sh:path bsip:knowledge_cutoff_kind ;
    sh:name "Knowledge-cutoff kind" ;
    sh:description "How the decision cutoff was derived." ;
    sh:datatype xsd:string ;
    sh:order "6"^^xsd:integer .

_:DecisionEvent_source_table_prop     sh:path bsip:source_table ;
    sh:name "Source table" ;
    sh:description "Physical table that supplied a decision or graph item." ;
    sh:datatype xsd:string ;
    sh:order "7"^^xsd:integer .

_:DecisionEvent_source_key_prop     sh:path bsip:source_key ;
    sh:name "Source key" ;
    sh:description "Stable source-row key carried by a decision event." ;
    sh:datatype xsd:string ;
    sh:order "8"^^xsd:integer .

_:DecisionEvent_ranker_policy_version_prop     sh:path bsip:ranker_policy_version ;
    sh:name "Ranker policy version" ;
    sh:description "Version of the deterministic decision policy." ;
    sh:datatype xsd:string ;
    sh:order "9"^^xsd:integer .

_:DecisionEvent_feature_set_version_prop     sh:path bsip:feature_set_version ;
    sh:name "Feature-set version" ;
    sh:description "Version of the feature snapshot used by a decision." ;
    sh:datatype xsd:string ;
    sh:order "10"^^xsd:integer .

_:DecisionEvent_model_versions_prop     sh:path bsip:model_versions ;
    sh:name "Model versions" ;
    sh:description "Model artifacts used by a decision." ;
    sh:datatype rdf:JSON ;
    sh:order "11"^^xsd:integer .

_:DecisionEvent_unified_score_prop     sh:path bsip:unified_score ;
    sh:name "Unified score" ;
    sh:description "The composite the unified ranker serves. An OUTPUT of the platform, so it is a legitimate feature only for a model predicting something else." ;
    sh:datatype xsd:decimal ;
    sh:order "12"^^xsd:integer ;
    bsi:unit "score_0_100" .

_:DecisionEvent_classification_prop     sh:path bsip:classification ;
    sh:name "Classification" ;
    sh:description "Human-readable action label." ;
    sh:datatype xsd:string ;
    sh:order "13"^^xsd:integer ;
    bsi:vocabulary bsiv:recommendation_classification ;
    sh:in _:DecisionEvent_classification_in0 .

_:DecisionEvent_classification_in0     rdf:first "Strong Buy" ;
    rdf:rest _:DecisionEvent_classification_in1 .

_:DecisionEvent_classification_in1     rdf:first "Buy" ;
    rdf:rest _:DecisionEvent_classification_in2 .

_:DecisionEvent_classification_in2     rdf:first "Hold" ;
    rdf:rest _:DecisionEvent_classification_in3 .

_:DecisionEvent_classification_in3     rdf:first "Sell" ;
    rdf:rest _:DecisionEvent_classification_in4 .

_:DecisionEvent_classification_in4     rdf:first "Strong Sell" ;
    rdf:rest rdf:nil .

_:DecisionEvent_timeframe_prop     sh:path bsip:timeframe ;
    sh:name "Timeframe" ;
    sh:description "Horizon a signal or recommendation is expressed on." ;
    sh:datatype xsd:string ;
    sh:order "14"^^xsd:integer ;
    bsi:vocabulary bsiv:timeframe ;
    sh:in _:DecisionEvent_timeframe_in0 .

_:DecisionEvent_timeframe_in0     rdf:first "INTRADAY" ;
    rdf:rest _:DecisionEvent_timeframe_in1 .

_:DecisionEvent_timeframe_in1     rdf:first "SWING" ;
    rdf:rest _:DecisionEvent_timeframe_in2 .

_:DecisionEvent_timeframe_in2     rdf:first "POSITIONAL" ;
    rdf:rest _:DecisionEvent_timeframe_in3 .

_:DecisionEvent_timeframe_in3     rdf:first "LONG_TERM" ;
    rdf:rest rdf:nil .

_:DecisionEvent_decision_status_prop     sh:path bsip:decision_status ;
    sh:name "Decision status" ;
    sh:description "Advisory, shadow, publishable, blocked, or expired state." ;
    sh:datatype xsd:string ;
    sh:order "15"^^xsd:integer .

_:DecisionEvent_quality_snapshot_prop     sh:path bsip:quality_snapshot ;
    sh:name "Quality snapshot" ;
    sh:description "Data-quality state captured with a decision." ;
    sh:datatype rdf:JSON ;
    sh:order "16"^^xsd:integer .

_:DecisionEvent_data_watermarks_prop     sh:path bsip:data_watermarks ;
    sh:name "Data watermarks" ;
    sh:description "Completeness watermarks captured with a decision." ;
    sh:datatype rdf:JSON ;
    sh:order "17"^^xsd:integer .

_:DecisionEvent_veto_reasons_prop     sh:path bsip:veto_reasons ;
    sh:name "Veto reasons" ;
    sh:description "Structured reasons a decision was blocked or constrained." ;
    sh:datatype rdf:JSON ;
    sh:order "18"^^xsd:integer .

_:DecisionEvent_guardrails_prop     sh:path bsip:guardrails ;
    sh:name "Guardrails" ;
    sh:description "Decision guardrails applied at generation time." ;
    sh:datatype rdf:JSON ;
    sh:order "19"^^xsd:integer .

_:DecisionEvent_created_at_prop     sh:path bsip:created_at ;
    sh:name "Created at" ;
    sh:description "Time the semantic row was created." ;
    sh:datatype xsd:dateTime ;
    sh:order "20"^^xsd:integer .

_:DecisionEvent_evidence_key_prop     sh:path bsip:evidence_key ;
    sh:name "Evidence key" ;
    sh:description "Stable key for source evidence or a decision evidence item." ;
    sh:datatype xsd:string ;
    sh:order "21"^^xsd:integer .

_:DecisionEvent_relation_prop     sh:path bsip:relation ;
    sh:name "Evidence relation" ;
    sh:description "Supports, opposes, context, or veto relationship." ;
    sh:datatype xsd:string ;
    sh:order "22"^^xsd:integer .

_:DecisionEvent_evidence_type_prop     sh:path bsip:evidence_type ;
    sh:name "Evidence type" ;
    sh:description "Kind of evidence attached to a decision." ;
    sh:datatype xsd:string ;
    sh:order "23"^^xsd:integer .

_:DecisionEvent_metric_prop     sh:path bsip:metric ;
    sh:name "Decision metric" ;
    sh:description "Named metric represented by decision evidence." ;
    sh:datatype xsd:string ;
    sh:order "24"^^xsd:integer .

_:DecisionEvent_value_json_prop     sh:path bsip:value_json ;
    sh:name "Decision evidence value" ;
    sh:description "Structured value attached to decision evidence." ;
    sh:datatype rdf:JSON ;
    sh:order "25"^^xsd:integer .

_:DecisionEvent_source_ref_prop     sh:path bsip:source_ref ;
    sh:name "Source reference" ;
    sh:description "Provider or source-row reference for a semantic assertion." ;
    sh:datatype xsd:string ;
    sh:order "26"^^xsd:integer .

_:DecisionEvent_observed_at_prop     sh:path bsip:observed_at ;
    sh:name "Observed at" ;
    sh:description "Time the source observation was made." ;
    sh:datatype xsd:dateTime ;
    sh:order "27"^^xsd:integer .

_:DecisionEvent_available_at_prop     sh:path bsip:available_at ;
    sh:name "Available at" ;
    sh:description "Earliest time the platform could know the assertion." ;
    sh:datatype xsd:dateTime ;
    sh:order "28"^^xsd:integer .

_:DecisionEvent_confidence_kind_prop     sh:path bsip:confidence_kind ;
    sh:name "Confidence kind" ;
    sh:description "Explicit semantics of a confidence value; never an assumed probability." ;
    sh:datatype xsd:string ;
    sh:order "29"^^xsd:integer .

_:DecisionEvent_note_prop     sh:path bsip:note ;
    sh:name "Note" ;
    sh:description "Human-readable semantic or decision note; never evidence by itself." ;
    sh:datatype xsd:string ;
    sh:order "30"^^xsd:integer .

bsi:DecisionOutcomeShape     rdf:type sh:NodeShape ;
    sh:targetClass bsi:DecisionOutcome ;
    sh:name "Decision outcome" ;
    sh:description "A realized outcome attached to a decision under an explicit label definition and horizon." ;
    bsi:grain "(decision_key, label_definition, horizon_days)" ;
    sh:property _:DecisionOutcome_decision_key_prop, _:DecisionOutcome_label_definition_prop, _:DecisionOutcome_horizon_days_prop, _:DecisionOutcome_outcome_status_prop, _:DecisionOutcome_entry_price_prop, _:DecisionOutcome_exit_price_prop, _:DecisionOutcome_return_pct_prop, _:DecisionOutcome_mfe_pct_prop, _:DecisionOutcome_mae_pct_prop, _:DecisionOutcome_resolved_at_prop, _:DecisionOutcome_source_table_prop, _:DecisionOutcome_source_ref_prop, _:DecisionOutcome_created_at_prop .

_:DecisionOutcome_decision_key_prop     sh:path bsip:decision_key ;
    sh:name "Decision key" ;
    sh:description "Stable key for a served decision event." ;
    sh:datatype xsd:string ;
    sh:order "1"^^xsd:integer ;
    sh:minCount "1"^^xsd:integer .

_:DecisionOutcome_label_definition_prop     sh:path bsip:label_definition ;
    sh:name "Label definition" ;
    sh:description "Which rule produced the label. Labels are NOT comparable across definitions — always filter on this column before aggregating accuracy." ;
    sh:datatype xsd:string ;
    sh:order "2"^^xsd:integer ;
    sh:minCount "1"^^xsd:integer ;
    bsi:vocabulary bsiv:label_definition ;
    sh:in _:DecisionOutcome_label_definition_in0 .

_:DecisionOutcome_label_definition_in0     rdf:first "path_barrier" ;
    rdf:rest _:DecisionOutcome_label_definition_in1 .

_:DecisionOutcome_label_definition_in1     rdf:first "terminal_pct2" ;
    rdf:rest rdf:nil .

_:DecisionOutcome_horizon_days_prop     sh:path bsip:horizon_days ;
    sh:name "Horizon (days)" ;
    sh:description "Evaluation horizon a signal or outcome is expressed over. A parameter of the label, not a property of the market." ;
    sh:datatype xsd:integer ;
    sh:order "3"^^xsd:integer ;
    sh:minCount "1"^^xsd:integer ;
    bsi:unit "count" .

_:DecisionOutcome_outcome_status_prop     sh:path bsip:outcome_status ;
    sh:name "Outcome status" ;
    sh:description "Pending, resolved, or invalid outcome state." ;
    sh:datatype xsd:string ;
    sh:order "4"^^xsd:integer .

_:DecisionOutcome_entry_price_prop     sh:path bsip:entry_price ;
    sh:name "Entry price" ;
    sh:description "Assumed or realised entry fill used by an outcome calculation." ;
    sh:datatype xsd:decimal ;
    sh:order "5"^^xsd:integer ;
    bsi:unit "per_share_INR" .

_:DecisionOutcome_exit_price_prop     sh:path bsip:exit_price ;
    sh:name "Exit price" ;
    sh:description "Realised exit fill; only exists on resolved outcomes." ;
    sh:datatype xsd:decimal ;
    sh:order "6"^^xsd:integer ;
    bsi:unit "per_share_INR" .

_:DecisionOutcome_return_pct_prop     sh:path bsip:return_pct ;
    sh:name "Realised return" ;
    sh:description "Terminal return over the horizon. Outcome-side: using it as a feature is a look-ahead bug." ;
    sh:datatype xsd:decimal ;
    sh:order "7"^^xsd:integer ;
    bsi:unit "percent" .

_:DecisionOutcome_mfe_pct_prop     sh:path bsip:mfe_pct ;
    sh:name "Max favourable excursion" ;
    sh:description "Best unrealised gain inside the window. Outcome-side." ;
    sh:datatype xsd:decimal ;
    sh:order "8"^^xsd:integer ;
    bsi:unit "percent" .

_:DecisionOutcome_mae_pct_prop     sh:path bsip:mae_pct ;
    sh:name "Max adverse excursion" ;
    sh:description "Worst unrealised drawdown inside the window. Outcome-side." ;
    sh:datatype xsd:decimal ;
    sh:order "9"^^xsd:integer ;
    bsi:unit "percent" .

_:DecisionOutcome_resolved_at_prop     sh:path bsip:resolved_at ;
    sh:name "Resolved at" ;
    sh:description "Time an outcome became final." ;
    sh:datatype xsd:dateTime ;
    sh:order "10"^^xsd:integer .

_:DecisionOutcome_source_table_prop     sh:path bsip:source_table ;
    sh:name "Source table" ;
    sh:description "Physical table that supplied a decision or graph item." ;
    sh:datatype xsd:string ;
    sh:order "11"^^xsd:integer .

_:DecisionOutcome_source_ref_prop     sh:path bsip:source_ref ;
    sh:name "Source reference" ;
    sh:description "Provider or source-row reference for a semantic assertion." ;
    sh:datatype xsd:string ;
    sh:order "12"^^xsd:integer .

_:DecisionOutcome_created_at_prop     sh:path bsip:created_at ;
    sh:name "Created at" ;
    sh:description "Time the semantic row was created." ;
    sh:datatype xsd:dateTime ;
    sh:order "13"^^xsd:integer .

