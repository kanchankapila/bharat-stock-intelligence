_:FuturesPositioning_symbol_prop     sh:path bsip:symbol ;
    sh:name "Symbol" ;
    sh:description "Exchange ticker, NSE/BSE convention embedded in the string. The platform's universal join key across ~40 tables." ;
    sh:datatype xsd:string ;
    sh:order "1"^^xsd:integer ;
    sh:minCount "1"^^xsd:integer .

_:FuturesPositioning_date_prop     sh:path bsip:date ;
    sh:name "Date" ;
    sh:description "Trading-session date. Day cuts are Asia/Kolkata: a date column is a session, not a midnight-to-midnight instant." ;
    sh:datatype xsd:date ;
    sh:order "2"^^xsd:integer ;
    sh:minCount "1"^^xsd:integer ;
    bsi:unit "calendar_day" .

_:FuturesPositioning_expiry_prop     sh:path bsip:expiry ;
    sh:name "Expiry" ;
    sh:description "Derivative contract expiry. Several expiries coexist per symbol per date." ;
    sh:datatype xsd:date ;
    sh:order "3"^^xsd:integer ;
    sh:minCount "1"^^xsd:integer ;
    bsi:unit "calendar_day" .

_:FuturesPositioning_open_interest_prop     sh:path bsip:open_interest ;
    sh:name "Open interest" ;
    sh:description "Outstanding contracts on a derivative." ;
    sh:datatype xsd:decimal ;
    sh:order "4"^^xsd:integer ;
    bsi:unit "contracts" .

_:FuturesPositioning_oi_change_prop     sh:path bsip:oi_change ;
    sh:name "OI change" ;
    sh:description "Session-over-session open-interest change." ;
    sh:datatype xsd:decimal ;
    sh:order "5"^^xsd:integer ;
    bsi:unit "contracts" .

_:FuturesPositioning_oi_pct_change_prop     sh:path bsip:oi_pct_change ;
    sh:name "OI change percent" ;
    sh:description "Session-over-session open-interest change." ;
    sh:datatype xsd:decimal ;
    sh:order "6"^^xsd:integer ;
    bsi:unit "percent" .

_:FuturesPositioning_oi_buildup_prop     sh:path bsip:oi_buildup ;
    sh:name "OI buildup" ;
    sh:description "Futures positioning label derived from price and OI." ;
    sh:datatype xsd:string ;
    sh:order "7"^^xsd:integer ;
    bsi:vocabulary bsiv:oi_buildup ;
    bsi:openEndedVocabulary "stock_futures_oi_history.oi_buildup" .

_:FuturesPositioning_rollover_pct_prop     sh:path bsip:rollover_pct ;
    sh:name "Rollover percent" ;
    sh:description "Share of open interest rolled from the near to the next expiry." ;
    sh:datatype xsd:decimal ;
    sh:order "8"^^xsd:integer ;
    bsi:unit "percent" .

_:FuturesPositioning_pcr_oi_prop     sh:path bsip:pcr_oi ;
    sh:name "PCR (open interest)" ;
    sh:description "Put-call ratio measured on open interest." ;
    sh:datatype xsd:decimal ;
    sh:order "9"^^xsd:integer ;
    bsi:unit "ratio" .

_:FuturesPositioning_futures_price_prop     sh:path bsip:futures_price ;
    sh:name "Futures price" ;
    sh:description "Price of the futures leg." ;
    sh:datatype xsd:decimal ;
    sh:order "10"^^xsd:integer ;
    bsi:unit "per_share_INR" .

_:FuturesPositioning_spot_price_prop     sh:path bsip:spot_price ;
    sh:name "Spot price" ;
    sh:description "Underlying spot price captured at the same instant as the derivative." ;
    sh:datatype xsd:decimal ;
    sh:order "11"^^xsd:integer ;
    bsi:unit "per_share_INR" .

_:FuturesPositioning_basis_prop     sh:path bsip:basis ;
    sh:name "Basis" ;
    sh:description "Futures price minus spot price." ;
    sh:datatype xsd:decimal ;
    sh:order "12"^^xsd:integer ;
    bsi:unit "per_share_INR" .

_:FuturesPositioning_contracts_prop     sh:path bsip:contracts ;
    sh:name "Contracts" ;
    sh:description "Number of derivative contracts." ;
    sh:datatype xsd:decimal ;
    sh:order "13"^^xsd:integer ;
    bsi:unit "shares" .

_:FuturesPositioning_volume_prop     sh:path bsip:volume ;
    sh:name "Volume" ;
    sh:description "Shares traded in the session." ;
    sh:datatype xsd:decimal ;
    sh:order "14"^^xsd:integer .

_:FuturesPositioning_lot_size_prop     sh:path bsip:lot_size ;
    sh:name "Lot size" ;
    sh:description "Contract multiplier — required to convert a price move into a rupee P&L." ;
    sh:datatype xsd:decimal ;
    sh:order "15"^^xsd:integer ;
    bsi:unit "shares" .

_:FuturesPositioning_source_prop     sh:path bsip:source ;
    sh:name "Source" ;
    sh:description "Which provider or fetcher wrote the row. Provenance is per-row on this platform, so this is the first column to check before trusting a value." ;
    sh:datatype xsd:string ;
    sh:order "16"^^xsd:integer .

_:FuturesPositioning_fetched_at_prop     sh:path bsip:fetched_at ;
    sh:name "Fetched at" ;
    sh:description "When the provider response was received — distinct from the date the observation refers to." ;
    sh:datatype xsd:dateTime ;
    sh:order "17"^^xsd:integer .

_:FuturesPositioning_total_oi_prop     sh:path bsip:total_oi ;
    sh:name "Total open interest" ;
    sh:description "Open interest summed across the expiries a rollover row spans." ;
    sh:datatype xsd:decimal ;
    sh:order "18"^^xsd:integer ;
    bsi:unit "shares" .

_:FuturesPositioning_cost_of_carry_ann_prop     sh:path bsip:cost_of_carry_ann ;
    sh:name "Annualised cost of carry" ;
    sh:description "Futures basis expressed as an annualised rate." ;
    sh:datatype xsd:decimal ;
    sh:order "19"^^xsd:integer ;
    bsi:unit "percent" .

_:FuturesPositioning_close_prop     sh:path bsip:close ;
    sh:name "Close" ;
    sh:description "Session close. The reference price for almost every downstream calculation." ;
    sh:datatype xsd:decimal ;
    sh:order "20"^^xsd:integer ;
    bsi:unit "per_share_INR" .

bsi:IndexDerivativesSnapshotShape     rdf:type sh:NodeShape ;
    sh:targetClass bsi:IndexDerivativesSnapshot ;
    sh:name "Index derivatives snapshot" ;
    sh:description "Index-level positioning: PCR (single-strike time series and EOD), max pain, and aggregate call/put open interest." ;
    bsi:grain "(index_name, date, expiry)" ;
    sh:property _:IndexDerivativesSnapshot_index_name_prop, _:IndexDerivativesSnapshot_date_prop, _:IndexDerivativesSnapshot_expiry_prop, _:IndexDerivativesSnapshot_max_pain_prop, _:IndexDerivativesSnapshot_pcr_oi_prop, _:IndexDerivativesSnapshot_option_oi_prop, _:IndexDerivativesSnapshot_source_prop, _:IndexDerivativesSnapshot_fetched_at_prop, _:IndexDerivativesSnapshot_datetime_prop, _:IndexDerivativesSnapshot_pcr_prop, _:IndexDerivativesSnapshot_close_prop .

_:IndexDerivativesSnapshot_index_name_prop     sh:path bsip:index_name ;
    sh:name "Index name" ;
    sh:description "Index identifier used by the derivatives, PCR and max-pain tables." ;
    sh:datatype xsd:string ;
    sh:order "1"^^xsd:integer ;
    sh:minCount "1"^^xsd:integer .

_:IndexDerivativesSnapshot_date_prop     sh:path bsip:date ;
    sh:name "Date" ;
    sh:description "Trading-session date. Day cuts are Asia/Kolkata: a date column is a session, not a midnight-to-midnight instant." ;
    sh:datatype xsd:date ;
    sh:order "2"^^xsd:integer ;
    sh:minCount "1"^^xsd:integer ;
    bsi:unit "calendar_day" .

_:IndexDerivativesSnapshot_expiry_prop     sh:path bsip:expiry ;
    sh:name "Expiry" ;
    sh:description "Derivative contract expiry. Several expiries coexist per symbol per date." ;
    sh:datatype xsd:date ;
    sh:order "3"^^xsd:integer ;
    sh:minCount "1"^^xsd:integer ;
    bsi:unit "calendar_day" .

_:IndexDerivativesSnapshot_max_pain_prop     sh:path bsip:max_pain ;
    sh:name "Max pain" ;
    sh:description "Strike at which the largest number of option contracts expire worthless." ;
    sh:datatype xsd:decimal ;
    sh:order "4"^^xsd:integer ;
    bsi:unit "index_points" .

_:IndexDerivativesSnapshot_pcr_oi_prop     sh:path bsip:pcr_oi ;
    sh:name "PCR (open interest)" ;
    sh:description "Put-call ratio measured on open interest." ;
    sh:datatype xsd:decimal ;
    sh:order "5"^^xsd:integer ;
    bsi:unit "ratio" .

_:IndexDerivativesSnapshot_option_oi_prop     sh:path bsip:option_oi ;
    sh:name "Option open interest" ;
    sh:description "Open interest on that leg." ;
    sh:datatype xsd:decimal ;
    sh:order "6"^^xsd:integer ;
    bsi:unit "per_share_INR" .

_:IndexDerivativesSnapshot_source_prop     sh:path bsip:source ;
    sh:name "Source" ;
    sh:description "Which provider or fetcher wrote the row. Provenance is per-row on this platform, so this is the first column to check before trusting a value." ;
    sh:datatype xsd:string ;
    sh:order "7"^^xsd:integer .

_:IndexDerivativesSnapshot_fetched_at_prop     sh:path bsip:fetched_at ;
    sh:name "Fetched at" ;
    sh:description "When the provider response was received — distinct from the date the observation refers to." ;
    sh:datatype xsd:dateTime ;
    sh:order "8"^^xsd:integer .

_:IndexDerivativesSnapshot_datetime_prop     sh:path bsip:datetime ;
    sh:name "Timestamp" ;
    sh:description "Intraday bar timestamp, Asia/Kolkata." ;
    sh:datatype xsd:dateTime ;
    sh:order "9"^^xsd:integer .

_:IndexDerivativesSnapshot_pcr_prop     sh:path bsip:pcr ;
    sh:name "Put-call ratio" ;
    sh:description "Index put-call ratio." ;
    sh:datatype xsd:decimal ;
    sh:order "10"^^xsd:integer ;
    bsi:unit "ratio" .

_:IndexDerivativesSnapshot_close_prop     sh:path bsip:close ;
    sh:name "Close" ;
    sh:description "Session close. The reference price for almost every downstream calculation." ;
    sh:datatype xsd:decimal ;
    sh:order "11"^^xsd:integer ;
    bsi:unit "per_share_INR" .

bsi:MoverSnapshotShape     rdf:type sh:NodeShape ;
    sh:targetClass bsi:MoverSnapshot ;
    sh:name "Mover snapshot" ;
    sh:description "A ranked intraday mover list entry from a vendor feed: the platform's within-day event backbone alongside the event triggers." ;
    bsi:grain "(source, trade_date, symbol, rank)" ;
    sh:property _:MoverSnapshot_source_prop, _:MoverSnapshot_date_prop, _:MoverSnapshot_symbol_prop, _:MoverSnapshot_rank_position_prop, _:MoverSnapshot_change_pct_prop, _:MoverSnapshot_payload_json_prop, _:MoverSnapshot_captured_at_prop .

_:MoverSnapshot_source_prop     sh:path bsip:source ;
    sh:name "Source" ;
    sh:description "Which provider or fetcher wrote the row. Provenance is per-row on this platform, so this is the first column to check before trusting a value." ;
    sh:datatype xsd:string ;
    sh:order "1"^^xsd:integer ;
    sh:minCount "1"^^xsd:integer .

_:MoverSnapshot_date_prop     sh:path bsip:date ;
    sh:name "Date" ;
    sh:description "Trading-session date. Day cuts are Asia/Kolkata: a date column is a session, not a midnight-to-midnight instant." ;
    sh:datatype xsd:date ;
    sh:order "2"^^xsd:integer ;
    sh:minCount "1"^^xsd:integer ;
    bsi:unit "calendar_day" .

_:MoverSnapshot_symbol_prop     sh:path bsip:symbol ;
    sh:name "Symbol" ;
    sh:description "Exchange ticker, NSE/BSE convention embedded in the string. The platform's universal join key across ~40 tables." ;
    sh:datatype xsd:string ;
    sh:order "3"^^xsd:integer ;
    sh:minCount "1"^^xsd:integer .

_:MoverSnapshot_rank_position_prop     sh:path bsip:rank_position ;
    sh:name "Importance rank" ;
    sh:description "Rank of a feature within its model run." ;
    sh:datatype xsd:integer ;
    sh:order "4"^^xsd:integer ;
    sh:minCount "1"^^xsd:integer ;
    bsi:unit "count" .

_:MoverSnapshot_change_pct_prop     sh:path bsip:change_pct ;
    sh:name "Change percent" ;
    sh:description "Session or snapshot price change." ;
    sh:datatype xsd:decimal ;
    sh:order "5"^^xsd:integer ;
    bsi:unit "percent" .

_:MoverSnapshot_payload_json_prop     sh:path bsip:payload_json ;
    sh:name "Raw payload" ;
    sh:description "Raw vendor response body retained for replay." ;
    sh:datatype rdf:JSON ;
    sh:order "6"^^xsd:integer .

_:MoverSnapshot_captured_at_prop     sh:path bsip:captured_at ;
    sh:name "Captured at" ;
    sh:description "Snapshot capture time for vendor grids that are otherwise undated." ;
    sh:datatype xsd:dateTime ;
    sh:order "7"^^xsd:integer .

bsi:RegimeStateShape     rdf:type sh:NodeShape ;
    sh:targetClass bsi:RegimeState ;
    sh:name "Regime state" ;
    sh:description "The macro regime for a session, with its posterior probability and the decoded HMM path. Also covers the intraday regime panel." ;
    bsi:grain "one row per date" ;
    sh:property _:RegimeState_date_prop, _:RegimeState_regime_prop, _:RegimeState_regime_prob_prop, _:RegimeState_features_json_prop, _:RegimeState_viterbi_path_json_prop, _:RegimeState_computed_at_prop, _:RegimeState_intraday_regime_prop, _:RegimeState_composite_prop, _:RegimeState_pcr_prop .

_:RegimeState_date_prop     sh:path bsip:date ;
    sh:name "Date" ;
    sh:description "Trading-session date. Day cuts are Asia/Kolkata: a date column is a session, not a midnight-to-midnight instant." ;
    sh:datatype xsd:date ;
    sh:order "1"^^xsd:integer ;
    sh:minCount "1"^^xsd:integer ;
    bsi:unit "calendar_day" .

_:RegimeState_regime_prop     sh:path bsip:regime ;
    sh:name "Market regime" ;
    sh:description "Macro regime label applied to the row's date." ;
    sh:datatype xsd:string ;
    sh:order "2"^^xsd:integer ;
    bsi:vocabulary bsiv:market_regime ;
    sh:in _:RegimeState_regime_in0 .

_:RegimeState_regime_in0     rdf:first "BULL" ;
    rdf:rest _:RegimeState_regime_in1 .

_:RegimeState_regime_in1     rdf:first "BEAR" ;
    rdf:rest _:RegimeState_regime_in2 .

_:RegimeState_regime_in2     rdf:first "SIDEWAYS" ;
    rdf:rest _:RegimeState_regime_in3 .

_:RegimeState_regime_in3     rdf:first "HIGH_VOL" ;
    rdf:rest _:RegimeState_regime_in4 .

_:RegimeState_regime_in4     rdf:first "CRASH" ;
    rdf:rest rdf:nil .

_:RegimeState_regime_prob_prop     sh:path bsip:regime_prob ;
    sh:name "Regime probability" ;
    sh:description "Posterior probability of the HMM regime state for the date." ;
    sh:datatype xsd:decimal ;
    sh:order "3"^^xsd:integer ;
    bsi:unit "probability" .

_:RegimeState_features_json_prop     sh:path bsip:features_json ;
    sh:name "Regime features" ;
    sh:description "JSON payload of the regime model's inputs." ;
    sh:datatype rdf:JSON ;
    sh:order "4"^^xsd:integer .

_:RegimeState_viterbi_path_json_prop     sh:path bsip:viterbi_path_json ;
    sh:name "Viterbi path" ;
    sh:description "Decoded HMM state path." ;
    sh:datatype rdf:JSON ;
    sh:order "5"^^xsd:integer .

_:RegimeState_computed_at_prop     sh:path bsip:computed_at ;
    sh:name "Computed at" ;
    sh:description "When the platform produced the row. NOT uniform across tables: TEXT in `unified_recommendations`, native TIMESTAMPTZ in `confluence_signals`. Cast before comparing the two." ;
    sh:datatype xsd:dateTime ;
    sh:order "6"^^xsd:integer .

_:RegimeState_intraday_regime_prop     sh:path bsip:intraday_regime ;
    sh:name "Intraday regime" ;
    sh:description "Within-session risk state." ;
    sh:datatype xsd:string ;
    sh:order "7"^^xsd:integer ;
    bsi:vocabulary bsiv:intraday_regime ;
    bsi:openEndedVocabulary "intraday_recommendations.intraday_regime" .

_:RegimeState_composite_prop     sh:path bsip:composite ;
    sh:name "Composite" ;
    sh:description "Multi-engine composite stored per symbol and date." ;
    sh:datatype xsd:decimal ;
    sh:order "8"^^xsd:integer ;
    bsi:unit "score_0_100" .

_:RegimeState_pcr_prop     sh:path bsip:pcr ;
    sh:name "Put-call ratio" ;
    sh:description "Index put-call ratio." ;
    sh:datatype xsd:decimal ;
    sh:order "9"^^xsd:integer ;
    bsi:unit "ratio" .

bsi:BreadthObservationShape     rdf:type sh:NodeShape ;
    sh:targetClass bsi:BreadthObservation ;
    sh:name "Breadth observation" ;
    sh:description "Market-wide participation statistics: share of the universe above its 200-day average, advance/decline ratio, net highs minus lows." ;
    bsi:grain "one row per date" ;
    sh:property _:BreadthObservation_date_prop, _:BreadthObservation_pct_above_200dma_prop, _:BreadthObservation_adv_decline_ratio_prop, _:BreadthObservation_computed_at_prop .

_:BreadthObservation_date_prop     sh:path bsip:date ;
    sh:name "Date" ;
    sh:description "Trading-session date. Day cuts are Asia/Kolkata: a date column is a session, not a midnight-to-midnight instant." ;
    sh:datatype xsd:date ;
    sh:order "1"^^xsd:integer ;
    sh:minCount "1"^^xsd:integer ;
    bsi:unit "calendar_day" .

_:BreadthObservation_pct_above_200dma_prop     sh:path bsip:pct_above_200dma ;
    sh:name "Percent above 200-DMA" ;
    sh:description "Breadth measure: share of the universe trading above its 200-day average." ;
    sh:datatype xsd:decimal ;
    sh:order "2"^^xsd:integer ;
    bsi:unit "percent" .

_:BreadthObservation_adv_decline_ratio_prop     sh:path bsip:adv_decline_ratio ;
    sh:name "Advance/decline ratio" ;
    sh:description "Advancing over declining names." ;
    sh:datatype xsd:decimal ;
    sh:order "3"^^xsd:integer ;
    bsi:unit "percent" .

_:BreadthObservation_computed_at_prop     sh:path bsip:computed_at ;
    sh:name "Computed at" ;
    sh:description "When the platform produced the row. NOT uniform across tables: TEXT in `unified_recommendations`, native TIMESTAMPTZ in `confluence_signals`. Cast before comparing the two." ;
    sh:datatype xsd:dateTime ;
    sh:order "4"^^xsd:integer .

bsi:SectorRotationPointShape     rdf:type sh:NodeShape ;
    sh:targetClass bsi:SectorRotationPoint ;
    sh:name "Sector rotation point" ;
    sh:description "Weekly relative-rotation coordinates and quadrant per sector — the intended input to sector-plus-stock relative strength." ;
    bsi:grain "(sector, week_date)" ;
    sh:property _:SectorRotationPoint_sector_prop, _:SectorRotationPoint_week_date_prop, _:SectorRotationPoint_quadrant_prop, _:SectorRotationPoint_return_pct_prop, _:SectorRotationPoint_stocks_count_prop, _:SectorRotationPoint_source_prop, _:SectorRotationPoint_fetched_at_prop .

_:SectorRotationPoint_sector_prop     sh:path bsip:sector ;
    sh:name "Sector" ;
    sh:description "Industry grouping label as supplied by the writing fetcher. No canonical table backs it, so a cross-table sector join can silently lose names." ;
    sh:datatype xsd:string ;
    sh:order "1"^^xsd:integer ;
    sh:minCount "1"^^xsd:integer .

_:SectorRotationPoint_week_date_prop     sh:path bsip:week_date ;
    sh:name "Week date" ;
    sh:description "Weekly anchor used by the sector-rotation panel." ;
    sh:datatype xsd:date ;
    sh:order "2"^^xsd:integer ;
    sh:minCount "1"^^xsd:integer ;
    bsi:unit "calendar_day" .

_:SectorRotationPoint_quadrant_prop     sh:path bsip:quadrant ;
    sh:name "Rotation quadrant" ;
    sh:description "Relative-rotation quadrant for the sector." ;
    sh:datatype xsd:string ;
    sh:order "3"^^xsd:integer ;
    bsi:vocabulary bsiv:rrg_quadrant ;
    sh:in _:SectorRotationPoint_quadrant_in0 .

_:SectorRotationPoint_quadrant_in0     rdf:first "Leading" ;
    rdf:rest _:SectorRotationPoint_quadrant_in1 .

_:SectorRotationPoint_quadrant_in1     rdf:first "Weakening" ;
    rdf:rest _:SectorRotationPoint_quadrant_in2 .

_:SectorRotationPoint_quadrant_in2     rdf:first "Lagging" ;
    rdf:rest _:SectorRotationPoint_quadrant_in3 .

_:SectorRotationPoint_quadrant_in3     rdf:first "Improving" ;
    rdf:rest rdf:nil .

_:SectorRotationPoint_return_pct_prop     sh:path bsip:return_pct ;
    sh:name "Realised return" ;
    sh:description "Terminal return over the horizon. Outcome-side: using it as a feature is a look-ahead bug." ;
    sh:datatype xsd:decimal ;
    sh:order "4"^^xsd:integer ;
    bsi:unit "percent" .

_:SectorRotationPoint_stocks_count_prop     sh:path bsip:stocks_count ;
    sh:name "Constituent count" ;
    sh:description "Members in a sector or index aggregate." ;
    sh:datatype xsd:integer ;
    sh:order "5"^^xsd:integer ;
    bsi:unit "count" .

_:SectorRotationPoint_source_prop     sh:path bsip:source ;
    sh:name "Source" ;
    sh:description "Which provider or fetcher wrote the row. Provenance is per-row on this platform, so this is the first column to check before trusting a value." ;
    sh:datatype xsd:string ;
    sh:order "6"^^xsd:integer .

_:SectorRotationPoint_fetched_at_prop     sh:path bsip:fetched_at ;
    sh:name "Fetched at" ;
    sh:description "When the provider response was received — distinct from the date the observation refers to." ;
    sh:datatype xsd:dateTime ;
    sh:order "7"^^xsd:integer .

bsi:PlatformOutputShape     rdf:type sh:NodeShape ;
    sh:targetClass bsi:PlatformOutput ;
    sh:name "Platform output" ;
    sh:description "Abstract parent for anything this platform computes and serves. Every subclass is an OPINION of this system, not an observation of the market." .

bsi:FeatureVectorShape     rdf:type sh:NodeShape ;
    sh:targetClass bsi:FeatureVector ;
    sh:name "Feature vector" ;
    sh:description "The rolling per-symbol, per-date feature panel the models train on. Features, not information: they re-express price, flow and vendor data." ;
    bsi:grain "(symbol, date, timeframe)" ;
    sh:property _:FeatureVector_symbol_prop, _:FeatureVector_date_prop, _:FeatureVector_timeframe_prop, _:FeatureVector_sma50_prop, _:FeatureVector_sma200_prop, _:FeatureVector_above_sma200_prop, _:FeatureVector_macd_prop, _:FeatureVector_adx_prop, _:FeatureVector_bb_width_prop, _:FeatureVector_vwap_prop, _:FeatureVector_rsi_prop, _:FeatureVector_atr_prop, _:FeatureVector_volume_ratio_prop .

_:FeatureVector_symbol_prop     sh:path bsip:symbol ;
    sh:name "Symbol" ;
    sh:description "Exchange ticker, NSE/BSE convention embedded in the string. The platform's universal join key across ~40 tables." ;
    sh:datatype xsd:string ;
    sh:order "1"^^xsd:integer ;
    sh:minCount "1"^^xsd:integer .

_:FeatureVector_date_prop     sh:path bsip:date ;
    sh:name "Date" ;
    sh:description "Trading-session date. Day cuts are Asia/Kolkata: a date column is a session, not a midnight-to-midnight instant." ;
    sh:datatype xsd:date ;
    sh:order "2"^^xsd:integer ;
    sh:minCount "1"^^xsd:integer ;
    bsi:unit "calendar_day" .

_:FeatureVector_timeframe_prop     sh:path bsip:timeframe ;
    sh:name "Timeframe" ;
    sh:description "Horizon a signal or recommendation is expressed on." ;
    sh:datatype xsd:string ;
    sh:order "3"^^xsd:integer ;
    sh:minCount "1"^^xsd:integer ;
    bsi:vocabulary bsiv:timeframe ;
    sh:in _:FeatureVector_timeframe_in0 .

_:FeatureVector_timeframe_in0     rdf:first "INTRADAY" ;
    rdf:rest _:FeatureVector_timeframe_in1 .

_:FeatureVector_timeframe_in1     rdf:first "SWING" ;
    rdf:rest _:FeatureVector_timeframe_in2 .

_:FeatureVector_timeframe_in2     rdf:first "POSITIONAL" ;
    rdf:rest _:FeatureVector_timeframe_in3 .

_:FeatureVector_timeframe_in3     rdf:first "LONG_TERM" ;
    rdf:rest rdf:nil .

_:FeatureVector_sma50_prop     sh:path bsip:sma50 ;
    sh:name "SMA 50" ;
    sh:description "50-session simple moving average level." ;
    sh:datatype xsd:decimal ;
    sh:order "4"^^xsd:integer ;
    bsi:unit "per_share_INR" .

_:FeatureVector_sma200_prop     sh:path bsip:sma200 ;
    sh:name "SMA 200" ;
    sh:description "200-session simple moving average level." ;
    sh:datatype xsd:decimal ;
    sh:order "5"^^xsd:integer ;
    bsi:unit "per_share_INR" .

_:FeatureVector_above_sma200_prop     sh:path bsip:above_sma200 ;
    sh:name "Above 200-DMA" ;
    sh:description "Price above its 200-session average." ;
    sh:datatype xsd:boolean ;
    sh:order "6"^^xsd:integer .

_:FeatureVector_macd_prop     sh:path bsip:macd ;
    sh:name "MACD" ;
    sh:description "MACD line value." ;
    sh:datatype xsd:decimal ;
    sh:order "7"^^xsd:integer ;
    bsi:unit "per_share_INR" .

_:FeatureVector_adx_prop     sh:path bsip:adx ;
    sh:name "ADX" ;
    sh:description "Trend-strength indicator; measured edge approximately zero." ;
    sh:datatype xsd:decimal ;
    sh:order "8"^^xsd:integer ;
    bsi:unit "index_points" .

_:FeatureVector_bb_width_prop     sh:path bsip:bb_width ;
    sh:name "Bollinger band width" ;
    sh:description "Band width, a volatility proxy." ;
    sh:datatype xsd:decimal ;
    sh:order "9"^^xsd:integer ;
    bsi:unit "ratio" .

_:FeatureVector_vwap_prop     sh:path bsip:vwap ;
    sh:name "VWAP" ;
    sh:description "Volume-weighted average price; present on intraday bars only." ;
    sh:datatype xsd:decimal ;
    sh:order "10"^^xsd:integer ;
    bsi:unit "per_share_INR" .

_:FeatureVector_rsi_prop     sh:path bsip:rsi ;
    sh:name "RSI (14)" ;
    sh:description "Wilder RSI. Graded on this platform as a mean-reversion input with NEGATIVE rank-IC at 5 days — a finding, not a defect." ;
    sh:datatype xsd:decimal ;
    sh:order "11"^^xsd:integer ;
    bsi:unit "index_points" .

_:FeatureVector_atr_prop     sh:path bsip:atr ;
    sh:name "ATR" ;
    sh:description "Average true range, used for stop placement." ;
    sh:datatype xsd:decimal ;
    sh:order "12"^^xsd:integer ;
    bsi:unit "per_share_INR" .

_:FeatureVector_volume_ratio_prop     sh:path bsip:volume_ratio ;
    sh:name "Volume ratio" ;
    sh:description "Session volume over its recent average." ;
    sh:datatype xsd:decimal ;
    sh:order "13"^^xsd:integer ;
    bsi:unit "ratio" .

bsi:TechnicalSignalShape     rdf:type sh:NodeShape ;
    sh:targetClass bsi:TechnicalSignal ;
    sh:name "Technical signal" ;
    sh:description "The wide per-symbol, per-date technical panel: indicators, regime stamp, flow and fundamental context columns, plus the model's probability outputs." ;
    bsi:grain "(symbol, date)" ;
    sh:property _:TechnicalSignal_symbol_prop, _:TechnicalSignal_date_prop, _:TechnicalSignal_signal_score_prop, _:TechnicalSignal_rsi_prop, _:TechnicalSignal_sma50_prop, _:TechnicalSignal_sma200_prop, _:TechnicalSignal_macd_prop, _:TechnicalSignal_adx_prop, _:TechnicalSignal_bb_width_prop, _:TechnicalSignal_volume_ratio_prop, _:TechnicalSignal_above_sma200_prop, _:TechnicalSignal_cmp_prop, _:TechnicalSignal_change_pct_prop, _:TechnicalSignal_ai_insight_prop, _:TechnicalSignal_stop_loss_prop, _:TechnicalSignal_timeframe_prop, _:TechnicalSignal_computed_at_prop, _:TechnicalSignal_delivery_pct_prop, _:TechnicalSignal_fii_3d_net_prop, _:TechnicalSignal_dii_3d_net_prop, _:TechnicalSignal_win_probability_prop, _:TechnicalSignal_calibrated_win_probability_prop, _:TechnicalSignal_iv_rank_prop, _:TechnicalSignal_cs_score_prop, _:TechnicalSignal_oi_pct_change_prop, _:TechnicalSignal_rollover_pct_prop, _:TechnicalSignal_cost_of_carry_ann_prop, _:TechnicalSignal_mf_holding_pct_prop, _:TechnicalSignal_value_cr_prop, _:TechnicalSignal_return_on_equity_prop, _:TechnicalSignal_operating_margins_prop, _:TechnicalSignal_pledge_pct_prop, _:TechnicalSignal_n_analysts_prop, _:TechnicalSignal_pcr_oi_prop, _:TechnicalSignal_asm_flag_prop, _:TechnicalSignal_fcf_positive_prop, _:TechnicalSignal_signals_json_prop, _:TechnicalSignal_sentiment_score_prop, _:TechnicalSignal_regime_prop, _:TechnicalSignal_iv_hv_ratio_prop .

_:TechnicalSignal_symbol_prop     sh:path bsip:symbol ;
    sh:name "Symbol" ;
    sh:description "Exchange ticker, NSE/BSE convention embedded in the string. The platform's universal join key across ~40 tables." ;
    sh:datatype xsd:string ;
    sh:order "1"^^xsd:integer ;
    sh:minCount "1"^^xsd:integer .

_:TechnicalSignal_date_prop     sh:path bsip:date ;
    sh:name "Date" ;
    sh:description "Trading-session date. Day cuts are Asia/Kolkata: a date column is a session, not a midnight-to-midnight instant." ;
    sh:datatype xsd:date ;
    sh:order "2"^^xsd:integer ;
    sh:minCount "1"^^xsd:integer ;
    bsi:unit "calendar_day" .

_:TechnicalSignal_signal_score_prop     sh:path bsip:signal_score ;
    sh:name "Signal score" ;
    sh:description "Score attached to a technical signal at creation." ;
    sh:datatype xsd:decimal ;
    sh:order "3"^^xsd:integer ;
    bsi:unit "score_0_100" .

_:TechnicalSignal_rsi_prop     sh:path bsip:rsi ;
    sh:name "RSI (14)" ;
    sh:description "Wilder RSI. Graded on this platform as a mean-reversion input with NEGATIVE rank-IC at 5 days — a finding, not a defect." ;
    sh:datatype xsd:decimal ;
    sh:order "4"^^xsd:integer ;
    bsi:unit "index_points" .

_:TechnicalSignal_sma50_prop     sh:path bsip:sma50 ;
    sh:name "SMA 50" ;
    sh:description "50-session simple moving average level." ;
    sh:datatype xsd:decimal ;
    sh:order "5"^^xsd:integer ;
    bsi:unit "per_share_INR" .

_:TechnicalSignal_sma200_prop     sh:path bsip:sma200 ;
    sh:name "SMA 200" ;
    sh:description "200-session simple moving average level." ;
    sh:datatype xsd:decimal ;
    sh:order "6"^^xsd:integer ;
    bsi:unit "per_share_INR" .

_:TechnicalSignal_macd_prop     sh:path bsip:macd ;
    sh:name "MACD" ;
    sh:description "MACD line value." ;
    sh:datatype xsd:decimal ;
    sh:order "7"^^xsd:integer ;
    bsi:unit "per_share_INR" .

_:TechnicalSignal_adx_prop     sh:path bsip:adx ;
    sh:name "ADX" ;
    sh:description "Trend-strength indicator; measured edge approximately zero." ;
    sh:datatype xsd:decimal ;
    sh:order "8"^^xsd:integer ;
    bsi:unit "index_points" .

_:TechnicalSignal_bb_width_prop     sh:path bsip:bb_width ;
    sh:name "Bollinger band width" ;
    sh:description "Band width, a volatility proxy." ;
    sh:datatype xsd:decimal ;
    sh:order "9"^^xsd:integer ;
    bsi:unit "ratio" .

_:TechnicalSignal_volume_ratio_prop     sh:path bsip:volume_ratio ;
    sh:name "Volume ratio" ;
    sh:description "Session volume over its recent average." ;
    sh:datatype xsd:decimal ;
    sh:order "10"^^xsd:integer ;
    bsi:unit "ratio" .

_:TechnicalSignal_above_sma200_prop     sh:path bsip:above_sma200 ;
    sh:name "Above 200-DMA" ;
    sh:description "Price above its 200-session average." ;
    sh:datatype xsd:boolean ;
    sh:order "11"^^xsd:integer .

_:TechnicalSignal_cmp_prop     sh:path bsip:cmp ;
    sh:name "Current market price" ;
    sh:description "Last traded price at the moment the row was written — a point-in-time snapshot, not a session close. Do not substitute it for `close`." ;
    sh:datatype xsd:decimal ;
    sh:order "12"^^xsd:integer ;
    bsi:unit "per_share_INR" .

_:TechnicalSignal_change_pct_prop     sh:path bsip:change_pct ;
    sh:name "Change percent" ;
    sh:description "Session or snapshot price change." ;
    sh:datatype xsd:decimal ;
    sh:order "13"^^xsd:integer ;
    bsi:unit "percent" .

_:TechnicalSignal_ai_insight_prop     sh:path bsip:ai_insight ;
    sh:name "AI insight" ;
    sh:description "Generated commentary attached to a signal." ;
    sh:datatype xsd:string ;
    sh:order "14"^^xsd:integer .

_:TechnicalSignal_stop_loss_prop     sh:path bsip:stop_loss ;
    sh:name "Stop loss" ;
    sh:description "Advised protective stop." ;
    sh:datatype xsd:decimal ;
    sh:order "15"^^xsd:integer ;
    bsi:unit "per_share_INR" .

_:TechnicalSignal_timeframe_prop     sh:path bsip:timeframe ;
    sh:name "Timeframe" ;
    sh:description "Horizon a signal or recommendation is expressed on." ;
    sh:datatype xsd:string ;
    sh:order "16"^^xsd:integer ;
    bsi:vocabulary bsiv:timeframe ;
    sh:in _:TechnicalSignal_timeframe_in0 .

_:TechnicalSignal_timeframe_in0     rdf:first "INTRADAY" ;
    rdf:rest _:TechnicalSignal_timeframe_in1 .

_:TechnicalSignal_timeframe_in1     rdf:first "SWING" ;
    rdf:rest _:TechnicalSignal_timeframe_in2 .

_:TechnicalSignal_timeframe_in2     rdf:first "POSITIONAL" ;
    rdf:rest _:TechnicalSignal_timeframe_in3 .

_:TechnicalSignal_timeframe_in3     rdf:first "LONG_TERM" ;
    rdf:rest rdf:nil .

_:TechnicalSignal_computed_at_prop     sh:path bsip:computed_at ;
    sh:name "Computed at" ;
    sh:description "When the platform produced the row. NOT uniform across tables: TEXT in `unified_recommendations`, native TIMESTAMPTZ in `confluence_signals`. Cast before comparing the two." ;
    sh:datatype xsd:dateTime ;
    sh:order "17"^^xsd:integer .

_:TechnicalSignal_delivery_pct_prop     sh:path bsip:delivery_pct ;
    sh:name "Delivery percentage" ;
    sh:description "Delivered shares as a share of traded shares. T+1 by construction, underexploited here, and the platform's best high-frequency ownership proxy." ;
    sh:datatype xsd:decimal ;
    sh:order "18"^^xsd:integer ;
    bsi:unit "percent" .

_:TechnicalSignal_fii_3d_net_prop     sh:path bsip:fii_3d_net ;
    sh:name "FII net 3-day flow" ;
    sh:description "Foreign-institutional net cash flow over three sessions. Coincident-to-lagging, not leading." ;
    sh:datatype xsd:decimal ;
    sh:order "19"^^xsd:integer ;
    bsi:unit "ratio" .

_:TechnicalSignal_dii_3d_net_prop     sh:path bsip:dii_3d_net ;
    sh:name "DII net 3-day flow" ;
    sh:description "Domestic-institutional net flow over three sessions." ;
    sh:datatype xsd:decimal ;
    sh:order "20"^^xsd:integer ;
    bsi:unit "ratio" .

_:TechnicalSignal_win_probability_prop     sh:path bsip:win_probability ;
    sh:name "Win probability" ;
    sh:description "Raw model probability, isotonic-banded downstream. Forbidden as a feature: it is a model output, so feeding it back leaks the model into its own inputs." ;
    sh:datatype xsd:decimal ;
    sh:order "21"^^xsd:integer ;
    bsi:unit "probability" .

_:TechnicalSignal_calibrated_win_probability_prop     sh:path bsip:calibrated_win_probability ;
    sh:name "Calibrated win probability" ;
    sh:description "Isotonic-calibrated variant of the above; same prohibition." ;
    sh:datatype xsd:decimal ;
    sh:order "22"^^xsd:integer ;
    bsi:unit "probability" .

_:TechnicalSignal_iv_rank_prop     sh:path bsip:iv_rank ;
    sh:name "IV rank" ;
    sh:description "Where current implied volatility sits inside its own history." ;
    sh:datatype xsd:decimal ;
    sh:order "23"^^xsd:integer ;
    bsi:unit "percent" .

_:TechnicalSignal_cs_score_prop     sh:path bsip:cs_score ;
    sh:name "Cross-sectional score" ;
    sh:description "Rank-based cross-sectional output; measured 0.0 across all regimes." ;
    sh:datatype xsd:decimal ;
    sh:order "24"^^xsd:integer ;
    bsi:unit "score_0_100" .

_:TechnicalSignal_oi_pct_change_prop     sh:path bsip:oi_pct_change ;
    sh:name "OI change percent" ;
    sh:description "Session-over-session open-interest change." ;
    sh:datatype xsd:decimal ;
    sh:order "25"^^xsd:integer ;
    bsi:unit "percent" .

_:TechnicalSignal_rollover_pct_prop     sh:path bsip:rollover_pct ;
    sh:name "Rollover percent" ;
    sh:description "Share of open interest rolled from the near to the next expiry." ;
    sh:datatype xsd:decimal ;
    sh:order "26"^^xsd:integer ;
    bsi:unit "percent" .

_:TechnicalSignal_cost_of_carry_ann_prop     sh:path bsip:cost_of_carry_ann ;
    sh:name "Annualised cost of carry" ;
    sh:description "Futures basis expressed as an annualised rate." ;
    sh:datatype xsd:decimal ;
    sh:order "27"^^xsd:integer ;
    bsi:unit "percent" .

_:TechnicalSignal_mf_holding_pct_prop     sh:path bsip:mf_holding_pct ;
    sh:name "Mutual-fund holding percent" ;
    sh:description "Aggregate mutual-fund ownership of the symbol." ;
    sh:datatype xsd:decimal ;
    sh:order "28"^^xsd:integer ;
    bsi:unit "percent" .

_:TechnicalSignal_value_cr_prop     sh:path bsip:value_cr ;
    sh:name "Value (crore)" ;
    sh:description "Transaction value in CRORES, as a bare number. The multiplier is not declared anywhere in the schema — see alignment.py." ;
    sh:datatype xsd:decimal ;
    sh:order "29"^^xsd:integer .

_:TechnicalSignal_return_on_equity_prop     sh:path bsip:return_on_equity ;
    sh:name "Return on equity" ;
    sh:description "Vendor-computed ROE." ;
    sh:datatype xsd:decimal ;
    sh:order "30"^^xsd:integer ;
    bsi:unit "percent" .

_:TechnicalSignal_operating_margins_prop     sh:path bsip:operating_margins ;
    sh:name "Operating margin" ;
    sh:description "Vendor-computed operating margin." ;
    sh:datatype xsd:decimal ;
    sh:order "31"^^xsd:integer ;
    bsi:unit "percent" .

_:TechnicalSignal_pledge_pct_prop     sh:path bsip:pledge_pct ;
    sh:name "Pledged percent" ;
    sh:description "Promoter shares pledged as collateral." ;
    sh:datatype xsd:decimal ;
    sh:order "32"^^xsd:integer ;
    bsi:unit "percent" .

_:TechnicalSignal_n_analysts_prop     sh:path bsip:n_analysts ;
    sh:name "Analyst count" ;
    sh:description "Contributing analysts in the consensus snapshot." ;
    sh:datatype xsd:integer ;
    sh:order "33"^^xsd:integer ;
    bsi:unit "count" .

_:TechnicalSignal_pcr_oi_prop     sh:path bsip:pcr_oi ;
    sh:name "PCR (open interest)" ;
    sh:description "Put-call ratio measured on open interest." ;
    sh:datatype xsd:decimal ;
    sh:order "34"^^xsd:integer ;
    bsi:unit "ratio" .

_:TechnicalSignal_asm_flag_prop     sh:path bsip:asm_flag ;
    sh:name "ASM flag" ;
    sh:description "Exchange surveillance listing — a tradability constraint, not a signal." ;
    sh:datatype xsd:boolean ;
    sh:order "35"^^xsd:integer .

_:TechnicalSignal_fcf_positive_prop     sh:path bsip:fcf_positive ;
    sh:name "Positive free cash flow" ;
    sh:description "Sign of free cash flow." ;
    sh:datatype xsd:boolean ;
    sh:order "36"^^xsd:integer .

_:TechnicalSignal_signals_json_prop     sh:path bsip:signals_json ;
    sh:name "Signals payload" ;
    sh:description "Serialized signal bundle for the row." ;
    sh:datatype rdf:JSON ;
    sh:order "37"^^xsd:integer .

_:TechnicalSignal_sentiment_score_prop     sh:path bsip:sentiment_score ;
    sh:name "Vendor sentiment score" ;
    sh:description "Vendor's numeric sentiment." ;
    sh:datatype xsd:decimal ;
    sh:order "38"^^xsd:integer ;
    bsi:unit "score_minus1_1" .

_:TechnicalSignal_regime_prop     sh:path bsip:regime ;
    sh:name "Market regime" ;
    sh:description "Macro regime label applied to the row's date." ;
    sh:datatype xsd:string ;
    sh:order "39"^^xsd:integer ;
    bsi:vocabulary bsiv:market_regime ;
    sh:in _:TechnicalSignal_regime_in0 .

_:TechnicalSignal_regime_in0     rdf:first "BULL" ;
    rdf:rest _:TechnicalSignal_regime_in1 .

_:TechnicalSignal_regime_in1     rdf:first "BEAR" ;
    rdf:rest _:TechnicalSignal_regime_in2 .

_:TechnicalSignal_regime_in2     rdf:first "SIDEWAYS" ;
    rdf:rest _:TechnicalSignal_regime_in3 .

_:TechnicalSignal_regime_in3     rdf:first "HIGH_VOL" ;
    rdf:rest _:TechnicalSignal_regime_in4 .

_:TechnicalSignal_regime_in4     rdf:first "CRASH" ;
    rdf:rest rdf:nil .

_:TechnicalSignal_iv_hv_ratio_prop     sh:path bsip:iv_hv_ratio ;
    sh:name "IV/HV ratio" ;
    sh:description "Implied over historical volatility — a cheap richness measure." ;
    sh:datatype xsd:decimal ;
    sh:order "40"^^xsd:integer ;
    bsi:unit "ratio" .

bsi:EngineScoreShape     rdf:type sh:NodeShape ;
    sh:targetClass bsi:EngineScore ;
    sh:name "Engine score" ;
    sh:description "A single engine's, or the multi-engine composite's, score for a symbol and date with its engine-coverage count." ;
    bsi:grain "(symbol, date)" ;
    sh:property _:EngineScore_symbol_prop, _:EngineScore_computed_at_prop, _:EngineScore_confluence_score_prop, _:EngineScore_conviction_level_prop, _:EngineScore_active_screener_count_prop, _:EngineScore_bullish_screener_count_prop, _:EngineScore_bearish_screener_count_prop, _:EngineScore_screener_ids_json_prop, _:EngineScore_screener_names_json_prop, _:EngineScore_screener_weights_json_prop, _:EngineScore_fundamental_score_prop, _:EngineScore_ml_breakout_probability_prop, _:EngineScore_ml_trend_probability_prop, _:EngineScore_entry_zone_low_prop, _:EngineScore_entry_zone_high_prop, _:EngineScore_stop_loss_prop, _:EngineScore_target_1_prop, _:EngineScore_target_2_prop, _:EngineScore_target_3_prop, _:EngineScore_risk_reward_prop, _:EngineScore_ai_insight_prop, _:EngineScore_trade_reasoning_prop, _:EngineScore_sector_prop, _:EngineScore_market_cap_prop, _:EngineScore_current_price_prop, _:EngineScore_current_volume_prop, _:EngineScore_rsi_prop, _:EngineScore_atr_prop, _:EngineScore_expiry_prop, _:EngineScore_date_prop, _:EngineScore_composite_prop, _:EngineScore_engine_coverage_count_prop, _:EngineScore_timeframe_prop, _:EngineScore_win_probability_prop, _:EngineScore_classification_prop, _:EngineScore_last_updated_prop .

_:EngineScore_symbol_prop     sh:path bsip:symbol ;
    sh:name "Symbol" ;
    sh:description "Exchange ticker, NSE/BSE convention embedded in the string. The platform's universal join key across ~40 tables." ;
    sh:datatype xsd:string ;
    sh:order "1"^^xsd:integer ;
    sh:minCount "1"^^xsd:integer .

_:EngineScore_computed_at_prop     sh:path bsip:computed_at ;
    sh:name "Computed at" ;
    sh:description "When the platform produced the row. NOT uniform across tables: TEXT in `unified_recommendations`, native TIMESTAMPTZ in `confluence_signals`. Cast before comparing the two." ;
    sh:datatype xsd:dateTime ;
    sh:order "2"^^xsd:integer .

_:EngineScore_confluence_score_prop     sh:path bsip:confluence_score ;
    sh:name "Confluence score" ;
    sh:description "Cross-evidence agreement score. The only engine score with a growing positive graded reading on this platform." ;
    sh:datatype xsd:decimal ;
    sh:order "3"^^xsd:integer ;
    bsi:unit "score_0_100" .

_:EngineScore_conviction_level_prop     sh:path bsip:conviction_level ;
    sh:name "Conviction level" ;
    sh:description "Ranked conviction bucket." ;
    sh:datatype xsd:string ;
    sh:order "4"^^xsd:integer ;
    bsi:vocabulary bsiv:conviction ;
    sh:in _:EngineScore_conviction_level_in0 .

_:EngineScore_conviction_level_in0     rdf:first "S_ELITE" ;
    rdf:rest _:EngineScore_conviction_level_in1 .

_:EngineScore_conviction_level_in1     rdf:first "A_HIGH" ;
    rdf:rest _:EngineScore_conviction_level_in2 .

_:EngineScore_conviction_level_in2     rdf:first "D_MARGINAL" ;
    rdf:rest rdf:nil .

_:EngineScore_active_screener_count_prop     sh:path bsip:active_screener_count ;
    sh:name "Active screener count" ;
    sh:description "Distinct screeners holding the name at once." ;
    sh:datatype xsd:integer ;
    sh:order "5"^^xsd:integer ;
    bsi:unit "count" .

_:EngineScore_bullish_screener_count_prop     sh:path bsip:bullish_screener_count ;
    sh:name "Bullish screener count" ;
    sh:description "Screener appearances with an inferred bullish bias." ;
    sh:datatype xsd:integer ;
    sh:order "6"^^xsd:integer ;
    bsi:unit "count" .

_:EngineScore_bearish_screener_count_prop     sh:path bsip:bearish_screener_count ;
    sh:name "Bearish screener count" ;
    sh:description "Screener appearances with an inferred bearish bias." ;
    sh:datatype xsd:integer ;
    sh:order "7"^^xsd:integer ;
    bsi:unit "count" .

_:EngineScore_screener_ids_json_prop     sh:path bsip:screener_ids_json ;
    sh:name "Screener ids" ;
    sh:description "JSON array of screener ids." ;
    sh:datatype rdf:JSON ;
    sh:order "8"^^xsd:integer .

_:EngineScore_screener_names_json_prop     sh:path bsip:screener_names_json ;
    sh:name "Screener names" ;
    sh:description "JSON array of contributing screeners." ;
    sh:datatype rdf:JSON ;
    sh:order "9"^^xsd:integer .

_:EngineScore_screener_weights_json_prop     sh:path bsip:screener_weights_json ;
    sh:name "Screener weights" ;
    sh:description "JSON map of screener id to the weight it carried at scoring time." ;
    sh:datatype rdf:JSON ;
    sh:order "10"^^xsd:integer .

_:EngineScore_fundamental_score_prop     sh:path bsip:fundamental_score ;
    sh:name "Fundamental score" ;
    sh:description "Vendor-derived fundamental composite." ;
    sh:datatype xsd:decimal ;
    sh:order "11"^^xsd:integer ;
    bsi:unit "score_0_100" .

_:EngineScore_ml_breakout_probability_prop     sh:path bsip:ml_breakout_probability ;
    sh:name "ML breakout probability" ;
    sh:description "Model probability of a breakout. A model output — not a feature." ;
    sh:datatype xsd:decimal ;
    sh:order "12"^^xsd:integer ;
    bsi:unit "probability" .

_:EngineScore_ml_trend_probability_prop     sh:path bsip:ml_trend_probability ;
    sh:name "ML trend probability" ;
    sh:description "Model probability of trend continuation. A model output — not a feature." ;
    sh:datatype xsd:decimal ;
    sh:order "13"^^xsd:integer ;
    bsi:unit "probability" .

_:EngineScore_entry_zone_low_prop     sh:path bsip:entry_zone_low ;
    sh:name "Entry zone low" ;
    sh:description "Lower bound of the advised entry zone." ;
    sh:datatype xsd:decimal ;
    sh:order "14"^^xsd:integer ;
    bsi:unit "per_share_INR" .

_:EngineScore_entry_zone_high_prop     sh:path bsip:entry_zone_high ;
    sh:name "Entry zone high" ;
    sh:description "Upper bound of the advised entry zone." ;
    sh:datatype xsd:decimal ;
    sh:order "15"^^xsd:integer ;
    bsi:unit "per_share_INR" .

_:EngineScore_stop_loss_prop     sh:path bsip:stop_loss ;
    sh:name "Stop loss" ;
    sh:description "Advised protective stop." ;
    sh:datatype xsd:decimal ;
    sh:order "16"^^xsd:integer ;
    bsi:unit "per_share_INR" .

_:EngineScore_target_1_prop     sh:path bsip:target_1 ;
    sh:name "Target 1" ;
    sh:description "First advised target." ;
    sh:datatype xsd:decimal ;
    sh:order "17"^^xsd:integer ;
    bsi:unit "per_share_INR" .

_:EngineScore_target_2_prop     sh:path bsip:target_2 ;
    sh:name "Target 2" ;
    sh:description "Second advised target." ;
    sh:datatype xsd:decimal ;
    sh:order "18"^^xsd:integer ;
    bsi:unit "per_share_INR" .

_:EngineScore_target_3_prop     sh:path bsip:target_3 ;
    sh:name "Target 3" ;
    sh:description "Third advised target." ;
    sh:datatype xsd:decimal ;
    sh:order "19"^^xsd:integer ;
    bsi:unit "per_share_INR" .

_:EngineScore_risk_reward_prop     sh:path bsip:risk_reward ;
    sh:name "Risk/reward" ;
    sh:description "Target distance over stop distance on a served recommendation." ;
    sh:datatype xsd:decimal ;
    sh:order "20"^^xsd:integer ;
    bsi:unit "ratio" .

_:EngineScore_ai_insight_prop     sh:path bsip:ai_insight ;
    sh:name "AI insight" ;
    sh:description "Generated commentary attached to a signal." ;
    sh:datatype xsd:string ;
    sh:order "21"^^xsd:integer .

_:EngineScore_trade_reasoning_prop     sh:path bsip:trade_reasoning ;
    sh:name "Trade reasoning" ;
    sh:description "Why the platform served this trade. Generated text — an explanation, not evidence." ;
    sh:datatype xsd:string ;
    sh:order "22"^^xsd:integer .

_:EngineScore_sector_prop     sh:path bsip:sector ;
    sh:name "Sector" ;
    sh:description "Industry grouping label as supplied by the writing fetcher. No canonical table backs it, so a cross-table sector join can silently lose names." ;
    sh:datatype xsd:string ;
    sh:order "23"^^xsd:integer .

_:EngineScore_market_cap_prop     sh:path bsip:market_cap ;
    sh:name "Market capitalisation" ;
    sh:description "Vendor-computed market cap. The stored unit is NOT declared anywhere in the schema — confirm it before aggregating across tables." ;
    sh:datatype xsd:decimal ;
    sh:order "24"^^xsd:integer ;
    bsi:unit "INR_or_crore_UNDECLARED" .

_:EngineScore_current_price_prop     sh:path bsip:current_price ;
    sh:name "Current price" ;
    sh:description "Snapshot price at write time." ;
    sh:datatype xsd:decimal ;
    sh:order "25"^^xsd:integer ;
    bsi:unit "per_share_INR" .

_:EngineScore_current_volume_prop     sh:path bsip:current_volume ;
    sh:name "Current volume" ;
    sh:description "Snapshot volume at write time." ;
    sh:datatype xsd:decimal ;
    sh:order "26"^^xsd:integer .

_:EngineScore_rsi_prop     sh:path bsip:rsi ;
    sh:name "RSI (14)" ;
    sh:description "Wilder RSI. Graded on this platform as a mean-reversion input with NEGATIVE rank-IC at 5 days — a finding, not a defect." ;
    sh:datatype xsd:decimal ;
    sh:order "27"^^xsd:integer ;
    bsi:unit "index_points" .

_:EngineScore_atr_prop     sh:path bsip:atr ;
    sh:name "ATR" ;
    sh:description "Average true range, used for stop placement." ;
    sh:datatype xsd:decimal ;
    sh:order "28"^^xsd:integer ;
    bsi:unit "per_share_INR" .

_:EngineScore_expiry_prop     sh:path bsip:expiry ;
    sh:name "Expiry" ;
    sh:description "Derivative contract expiry. Several expiries coexist per symbol per date." ;
    sh:datatype xsd:date ;
    sh:order "29"^^xsd:integer ;
    bsi:unit "calendar_day" .

_:EngineScore_date_prop     sh:path bsip:date ;
    sh:name "Date" ;
    sh:description "Trading-session date. Day cuts are Asia/Kolkata: a date column is a session, not a midnight-to-midnight instant." ;
    sh:datatype xsd:date ;
    sh:order "30"^^xsd:integer ;
    sh:minCount "1"^^xsd:integer ;
    bsi:unit "calendar_day" .

_:EngineScore_composite_prop     sh:path bsip:composite ;
    sh:name "Composite" ;
    sh:description "Multi-engine composite stored per symbol and date." ;
    sh:datatype xsd:decimal ;
    sh:order "31"^^xsd:integer ;
    bsi:unit "score_0_100" .

_:EngineScore_engine_coverage_count_prop     sh:path bsip:engine_coverage_count ;
    sh:name "Engine coverage" ;
    sh:description "How many engines produced a score for this row — a coverage multiplier rather than a feature of the market." ;
    sh:datatype xsd:integer ;
    sh:order "32"^^xsd:integer ;
    bsi:unit "count" .

_:EngineScore_timeframe_prop     sh:path bsip:timeframe ;
    sh:name "Timeframe" ;
    sh:description "Horizon a signal or recommendation is expressed on." ;
    sh:datatype xsd:string ;
    sh:order "33"^^xsd:integer ;
    bsi:vocabulary bsiv:timeframe ;
    sh:in _:EngineScore_timeframe_in0 .

_:EngineScore_timeframe_in0     rdf:first "INTRADAY" ;
    rdf:rest _:EngineScore_timeframe_in1 .

_:EngineScore_timeframe_in1     rdf:first "SWING" ;
    rdf:rest _:EngineScore_timeframe_in2 .

_:EngineScore_timeframe_in2     rdf:first "POSITIONAL" ;
    rdf:rest _:EngineScore_timeframe_in3 .

_:EngineScore_timeframe_in3     rdf:first "LONG_TERM" ;
    rdf:rest rdf:nil .

_:EngineScore_win_probability_prop     sh:path bsip:win_probability ;
    sh:name "Win probability" ;
    sh:description "Raw model probability, isotonic-banded downstream. Forbidden as a feature: it is a model output, so feeding it back leaks the model into its own inputs." ;
    sh:datatype xsd:decimal ;
    sh:order "34"^^xsd:integer ;
    bsi:unit "probability" .

_:EngineScore_classification_prop     sh:path bsip:classification ;
    sh:name "Classification" ;
    sh:description "Human-readable action label." ;
    sh:datatype xsd:string ;
    sh:order "35"^^xsd:integer ;
    bsi:vocabulary bsiv:recommendation_classification ;
    sh:in _:EngineScore_classification_in0 .

_:EngineScore_classification_in0     rdf:first "Strong Buy" ;
    rdf:rest _:EngineScore_classification_in1 .

_:EngineScore_classification_in1     rdf:first "Buy" ;
    rdf:rest _:EngineScore_classification_in2 .

_:EngineScore_classification_in2     rdf:first "Hold" ;
    rdf:rest _:EngineScore_classification_in3 .

_:EngineScore_classification_in3     rdf:first "Sell" ;
    rdf:rest _:EngineScore_classification_in4 .

_:EngineScore_classification_in4     rdf:first "Strong Sell" ;
    rdf:rest rdf:nil .

_:EngineScore_last_updated_prop     sh:path bsip:last_updated ;
    sh:name "Last updated" ;
    sh:description "Writer-supplied modification stamp. Trust it only when the writer is known to set it on every write." ;
    sh:datatype xsd:dateTime ;
    sh:order "36"^^xsd:integer .

bsi:RecommendationShape     rdf:type sh:NodeShape ;
    sh:targetClass bsi:Recommendation ;
    sh:name "Recommendation" ;
    sh:description "The served trade: composite score, conviction bucket, action label, entry zone, stop, targets, risk/reward and position size for one symbol, date and timeframe." ;
    bsi:grain "(symbol, computed_at, timeframe)" ;
    sh:property _:Recommendation_symbol_prop, _:Recommendation_computed_at_prop, _:Recommendation_last_updated_prop, _:Recommendation_regime_prop, _:Recommendation_unified_score_prop, _:Recommendation_conviction_level_prop, _:Recommendation_screener_stock_score_prop, _:Recommendation_ml_score_prop, _:Recommendation_confluence_score_prop, _:Recommendation_technical_score_prop, _:Recommendation_dl_score_prop, _:Recommendation_cs_score_prop, _:Recommendation_breakout_score_prop, _:Recommendation_smart_money_score_prop, _:Recommendation_fundamental_score_prop, _:Recommendation_bullish_screener_count_prop, _:Recommendation_bearish_screener_count_prop, _:Recommendation_screener_names_json_prop, _:Recommendation_entry_zone_low_prop, _:Recommendation_entry_zone_high_prop, _:Recommendation_stop_loss_prop, _:Recommendation_target_1_prop, _:Recommendation_target_2_prop, _:Recommendation_target_3_prop, _:Recommendation_risk_reward_prop, _:Recommendation_timeframe_prop, _:Recommendation_sector_prop, _:Recommendation_trade_reasoning_prop, _:Recommendation_classification_prop, _:Recommendation_position_size_pct_prop, _:Recommendation_engine_coverage_count_prop, _:Recommendation_win_probability_prop, _:Recommendation_intraday_regime_prop, _:Recommendation_cmp_prop, _:Recommendation_entry_price_prop, _:Recommendation_sentiment_score_prop .

_:Recommendation_symbol_prop     sh:path bsip:symbol ;
    sh:name "Symbol" ;
    sh:description "Exchange ticker, NSE/BSE convention embedded in the string. The platform's universal join key across ~40 tables." ;
    sh:datatype xsd:string ;
    sh:order "1"^^xsd:integer ;
    sh:minCount "1"^^xsd:integer .

_:Recommendation_computed_at_prop     sh:path bsip:computed_at ;
    sh:name "Computed at" ;
    sh:description "When the platform produced the row. NOT uniform across tables: TEXT in `unified_recommendations`, native TIMESTAMPTZ in `confluence_signals`. Cast before comparing the two." ;
    sh:datatype xsd:dateTime ;
    sh:order "2"^^xsd:integer ;
    sh:minCount "1"^^xsd:integer .

_:Recommendation_last_updated_prop     sh:path bsip:last_updated ;
    sh:name "Last updated" ;
    sh:description "Writer-supplied modification stamp. Trust it only when the writer is known to set it on every write." ;
    sh:datatype xsd:dateTime ;
    sh:order "3"^^xsd:integer .

_:Recommendation_regime_prop     sh:path bsip:regime ;
    sh:name "Market regime" ;
    sh:description "Macro regime label applied to the row's date." ;
    sh:datatype xsd:string ;
    sh:order "4"^^xsd:integer ;
    bsi:vocabulary bsiv:market_regime ;
    sh:in _:Recommendation_regime_in0 .

_:Recommendation_regime_in0     rdf:first "BULL" ;
    rdf:rest _:Recommendation_regime_in1 .

_:Recommendation_regime_in1     rdf:first "BEAR" ;
    rdf:rest _:Recommendation_regime_in2 .

_:Recommendation_regime_in2     rdf:first "SIDEWAYS" ;
    rdf:rest _:Recommendation_regime_in3 .

_:Recommendation_regime_in3     rdf:first "HIGH_VOL" ;
    rdf:rest _:Recommendation_regime_in4 .

_:Recommendation_regime_in4     rdf:first "CRASH" ;
    rdf:rest rdf:nil .

_:Recommendation_unified_score_prop     sh:path bsip:unified_score ;
    sh:name "Unified score" ;
    sh:description "The composite the unified ranker serves. An OUTPUT of the platform, so it is a legitimate feature only for a model predicting something else." ;
    sh:datatype xsd:decimal ;
    sh:order "5"^^xsd:integer ;
    bsi:unit "score_0_100" .

_:Recommendation_conviction_level_prop     sh:path bsip:conviction_level ;
    sh:name "Conviction level" ;
    sh:description "Ranked conviction bucket." ;
    sh:datatype xsd:string ;
    sh:order "6"^^xsd:integer ;
    bsi:vocabulary bsiv:conviction ;
    sh:in _:Recommendation_conviction_level_in0 .

_:Recommendation_conviction_level_in0     rdf:first "S_ELITE" ;
    rdf:rest _:Recommendation_conviction_level_in1 .

_:Recommendation_conviction_level_in1     rdf:first "A_HIGH" ;
    rdf:rest _:Recommendation_conviction_level_in2 .

_:Recommendation_conviction_level_in2     rdf:first "D_MARGINAL" ;
    rdf:rest rdf:nil .

_:Recommendation_screener_stock_score_prop     sh:path bsip:screener_stock_score ;
    sh:name "Screener stock score" ;
    sh:description "Aggregate screener evidence for the symbol." ;
    sh:datatype xsd:decimal ;
    sh:order "7"^^xsd:integer ;
    bsi:unit "score_0_100" .

_:Recommendation_ml_score_prop     sh:path bsip:ml_score ;
    sh:name "ML score" ;
    sh:description "Ensemble output; measured to add roughly +0.02 rank quality over the blend." ;
    sh:datatype xsd:decimal ;
    sh:order "8"^^xsd:integer ;
    bsi:unit "score_0_100" .

_:Recommendation_confluence_score_prop     sh:path bsip:confluence_score ;
    sh:name "Confluence score" ;
    sh:description "Cross-evidence agreement score. The only engine score with a growing positive graded reading on this platform." ;
    sh:datatype xsd:decimal ;
    sh:order "9"^^xsd:integer ;
    bsi:unit "score_0_100" .

_:Recommendation_technical_score_prop     sh:path bsip:technical_score ;
    sh:name "Technical score" ;
    sh:description "Rule-based technical engine output." ;
    sh:datatype xsd:decimal ;
    sh:order "10"^^xsd:integer ;
    bsi:unit "score_0_100" .

_:Recommendation_dl_score_prop     sh:path bsip:dl_score ;
    sh:name "Deep-learning score" ;
    sh:description "BiLSTM output, currently paused at a measured 0.0 contribution." ;
    sh:datatype xsd:decimal ;
    sh:order "11"^^xsd:integer ;
    bsi:unit "score_0_100" .

_:Recommendation_cs_score_prop     sh:path bsip:cs_score ;
    sh:name "Cross-sectional score" ;
    sh:description "Rank-based cross-sectional output; measured 0.0 across all regimes." ;
    sh:datatype xsd:decimal ;
    sh:order "12"^^xsd:integer ;
    bsi:unit "score_0_100" .

_:Recommendation_breakout_score_prop     sh:path bsip:breakout_score ;
    sh:name "Breakout score" ;
    sh:description "Breakout probability model output." ;
    sh:datatype xsd:decimal ;
    sh:order "13"^^xsd:integer ;
    bsi:unit "score_0_100" .

_:Recommendation_smart_money_score_prop     sh:path bsip:smart_money_score ;
    sh:name "Smart-money score" ;
    sh:description "Flow-aggregation score; measured 0.0 across all regimes." ;
    sh:datatype xsd:decimal ;
    sh:order "14"^^xsd:integer ;
    bsi:unit "score_0_100" .

_:Recommendation_fundamental_score_prop     sh:path bsip:fundamental_score ;
    sh:name "Fundamental score" ;
    sh:description "Vendor-derived fundamental composite." ;
    sh:datatype xsd:decimal ;
    sh:order "15"^^xsd:integer ;
    bsi:unit "score_0_100" .

_:Recommendation_bullish_screener_count_prop     sh:path bsip:bullish_screener_count ;
    sh:name "Bullish screener count" ;
    sh:description "Screener appearances with an inferred bullish bias." ;
    sh:datatype xsd:integer ;
    sh:order "16"^^xsd:integer ;
    bsi:unit "count" .

_:Recommendation_bearish_screener_count_prop     sh:path bsip:bearish_screener_count ;
    sh:name "Bearish screener count" ;
    sh:description "Screener appearances with an inferred bearish bias." ;
    sh:datatype xsd:integer ;
    sh:order "17"^^xsd:integer ;
    bsi:unit "count" .

_:Recommendation_screener_names_json_prop     sh:path bsip:screener_names_json ;
    sh:name "Screener names" ;
    sh:description "JSON array of contributing screeners." ;
    sh:datatype rdf:JSON ;
    sh:order "18"^^xsd:integer .

_:Recommendation_entry_zone_low_prop     sh:path bsip:entry_zone_low ;
    sh:name "Entry zone low" ;
    sh:description "Lower bound of the advised entry zone." ;
    sh:datatype xsd:decimal ;
    sh:order "19"^^xsd:integer ;
    bsi:unit "per_share_INR" .

_:Recommendation_entry_zone_high_prop     sh:path bsip:entry_zone_high ;
    sh:name "Entry zone high" ;
    sh:description "Upper bound of the advised entry zone." ;
    sh:datatype xsd:decimal ;
    sh:order "20"^^xsd:integer ;
    bsi:unit "per_share_INR" .

_:Recommendation_stop_loss_prop     sh:path bsip:stop_loss ;
    sh:name "Stop loss" ;
    sh:description "Advised protective stop." ;
    sh:datatype xsd:decimal ;
    sh:order "21"^^xsd:integer ;
    bsi:unit "per_share_INR" .

_:Recommendation_target_1_prop     sh:path bsip:target_1 ;
    sh:name "Target 1" ;
    sh:description "First advised target." ;
    sh:datatype xsd:decimal ;
    sh:order "22"^^xsd:integer ;
    bsi:unit "per_share_INR" .

_:Recommendation_target_2_prop     sh:path bsip:target_2 ;
    sh:name "Target 2" ;
    sh:description "Second advised target." ;
    sh:datatype xsd:decimal ;
    sh:order "23"^^xsd:integer ;
    bsi:unit "per_share_INR" .

_:Recommendation_target_3_prop     sh:path bsip:target_3 ;
    sh:name "Target 3" ;
    sh:description "Third advised target." ;
    sh:datatype xsd:decimal ;
    sh:order "24"^^xsd:integer ;
    bsi:unit "per_share_INR" .

_:Recommendation_risk_reward_prop     sh:path bsip:risk_reward ;
    sh:name "Risk/reward" ;
    sh:description "Target distance over stop distance on a served recommendation." ;
    sh:datatype xsd:decimal ;
    sh:order "25"^^xsd:integer ;
    bsi:unit "ratio" .

_:Recommendation_timeframe_prop     sh:path bsip:timeframe ;
    sh:name "Timeframe" ;
    sh:description "Horizon a signal or recommendation is expressed on." ;
    sh:datatype xsd:string ;
    sh:order "26"^^xsd:integer ;
    sh:minCount "1"^^xsd:integer ;
    bsi:vocabulary bsiv:timeframe ;
    sh:in _:Recommendation_timeframe_in0 .

_:Recommendation_timeframe_in0     rdf:first "INTRADAY" ;
    rdf:rest _:Recommendation_timeframe_in1 .

_:Recommendation_timeframe_in1     rdf:first "SWING" ;
    rdf:rest _:Recommendation_timeframe_in2 .

_:Recommendation_timeframe_in2     rdf:first "POSITIONAL" ;
    rdf:rest _:Recommendation_timeframe_in3 .

_:Recommendation_timeframe_in3     rdf:first "LONG_TERM" ;
    rdf:rest rdf:nil .

_:Recommendation_sector_prop     sh:path bsip:sector ;
    sh:name "Sector" ;
    sh:description "Industry grouping label as supplied by the writing fetcher. No canonical table backs it, so a cross-table sector join can silently lose names." ;
    sh:datatype xsd:string ;
    sh:order "27"^^xsd:integer .

_:Recommendation_trade_reasoning_prop     sh:path bsip:trade_reasoning ;
    sh:name "Trade reasoning" ;
    sh:description "Why the platform served this trade. Generated text — an explanation, not evidence." ;
    sh:datatype xsd:string ;
    sh:order "28"^^xsd:integer .

_:Recommendation_classification_prop     sh:path bsip:classification ;
    sh:name "Classification" ;
    sh:description "Human-readable action label." ;
    sh:datatype xsd:string ;
    sh:order "29"^^xsd:integer ;
    bsi:vocabulary bsiv:recommendation_classification ;
    sh:in _:Recommendation_classification_in0 .

_:Recommendation_classification_in0     rdf:first "Strong Buy" ;
    rdf:rest _:Recommendation_classification_in1 .

_:Recommendation_classification_in1     rdf:first "Buy" ;
    rdf:rest _:Recommendation_classification_in2 .

_:Recommendation_classification_in2     rdf:first "Hold" ;
    rdf:rest _:Recommendation_classification_in3 .

_:Recommendation_classification_in3     rdf:first "Sell" ;
    rdf:rest _:Recommendation_classification_in4 .

_:Recommendation_classification_in4     rdf:first "Strong Sell" ;
    rdf:rest rdf:nil .

_:Recommendation_position_size_pct_prop     sh:path bsip:position_size_pct ;
    sh:name "Position size percent" ;
    sh:description "Recommended allocation. Its raw meta-label is stored in the history table." ;
    sh:datatype xsd:decimal ;
    sh:order "30"^^xsd:integer ;
    bsi:unit "ratio" .

_:Recommendation_engine_coverage_count_prop     sh:path bsip:engine_coverage_count ;
    sh:name "Engine coverage" ;
    sh:description "How many engines produced a score for this row — a coverage multiplier rather than a feature of the market." ;
    sh:datatype xsd:integer ;
    sh:order "31"^^xsd:integer ;
    bsi:unit "count" .

_:Recommendation_win_probability_prop     sh:path bsip:win_probability ;
    sh:name "Win probability" ;
    sh:description "Raw model probability, isotonic-banded downstream. Forbidden as a feature: it is a model output, so feeding it back leaks the model into its own inputs." ;
    sh:datatype xsd:decimal ;
    sh:order "32"^^xsd:integer ;
    bsi:unit "probability" .

_:Recommendation_intraday_regime_prop     sh:path bsip:intraday_regime ;
    sh:name "Intraday regime" ;
    sh:description "Within-session risk state." ;
    sh:datatype xsd:string ;
    sh:order "33"^^xsd:integer ;
    bsi:vocabulary bsiv:intraday_regime ;
    bsi:openEndedVocabulary "intraday_recommendations.intraday_regime" .

_:Recommendation_cmp_prop     sh:path bsip:cmp ;
    sh:name "Current market price" ;
    sh:description "Last traded price at the moment the row was written — a point-in-time snapshot, not a session close. Do not substitute it for `close`." ;
    sh:datatype xsd:decimal ;
    sh:order "34"^^xsd:integer ;
    bsi:unit "per_share_INR" .

_:Recommendation_entry_price_prop     sh:path bsip:entry_price ;
    sh:name "Entry price" ;
    sh:description "Assumed or realised entry fill used by an outcome calculation." ;
    sh:datatype xsd:decimal ;
    sh:order "35"^^xsd:integer ;
    bsi:unit "per_share_INR" .

_:Recommendation_sentiment_score_prop     sh:path bsip:sentiment_score ;
    sh:name "Vendor sentiment score" ;
    sh:description "Vendor's numeric sentiment." ;
    sh:datatype xsd:decimal ;
    sh:order "36"^^xsd:integer ;
    bsi:unit "score_minus1_1" .

bsi:ModelArtifactShape     rdf:type sh:NodeShape ;
    sh:targetClass bsi:ModelArtifact ;
    sh:name "Model artifact" ;
    sh:description "A registered trained model: type, version, evaluation metrics, feature count, horizon and active flag." ;
    bsi:grain "one row per version" ;
    sh:property _:ModelArtifact_id_prop, _:ModelArtifact_name_prop, _:ModelArtifact_category_prop, _:ModelArtifact_computed_at_prop, _:ModelArtifact_horizon_days_prop, _:ModelArtifact_top_features_json_prop .

_:ModelArtifact_id_prop     sh:path bsip:id ;
    sh:name "Row id" ;
    sh:description "Surrogate key that is NOT stable across a re-fetch or backfill. Never join on this across runs — use the table's natural key." ;
    sh:datatype xsd:string ;
    sh:order "1"^^xsd:integer ;
    sh:minCount "1"^^xsd:integer .

_:ModelArtifact_name_prop     sh:path bsip:name ;
    sh:name "Name" ;
    sh:description "Display name of the entity (screener name, index name, ...)." ;
    sh:datatype xsd:string ;
    sh:order "2"^^xsd:integer .

_:ModelArtifact_category_prop     sh:path bsip:category ;
    sh:name "Category" ;
    sh:description "Registry's category classification." ;
    sh:datatype xsd:string ;
    sh:order "3"^^xsd:integer .

_:ModelArtifact_computed_at_prop     sh:path bsip:computed_at ;
    sh:name "Computed at" ;
    sh:description "When the platform produced the row. NOT uniform across tables: TEXT in `unified_recommendations`, native TIMESTAMPTZ in `confluence_signals`. Cast before comparing the two." ;
    sh:datatype xsd:dateTime ;
    sh:order "4"^^xsd:integer .

_:ModelArtifact_horizon_days_prop     sh:path bsip:horizon_days ;
    sh:name "Horizon (days)" ;
    sh:description "Evaluation horizon a signal or outcome is expressed over. A parameter of the label, not a property of the market." ;
    sh:datatype xsd:integer ;
    sh:order "5"^^xsd:integer ;
    bsi:unit "count" .

_:ModelArtifact_top_features_json_prop     sh:path bsip:top_features_json ;
    sh:name "Top features" ;
    sh:description "JSON list of a model's leading features." ;
    sh:datatype rdf:JSON ;
    sh:order "6"^^xsd:integer .

bsi:FeatureImportanceShape     rdf:type sh:NodeShape ;
    sh:targetClass bsi:FeatureImportance ;
    sh:name "Feature importance" ;
    sh:description "Per-model, per-run feature importance with rank — the audit trail behind which inputs a model actually used." ;
    bsi:grain "(model, run, feature)" ;
    sh:property _:FeatureImportance_id_prop, _:FeatureImportance_name_prop, _:FeatureImportance_computed_at_prop, _:FeatureImportance_importance_prop, _:FeatureImportance_rank_position_prop .

_:FeatureImportance_id_prop     sh:path bsip:id ;
    sh:name "Row id" ;
    sh:description "Surrogate key that is NOT stable across a re-fetch or backfill. Never join on this across runs — use the table's natural key." ;
    sh:datatype xsd:string ;
    sh:order "1"^^xsd:integer ;
    sh:minCount "1"^^xsd:integer .

_:FeatureImportance_name_prop     sh:path bsip:name ;
    sh:name "Name" ;
    sh:description "Display name of the entity (screener name, index name, ...)." ;
    sh:datatype xsd:string ;
    sh:order "2"^^xsd:integer .

_:FeatureImportance_computed_at_prop     sh:path bsip:computed_at ;
    sh:name "Computed at" ;
    sh:description "When the platform produced the row. NOT uniform across tables: TEXT in `unified_recommendations`, native TIMESTAMPTZ in `confluence_signals`. Cast before comparing the two." ;
    sh:datatype xsd:dateTime ;
    sh:order "3"^^xsd:integer .

_:FeatureImportance_importance_prop     sh:path bsip:importance ;
    sh:name "Feature importance" ;
    sh:description "Model feature importance for a run." ;
    sh:datatype xsd:integer ;
    sh:order "4"^^xsd:integer ;
    bsi:unit "count" .

_:FeatureImportance_rank_position_prop     sh:path bsip:rank_position ;
    sh:name "Importance rank" ;
    sh:description "Rank of a feature within its model run." ;
    sh:datatype xsd:integer ;
    sh:order "5"^^xsd:integer ;
    bsi:unit "count" .

bsi:OutcomeRecordShape     rdf:type sh:NodeShape ;
    sh:targetClass bsi:OutcomeRecord ;
    sh:name "Outcome record" ;
    sh:description "Abstract parent for resolved results. Labels live here and nowhere else: nothing in this branch may ever appear on the input side of a model." .

bsi:EdgeReadingShape     rdf:type sh:NodeShape ;
    sh:targetClass bsi:EdgeReading ;
    sh:name "Edge reading" ;
    sh:description "One factor-grading result: rank-IC and hit-AUC for a table/column, per regime and horizon, with the effective-date count and a verdict." ;
    bsi:grain "(run_at, table_name, score_col, horizon_days, regime)" ;
    sh:property _:EdgeReading_computed_at_prop, _:EdgeReading_source_prop, _:EdgeReading_name_prop, _:EdgeReading_horizon_days_prop, _:EdgeReading_rank_ic_prop, _:EdgeReading_hit_auc_prop, _:EdgeReading_eff_dates_prop, _:EdgeReading_verdict_prop .

_:EdgeReading_computed_at_prop     sh:path bsip:computed_at ;
    sh:name "Computed at" ;
    sh:description "When the platform produced the row. NOT uniform across tables: TEXT in `unified_recommendations`, native TIMESTAMPTZ in `confluence_signals`. Cast before comparing the two." ;
    sh:datatype xsd:dateTime ;
    sh:order "1"^^xsd:integer .

_:EdgeReading_source_prop     sh:path bsip:source ;
    sh:name "Source" ;
    sh:description "Which provider or fetcher wrote the row. Provenance is per-row on this platform, so this is the first column to check before trusting a value." ;
    sh:datatype xsd:string ;
    sh:order "2"^^xsd:integer ;
    sh:minCount "1"^^xsd:integer .

_:EdgeReading_name_prop     sh:path bsip:name ;
    sh:name "Name" ;
    sh:description "Display name of the entity (screener name, index name, ...)." ;
    sh:datatype xsd:string ;
    sh:order "3"^^xsd:integer ;
    sh:minCount "1"^^xsd:integer .

_:EdgeReading_horizon_days_prop     sh:path bsip:horizon_days ;
    sh:name "Horizon (days)" ;
    sh:description "Evaluation horizon a signal or outcome is expressed over. A parameter of the label, not a property of the market." ;
    sh:datatype xsd:integer ;
    sh:order "4"^^xsd:integer ;
    sh:minCount "1"^^xsd:integer ;
    bsi:unit "count" .

_:EdgeReading_rank_ic_prop     sh:path bsip:rank_ic ;
    sh:name "Rank IC" ;
    sh:description "Rank correlation between a factor and forward returns, computed per date then aggregated. Read alongside `eff_dates`, never on its own." ;
    sh:datatype xsd:decimal ;
    sh:order "5"^^xsd:integer ;
    bsi:unit "information_coefficient" .

_:EdgeReading_hit_auc_prop     sh:path bsip:hit_auc ;
    sh:name "Hit AUC" ;
    sh:description "Discrimination of the factor's sign for hit versus miss." ;
    sh:datatype xsd:decimal ;
    sh:order "6"^^xsd:integer ;
    bsi:unit "information_coefficient" .

_:EdgeReading_eff_dates_prop     sh:path bsip:eff_dates ;
    sh:name "Effective dates" ;
    sh:description "Independent-observation count used by the factor grader: the guard that stops overlapping forward windows from inflating a reading." ;
    sh:datatype xsd:integer ;
    sh:order "7"^^xsd:integer ;
    bsi:unit "count" .

_:EdgeReading_verdict_prop     sh:path bsip:verdict ;
    sh:name "Edge verdict" ;
    sh:description "Recorded outcome of a factor grading run after the power guards." ;
    sh:datatype xsd:string ;
    sh:order "8"^^xsd:integer ;
    sh:minCount "1"^^xsd:integer ;
    bsi:vocabulary bsiv:edge_verdict ;
    bsi:openEndedVocabulary "factor_edge_history.verdict" .

bsi:SignalOutcomeShape     rdf:type sh:NodeShape ;
    sh:targetClass bsi:SignalOutcome ;
    sh:name "Signal outcome" ;
    sh:description "The resolved result of a signal: entry, exit, horizon, return and the outcome label, under one of two possibly-different labelling rules." ;
    bsi:grain "(symbol, signal_date, horizon_days, signal_source)" ;
    sh:property _:SignalOutcome_symbol_prop, _:SignalOutcome_signal_date_prop, _:SignalOutcome_horizon_days_prop, _:SignalOutcome_entry_price_prop, _:SignalOutcome_check_date_prop, _:SignalOutcome_exit_price_prop, _:SignalOutcome_return_pct_prop, _:SignalOutcome_outcome_prop, _:SignalOutcome_signal_score_prop, _:SignalOutcome_signals_json_prop, _:SignalOutcome_computed_at_prop, _:SignalOutcome_max_return_pct_prop, _:SignalOutcome_label_definition_prop, _:SignalOutcome_is_suspect_prop, _:SignalOutcome_signal_source_prop, _:SignalOutcome_id_prop, _:SignalOutcome_exit_reason_prop .

_:SignalOutcome_symbol_prop     sh:path bsip:symbol ;
    sh:name "Symbol" ;
    sh:description "Exchange ticker, NSE/BSE convention embedded in the string. The platform's universal join key across ~40 tables." ;
    sh:datatype xsd:string ;
    sh:order "1"^^xsd:integer ;
    sh:minCount "1"^^xsd:integer .

_:SignalOutcome_signal_date_prop     sh:path bsip:signal_date ;
    sh:name "Signal date" ;
    sh:description "Session a signal was generated for. Entry happens at the NEXT session's open — the most common off-by-one in this repo." ;
    sh:datatype xsd:date ;
    sh:order "2"^^xsd:integer ;
    sh:minCount "1"^^xsd:integer ;
    bsi:unit "calendar_day" .

_:SignalOutcome_horizon_days_prop     sh:path bsip:horizon_days ;
    sh:name "Horizon (days)" ;
    sh:description "Evaluation horizon a signal or outcome is expressed over. A parameter of the label, not a property of the market." ;
    sh:datatype xsd:integer ;
    sh:order "3"^^xsd:integer ;
    sh:minCount "1"^^xsd:integer ;
    bsi:unit "count" .

_:SignalOutcome_entry_price_prop     sh:path bsip:entry_price ;
    sh:name "Entry price" ;
    sh:description "Assumed or realised entry fill used by an outcome calculation." ;
    sh:datatype xsd:decimal ;
    sh:order "4"^^xsd:integer ;
    bsi:unit "per_share_INR" .

_:SignalOutcome_check_date_prop     sh:path bsip:check_date ;
    sh:name "Check date" ;
    sh:description "Session an outcome was resolved on; with `signal_date` it bounds the window." ;
    sh:datatype xsd:date ;
    sh:order "5"^^xsd:integer ;
    bsi:unit "calendar_day" .

_:SignalOutcome_exit_price_prop     sh:path bsip:exit_price ;
    sh:name "Exit price" ;
    sh:description "Realised exit fill; only exists on resolved outcomes." ;
    sh:datatype xsd:decimal ;
    sh:order "6"^^xsd:integer ;
    bsi:unit "per_share_INR" .

_:SignalOutcome_return_pct_prop     sh:path bsip:return_pct ;
    sh:name "Realised return" ;
    sh:description "Terminal return over the horizon. Outcome-side: using it as a feature is a look-ahead bug." ;
    sh:datatype xsd:decimal ;
    sh:order "7"^^xsd:integer ;
    bsi:unit "percent" .

_:SignalOutcome_outcome_prop     sh:path bsip:outcome ;
    sh:name "Outcome" ;
    sh:description "Resolved result of a signal under its recorded labelling rule — the platform's primary supervised target." ;
    sh:datatype xsd:string ;
    sh:order "8"^^xsd:integer ;
    bsi:vocabulary bsiv:outcome ;
    sh:in _:SignalOutcome_outcome_in0 .

_:SignalOutcome_outcome_in0     rdf:first "WIN" ;
    rdf:rest _:SignalOutcome_outcome_in1 .

_:SignalOutcome_outcome_in1     rdf:first "LOSS" ;
    rdf:rest _:SignalOutcome_outcome_in2 .

_:SignalOutcome_outcome_in2     rdf:first "STOP_LOSS" ;
    rdf:rest _:SignalOutcome_outcome_in3 .

_:SignalOutcome_outcome_in3     rdf:first "NEUTRAL" ;
    rdf:rest _:SignalOutcome_outcome_in4 .

_:SignalOutcome_outcome_in4     rdf:first "PENDING" ;
    rdf:rest rdf:nil .

_:SignalOutcome_signal_score_prop     sh:path bsip:signal_score ;
    sh:name "Signal score" ;
    sh:description "Score attached to a technical signal at creation." ;
    sh:datatype xsd:decimal ;
    sh:order "9"^^xsd:integer ;
    bsi:unit "score_0_100" .

_:SignalOutcome_signals_json_prop     sh:path bsip:signals_json ;
    sh:name "Signals payload" ;
    sh:description "Serialized signal bundle for the row." ;
    sh:datatype rdf:JSON ;
    sh:order "10"^^xsd:integer .

_:SignalOutcome_computed_at_prop     sh:path bsip:computed_at ;
    sh:name "Computed at" ;
    sh:description "When the platform produced the row. NOT uniform across tables: TEXT in `unified_recommendations`, native TIMESTAMPTZ in `confluence_signals`. Cast before comparing the two." ;
    sh:datatype xsd:dateTime ;
    sh:order "11"^^xsd:integer .

_:SignalOutcome_max_return_pct_prop     sh:path bsip:max_return_pct ;
    sh:name "Max return in window" ;
    sh:description "Peak return recorded for the signal." ;
    sh:datatype xsd:decimal ;
    sh:order "12"^^xsd:integer ;
    bsi:unit "percent" .

_:SignalOutcome_label_definition_prop     sh:path bsip:label_definition ;
    sh:name "Label definition" ;
    sh:description "Which rule produced the label. Labels are NOT comparable across definitions — always filter on this column before aggregating accuracy." ;
    sh:datatype xsd:string ;
    sh:order "13"^^xsd:integer ;
    bsi:vocabulary bsiv:label_definition ;
    sh:in _:SignalOutcome_label_definition_in0 .

_:SignalOutcome_label_definition_in0     rdf:first "path_barrier" ;
    rdf:rest _:SignalOutcome_label_definition_in1 .

_:SignalOutcome_label_definition_in1     rdf:first "terminal_pct2" ;
    rdf:rest rdf:nil .

_:SignalOutcome_is_suspect_prop     sh:path bsip:is_suspect ;
    sh:name "Suspect row" ;
    sh:description "Quarantined by a data-quality rule. Filter it OUT of any training panel; never impute over it silently." ;
    sh:datatype xsd:boolean ;
    sh:order "14"^^xsd:integer .

_:SignalOutcome_signal_source_prop     sh:path bsip:signal_source ;
    sh:name "Signal source" ;
    sh:description "Which producer emitted the signal." ;
    sh:datatype xsd:string ;
    sh:order "15"^^xsd:integer ;
    bsi:vocabulary bsiv:signal_source ;
    bsi:openEndedVocabulary "signal_outcomes.signal_source + unified_signal_outcomes.signal_source" .

_:SignalOutcome_id_prop     sh:path bsip:id ;
    sh:name "Row id" ;
    sh:description "Surrogate key that is NOT stable across a re-fetch or backfill. Never join on this across runs — use the table's natural key." ;
    sh:datatype xsd:string ;
    sh:order "16"^^xsd:integer .

_:SignalOutcome_exit_reason_prop     sh:path bsip:exit_reason ;
    sh:name "Exit reason" ;
    sh:description "Why a tracked position closed. `NO_ENTRY_PRICE` and `SUSPECT_DATA` are integrity exits, not labels, and must be dropped before grading." ;
    sh:datatype xsd:string ;
    sh:order "17"^^xsd:integer ;
    bsi:vocabulary bsiv:exit_reason ;
    sh:in _:SignalOutcome_exit_reason_in0 .

_:SignalOutcome_exit_reason_in0     rdf:first "TIME_EXIT" ;
    rdf:rest _:SignalOutcome_exit_reason_in1 .

_:SignalOutcome_exit_reason_in1     rdf:first "TIME_EXIT_PARTIAL" ;
    rdf:rest _:SignalOutcome_exit_reason_in2 .

_:SignalOutcome_exit_reason_in2     rdf:first "STOP_LOSS" ;
    rdf:rest _:SignalOutcome_exit_reason_in3 .

_:SignalOutcome_exit_reason_in3     rdf:first "TRAILING_STOP" ;
    rdf:rest _:SignalOutcome_exit_reason_in4 .

_:SignalOutcome_exit_reason_in4     rdf:first "NO_ENTRY_PRICE" ;
    rdf:rest _:SignalOutcome_exit_reason_in5 .

_:SignalOutcome_exit_reason_in5     rdf:first "SUSPECT_DATA" ;
    rdf:rest rdf:nil .

bsi:SignalExcursionShape     rdf:type sh:NodeShape ;
    sh:targetClass bsi:SignalExcursion ;
    sh:name "Signal excursion" ;
    sh:description "Path statistics inside the evaluation window: maximum favourable and adverse excursion, days to each, and whether MFE preceded MAE." ;
    bsi:grain "(symbol, signal_date, horizon_days)" ;
    sh:property _:SignalExcursion_symbol_prop, _:SignalExcursion_signal_date_prop, _:SignalExcursion_horizon_days_prop, _:SignalExcursion_entry_price_prop, _:SignalExcursion_mfe_pct_prop, _:SignalExcursion_mae_pct_prop, _:SignalExcursion_computed_at_prop, _:SignalExcursion_atr_prop, _:SignalExcursion_label_definition_prop .

_:SignalExcursion_symbol_prop     sh:path bsip:symbol ;
    sh:name "Symbol" ;
    sh:description "Exchange ticker, NSE/BSE convention embedded in the string. The platform's universal join key across ~40 tables." ;
    sh:datatype xsd:string ;
    sh:order "1"^^xsd:integer ;
    sh:minCount "1"^^xsd:integer .

_:SignalExcursion_signal_date_prop     sh:path bsip:signal_date ;
    sh:name "Signal date" ;
    sh:description "Session a signal was generated for. Entry happens at the NEXT session's open — the most common off-by-one in this repo." ;
    sh:datatype xsd:date ;
    sh:order "2"^^xsd:integer ;
    sh:minCount "1"^^xsd:integer ;
    bsi:unit "calendar_day" .

_:SignalExcursion_horizon_days_prop     sh:path bsip:horizon_days ;
    sh:name "Horizon (days)" ;
    sh:description "Evaluation horizon a signal or outcome is expressed over. A parameter of the label, not a property of the market." ;
    sh:datatype xsd:integer ;
    sh:order "3"^^xsd:integer ;
    sh:minCount "1"^^xsd:integer ;
    bsi:unit "count" .

_:SignalExcursion_entry_price_prop     sh:path bsip:entry_price ;
    sh:name "Entry price" ;
    sh:description "Assumed or realised entry fill used by an outcome calculation." ;
    sh:datatype xsd:decimal ;
    sh:order "4"^^xsd:integer ;
    bsi:unit "per_share_INR" .

_:SignalExcursion_mfe_pct_prop     sh:path bsip:mfe_pct ;
    sh:name "Max favourable excursion" ;
    sh:description "Best unrealised gain inside the window. Outcome-side." ;
    sh:datatype xsd:decimal ;
    sh:order "5"^^xsd:integer ;
    bsi:unit "percent" .

_:SignalExcursion_mae_pct_prop     sh:path bsip:mae_pct ;
    sh:name "Max adverse excursion" ;
    sh:description "Worst unrealised drawdown inside the window. Outcome-side." ;
    sh:datatype xsd:decimal ;
    sh:order "6"^^xsd:integer ;
    bsi:unit "percent" .

_:SignalExcursion_computed_at_prop     sh:path bsip:computed_at ;
    sh:name "Computed at" ;
    sh:description "When the platform produced the row. NOT uniform across tables: TEXT in `unified_recommendations`, native TIMESTAMPTZ in `confluence_signals`. Cast before comparing the two." ;
    sh:datatype xsd:dateTime ;
    sh:order "7"^^xsd:integer .

_:SignalExcursion_atr_prop     sh:path bsip:atr ;
    sh:name "ATR" ;
    sh:description "Average true range, used for stop placement." ;
    sh:datatype xsd:decimal ;
    sh:order "8"^^xsd:integer ;
    bsi:unit "per_share_INR" .

_:SignalExcursion_label_definition_prop     sh:path bsip:label_definition ;
    sh:name "Label definition" ;
    sh:description "Which rule produced the label. Labels are NOT comparable across definitions — always filter on this column before aggregating accuracy." ;
    sh:datatype xsd:string ;
    sh:order "9"^^xsd:integer ;
    bsi:vocabulary bsiv:label_definition ;
    sh:in _:SignalExcursion_label_definition_in0 .

_:SignalExcursion_label_definition_in0     rdf:first "path_barrier" ;
    rdf:rest _:SignalExcursion_label_definition_in1 .

_:SignalExcursion_label_definition_in1     rdf:first "terminal_pct2" ;
    rdf:rest rdf:nil .

bsi:CandidateRecordShape     rdf:type sh:NodeShape ;
    sh:targetClass bsi:CandidateRecord ;
    sh:name "Candidate record" ;
    sh:description "Abstract parent for vendor-opinion streams. These SURFACE candidates; they are never ground truth." .

bsi:ScreenerShape     rdf:type sh:NodeShape ;
    sh:targetClass bsi:Screener ;
    sh:name "Screener" ;
    sh:description "A vendor screener definition with its inferred sentiment, category, reliability tier and classification confidence." ;
    bsi:grain "one row per screener" ;
    sh:property _:Screener_id_prop, _:Screener_name_prop, _:Screener_source_prop, _:Screener_inferred_sentiment_prop, _:Screener_inferred_category_prop, _:Screener_tier_prop, _:Screener_last_updated_prop, _:Screener_computed_at_prop .

_:Screener_id_prop     sh:path bsip:id ;
    sh:name "Row id" ;
    sh:description "Surrogate key that is NOT stable across a re-fetch or backfill. Never join on this across runs — use the table's natural key." ;
    sh:datatype xsd:string ;
    sh:order "1"^^xsd:integer ;
    sh:minCount "1"^^xsd:integer .

_:Screener_name_prop     sh:path bsip:name ;
    sh:name "Name" ;
    sh:description "Display name of the entity (screener name, index name, ...)." ;
    sh:datatype xsd:string ;
    sh:order "2"^^xsd:integer .

_:Screener_source_prop     sh:path bsip:source ;
    sh:name "Source" ;
    sh:description "Which provider or fetcher wrote the row. Provenance is per-row on this platform, so this is the first column to check before trusting a value." ;
    sh:datatype xsd:string ;
    sh:order "3"^^xsd:integer .

_:Screener_inferred_sentiment_prop     sh:path bsip:inferred_sentiment ;
    sh:name "Inferred sentiment" ;
    sh:description "Inferred directional bias of a screener." ;
    sh:datatype xsd:string ;
    sh:order "4"^^xsd:integer ;
    bsi:vocabulary bsiv:screener_sentiment ;
    sh:in _:Screener_inferred_sentiment_in0 .

_:Screener_inferred_sentiment_in0     rdf:first "bullish" ;
    rdf:rest _:Screener_inferred_sentiment_in1 .

_:Screener_inferred_sentiment_in1     rdf:first "bearish" ;
    rdf:rest _:Screener_inferred_sentiment_in2 .

_:Screener_inferred_sentiment_in2     rdf:first "neutral" ;
    rdf:rest rdf:nil .

_:Screener_inferred_category_prop     sh:path bsip:inferred_category ;
    sh:name "Inferred category" ;
    sh:description "Inferred family of a screener." ;
    sh:datatype xsd:string ;
    sh:order "5"^^xsd:integer ;
    bsi:vocabulary bsiv:screener_category ;
    bsi:openEndedVocabulary "screener_master.inferred_category" .

_:Screener_tier_prop     sh:path bsip:tier ;
    sh:name "Screener tier" ;
    sh:description "Reliability tier assigned by the screener scorer." ;
    sh:datatype xsd:string ;
    sh:order "6"^^xsd:integer ;
    bsi:vocabulary bsiv:screener_tier ;
    bsi:openEndedVocabulary "screener_master.tier" .

_:Screener_last_updated_prop     sh:path bsip:last_updated ;
    sh:name "Last updated" ;
    sh:description "Writer-supplied modification stamp. Trust it only when the writer is known to set it on every write." ;
    sh:datatype xsd:dateTime ;
    sh:order "7"^^xsd:integer .

_:Screener_computed_at_prop     sh:path bsip:computed_at ;
    sh:name "Computed at" ;
    sh:description "When the platform produced the row. NOT uniform across tables: TEXT in `unified_recommendations`, native TIMESTAMPTZ in `confluence_signals`. Cast before comparing the two." ;
    sh:datatype xsd:dateTime ;
    sh:order "8"^^xsd:integer .

bsi:ScreenerAppearanceShape     rdf:type sh:NodeShape ;
    sh:targetClass bsi:ScreenerAppearance ;
    sh:name "Screener appearance" ;
    sh:description "A single surfacing event: this screener listed this symbol at this instant, with the price, change and volume at that moment." ;
    bsi:grain "(run_id, symbol, filter_key)" ;
    sh:property _:ScreenerAppearance_id_prop, _:ScreenerAppearance_symbol_prop, _:ScreenerAppearance_name_prop, _:ScreenerAppearance_cmp_prop, _:ScreenerAppearance_change_pct_prop, _:ScreenerAppearance_volume_prop .

_:ScreenerAppearance_id_prop     sh:path bsip:id ;
    sh:name "Row id" ;
    sh:description "Surrogate key that is NOT stable across a re-fetch or backfill. Never join on this across runs — use the table's natural key." ;
    sh:datatype xsd:string ;
    sh:order "1"^^xsd:integer ;
    sh:minCount "1"^^xsd:integer .

_:ScreenerAppearance_symbol_prop     sh:path bsip:symbol ;
    sh:name "Symbol" ;
    sh:description "Exchange ticker, NSE/BSE convention embedded in the string. The platform's universal join key across ~40 tables." ;
    sh:datatype xsd:string ;
    sh:order "2"^^xsd:integer .

_:ScreenerAppearance_name_prop     sh:path bsip:name ;
    sh:name "Name" ;
    sh:description "Display name of the entity (screener name, index name, ...)." ;
    sh:datatype xsd:string ;
    sh:order "3"^^xsd:integer .

_:ScreenerAppearance_cmp_prop     sh:path bsip:cmp ;
    sh:name "Current market price" ;
    sh:description "Last traded price at the moment the row was written — a point-in-time snapshot, not a session close. Do not substitute it for `close`." ;
    sh:datatype xsd:decimal ;
    sh:order "4"^^xsd:integer ;
    bsi:unit "per_share_INR" .

_:ScreenerAppearance_change_pct_prop     sh:path bsip:change_pct ;
    sh:name "Change percent" ;
    sh:description "Session or snapshot price change." ;
    sh:datatype xsd:decimal ;
    sh:order "5"^^xsd:integer ;
    bsi:unit "percent" .

_:ScreenerAppearance_volume_prop     sh:path bsip:volume ;
    sh:name "Volume" ;
    sh:description "Shares traded in the session." ;
    sh:datatype xsd:decimal ;
    sh:order "6"^^xsd:integer .

bsi:ScreenerOutcomeShape     rdf:type sh:NodeShape ;
    sh:targetClass bsi:ScreenerOutcome ;
    sh:name "Screener outcome" ;
    sh:description "Forward returns pre-tracked and attached to an appearance at surfacing time." ;
    bsi:grain "(appearance_id, symbol)" ;
    sh:property _:ScreenerOutcome_id_prop, _:ScreenerOutcome_symbol_prop, _:ScreenerOutcome_entry_price_prop, _:ScreenerOutcome_return_pct_prop, _:ScreenerOutcome_check_date_prop .

_:ScreenerOutcome_id_prop     sh:path bsip:id ;
    sh:name "Row id" ;
    sh:description "Surrogate key that is NOT stable across a re-fetch or backfill. Never join on this across runs — use the table's natural key." ;
    sh:datatype xsd:string ;
    sh:order "1"^^xsd:integer ;
    sh:minCount "1"^^xsd:integer .

_:ScreenerOutcome_symbol_prop     sh:path bsip:symbol ;
    sh:name "Symbol" ;
    sh:description "Exchange ticker, NSE/BSE convention embedded in the string. The platform's universal join key across ~40 tables." ;
    sh:datatype xsd:string ;
    sh:order "2"^^xsd:integer ;
    sh:minCount "1"^^xsd:integer .

_:ScreenerOutcome_entry_price_prop     sh:path bsip:entry_price ;
    sh:name "Entry price" ;
    sh:description "Assumed or realised entry fill used by an outcome calculation." ;
    sh:datatype xsd:decimal ;
    sh:order "3"^^xsd:integer ;
    bsi:unit "per_share_INR" .

_:ScreenerOutcome_return_pct_prop     sh:path bsip:return_pct ;
    sh:name "Realised return" ;
    sh:description "Terminal return over the horizon. Outcome-side: using it as a feature is a look-ahead bug." ;
    sh:datatype xsd:decimal ;
    sh:order "4"^^xsd:integer ;
    bsi:unit "percent" .

_:ScreenerOutcome_check_date_prop     sh:path bsip:check_date ;
    sh:name "Check date" ;
    sh:description "Session an outcome was resolved on; with `signal_date` it bounds the window." ;
    sh:datatype xsd:date ;
    sh:order "5"^^xsd:integer ;
    bsi:unit "calendar_day" .

bsi:EventTriggerShape     rdf:type sh:NodeShape ;
    sh:targetClass bsi:EventTrigger ;
    sh:name "Event trigger" ;
    sh:description "Detector output: which composite trigger classes fired for a symbol on a date, with news counts and bullish-tenure state." ;
    bsi:grain "(symbol, date)" ;
    sh:property _:EventTrigger_date_prop, _:EventTrigger_symbol_prop, _:EventTrigger_news_count_5d_prop, _:EventTrigger_sentiment_score_prop, _:EventTrigger_triggers_prop, _:EventTrigger_computed_at_prop .

_:EventTrigger_date_prop     sh:path bsip:date ;
    sh:name "Date" ;
    sh:description "Trading-session date. Day cuts are Asia/Kolkata: a date column is a session, not a midnight-to-midnight instant." ;
    sh:datatype xsd:date ;
    sh:order "1"^^xsd:integer ;
    sh:minCount "1"^^xsd:integer ;
    bsi:unit "calendar_day" .

_:EventTrigger_symbol_prop     sh:path bsip:symbol ;
    sh:name "Symbol" ;
    sh:description "Exchange ticker, NSE/BSE convention embedded in the string. The platform's universal join key across ~40 tables." ;
    sh:datatype xsd:string ;
    sh:order "2"^^xsd:integer ;
    sh:minCount "1"^^xsd:integer .

_:EventTrigger_news_count_5d_prop     sh:path bsip:news_count_5d ;
    sh:name "News count (5 sessions)" ;
    sh:description "Articles mentioning the symbol." ;
    sh:datatype xsd:integer ;
    sh:order "3"^^xsd:integer ;
    bsi:unit "count" .

_:EventTrigger_sentiment_score_prop     sh:path bsip:sentiment_score ;
    sh:name "Vendor sentiment score" ;
    sh:description "Vendor's numeric sentiment." ;
    sh:datatype xsd:decimal ;
    sh:order "4"^^xsd:integer ;
    bsi:unit "score_minus1_1" .

_:EventTrigger_triggers_prop     sh:path bsip:triggers ;
    sh:name "Trigger classes" ;
    sh:description "Comma-joined trigger classes with inline thresholds (e.g. `CROWDED_NEWS p90`). Parse the class token, not the whole string." ;
    sh:datatype rdf:JSON ;
    sh:order "5"^^xsd:integer ;
    bsi:vocabulary bsiv:event_trigger_class ;
    bsi:openEndedVocabulary "stock_event_triggers.triggers" .

_:EventTrigger_computed_at_prop     sh:path bsip:computed_at ;
    sh:name "Computed at" ;
    sh:description "When the platform produced the row. NOT uniform across tables: TEXT in `unified_recommendations`, native TIMESTAMPTZ in `confluence_signals`. Cast before comparing the two." ;
    sh:datatype xsd:dateTime ;
    sh:order "6"^^xsd:integer .

bsi:GovernanceRecordShape     rdf:type sh:NodeShape ;
    sh:targetClass bsi:GovernanceRecord ;
    sh:name "Governance record" ;
    sh:description "Abstract parent for operational metadata. These answer 'when was this true and who wrote it', which on this platform is the difference between a usable value and a guess." .

bsi:EndpointShape     rdf:type sh:NodeShape ;
    sh:targetClass bsi:Endpoint ;
    sh:name "Data endpoint" ;
    sh:description "A discovered, verified market-data endpoint: provider, domain, scope, update frequency and the template to call it. The platform's data-sourcing registry." ;
    bsi:grain "one row per endpoint" ;
    sh:property _:Endpoint_id_prop, _:Endpoint_name_prop, _:Endpoint_source_prop, _:Endpoint_data_domain_prop, _:Endpoint_category_prop, _:Endpoint_scope_prop, _:Endpoint_update_frequency_prop, _:Endpoint_use_case_prop, _:Endpoint_method_prop, _:Endpoint_target_url_prop, _:Endpoint_url_template_prop, _:Endpoint_auth_type_prop, _:Endpoint_output_fields_prop, _:Endpoint_captured_at_prop, _:Endpoint_description_prop, _:Endpoint_last_updated_prop .

_:Endpoint_id_prop     sh:path bsip:id ;
    sh:name "Row id" ;
    sh:description "Surrogate key that is NOT stable across a re-fetch or backfill. Never join on this across runs — use the table's natural key." ;
    sh:datatype xsd:string ;
    sh:order "1"^^xsd:integer ;
    sh:minCount "1"^^xsd:integer .

_:Endpoint_name_prop     sh:path bsip:name ;
    sh:name "Name" ;
    sh:description "Display name of the entity (screener name, index name, ...)." ;
    sh:datatype xsd:string ;
    sh:order "2"^^xsd:integer .

_:Endpoint_source_prop     sh:path bsip:source ;
    sh:name "Source" ;
    sh:description "Which provider or fetcher wrote the row. Provenance is per-row on this platform, so this is the first column to check before trusting a value." ;
    sh:datatype xsd:string ;
    sh:order "3"^^xsd:integer .

_:Endpoint_data_domain_prop     sh:path bsip:data_domain ;
    sh:name "Data domain" ;
    sh:description "Registry's coarse domain classification." ;
    sh:datatype xsd:string ;
    sh:order "4"^^xsd:integer .

_:Endpoint_category_prop     sh:path bsip:category ;
    sh:name "Category" ;
    sh:description "Registry's category classification." ;
    sh:datatype xsd:string ;
    sh:order "5"^^xsd:integer .

_:Endpoint_scope_prop     sh:path bsip:scope ;
    sh:name "Scope" ;
    sh:description "Whether an endpoint is per-symbol or whole-market." ;
    sh:datatype xsd:string ;
    sh:order "6"^^xsd:integer .

_:Endpoint_update_frequency_prop     sh:path bsip:update_frequency ;
    sh:name "Update frequency" ;
    sh:description "Declared cadence of an endpoint's data." ;
    sh:datatype xsd:string ;
    sh:order "7"^^xsd:integer .

_:Endpoint_use_case_prop     sh:path bsip:use_case ;
    sh:name "Use case" ;
    sh:description "What a discovered endpoint is good for, in the registry's own words." ;
    sh:datatype xsd:string ;
    sh:order "8"^^xsd:integer .

_:Endpoint_method_prop     sh:path bsip:method ;
    sh:name "HTTP method" ;
    sh:description "Request method a registry endpoint requires." ;
    sh:datatype xsd:string ;
    sh:order "9"^^xsd:integer .

_:Endpoint_target_url_prop     sh:path bsip:target_url ;
    sh:name "Target URL" ;
    sh:description "The concrete endpoint a registry row resolves to." ;
    sh:datatype xsd:string ;
    sh:order "10"^^xsd:integer .

_:Endpoint_url_template_prop     sh:path bsip:url_template ;
    sh:name "URL template" ;
    sh:description "Parameterized endpoint URL." ;
    sh:datatype xsd:string ;
    sh:order "11"^^xsd:integer .

_:Endpoint_auth_type_prop     sh:path bsip:auth_type ;
    sh:name "Auth type" ;
    sh:description "Credential class an endpoint needs, if any." ;
    sh:datatype xsd:string ;
    sh:order "12"^^xsd:integer .

_:Endpoint_output_fields_prop     sh:path bsip:output_fields ;
    sh:name "Output fields" ;
    sh:description "Fields an endpoint is known to return." ;
    sh:datatype xsd:string ;
    sh:order "13"^^xsd:integer .

_:Endpoint_captured_at_prop     sh:path bsip:captured_at ;
    sh:name "Captured at" ;
    sh:description "Snapshot capture time for vendor grids that are otherwise undated." ;
    sh:datatype xsd:dateTime ;
    sh:order "14"^^xsd:integer .

_:Endpoint_description_prop     sh:path bsip:description ;
    sh:name "Description" ;
    sh:description "Free-form narrative field." ;
    sh:datatype xsd:string ;
    sh:order "15"^^xsd:integer .

_:Endpoint_last_updated_prop     sh:path bsip:last_updated ;
    sh:name "Last updated" ;
    sh:description "Writer-supplied modification stamp. Trust it only when the writer is known to set it on every write." ;
    sh:datatype xsd:dateTime ;
    sh:order "16"^^xsd:integer .

bsi:JobRunShape     rdf:type sh:NodeShape ;
    sh:targetClass bsi:JobRun ;
    sh:name "Job run" ;
    sh:description "Per-job heartbeat: last status, last success, last error and run/failure counts." ;
    bsi:grain "one row per job" ;
    sh:property _:JobRun_job_name_prop, _:JobRun_last_status_prop, _:JobRun_computed_at_prop, _:JobRun_last_error_prop, _:JobRun_run_count_prop, _:JobRun_fail_count_prop .

_:JobRun_job_name_prop     sh:path bsip:job_name ;
    sh:name "Job name" ;
    sh:description "Scheduler job identity (pm2 / BullMQ): the unit of both lineage and failure." ;
    sh:datatype xsd:string ;
    sh:order "1"^^xsd:integer ;
    sh:minCount "1"^^xsd:integer .

_:JobRun_last_status_prop     sh:path bsip:last_status ;
    sh:name "Last status" ;
    sh:description "Terminal status of the job's last run." ;
    sh:datatype xsd:string ;
    sh:order "2"^^xsd:integer ;
    bsi:vocabulary bsiv:job_status ;
    bsi:openEndedVocabulary "job_heartbeat.last_status" .

_:JobRun_computed_at_prop     sh:path bsip:computed_at ;
    sh:name "Computed at" ;
    sh:description "When the platform produced the row. NOT uniform across tables: TEXT in `unified_recommendations`, native TIMESTAMPTZ in `confluence_signals`. Cast before comparing the two." ;
    sh:datatype xsd:dateTime ;
    sh:order "3"^^xsd:integer .

_:JobRun_last_error_prop     sh:path bsip:last_error ;
    sh:name "Last error" ;
    sh:description "Error string from the job's last failed run." ;
    sh:datatype xsd:string ;
    sh:order "4"^^xsd:integer .

_:JobRun_run_count_prop     sh:path bsip:run_count ;
    sh:name "Run count" ;
    sh:description "Successful job runs recorded." ;
    sh:datatype xsd:integer ;
    sh:order "5"^^xsd:integer .

_:JobRun_fail_count_prop     sh:path bsip:fail_count ;
    sh:name "Failure count" ;
    sh:description "Failed job runs recorded." ;
    sh:datatype xsd:integer ;
    sh:order "6"^^xsd:integer .

bsi:DataQualityCheckShape     rdf:type sh:NodeShape ;
    sh:targetClass bsi:DataQualityCheck ;
    sh:name "Data-quality check" ;
    sh:description "The result of one named validation check: category, criticality, status and a detail string." ;
    bsi:grain "(check_id, checked_at)" ;
    sh:property _:DataQualityCheck_check_id_prop, _:DataQualityCheck_name_prop, _:DataQualityCheck_category_prop, _:DataQualityCheck_status_prop, _:DataQualityCheck_detail_prop, _:DataQualityCheck_captured_at_prop .

_:DataQualityCheck_check_id_prop     sh:path bsip:check_id ;
    sh:name "Check id" ;
    sh:description "Stable identifier of a data-quality check definition." ;
    sh:datatype xsd:string ;
    sh:order "1"^^xsd:integer ;
    sh:minCount "1"^^xsd:integer .

_:DataQualityCheck_name_prop     sh:path bsip:name ;
    sh:name "Name" ;
    sh:description "Display name of the entity (screener name, index name, ...)." ;
    sh:datatype xsd:string ;
    sh:order "2"^^xsd:integer .

_:DataQualityCheck_category_prop     sh:path bsip:category ;
    sh:name "Category" ;
    sh:description "Registry's category classification." ;
    sh:datatype xsd:string ;
    sh:order "3"^^xsd:integer .

_:DataQualityCheck_status_prop     sh:path bsip:status ;
    sh:name "Check status" ;
    sh:description "Result of a data-quality check." ;
    sh:datatype xsd:string ;
    sh:order "4"^^xsd:integer ;
    bsi:vocabulary bsiv:data_quality_status ;
    bsi:openEndedVocabulary "data_quality_results.status" .

_:DataQualityCheck_detail_prop     sh:path bsip:detail ;
    sh:name "Detail" ;
    sh:description "Detail string from a data-quality check result." ;
    sh:datatype xsd:string ;
    sh:order "5"^^xsd:integer .

_:DataQualityCheck_captured_at_prop     sh:path bsip:captured_at ;
    sh:name "Captured at" ;
    sh:description "Snapshot capture time for vendor grids that are otherwise undated." ;
    sh:datatype xsd:dateTime ;
    sh:order "6"^^xsd:integer .

bsi:DataContractShape     rdf:type sh:NodeShape ;
    sh:targetClass bsi:DataContract ;
    sh:name "Data contract" ;
    sh:description "A versioned machine-readable contract describing one dataset's grain, timing, source, training use, and physical lineage." ;
    bsi:grain "contract_key" ;
    sh:property _:DataContract_contract_key_prop, _:DataContract_dataset_prop, _:DataContract_contract_version_prop, _:DataContract_grain_prop, _:DataContract_cadence_prop, _:DataContract_unit_prop, _:DataContract_time_semantics_prop, _:DataContract_source_kind_prop, _:DataContract_training_use_prop, _:DataContract_ontology_version_prop, _:DataContract_contract_prop, _:DataContract_active_prop, _:DataContract_created_at_prop, _:DataContract_updated_at_prop .

_:DataContract_contract_key_prop     sh:path bsip:contract_key ;
    sh:name "Contract key" ;
    sh:description "Stable key for one versioned dataset contract." ;
    sh:datatype xsd:string ;
    sh:order "1"^^xsd:integer ;
    sh:minCount "1"^^xsd:integer .

_:DataContract_dataset_prop     sh:path bsip:dataset ;
    sh:name "Dataset" ;
    sh:description "Logical dataset covered by a contract or watermark." ;
    sh:datatype xsd:string ;
    sh:order "2"^^xsd:integer .

_:DataContract_contract_version_prop     sh:path bsip:contract_version ;
    sh:name "Contract version" ;
    sh:description "Version of a dataset contract." ;
    sh:datatype xsd:string ;
    sh:order "3"^^xsd:integer .

_:DataContract_grain_prop     sh:path bsip:grain ;
    sh:name "Grain" ;
    sh:description "Row identity and aggregation grain of a dataset." ;
    sh:datatype xsd:string ;
    sh:order "4"^^xsd:integer .

_:DataContract_cadence_prop     sh:path bsip:cadence ;
    sh:name "Cadence" ;
    sh:description "Expected refresh cadence of a dataset or contract." ;
    sh:datatype xsd:string ;
    sh:order "5"^^xsd:integer .

_:DataContract_unit_prop     sh:path bsip:unit ;
    sh:name "Unit" ;
    sh:description "Declared unit or measurement scale, when known." ;
    sh:datatype xsd:string ;
    sh:order "6"^^xsd:integer .

_:DataContract_time_semantics_prop     sh:path bsip:time_semantics ;
    sh:name "Time semantics" ;
    sh:description "Meaning of the dataset's timestamps in point-in-time use." ;
    sh:datatype xsd:string ;
    sh:order "7"^^xsd:integer .

_:DataContract_source_kind_prop     sh:path bsip:source_kind ;
    sh:name "Source kind" ;
    sh:description "Whether a contract is authored, vendor, or platform-derived." ;
    sh:datatype xsd:string ;
    sh:order "8"^^xsd:integer .

_:DataContract_training_use_prop     sh:path bsip:training_use ;
    sh:name "Training use" ;
    sh:description "Whether and how a table may be used in model training." ;
    sh:datatype xsd:string ;
    sh:order "9"^^xsd:integer .

_:DataContract_ontology_version_prop     sh:path bsip:ontology_version ;
    sh:name "Ontology version" ;
    sh:description "Ontology release that authored a contract or definition." ;
    sh:datatype xsd:string ;
    sh:order "10"^^xsd:integer .

_:DataContract_contract_prop     sh:path bsip:contract ;
    sh:name "Data contract" ;
    sh:description "Machine-readable dataset contract payload." ;
    sh:datatype rdf:JSON ;
    sh:order "11"^^xsd:integer .

_:DataContract_active_prop     sh:path bsip:active ;
    sh:name "Active contract" ;
    sh:description "Whether a versioned semantic contract is active." ;
    sh:datatype xsd:boolean ;
    sh:order "12"^^xsd:integer .

_:DataContract_created_at_prop     sh:path bsip:created_at ;
    sh:name "Created at" ;
    sh:description "Time the semantic row was created." ;
    sh:datatype xsd:dateTime ;
    sh:order "13"^^xsd:integer .

_:DataContract_updated_at_prop     sh:path bsip:updated_at ;
    sh:name "Updated at" ;
    sh:description "Time the semantic row was last refreshed." ;
    sh:datatype xsd:dateTime ;
    sh:order "14"^^xsd:integer .

bsi:FeatureDefinitionShape     rdf:type sh:NodeShape ;
    sh:targetClass bsi:FeatureDefinition ;
    sh:name "Semantic feature definition" ;
    sh:description "A versioned authored definition of a model-facing property, including leakage and feature-use constraints." ;
    bsi:grain "feature_key" ;
    sh:property _:FeatureDefinition_feature_key_prop, _:FeatureDefinition_property_name_prop, _:FeatureDefinition_version_prop, _:FeatureDefinition_description_prop, _:FeatureDefinition_semantic_type_prop, _:FeatureDefinition_datatype_prop, _:FeatureDefinition_unit_prop, _:FeatureDefinition_timing_prop, _:FeatureDefinition_derivation_prop, _:FeatureDefinition_leakage_risk_prop, _:FeatureDefinition_pit_notes_prop, _:FeatureDefinition_physical_bindings_prop, _:FeatureDefinition_usable_as_feature_prop, _:FeatureDefinition_is_label_prop, _:FeatureDefinition_active_prop, _:FeatureDefinition_created_at_prop, _:FeatureDefinition_updated_at_prop .

_:FeatureDefinition_feature_key_prop     sh:path bsip:feature_key ;
    sh:name "Feature key" ;
    sh:description "Stable key for one versioned semantic feature definition." ;
    sh:datatype xsd:string ;
    sh:order "1"^^xsd:integer ;
    sh:minCount "1"^^xsd:integer .

_:FeatureDefinition_property_name_prop     sh:path bsip:property_name ;
    sh:name "Semantic property name" ;
    sh:description "Authored ontology property represented by a feature definition." ;
    sh:datatype xsd:string ;
    sh:order "2"^^xsd:integer .

_:FeatureDefinition_version_prop     sh:path bsip:version ;
    sh:name "Version" ;
    sh:description "Version label for a semantic definition or contract." ;
    sh:datatype xsd:string ;
    sh:order "3"^^xsd:integer .

_:FeatureDefinition_description_prop     sh:path bsip:description ;
    sh:name "Description" ;
    sh:description "Free-form narrative field." ;
    sh:datatype xsd:string ;
    sh:order "4"^^xsd:integer .

_:FeatureDefinition_semantic_type_prop     sh:path bsip:semantic_type ;
    sh:name "Semantic type" ;
    sh:description "Ontology semantic type of a property." ;
    sh:datatype xsd:string ;
    sh:order "5"^^xsd:integer .

_:FeatureDefinition_datatype_prop     sh:path bsip:datatype ;
    sh:name "Datatype" ;
    sh:description "Physical or logical datatype of a semantic property." ;
    sh:datatype xsd:string ;
    sh:order "6"^^xsd:integer .

_:FeatureDefinition_unit_prop     sh:path bsip:unit ;
    sh:name "Unit" ;
    sh:description "Declared unit or measurement scale, when known." ;
    sh:datatype xsd:string ;
    sh:order "7"^^xsd:integer .

_:FeatureDefinition_timing_prop     sh:path bsip:timing ;
    sh:name "Timing" ;
    sh:description "Point-in-time timing class of a semantic property." ;
    sh:datatype xsd:string ;
    sh:order "8"^^xsd:integer .

_:FeatureDefinition_derivation_prop     sh:path bsip:derivation ;
    sh:name "Derivation" ;
    sh:description "How a semantic property came to exist." ;
    sh:datatype xsd:string ;
    sh:order "9"^^xsd:integer .

_:FeatureDefinition_leakage_risk_prop     sh:path bsip:leakage_risk ;
    sh:name "Leakage risk" ;
    sh:description "Point-in-time leakage classification." ;
    sh:datatype xsd:string ;
    sh:order "10"^^xsd:integer .

_:FeatureDefinition_pit_notes_prop     sh:path bsip:pit_notes ;
    sh:name "Point-in-time note" ;
    sh:description "Usage rule for a semantic property at an as-of boundary." ;
    sh:datatype xsd:string ;
    sh:order "11"^^xsd:integer .

_:FeatureDefinition_physical_bindings_prop     sh:path bsip:physical_bindings ;
    sh:name "Physical bindings" ;
    sh:description "Physical table/column bindings for a semantic feature." ;
    sh:datatype rdf:JSON ;
    sh:order "12"^^xsd:integer .

_:FeatureDefinition_usable_as_feature_prop     sh:path bsip:usable_as_feature ;
    sh:name "Usable as feature" ;
    sh:description "Whether the semantic property is permitted as a model input." ;
    sh:datatype xsd:boolean ;
    sh:order "13"^^xsd:integer .

_:FeatureDefinition_is_label_prop     sh:path bsip:is_label ;
    sh:name "Is label" ;
    sh:description "Whether the semantic property is an outcome target." ;
    sh:datatype xsd:boolean ;
    sh:order "14"^^xsd:integer .

_:FeatureDefinition_active_prop     sh:path bsip:active ;
    sh:name "Active contract" ;
    sh:description "Whether a versioned semantic contract is active." ;
    sh:datatype xsd:boolean ;
    sh:order "15"^^xsd:integer .

_:FeatureDefinition_created_at_prop     sh:path bsip:created_at ;
    sh:name "Created at" ;
    sh:description "Time the semantic row was created." ;
    sh:datatype xsd:dateTime ;
    sh:order "16"^^xsd:integer .

_:FeatureDefinition_updated_at_prop     sh:path bsip:updated_at ;
    sh:name "Updated at" ;
    sh:description "Time the semantic row was last refreshed." ;
    sh:datatype xsd:dateTime ;
    sh:order "17"^^xsd:integer .

bsi:DataWatermarkShape     rdf:type sh:NodeShape ;
    sh:targetClass bsi:DataWatermark ;
    sh:name "Data completeness watermark" ;
    sh:description "Producer-published completeness and input/output boundary for a dataset partition." ;
    bsi:grain "(dataset, partition_key)" ;
    sh:property _:DataWatermark_dataset_prop, _:DataWatermark_partition_key_prop, _:DataWatermark_as_of_prop, _:DataWatermark_input_watermark_prop, _:DataWatermark_output_watermark_prop, _:DataWatermark_expected_rows_prop, _:DataWatermark_accepted_rows_prop, _:DataWatermark_rejected_rows_prop, _:DataWatermark_completeness_status_prop, _:DataWatermark_source_version_prop, _:DataWatermark_run_ref_prop, _:DataWatermark_recorded_at_prop .

_:DataWatermark_dataset_prop     sh:path bsip:dataset ;
    sh:name "Dataset" ;
    sh:description "Logical dataset covered by a contract or watermark." ;
    sh:datatype xsd:string ;
    sh:order "1"^^xsd:integer ;
    sh:minCount "1"^^xsd:integer .

_:DataWatermark_partition_key_prop     sh:path bsip:partition_key ;
    sh:name "Partition key" ;
    sh:description "Dataset partition represented by a completeness watermark." ;
    sh:datatype xsd:string ;
    sh:order "2"^^xsd:integer ;
    sh:minCount "1"^^xsd:integer .

_:DataWatermark_as_of_prop     sh:path bsip:as_of ;
    sh:name "As of" ;
    sh:description "Point-in-time boundary for a watermark or snapshot." ;
    sh:datatype xsd:dateTime ;
    sh:order "3"^^xsd:integer .

_:DataWatermark_input_watermark_prop     sh:path bsip:input_watermark ;
    sh:name "Input watermark" ;
    sh:description "Upstream completeness boundary consumed by a producer." ;
    sh:datatype xsd:dateTime ;
    sh:order "4"^^xsd:integer .

_:DataWatermark_output_watermark_prop     sh:path bsip:output_watermark ;
    sh:name "Output watermark" ;
    sh:description "Downstream boundary emitted by a producer." ;
    sh:datatype xsd:dateTime ;
    sh:order "5"^^xsd:integer .

_:DataWatermark_expected_rows_prop     sh:path bsip:expected_rows ;
    sh:name "Expected rows" ;
    sh:description "Expected row count for a completeness watermark." ;
    sh:datatype xsd:integer ;
    sh:order "6"^^xsd:integer ;
    bsi:unit "count" .

_:DataWatermark_accepted_rows_prop     sh:path bsip:accepted_rows ;
    sh:name "Accepted rows" ;
    sh:description "Rows accepted for a completeness watermark." ;
    sh:datatype xsd:integer ;
    sh:order "7"^^xsd:integer ;
    bsi:unit "count" .

_:DataWatermark_rejected_rows_prop     sh:path bsip:rejected_rows ;
    sh:name "Rejected rows" ;
    sh:description "Rows rejected or quarantined for a completeness watermark." ;
    sh:datatype xsd:integer ;
    sh:order "8"^^xsd:integer ;
    bsi:unit "count" .

_:DataWatermark_completeness_status_prop     sh:path bsip:completeness_status ;
    sh:name "Completeness status" ;
    sh:description "Whether an expected input partition is complete." ;
    sh:datatype xsd:string ;
    sh:order "9"^^xsd:integer .

_:DataWatermark_source_version_prop     sh:path bsip:source_version ;
    sh:name "Source version" ;
    sh:description "Version of the producer that emitted a watermark." ;
    sh:datatype xsd:string ;
    sh:order "10"^^xsd:integer .

_:DataWatermark_run_ref_prop     sh:path bsip:run_ref ;
    sh:name "Run reference" ;
    sh:description "Run identifier associated with a watermark or decision." ;
    sh:datatype xsd:string ;
    sh:order "11"^^xsd:integer .

_:DataWatermark_recorded_at_prop     sh:path bsip:recorded_at ;
    sh:name "Recorded at" ;
    sh:description "Time the platform recorded the assertion." ;
    sh:datatype xsd:dateTime ;
    sh:order "12"^^xsd:integer .

bsi:GraphNodeShape     rdf:type sh:NodeShape ;
    sh:targetClass bsi:GraphNode ;
    sh:name "Instance graph node" ;
    sh:description "A canonical entity projected into the bitemporal market graph." ;
    bsi:grain "node_key" ;
    sh:property _:GraphNode_id_prop, _:GraphNode_node_key_prop, _:GraphNode_node_type_prop, _:GraphNode_name_prop, _:GraphNode_symbol_prop, _:GraphNode_attributes_prop, _:GraphNode_valid_from_prop, _:GraphNode_valid_to_prop, _:GraphNode_available_at_prop, _:GraphNode_recorded_at_prop, _:GraphNode_source_prop, _:GraphNode_source_ref_prop, _:GraphNode_revision_prop .

_:GraphNode_id_prop     sh:path bsip:id ;
    sh:name "Row id" ;
    sh:description "Surrogate key that is NOT stable across a re-fetch or backfill. Never join on this across runs — use the table's natural key." ;
    sh:datatype xsd:string ;
    sh:order "1"^^xsd:integer .

_:GraphNode_node_key_prop     sh:path bsip:node_key ;
    sh:name "Node key" ;
    sh:description "Stable key for an instance-graph node." ;
    sh:datatype xsd:string ;
    sh:order "2"^^xsd:integer ;
    sh:minCount "1"^^xsd:integer .

_:GraphNode_node_type_prop     sh:path bsip:node_type ;
    sh:name "Node type" ;
    sh:description "Type of an instance-graph node." ;
    sh:datatype xsd:string ;
    sh:order "3"^^xsd:integer .

_:GraphNode_name_prop     sh:path bsip:name ;
    sh:name "Name" ;
    sh:description "Display name of the entity (screener name, index name, ...)." ;
    sh:datatype xsd:string ;
    sh:order "4"^^xsd:integer .

_:GraphNode_symbol_prop     sh:path bsip:symbol ;
    sh:name "Symbol" ;
    sh:description "Exchange ticker, NSE/BSE convention embedded in the string. The platform's universal join key across ~40 tables." ;
    sh:datatype xsd:string ;
    sh:order "5"^^xsd:integer .

_:GraphNode_attributes_prop     sh:path bsip:attributes ;
    sh:name "Semantic attributes" ;
    sh:description "Structured attributes attached to a canonical identity or graph node." ;
    sh:datatype rdf:JSON ;
    sh:order "6"^^xsd:integer .

_:GraphNode_valid_from_prop     sh:path bsip:valid_from ;
    sh:name "Valid from" ;
    sh:description "Start of the interval in which an assertion is valid." ;
    sh:datatype xsd:dateTime ;
    sh:order "7"^^xsd:integer .

_:GraphNode_valid_to_prop     sh:path bsip:valid_to ;
    sh:name "Valid to" ;
    sh:description "End of the interval in which an assertion is valid." ;
    sh:datatype xsd:dateTime ;
    sh:order "8"^^xsd:integer .

_:GraphNode_available_at_prop     sh:path bsip:available_at ;
    sh:name "Available at" ;
    sh:description "Earliest time the platform could know the assertion." ;
    sh:datatype xsd:dateTime ;
    sh:order "9"^^xsd:integer .

_:GraphNode_recorded_at_prop     sh:path bsip:recorded_at ;
    sh:name "Recorded at" ;
    sh:description "Time the platform recorded the assertion." ;
    sh:datatype xsd:dateTime ;
    sh:order "10"^^xsd:integer .

_:GraphNode_source_prop     sh:path bsip:source ;
    sh:name "Source" ;
    sh:description "Which provider or fetcher wrote the row. Provenance is per-row on this platform, so this is the first column to check before trusting a value." ;
    sh:datatype xsd:string ;
    sh:order "11"^^xsd:integer .

_:GraphNode_source_ref_prop     sh:path bsip:source_ref ;
    sh:name "Source reference" ;
    sh:description "Provider or source-row reference for a semantic assertion." ;
    sh:datatype xsd:string ;
    sh:order "12"^^xsd:integer .

_:GraphNode_revision_prop     sh:path bsip:revision ;
    sh:name "Revision" ;
    sh:description "Version or revision label attached to a graph node or source assertion." ;
    sh:datatype xsd:string ;
    sh:order "13"^^xsd:integer .

bsi:GraphEdgeShape     rdf:type sh:NodeShape ;
    sh:targetClass bsi:GraphEdge ;
    sh:name "Instance graph edge" ;
    sh:description "A typed, bitemporal assertion between graph nodes or a literal object value." ;
    bsi:grain "assertion_key" ;
    sh:property _:GraphEdge_id_prop, _:GraphEdge_predicate_prop, _:GraphEdge_object_value_prop, _:GraphEdge_valid_from_prop, _:GraphEdge_valid_to_prop, _:GraphEdge_available_at_prop, _:GraphEdge_recorded_at_prop, _:GraphEdge_source_prop, _:GraphEdge_source_ref_prop, _:GraphEdge_assertion_key_prop .

_:GraphEdge_id_prop     sh:path bsip:id ;
    sh:name "Row id" ;
    sh:description "Surrogate key that is NOT stable across a re-fetch or backfill. Never join on this across runs — use the table's natural key." ;
    sh:datatype xsd:string ;
    sh:order "1"^^xsd:integer .

_:GraphEdge_predicate_prop     sh:path bsip:predicate ;
    sh:name "Predicate" ;
    sh:description "Typed relationship label in the instance graph." ;
    sh:datatype xsd:string ;
    sh:order "2"^^xsd:integer .

_:GraphEdge_object_value_prop     sh:path bsip:object_value ;
    sh:name "Object value" ;
    sh:description "Typed object value carried by a graph assertion or claim." ;
    sh:datatype rdf:JSON ;
    sh:order "3"^^xsd:integer .

_:GraphEdge_valid_from_prop     sh:path bsip:valid_from ;
    sh:name "Valid from" ;
    sh:description "Start of the interval in which an assertion is valid." ;
    sh:datatype xsd:dateTime ;
    sh:order "4"^^xsd:integer .

_:GraphEdge_valid_to_prop     sh:path bsip:valid_to ;
    sh:name "Valid to" ;
    sh:description "End of the interval in which an assertion is valid." ;
    sh:datatype xsd:dateTime ;
    sh:order "5"^^xsd:integer .

_:GraphEdge_available_at_prop     sh:path bsip:available_at ;
    sh:name "Available at" ;
    sh:description "Earliest time the platform could know the assertion." ;
    sh:datatype xsd:dateTime ;
    sh:order "6"^^xsd:integer .

_:GraphEdge_recorded_at_prop     sh:path bsip:recorded_at ;
    sh:name "Recorded at" ;
    sh:description "Time the platform recorded the assertion." ;
    sh:datatype xsd:dateTime ;
    sh:order "7"^^xsd:integer .

_:GraphEdge_source_prop     sh:path bsip:source ;
    sh:name "Source" ;
    sh:description "Which provider or fetcher wrote the row. Provenance is per-row on this platform, so this is the first column to check before trusting a value." ;
    sh:datatype xsd:string ;
    sh:order "8"^^xsd:integer .

_:GraphEdge_source_ref_prop     sh:path bsip:source_ref ;
    sh:name "Source reference" ;
    sh:description "Provider or source-row reference for a semantic assertion." ;
    sh:datatype xsd:string ;
    sh:order "9"^^xsd:integer .

_:GraphEdge_assertion_key_prop     sh:path bsip:assertion_key ;
    sh:name "Assertion key" ;
    sh:description "Stable idempotency key for a graph assertion." ;
    sh:datatype xsd:string ;
    sh:order "10"^^xsd:integer ;
    sh:minCount "1"^^xsd:integer .

bsi:EvidenceRecordShape     rdf:type sh:NodeShape ;
    sh:targetClass bsi:EvidenceRecord ;
    sh:name "Evidence record" ;
    sh:description "Source material retained separately from the claim extracted or inferred from it." ;
    bsi:grain "evidence_key" ;
    sh:property _:EvidenceRecord_evidence_key_prop, _:EvidenceRecord_source_type_prop, _:EvidenceRecord_source_ref_prop, _:EvidenceRecord_source_uri_prop, _:EvidenceRecord_content_hash_prop, _:EvidenceRecord_content_prop, _:EvidenceRecord_observed_at_prop, _:EvidenceRecord_available_at_prop, _:EvidenceRecord_recorded_at_prop, _:EvidenceRecord_extraction_method_prop, _:EvidenceRecord_extraction_version_prop, _:EvidenceRecord_quality_status_prop, _:EvidenceRecord_claim_key_prop, _:EvidenceRecord_relation_prop, _:EvidenceRecord_contribution_prop, _:EvidenceRecord_note_prop .

_:EvidenceRecord_evidence_key_prop     sh:path bsip:evidence_key ;
    sh:name "Evidence key" ;
    sh:description "Stable key for source evidence or a decision evidence item." ;
    sh:datatype xsd:string ;
    sh:order "1"^^xsd:integer ;
    sh:minCount "1"^^xsd:integer .

_:EvidenceRecord_source_type_prop     sh:path bsip:source_type ;
    sh:name "Evidence source type" ;
    sh:description "Kind of source that supplied evidence." ;
    sh:datatype xsd:string ;
    sh:order "2"^^xsd:integer .

_:EvidenceRecord_source_ref_prop     sh:path bsip:source_ref ;
    sh:name "Source reference" ;
    sh:description "Provider or source-row reference for a semantic assertion." ;
    sh:datatype xsd:string ;
    sh:order "3"^^xsd:integer .

_:EvidenceRecord_source_uri_prop     sh:path bsip:source_uri ;
    sh:name "Source URI" ;
    sh:description "Canonical URI for a retained evidence item." ;
    sh:datatype xsd:string ;
    sh:order "4"^^xsd:integer .

_:EvidenceRecord_content_hash_prop     sh:path bsip:content_hash ;
    sh:name "Content hash" ;
    sh:description "Hash of source evidence content for replay and deduplication." ;
    sh:datatype xsd:string ;
    sh:order "5"^^xsd:integer .

_:EvidenceRecord_content_prop     sh:path bsip:content ;
    sh:name "Evidence content" ;
    sh:description "Source evidence content retained with provenance." ;
    sh:datatype rdf:JSON ;
    sh:order "6"^^xsd:integer .

_:EvidenceRecord_observed_at_prop     sh:path bsip:observed_at ;
    sh:name "Observed at" ;
    sh:description "Time the source observation was made." ;
    sh:datatype xsd:dateTime ;
    sh:order "7"^^xsd:integer .

_:EvidenceRecord_available_at_prop     sh:path bsip:available_at ;
    sh:name "Available at" ;
    sh:description "Earliest time the platform could know the assertion." ;
    sh:datatype xsd:dateTime ;
    sh:order "8"^^xsd:integer .

_:EvidenceRecord_recorded_at_prop     sh:path bsip:recorded_at ;
    sh:name "Recorded at" ;
    sh:description "Time the platform recorded the assertion." ;
    sh:datatype xsd:dateTime ;
    sh:order "9"^^xsd:integer .

_:EvidenceRecord_extraction_method_prop     sh:path bsip:extraction_method ;
    sh:name "Extraction method" ;
    sh:description "Method used to extract a claim or evidence item." ;
    sh:datatype xsd:string ;
    sh:order "10"^^xsd:integer .

_:EvidenceRecord_extraction_version_prop     sh:path bsip:extraction_version ;
    sh:name "Extraction version" ;
    sh:description "Version of the extractor that produced evidence." ;
    sh:datatype xsd:string ;
    sh:order "11"^^xsd:integer .

_:EvidenceRecord_quality_status_prop     sh:path bsip:quality_status ;
    sh:name "Evidence quality status" ;
    sh:description "Unverified, candidate, verified, or rejected evidence state." ;
    sh:datatype xsd:string ;
    sh:order "12"^^xsd:integer .

_:EvidenceRecord_claim_key_prop     sh:path bsip:claim_key ;
    sh:name "Claim key" ;
    sh:description "Stable key for an explicit market claim." ;
    sh:datatype xsd:string ;
    sh:order "13"^^xsd:integer .

_:EvidenceRecord_relation_prop     sh:path bsip:relation ;
    sh:name "Evidence relation" ;
    sh:description "Supports, opposes, context, or veto relationship." ;
    sh:datatype xsd:string ;
    sh:order "14"^^xsd:integer .

_:EvidenceRecord_contribution_prop     sh:path bsip:contribution ;
    sh:name "Evidence contribution" ;
    sh:description "Optional signed contribution of evidence to a claim or decision." ;
    sh:datatype xsd:decimal ;
    sh:order "15"^^xsd:integer ;
    bsi:unit "ratio" .

_:EvidenceRecord_note_prop     sh:path bsip:note ;
    sh:name "Note" ;
    sh:description "Human-readable semantic or decision note; never evidence by itself." ;
    sh:datatype xsd:string ;
    sh:order "16"^^xsd:integer .

bsi:MarketClaimShape     rdf:type sh:NodeShape ;
    sh:targetClass bsi:MarketClaim ;
    sh:name "Market claim" ;
