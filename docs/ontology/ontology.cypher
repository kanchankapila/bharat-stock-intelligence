MERGE (a:Class {name: 'BlockDeal'}) MERGE (b:Class {name: 'Observation'}) MERGE (a)-[:SUBCLASS_OF]->(b);
MERGE (a:Class {name: 'MFHolding'}) MERGE (b:Class {name: 'Observation'}) MERGE (a)-[:SUBCLASS_OF]->(b);
