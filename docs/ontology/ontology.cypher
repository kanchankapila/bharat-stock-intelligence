// Bharat Stock Intelligence ontology -> property graph
// version 1.1.0; generated by `python -m ontology export`
// Re-runnable: every statement MERGEs on a natural key.

// ---- uniqueness constraints ----
CREATE CONSTRAINT bsi_class_name IF NOT EXISTS FOR (n:Class) REQUIRE n.name IS UNIQUE;
CREATE CONSTRAINT bsi_property_name IF NOT EXISTS FOR (n:Property) REQUIRE n.name IS UNIQUE;
CREATE CONSTRAINT bsi_relation_name IF NOT EXISTS FOR (n:Relation) REQUIRE n.name IS UNIQUE;
CREATE CONSTRAINT bsi_metric_name IF NOT EXISTS FOR (n:Metric) REQUIRE n.name IS UNIQUE;
CREATE CONSTRAINT bsi_vocabulary_name IF NOT EXISTS FOR (n:Vocabulary) REQUIRE n.name IS UNIQUE;
CREATE CONSTRAINT bsi_term_id IF NOT EXISTS FOR (n:Term) REQUIRE n.id IS UNIQUE;
CREATE CONSTRAINT bsi_table_name IF NOT EXISTS FOR (n:Table) REQUIRE n.name IS UNIQUE;
CREATE CONSTRAINT bsi_column_id IF NOT EXISTS FOR (n:Column) REQUIRE n.id IS UNIQUE;
CREATE CONSTRAINT bsi_guardrail_id IF NOT EXISTS FOR (n:Guardrail) REQUIRE n.id IS UNIQUE;
CREATE CONSTRAINT bsi_externalconcept_iri IF NOT EXISTS FOR (n:ExternalConcept) REQUIRE n.iri IS UNIQUE;

// ---- the layer itself ----
MERGE (n:Ontology {name: 'bharat-stock-intelligence'}) SET n.version = '1.1.0', n.classes = 58, n.properties = 309, n.tables = 65, n.metrics = 18, n.vocabularies = 32 RETURN n.name AS name;

// ---- guardrails ----
MERGE (n:Guardrail {id: 'guardrail-1'}) SET n.rule = 'Columns with leakage_risk ''high'' or ''target'' are NEVER features. Columns whose semantic_type is ''label'' ARE the target.', n.order = 1 RETURN n.id AS id;
MERGE (g:Guardrail {id: 'guardrail-1'}) MERGE (o:Ontology {name: 'bharat-stock-intelligence'}) MERGE (g)-[:GUARDS]->(o);
MERGE (n:Guardrail {id: 'guardrail-2'}) SET n.rule = '`technical_signals`, `feature_store`, score-typed columns and the recommendation tables are platform OUTPUTS: a model may predict something else from them, but feeding an engine score back in as a feature leaks that engine into its own inputs.', n.order = 2 RETURN n.id AS id;
MERGE (g:Guardrail {id: 'guardrail-2'}) MERGE (o:Ontology {name: 'bharat-stock-intelligence'}) MERGE (g)-[:GUARDS]->(o);
MERGE (n:Guardrail {id: 'guardrail-3'}) SET n.rule = 'Point-in-time: entry is the NEXT session''s open after `signal_date`. A feature must have been knowable before that open.', n.order = 3 RETURN n.id AS id;
MERGE (g:Guardrail {id: 'guardrail-3'}) MERGE (o:Ontology {name: 'bharat-stock-intelligence'}) MERGE (g)-[:GUARDS]->(o);
MERGE (n:Guardrail {id: 'guardrail-4'}) SET n.rule = 'Labels are not comparable across `label_definition` values (`path_barrier` vs `terminal_pct2`). Filter it before aggregating any accuracy number.', n.order = 4 RETURN n.id AS id;
MERGE (g:Guardrail {id: 'guardrail-4'}) MERGE (o:Ontology {name: 'bharat-stock-intelligence'}) MERGE (g)-[:GUARDS]->(o);
MERGE (n:Guardrail {id: 'guardrail-5'}) SET n.rule = '`PENDING` outcome rows have not elapsed yet and are not negative examples.', n.order = 5 RETURN n.id AS id;
MERGE (g:Guardrail {id: 'guardrail-5'}) MERGE (o:Ontology {name: 'bharat-stock-intelligence'}) MERGE (g)-[:GUARDS]->(o);
MERGE (n:Guardrail {id: 'guardrail-6'}) SET n.rule = 'Mixing `adjustment_basis` values inside one price series invalidates every result derived from it.', n.order = 6 RETURN n.id AS id;
MERGE (g:Guardrail {id: 'guardrail-6'}) MERGE (o:Ontology {name: 'bharat-stock-intelligence'}) MERGE (g)-[:GUARDS]->(o);
MERGE (n:Guardrail {id: 'guardrail-7'}) SET n.rule = '`screener_*` tables are vendor OPINIONS used to surface candidates. They are never ground truth, and their aggregate score no longer clears the USABLE bar.', n.order = 7 RETURN n.id AS id;
MERGE (g:Guardrail {id: 'guardrail-7'}) MERGE (o:Ontology {name: 'bharat-stock-intelligence'}) MERGE (g)-[:GUARDS]->(o);
MERGE (n:Guardrail {id: 'guardrail-8'}) SET n.rule = 'Read `eff_dates` before any rank-IC reading: overlapping forward windows inflate a correlation by roughly the horizon factor.', n.order = 8 RETURN n.id AS id;
MERGE (g:Guardrail {id: 'guardrail-8'}) MERGE (o:Ontology {name: 'bharat-stock-intelligence'}) MERGE (g)-[:GUARDS]->(o);
MERGE (n:Guardrail {id: 'guardrail-9'}) SET n.rule = 'Every historical read is an as-of read: a feature value must come from rows whose data was knowable at or before entry — never from today''s state projected back.', n.order = 9 RETURN n.id AS id;
MERGE (g:Guardrail {id: 'guardrail-9'}) MERGE (o:Ontology {name: 'bharat-stock-intelligence'}) MERGE (g)-[:GUARDS]->(o);
MERGE (n:Guardrail {id: 'guardrail-10'}) SET n.rule = 'Nothing in this layer is investment advice or a solicitation to trade; it describes data semantics only, and any output built from it is not financial advice.', n.order = 10 RETURN n.id AS id;
MERGE (g:Guardrail {id: 'guardrail-10'}) MERGE (o:Ontology {name: 'bharat-stock-intelligence'}) MERGE (g)-[:GUARDS]->(o);

// ---- classes ----
MERGE (n:Class {name: 'Instrument'}) SET n.label = 'Instrument', n.layer = 'identity', n.description = 'Anything that is quoted and traded. The canonical instrument identity is table-backed in `market_instrument`; legacy observation tables still key on the exchange ticker.', n.grain = 'instrument_key', n.key_properties = ['instrument_key'], n.uri = 'https://bharat-stock-intelligence.dev/ontology/market#Instrument' RETURN n.name AS name;
MERGE (n:Class {name: 'Issuer'}) SET n.label = 'Issuer', n.layer = 'identity', n.description = 'The legal issuer behind one or more instruments. ISIN issuer-prefix keys are authoritative when a checksum-valid ISIN is available; symbol-only rows remain explicitly provisional.', n.grain = 'issuer_key', n.key_properties = ['issuer_key'], n.uri = 'https://bharat-stock-intelligence.dev/ontology/market#Issuer' RETURN n.name AS name;
MERGE (n:Class {name: 'Listing'}) SET n.label = 'Listing', n.layer = 'identity', n.description = 'One tradable exchange/segment/symbol representation of an instrument.', n.grain = 'listing_key', n.key_properties = ['listing_key'], n.uri = 'https://bharat-stock-intelligence.dev/ontology/market#Listing' RETURN n.name AS name;
MERGE (n:Class {name: 'ProviderIdentifier'}) SET n.label = 'Provider identifier', n.layer = 'identity', n.description = 'A provider-qualified identifier for an instrument. Provider and scheme are part of the identity; collisions are recorded rather than resolved by row order.', n.grain = '(provider, scheme, identifier_value)', n.key_properties = ['provider', 'scheme', 'identifier_value'], n.uri = 'https://bharat-stock-intelligence.dev/ontology/market#ProviderIdentifier' RETURN n.name AS name;
MERGE (n:Class {name: 'Equity'}) SET n.label = 'Equity', n.layer = 'identity', n.description = 'A listed equity, one row per exchange ticker. This is the platform''s universal join key and the subject of every other class.', n.grain = 'one row per exchange ticker in `stock_master`', n.key_properties = ['symbol', 'isin'], n.caveats = ['Keyed on ticker, not ISIN: a company listed on both NSE and BSE is two rows here and one instrument in any ISIN-first model (see alignment.py).', '`stock_master.sector` was EMPTY for every row as of 2026-09-21; sector is populated downstream (technical_signals.sector, unified_recommendations.sector).'], n.uri = 'https://bharat-stock-intelligence.dev/ontology/market#Equity' RETURN n.name AS name;
MERGE (n:Class {name: 'Index'}) SET n.label = 'Index', n.layer = 'identity', n.description = 'A market index used as a benchmark or as a derivatives underlying (NIFTY 50, BANK NIFTY, SENSEX, INDIA VIX, GIFT NIFTY, ...).', n.grain = 'one row per index', n.key_properties = ['index_name'], n.caveats = ['A *reference* class: the index exists only as a column value on `nt_index_pcr_ts`, `index_ohlcv`, `nt_fno_expiry` and the option tables. `stock_master` carries no index master, so an index is whatever a fetcher wrote — normalise case before joining across tables.'], n.uri = 'https://bharat-stock-intelligence.dev/ontology/market#Index' RETURN n.name AS name;
MERGE (n:Class {name: 'Sector'}) SET n.label = 'Sector', n.layer = 'identity', n.description = 'An industry grouping used for relative-strength and rotation analysis. Stored as free text across several tables rather than resolved to a scheme.', n.grain = 'one row per label, no canonical table', n.key_properties = ['sector'], n.caveats = ['A *reference* class with no master table: the label comes from whichever fetcher wrote the row (`technical_signals.sector`, `unified_recommendations.sector`), so cross-table sector joins can silently lose or double-count names. Resolve to a spelling before aggregating.'], n.uri = 'https://bharat-stock-intelligence.dev/ontology/market#Sector' RETURN n.name AS name;
MERGE (n:Class {name: 'Exchange'}) SET n.label = 'Exchange', n.layer = 'identity', n.description = 'The venue an instrument is admitted to. A two-value dimension (NSE / BSE): usually encoded inside `symbol`, but carried as its own column in seven tables (nse_stocks, market_holidays, nt_fno_expiry, stock_earnings_dates, institutional_deal_signals, mc_advance_decline, mc_chart_patterns).', n.grain = 'dimension', n.key_properties = ['exchange'], n.caveats = ['A *reference* class: it has no card because no single table is the exchange. `nse_stocks.exchange` is the canonical column and the other six are pass-through copies written by different fetchers.'], n.uri = 'https://bharat-stock-intelligence.dev/ontology/market#Exchange' RETURN n.name AS name;
MERGE (n:Class {name: 'ScripCodeMapping'}) SET n.label = 'Vendor scrip-code mapping', n.layer = 'identity', n.description = 'The vendor''s private scid mapped onto the platform symbol and issuer name — the only sanctioned route from one to the other.', n.grain = '(scid, symbol)', n.key_properties = ['scid', 'symbol'], n.caveats = ['Not enforced as unique: after a vendor scrip merge, one symbol can appear under more than one scid, so a symbol->scid join can fan out.'], n.uri = 'https://bharat-stock-intelligence.dev/ontology/market#ScripCodeMapping' RETURN n.name AS name;
MERGE (n:Class {name: 'CompanyProfile'}) SET n.label = 'CompanyProfile', n.layer = 'identity', n.description = 'Narrative and high-level attributes about the issuer behind a ticker.', n.grain = 'one row per symbol', n.key_properties = ['symbol'], n.caveats = ['Description text is vendor-authored and free-form; `growth_score` and `ai_analysis` are derived, not observed.'], n.uri = 'https://bharat-stock-intelligence.dev/ontology/market#CompanyProfile' RETURN n.name AS name;
MERGE (n:Class {name: 'Observation'}) SET n.label = 'Observation', n.layer = 'observation', n.description = 'Abstract parent for anything measured at a point in time without the platform adding an opinion to it. Raw or vendor-supplied; never a label.', n.key_properties = ['symbol'], n.uri = 'https://bharat-stock-intelligence.dev/ontology/market#Observation' RETURN n.name AS name;
MERGE (n:Class {name: 'Bar'}) SET n.label = 'Daily bar', n.layer = 'observation', n.description = 'One daily OHLCV bar per symbol per trading session — the platform''s only self-owned source of truth.', n.grain = '(symbol, date)', n.key_properties = ['symbol', 'date'], n.caveats = ['Price basis is recorded per row in `adjustment_basis` (nse_bhavcopy_raw | split_only | split_dividend). Mixing bases inside one series corrupts any backtest silently — this is a documented recurring bug class in this repo.', 'Quarantined bars are flagged, not deleted: filter `is_suspect = 0` before building a training panel. `suspect_reason` names the cause.'], n.uri = 'https://bharat-stock-intelligence.dev/ontology/market#Bar' RETURN n.name AS name;
MERGE (n:Class {name: 'IntradayBar'}) SET n.label = 'Intraday bar', n.layer = 'observation', n.description = 'Sub-daily OHLCV with VWAP. Currently a single interval (15m) of recent history.', n.grain = '(symbol, datetime, series)', n.key_properties = ['symbol', 'datetime', 'series'], n.caveats = ['Shallow history relative to the daily panel; not a substitute for `stock_ohlcv` in any long-horizon study.', 'The key''s `series` property is the bar interval (`15m`), NOT an NSE series symbol — the same `series` property is overloaded across the schema (see its bindings), so a join must qualify the table too.', '3.88M rows are stored in a single `datetime` column that mixes the exchange date and the clock time; it is a TIMESTAMP, not a trading-date column, so it does not join to `stock_ohlcv.date` without a cast.'], n.uri = 'https://bharat-stock-intelligence.dev/ontology/market#IntradayBar' RETURN n.name AS name;
MERGE (n:Class {name: 'DeliveryObservation'}) SET n.label = 'Delivery observation', n.layer = 'observation', n.description = 'The deliverable-to-traded quantity ratio — the highest-frequency ownership-behaviour proxy the platform owns, and a T+1 lag by construction.', n.grain = '(symbol, date)', n.key_properties = ['symbol', 'date'], n.caveats = ['Two writers exist (`stock_delivery_data`, `stock_delivery_volume`) with different column names and different series coverage — check which one a study used.'], n.uri = 'https://bharat-stock-intelligence.dev/ontology/market#DeliveryObservation' RETURN n.name AS name;
MERGE (n:Class {name: 'CorporateAction'}) SET n.label = 'Corporate action', n.layer = 'observation', n.description = 'A capital-structure event with a price consequence (dividend, split, bonus, rights) plus the record/ex dates that make it usable point-in-time.', n.grain = '(symbol, ex_date, action_type)', n.key_properties = ['symbol', 'ex_date', 'action_type'], n.caveats = ['The same table also carries `Quarterly Results` rows, which are not capital actions at all — filter `action_type` before computing an adjustment factor.'], n.uri = 'https://bharat-stock-intelligence.dev/ontology/market#CorporateAction' RETURN n.name AS name;
MERGE (n:Class {name: 'FundamentalSnapshot'}) SET n.label = 'Fundamental snapshot', n.layer = 'observation', n.description = 'Vendor-supplied accounting ratios and market-cap for a symbol, captured with an as-of date. Lagging information: the publication delay is the point-in-time risk.', n.grain = '(symbol, as_of_date)', n.key_properties = ['symbol', 'as_of_date'], n.caveats = ['Vendor restatements make re-fetched history differ from what was known at the time; only the as-of-captured row is point-in-time honest.'], n.uri = 'https://bharat-stock-intelligence.dev/ontology/market#FundamentalSnapshot' RETURN n.name AS name;
MERGE (n:Class {name: 'AnalystEstimate'}) SET n.label = 'Analyst estimate', n.layer = 'observation', n.description = 'Consensus ratings, target prices and next-period estimates captured as a dated snapshot. Genuinely leading information; short panel relative to the news table.', n.grain = '(symbol, as_of_date)', n.key_properties = ['symbol', 'as_of_date'], n.caveats = ['The revision trio (eps/target revision, analyst-count change) is carried downstream into `technical_signals` and is not yet graded.'], n.uri = 'https://bharat-stock-intelligence.dev/ontology/market#AnalystEstimate' RETURN n.name AS name;
MERGE (n:Class {name: 'EarningsSurprise'}) SET n.label = 'Earnings surprise', n.layer = 'observation', n.description = 'Actual versus estimated net profit and revenue for a quarter, with the surprise computed per line. Coincident for the print, leading for the drift after it.', n.grain = '(symbol, quarter)', n.key_properties = ['symbol', 'series'], n.caveats = ['Keyed by vendor `scid` in the source table while every other table keys on `symbol` — the join runs through `mc_scid_map`.', 'The `quarter` column is MISNAMED: it holds a result DATE rendered as free text (`''May 30, 2026''`), not a fiscal-quarter label, so it will not sort lexicographically and will not parse as an ISO date. Cast at read time.', '`scid` is stored as TEXT, so the symbol join is a string match, not a numeric one.'], n.uri = 'https://bharat-stock-intelligence.dev/ontology/market#EarningsSurprise' RETURN n.name AS name;
MERGE (n:Class {name: 'InsiderTransaction'}) SET n.label = 'Insider transaction', n.layer = 'observation', n.description = 'A promoter/insider buy or sell filing. Leading in principle; graded weak as a standalone signal on this platform and kept as a confluence input.', n.grain = '(symbol, date, acquirer, transaction)', n.key_properties = ['symbol', 'date', 'company_name', 'trade_type'], n.caveats = ['Filed with a lag; treat the filing date as the earliest knowable time, not the trade date.', '`acquirerName` is vendor free text, NOT a foreign key to `stock_master` — it cannot be joined to a symbol and must be matched by name at best.', '`valueInr` is rupees as a bare number with no currency or unit column, unlike `block_deals.value_cr` which is crores. Same semantic field, two different multipliers; do not union them without normalising.'], n.uri = 'https://bharat-stock-intelligence.dev/ontology/market#InsiderTransaction' RETURN n.name AS name;
MERGE (n:Class {name: 'BlockDeal'}) SET n.label = 'Block / bulk deal', n.layer = 'observation', n.description = 'An off-book or bulk transaction with quantity, price and value. Value is stored in CRORES as a bare number, with no currency or unit term attached.', n.grain = '(symbol, date, deal)', n.key_properties = ['symbol', 'date', 'id'], n.caveats = ['`trade_type` is stored in mixed case by different fetchers — normalise with UPPER() before aggregating buys and sells.'], n.uri = 'https://bharat-stock-intelligence.dev/ontology/market#BlockDeal' RETURN n.name AS name;
MERGE (n:Class {name: 'MFHolding'}) SET n.label = 'Mutual-fund holding', n.layer = 'observation', n.description = 'Aggregate mutual-fund ownership of a symbol: holding percentage, fund count and the change versus the previous disclosure.', n.grain = '(symbol, disclosure date)', n.key_properties = ['symbol', 'date'], n.uri = 'https://bharat-stock-intelligence.dev/ontology/market#MFHolding' RETURN n.name AS name;
MERGE (n:Class {name: 'NewsItem'}) SET n.label = 'News item', n.layer = 'observation', n.description = 'A news article or exchange announcement with vendor sentiment, a FinBERT tone ensemble, an impact bucket and the symbols it mentions. 15 years deep — the only panel here that supports a real event study.', n.grain = 'one row per article/announcement', n.key_properties = ['id'], n.caveats = ['Two sentiment sources coexist (`sentiment` from the vendor, `tone_*` from FinBERT) and can disagree; `sentiment_conflict` flags it. Whichever one a study used must be stated.', '`symbols_json` is a JSON array — a mention is NOT a foreign key. Join through `news_symbol_link` or the JSON expansion, never by string match.'], n.uri = 'https://bharat-stock-intelligence.dev/ontology/market#NewsItem' RETURN n.name AS name;
MERGE (n:Class {name: 'OptionChainRow'}) SET n.label = 'Option chain row', n.layer = 'observation', n.description = 'One strike, one expiry, one session: call and put leg premium, volume, open interest, IV and greeks. A grid, not a time series.', n.grain = '(symbol, date, expiry, strike)', n.key_properties = ['symbol', 'date', 'expiry', 'strike'], n.caveats = ['Index panels are deep; STOCK option panels are shallow. Any stock-level derivatives study inherits that shallow panel.'], n.uri = 'https://bharat-stock-intelligence.dev/ontology/market#OptionChainRow' RETURN n.name AS name;
MERGE (n:Class {name: 'FuturesPositioning'}) SET n.label = 'Futures positioning', n.layer = 'observation', n.description = 'Stock-futures open interest, buildup label, rollover percentage, basis and cost of carry for one expiry and session.', n.grain = '(symbol, date, expiry)', n.key_properties = ['symbol', 'date', 'expiry'], n.caveats = ['LOW-DATA: the stock-futures panel covers roughly two weeks of dates. Any ''measured'' claim built on it is a calendar artefact, not an edge — this is the specific finding the master report''s LOW-DATA verdict records.'], n.uri = 'https://bharat-stock-intelligence.dev/ontology/market#FuturesPositioning' RETURN n.name AS name;
MERGE (n:Class {name: 'IndexDerivativesSnapshot'}) SET n.label = 'Index derivatives snapshot', n.layer = 'observation', n.description = 'Index-level positioning: PCR (single-strike time series and EOD), max pain, and aggregate call/put open interest.', n.grain = '(index_name, date, expiry)', n.key_properties = ['index_name', 'date', 'expiry'], n.caveats = ['The index panel is far deeper than the stock panel but remains ungraded as a standalone signal — treated here as a research candidate.'], n.uri = 'https://bharat-stock-intelligence.dev/ontology/market#IndexDerivativesSnapshot' RETURN n.name AS name;
MERGE (n:Class {name: 'MoverSnapshot'}) SET n.label = 'Mover snapshot', n.layer = 'observation', n.description = 'A ranked intraday mover list entry from a vendor feed: the platform''s within-day event backbone alongside the event triggers.', n.grain = '(source, trade_date, symbol, rank)', n.key_properties = ['source', 'date', 'symbol', 'rank_position'], n.caveats = ['Rank is per source per capture, so a rank is only comparable within one source and one instant.'], n.uri = 'https://bharat-stock-intelligence.dev/ontology/market#MoverSnapshot' RETURN n.name AS name;
MERGE (n:Class {name: 'RegimeState'}) SET n.label = 'Regime state', n.layer = 'context', n.description = 'The macro regime for a session, with its posterior probability and the decoded HMM path. Also covers the intraday regime panel.', n.grain = 'one row per date', n.key_properties = ['date'], n.caveats = ['This is a weight GATE on this platform — it re-blends engine weights — not a directional signal. Treating a regime label as alpha inverts its role.'], n.uri = 'https://bharat-stock-intelligence.dev/ontology/market#RegimeState' RETURN n.name AS name;
MERGE (n:Class {name: 'BreadthObservation'}) SET n.label = 'Breadth observation', n.layer = 'context', n.description = 'Market-wide participation statistics: share of the universe above its 200-day average, advance/decline ratio, net highs minus lows.', n.grain = 'one row per date', n.key_properties = ['date'], n.caveats = ['Computed over this platform''s own universe definition, so the numbers are not comparable to a vendor''s breadth series without re-basing.'], n.uri = 'https://bharat-stock-intelligence.dev/ontology/market#BreadthObservation' RETURN n.name AS name;
MERGE (n:Class {name: 'SectorRotationPoint'}) SET n.label = 'Sector rotation point', n.layer = 'context', n.description = 'Weekly relative-rotation coordinates and quadrant per sector — the intended input to sector-plus-stock relative strength.', n.grain = '(sector, week_date)', n.key_properties = ['sector', 'week_date'], n.caveats = ['The sector-to-stock relative-strength link is a RESEARCH CANDIDATE: the master report names it as an experiment, not an established edge.'], n.uri = 'https://bharat-stock-intelligence.dev/ontology/market#SectorRotationPoint' RETURN n.name AS name;
MERGE (n:Class {name: 'PlatformOutput'}) SET n.label = 'Platform output', n.layer = 'derived', n.description = 'Abstract parent for anything this platform computes and serves. Every subclass is an OPINION of this system, not an observation of the market.', n.key_properties = ['symbol'], n.uri = 'https://bharat-stock-intelligence.dev/ontology/market#PlatformOutput' RETURN n.name AS name;
MERGE (n:Class {name: 'FeatureVector'}) SET n.label = 'Feature vector', n.layer = 'derived', n.description = 'The rolling per-symbol, per-date feature panel the models train on. Features, not information: they re-express price, flow and vendor data.', n.grain = '(symbol, date, timeframe)', n.key_properties = ['symbol', 'date', 'timeframe'], n.caveats = ['A feature''s meaning is defined by `feature_engineering.py` at a specific commit, not by this ontology. Cite the feature version when a result depends on it.', 'Pre-rebuild rows are not comparable with post-rebuild rows.'], n.uri = 'https://bharat-stock-intelligence.dev/ontology/market#FeatureVector' RETURN n.name AS name;
MERGE (n:Class {name: 'TechnicalSignal'}) SET n.label = 'Technical signal', n.layer = 'derived', n.description = 'The wide per-symbol, per-date technical panel: indicators, regime stamp, flow and fundamental context columns, plus the model''s probability outputs.', n.grain = '(symbol, date)', n.key_properties = ['symbol', 'date'], n.caveats = ['Over 300 columns of mixed provenance: raw indicators, vendor opinions (ext_* / mc_* / tl_* prefixes) and model outputs sit side by side. The binding table marks which is which.', '`win_probability` and `calibrated_win_probability` are model OUTPUTS and must not be fed back in as features.'], n.uri = 'https://bharat-stock-intelligence.dev/ontology/market#TechnicalSignal' RETURN n.name AS name;
MERGE (n:Class {name: 'EngineScore'}) SET n.label = 'Engine score', n.layer = 'derived', n.description = 'A single engine''s, or the multi-engine composite''s, score for a symbol and date with its engine-coverage count.', n.grain = '(symbol, date)', n.key_properties = ['symbol', 'date'], n.caveats = ['Engine contributions are measured here, not assumed: only the confluence engine carries a growing positive reading, the ML ensemble adds roughly +0.02, and the DL / cross-sectional / smart-money engines measured 0.0 across all regimes.'], n.uri = 'https://bharat-stock-intelligence.dev/ontology/market#EngineScore' RETURN n.name AS name;
MERGE (n:Class {name: 'Recommendation'}) SET n.label = 'Recommendation', n.layer = 'derived', n.description = 'The served trade: composite score, conviction bucket, action label, entry zone, stop, targets, risk/reward and position size for one symbol, date and timeframe.', n.grain = '(symbol, computed_at, timeframe)', n.key_properties = ['symbol', 'computed_at', 'timeframe'], n.caveats = ['`computed_at` is TEXT here and native TIMESTAMPTZ in `confluence_signals` — cast before joining the two.', '`trade_reasoning` is generated text: an explanation, never evidence.', 'The history table carries the raw meta-label behind `position_size_pct`, which the serving table does not.'], n.uri = 'https://bharat-stock-intelligence.dev/ontology/market#Recommendation' RETURN n.name AS name;
MERGE (n:Class {name: 'ModelArtifact'}) SET n.label = 'Model artifact', n.layer = 'derived', n.description = 'A registered trained model: type, version, evaluation metrics, feature count, horizon and active flag.', n.grain = 'one row per version', n.key_properties = ['id'], n.caveats = ['Promotion is gated on holdout error plus a margin; a row existing does not mean the model is serving.'], n.uri = 'https://bharat-stock-intelligence.dev/ontology/market#ModelArtifact' RETURN n.name AS name;
MERGE (n:Class {name: 'FeatureImportance'}) SET n.label = 'Feature importance', n.layer = 'derived', n.description = 'Per-model, per-run feature importance with rank — the audit trail behind which inputs a model actually used.', n.grain = '(model, run, feature)', n.key_properties = ['id'], n.uri = 'https://bharat-stock-intelligence.dev/ontology/market#FeatureImportance' RETURN n.name AS name;
MERGE (n:Class {name: 'OutcomeRecord'}) SET n.label = 'Outcome record', n.layer = 'outcome', n.description = 'Abstract parent for resolved results. Labels live here and nowhere else: nothing in this branch may ever appear on the input side of a model.', n.key_properties = ['symbol', 'signal_date'], n.uri = 'https://bharat-stock-intelligence.dev/ontology/market#OutcomeRecord' RETURN n.name AS name;
MERGE (n:Class {name: 'EdgeReading'}) SET n.label = 'Edge reading', n.layer = 'outcome', n.description = 'One factor-grading result: rank-IC and hit-AUC for a table/column, per regime and horizon, with the effective-date count and a verdict.', n.grain = '(run_at, table_name, score_col, horizon_days, regime)', n.key_properties = ['source', 'name', 'horizon_days', 'verdict'], n.caveats = ['Read `eff_dates` BEFORE the reading. Overlapping forward windows inflate a correlation by roughly the horizon factor, and the effective-date count is the guard that exposes it — too few effective dates makes a reading a calendar artefact rather than an edge.'], n.uri = 'https://bharat-stock-intelligence.dev/ontology/market#EdgeReading' RETURN n.name AS name;
MERGE (n:Class {name: 'SignalOutcome'}) SET n.label = 'Signal outcome', n.layer = 'outcome', n.description = 'The resolved result of a signal: entry, exit, horizon, return and the outcome label, under one of two possibly-different labelling rules.', n.grain = '(symbol, signal_date, horizon_days, signal_source)', n.key_properties = ['symbol', 'signal_date', 'horizon_days'], n.caveats = ['Labels are NOT comparable across `label_definition` (`path_barrier` vs `terminal_pct2`). Always filter on it before aggregating accuracy.', '`PENDING` rows have not elapsed — they are not negative examples.', '`NO_ENTRY_PRICE` / `SUSPECT_DATA` are integrity exits, not labels.'], n.uri = 'https://bharat-stock-intelligence.dev/ontology/market#SignalOutcome' RETURN n.name AS name;
MERGE (n:Class {name: 'SignalExcursion'}) SET n.label = 'Signal excursion', n.layer = 'outcome', n.description = 'Path statistics inside the evaluation window: maximum favourable and adverse excursion, days to each, and whether MFE preceded MAE.', n.grain = '(symbol, signal_date, horizon_days)', n.key_properties = ['symbol', 'signal_date', 'horizon_days'], n.caveats = ['This is what makes a stop-loss study possible: the terminal return alone cannot tell you whether the trade was ever viable.'], n.uri = 'https://bharat-stock-intelligence.dev/ontology/market#SignalExcursion' RETURN n.name AS name;
MERGE (n:Class {name: 'CandidateRecord'}) SET n.label = 'Candidate record', n.layer = 'candidate', n.description = 'Abstract parent for vendor-opinion streams. These SURFACE candidates; they are never ground truth.', n.key_properties = ['symbol'], n.uri = 'https://bharat-stock-intelligence.dev/ontology/market#CandidateRecord' RETURN n.name AS name;
MERGE (n:Class {name: 'Screener'}) SET n.label = 'Screener', n.layer = 'candidate', n.description = 'A vendor screener definition with its inferred sentiment, category, reliability tier and classification confidence.', n.grain = 'one row per screener', n.key_properties = ['id'], n.caveats = ['Sentiment, category and tier are INFERRED by this platform, not supplied by the vendor: they are model output about a vendor product.', 'A screener is a candidate generator, never evidence — its aggregate momentum score no longer clears the USABLE bar.'], n.uri = 'https://bharat-stock-intelligence.dev/ontology/market#Screener' RETURN n.name AS name;
MERGE (n:Class {name: 'ScreenerAppearance'}) SET n.label = 'Screener appearance', n.layer = 'candidate', n.description = 'A single surfacing event: this screener listed this symbol at this instant, with the price, change and volume at that moment.', n.grain = '(run_id, symbol, filter_key)', n.key_properties = ['id'], n.caveats = ['12.25M rows and growing: always bound a query by run_id or symbol.', 'Surfacing time is the only knowable time; the screener''s internal logic is not visible.'], n.uri = 'https://bharat-stock-intelligence.dev/ontology/market#ScreenerAppearance' RETURN n.name AS name;
MERGE (n:Class {name: 'ScreenerOutcome'}) SET n.label = 'Screener outcome', n.layer = 'outcome', n.description = 'Forward returns pre-tracked and attached to an appearance at surfacing time.', n.grain = '(appearance_id, symbol)', n.key_properties = ['id', 'symbol'], n.caveats = ['The platform''s largest pre-labelled dataset (9.2M outcomes) and the reason screener research is worth doing — but the labels are forward returns from the surfacing price, so any attribution belongs to the SCREENER, not to an engine that happened to agree with it.'], n.uri = 'https://bharat-stock-intelligence.dev/ontology/market#ScreenerOutcome' RETURN n.name AS name;
MERGE (n:Class {name: 'EventTrigger'}) SET n.label = 'Event trigger', n.layer = 'candidate', n.description = 'Detector output: which composite trigger classes fired for a symbol on a date, with news counts and bullish-tenure state.', n.grain = '(symbol, date)', n.key_properties = ['symbol', 'date'], n.caveats = ['`triggers` is a comma-joined string carrying inline thresholds (`CROWDED_NEWS p90`) — parse the class token, never the whole value.'], n.uri = 'https://bharat-stock-intelligence.dev/ontology/market#EventTrigger' RETURN n.name AS name;
MERGE (n:Class {name: 'GovernanceRecord'}) SET n.label = 'Governance record', n.layer = 'governance', n.description = 'Abstract parent for operational metadata. These answer ''when was this true and who wrote it'', which on this platform is the difference between a usable value and a guess.', n.key_properties = ['id'], n.uri = 'https://bharat-stock-intelligence.dev/ontology/market#GovernanceRecord' RETURN n.name AS name;
MERGE (n:Class {name: 'Endpoint'}) SET n.label = 'Data endpoint', n.layer = 'governance', n.description = 'A discovered, verified market-data endpoint: provider, domain, scope, update frequency and the template to call it. The platform''s data-sourcing registry.', n.grain = 'one row per endpoint', n.key_properties = ['id'], n.caveats = ['This registry is the mandatory first stop when a source stops returning data — 3,408 verified endpoints exist here and a ''dead vendor'' conclusion is not admissible until they have been checked.'], n.uri = 'https://bharat-stock-intelligence.dev/ontology/market#Endpoint' RETURN n.name AS name;
MERGE (n:Class {name: 'JobRun'}) SET n.label = 'Job run', n.layer = 'governance', n.description = 'Per-job heartbeat: last status, last success, last error and run/failure counts.', n.grain = 'one row per job', n.key_properties = ['job_name'], n.caveats = ['`last_run_at` is the last ATTEMPT; `last_success_at` is what freshness should be judged against. A job that runs and fails updates the former only.', 'A step exiting 0 is not evidence that data was written; this repo treats ''data not successfully written'' as an error regardless of log level.'], n.uri = 'https://bharat-stock-intelligence.dev/ontology/market#JobRun' RETURN n.name AS name;
MERGE (n:Class {name: 'DataQualityCheck'}) SET n.label = 'Data-quality check', n.layer = 'governance', n.description = 'The result of one named validation check: category, criticality, status and a detail string.', n.grain = '(check_id, checked_at)', n.key_properties = ['check_id'], n.caveats = ['Status is stored lowercase (`pass` / `warn`), so a case-sensitive comparison against ''PASS'' matches nothing.'], n.uri = 'https://bharat-stock-intelligence.dev/ontology/market#DataQualityCheck' RETURN n.name AS name;
MERGE (n:Class {name: 'DataContract'}) SET n.label = 'Data contract', n.layer = 'governance', n.description = 'A versioned machine-readable contract describing one dataset''s grain, timing, source, training use, and physical lineage.', n.grain = 'contract_key', n.key_properties = ['contract_key'], n.uri = 'https://bharat-stock-intelligence.dev/ontology/market#DataContract' RETURN n.name AS name;
MERGE (n:Class {name: 'FeatureDefinition'}) SET n.label = 'Semantic feature definition', n.layer = 'governance', n.description = 'A versioned authored definition of a model-facing property, including leakage and feature-use constraints.', n.grain = 'feature_key', n.key_properties = ['feature_key'], n.uri = 'https://bharat-stock-intelligence.dev/ontology/market#FeatureDefinition' RETURN n.name AS name;
MERGE (n:Class {name: 'DataWatermark'}) SET n.label = 'Data completeness watermark', n.layer = 'governance', n.description = 'Producer-published completeness and input/output boundary for a dataset partition.', n.grain = '(dataset, partition_key)', n.key_properties = ['dataset', 'partition_key'], n.uri = 'https://bharat-stock-intelligence.dev/ontology/market#DataWatermark' RETURN n.name AS name;
MERGE (n:Class {name: 'GraphNode'}) SET n.label = 'Instance graph node', n.layer = 'governance', n.description = 'A canonical entity projected into the bitemporal market graph.', n.grain = 'node_key', n.key_properties = ['node_key'], n.uri = 'https://bharat-stock-intelligence.dev/ontology/market#GraphNode' RETURN n.name AS name;
MERGE (n:Class {name: 'GraphEdge'}) SET n.label = 'Instance graph edge', n.layer = 'governance', n.description = 'A typed, bitemporal assertion between graph nodes or a literal object value.', n.grain = 'assertion_key', n.key_properties = ['assertion_key'], n.uri = 'https://bharat-stock-intelligence.dev/ontology/market#GraphEdge' RETURN n.name AS name;
MERGE (n:Class {name: 'EvidenceRecord'}) SET n.label = 'Evidence record', n.layer = 'governance', n.description = 'Source material retained separately from the claim extracted or inferred from it.', n.grain = 'evidence_key', n.key_properties = ['evidence_key'], n.uri = 'https://bharat-stock-intelligence.dev/ontology/market#EvidenceRecord' RETURN n.name AS name;
MERGE (n:Class {name: 'MarketClaim'}) SET n.label = 'Market claim', n.layer = 'derived', n.description = 'An explicit, status-bearing assertion about a market entity, separate from raw evidence.', n.grain = 'claim_key', n.key_properties = ['claim_key'], n.uri = 'https://bharat-stock-intelligence.dev/ontology/market#MarketClaim' RETURN n.name AS name;
MERGE (n:Class {name: 'DecisionEvent'}) SET n.label = 'Decision event', n.layer = 'derived', n.description = 'An append-only, reconstructable decision record with cutoff, versions, quality, and structured supporting or contradictory evidence.', n.grain = 'decision_key', n.key_properties = ['decision_key'], n.uri = 'https://bharat-stock-intelligence.dev/ontology/market#DecisionEvent' RETURN n.name AS name;
MERGE (n:Class {name: 'DecisionOutcome'}) SET n.label = 'Decision outcome', n.layer = 'outcome', n.description = 'A realized outcome attached to a decision under an explicit label definition and horizon.', n.grain = '(decision_key, label_definition, horizon_days)', n.key_properties = ['decision_key', 'label_definition', 'horizon_days'], n.uri = 'https://bharat-stock-intelligence.dev/ontology/market#DecisionOutcome' RETURN n.name AS name;

// ---- subclass edges ----
MERGE (a:Class {name: 'Listing'}) MERGE (b:Class {name: 'Instrument'}) MERGE (a)-[:SUBCLASS_OF]->(b);
MERGE (a:Class {name: 'Equity'}) MERGE (b:Class {name: 'Instrument'}) MERGE (a)-[:SUBCLASS_OF]->(b);
