MERGE (a:Class {name: 'FuturesPositioning'}) MERGE (b:Class {name: 'Observation'}) MERGE (a)-[:SUBCLASS_OF]->(b);
MERGE (a:Class {name: 'IndexDerivativesSnapshot'}) MERGE (b:Class {name: 'Observation'}) MERGE (a)-[:SUBCLASS_OF]->(b);
MERGE (a:Class {name: 'MoverSnapshot'}) MERGE (b:Class {name: 'Observation'}) MERGE (a)-[:SUBCLASS_OF]->(b);
MERGE (a:Class {name: 'FeatureVector'}) MERGE (b:Class {name: 'PlatformOutput'}) MERGE (a)-[:SUBCLASS_OF]->(b);
MERGE (a:Class {name: 'TechnicalSignal'}) MERGE (b:Class {name: 'PlatformOutput'}) MERGE (a)-[:SUBCLASS_OF]->(b);
MERGE (a:Class {name: 'EngineScore'}) MERGE (b:Class {name: 'PlatformOutput'}) MERGE (a)-[:SUBCLASS_OF]->(b);
MERGE (a:Class {name: 'Recommendation'}) MERGE (b:Class {name: 'PlatformOutput'}) MERGE (a)-[:SUBCLASS_OF]->(b);
MERGE (a:Class {name: 'ModelArtifact'}) MERGE (b:Class {name: 'PlatformOutput'}) MERGE (a)-[:SUBCLASS_OF]->(b);
MERGE (a:Class {name: 'FeatureImportance'}) MERGE (b:Class {name: 'PlatformOutput'}) MERGE (a)-[:SUBCLASS_OF]->(b);
MERGE (a:Class {name: 'EdgeReading'}) MERGE (b:Class {name: 'OutcomeRecord'}) MERGE (a)-[:SUBCLASS_OF]->(b);
MERGE (a:Class {name: 'SignalOutcome'}) MERGE (b:Class {name: 'OutcomeRecord'}) MERGE (a)-[:SUBCLASS_OF]->(b);
