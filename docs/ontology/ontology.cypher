// ---- properties (the semantic axes a schema cannot express) ----
MERGE (n:Property {name: 'symbol'}) SET n.label = 'Symbol', n.semantic_type = 'identifier', n.datatype = 'string', n.timing = 'context', n.derivation = 'raw', n.leakage_risk = 'none', n.usable_as_feature = false, n.is_label = false, n.description = 'Exchange ticker, NSE/BSE convention embedded in the string. The platform''s universal join key across ~40 tables.', n.uri = 'https://bharat-stock-intelligence.dev/ontology/property#symbol' RETURN n.name AS name;
MERGE (n:Property {name: 'isin'}) SET n.label = 'ISIN', n.semantic_type = 'identifier', n.datatype = 'string', n.timing = 'context', n.derivation = 'raw', n.leakage_risk = 'none', n.usable_as_feature = false, n.is_label = false, n.description = 'ISO 6166 identifier. The only globally-unique key here; coverage is partial, which makes an ISIN-first instrument master a project, not a rename.', n.uri = 'https://bharat-stock-intelligence.dev/ontology/property#isin' RETURN n.name AS name;
MERGE (n:Property {name: 'scid'}) SET n.label = 'MoneyControl scid', n.semantic_type = 'identifier', n.datatype = 'string', n.timing = 'context', n.derivation = 'raw', n.leakage_risk = 'none', n.usable_as_feature = false, n.is_label = false, n.description = 'Vendor-private MoneyControl id. Reachable from `symbol` only through `mc_scid_map`, and comparable to no other vendor''s id.', n.uri = 'https://bharat-stock-intelligence.dev/ontology/property#scid' RETURN n.name AS name;
MERGE (n:Property {name: 'company_name'}) SET n.label = 'Company name', n.semantic_type = 'identifier', n.datatype = 'string', n.timing = 'context', n.derivation = 'raw', n.leakage_risk = 'none', n.usable_as_feature = false, n.is_label = false, n.description = 'Issuer name as supplied by the writer. Free text: one company can appear under two names across tables.', n.uri = 'https://bharat-stock-intelligence.dev/ontology/property#company_name' RETURN n.name AS name;
MERGE (n:Property {name: 'id'}) SET n.label = 'Row id', n.semantic_type = 'identifier', n.datatype = 'string', n.timing = 'context', n.derivation = 'raw', n.leakage_risk = 'none', n.usable_as_feature = false, n.is_label = false, n.description = 'Surrogate key that is NOT stable across a re-fetch or backfill. Never join on this across runs — use the table''s natural key.', n.uri = 'https://bharat-stock-intelligence.dev/ontology/property#id' RETURN n.name AS name;
MERGE (n:Property {name: 'check_id'}) SET n.label = 'Check id', n.semantic_type = 'identifier', n.datatype = 'string', n.timing = 'context', n.derivation = 'raw', n.leakage_risk = 'none', n.usable_as_feature = false, n.is_label = false, n.description = 'Stable identifier of a data-quality check definition.', n.uri = 'https://bharat-stock-intelligence.dev/ontology/property#check_id' RETURN n.name AS name;
MERGE (n:Property {name: 'issuer_key'}) SET n.label = 'Issuer key', n.semantic_type = 'identifier', n.datatype = 'string', n.timing = 'context', n.derivation = 'raw', n.leakage_risk = 'none', n.usable_as_feature = false, n.is_label = false, n.description = 'Stable internal issuer key. ISIN issuer-prefix keys are authoritative; provisional symbol keys are explicitly low-confidence.', n.uri = 'https://bharat-stock-intelligence.dev/ontology/property#issuer_key' RETURN n.name AS name;
MERGE (n:Property {name: 'instrument_key'}) SET n.label = 'Instrument key', n.semantic_type = 'identifier', n.datatype = 'string', n.timing = 'context', n.derivation = 'raw', n.leakage_risk = 'none', n.usable_as_feature = false, n.is_label = false, n.description = 'Stable internal instrument key, normally derived from the full ISIN rather than a ticker.', n.uri = 'https://bharat-stock-intelligence.dev/ontology/property#instrument_key' RETURN n.name AS name;
MERGE (n:Property {name: 'listing_key'}) SET n.label = 'Listing key', n.semantic_type = 'identifier', n.datatype = 'string', n.timing = 'context', n.derivation = 'raw', n.leakage_risk = 'none', n.usable_as_feature = false, n.is_label = false, n.description = 'Exchange/segment/symbol identity for one tradable listing.', n.uri = 'https://bharat-stock-intelligence.dev/ontology/property#listing_key' RETURN n.name AS name;
MERGE (n:Property {name: 'provider'}) SET n.label = 'Provider', n.semantic_type = 'identifier', n.datatype = 'string', n.timing = 'context', n.derivation = 'raw', n.leakage_risk = 'none', n.usable_as_feature = false, n.is_label = false, n.description = 'Namespace that owns a private identifier. Provider is always part of an identifier key.', n.uri = 'https://bharat-stock-intelligence.dev/ontology/property#provider' RETURN n.name AS name;
MERGE (n:Property {name: 'scheme'}) SET n.label = 'Identifier scheme', n.semantic_type = 'identifier', n.datatype = 'string', n.timing = 'context', n.derivation = 'raw', n.leakage_risk = 'none', n.usable_as_feature = false, n.is_label = false, n.description = 'Meaning of a provider identifier, such as ticker, scrip_code or company_id.', n.uri = 'https://bharat-stock-intelligence.dev/ontology/property#scheme' RETURN n.name AS name;
MERGE (n:Property {name: 'identifier_value'}) SET n.label = 'Identifier value', n.semantic_type = 'identifier', n.datatype = 'string', n.timing = 'context', n.derivation = 'raw', n.leakage_risk = 'none', n.usable_as_feature = false, n.is_label = false, n.description = 'Provider-issued identifier value; comparable only within the same provider and scheme.', n.uri = 'https://bharat-stock-intelligence.dev/ontology/property#identifier_value' RETURN n.name AS name;
MERGE (n:Property {name: 'identity_basis'}) SET n.label = 'Identity basis', n.semantic_type = 'identifier', n.datatype = 'string', n.timing = 'context', n.derivation = 'raw', n.leakage_risk = 'none', n.usable_as_feature = false, n.is_label = false, n.description = 'Evidence used to construct an issuer or instrument identity.', n.uri = 'https://bharat-stock-intelligence.dev/ontology/property#identity_basis' RETURN n.name AS name;
MERGE (n:Property {name: 'mapping_status'}) SET n.label = 'Mapping status', n.semantic_type = 'identifier', n.datatype = 'string', n.timing = 'context', n.derivation = 'raw', n.leakage_risk = 'none', n.usable_as_feature = false, n.is_label = false, n.description = 'Whether an identifier mapping is verified, ambiguous, unresolved or rejected.', n.uri = 'https://bharat-stock-intelligence.dev/ontology/property#mapping_status' RETURN n.name AS name;
MERGE (n:Property {name: 'sector'}) SET n.label = 'Sector', n.semantic_type = 'dimension', n.datatype = 'string', n.timing = 'context', n.derivation = 'raw', n.leakage_risk = 'none', n.usable_as_feature = true, n.is_label = false, n.description = 'Industry grouping label as supplied by the writing fetcher. No canonical table backs it, so a cross-table sector join can silently lose names.', n.uri = 'https://bharat-stock-intelligence.dev/ontology/property#sector' RETURN n.name AS name;
MERGE (n:Property {name: 'industry'}) SET n.label = 'Industry', n.semantic_type = 'dimension', n.datatype = 'string', n.timing = 'context', n.derivation = 'raw', n.leakage_risk = 'none', n.usable_as_feature = true, n.is_label = false, n.description = 'Finer-grained grouping than sector, same provenance caveat. Carried as its own column only in `stock_master` and `nse_stocks`.', n.uri = 'https://bharat-stock-intelligence.dev/ontology/property#industry' RETURN n.name AS name;
MERGE (n:Property {name: 'exchange'}) SET n.label = 'Exchange', n.semantic_type = 'dimension', n.datatype = 'string', n.timing = 'context', n.derivation = 'raw', n.leakage_risk = 'none', n.usable_as_feature = true, n.is_label = false, n.description = 'Venue: NSE or BSE. Usually encoded inside `symbol`, but carried as its own column in seven tables — `nse_stocks.exchange` is the canonical one. That column-count is the reason `Exchange` is modelled as a reference class rather than a table.', n.uri = 'https://bharat-stock-intelligence.dev/ontology/property#exchange' RETURN n.name AS name;
MERGE (n:Property {name: 'series'}) SET n.label = 'Series', n.semantic_type = 'dimension', n.datatype = 'string', n.timing = 'context', n.derivation = 'raw', n.leakage_risk = 'none', n.usable_as_feature = true, n.is_label = false, n.description = 'NSE trading series (EQ, BE, BZ, ...). Distinguishes liquidity tiers; mixing them silently changes a universe.', n.uri = 'https://bharat-stock-intelligence.dev/ontology/property#series' RETURN n.name AS name;
MERGE (n:Property {name: 'index_name'}) SET n.label = 'Index name', n.semantic_type = 'dimension', n.datatype = 'string', n.timing = 'context', n.derivation = 'raw', n.leakage_risk = 'none', n.usable_as_feature = true, n.is_label = false, n.description = 'Index identifier used by the derivatives, PCR and max-pain tables.', n.uri = 'https://bharat-stock-intelligence.dev/ontology/property#index_name' RETURN n.name AS name;
MERGE (n:Property {name: 'source'}) SET n.label = 'Source', n.semantic_type = 'dimension', n.datatype = 'string', n.timing = 'context', n.derivation = 'raw', n.leakage_risk = 'none', n.usable_as_feature = true, n.is_label = false, n.description = 'Which provider or fetcher wrote the row. Provenance is per-row on this platform, so this is the first column to check before trusting a value.', n.uri = 'https://bharat-stock-intelligence.dev/ontology/property#source' RETURN n.name AS name;
MERGE (n:Property {name: 'session'}) SET n.label = 'Session', n.semantic_type = 'dimension', n.datatype = 'string', n.timing = 'context', n.derivation = 'raw', n.leakage_risk = 'none', n.usable_as_feature = true, n.is_label = false, n.description = 'Trading-session segment a row belongs to (block deals carry this).', n.uri = 'https://bharat-stock-intelligence.dev/ontology/property#session' RETURN n.name AS name;
MERGE (n:Property {name: 'date'}) SET n.label = 'Date', n.semantic_type = 'timestamp', n.datatype = 'date', n.unit = 'calendar_day', n.timing = 'context', n.derivation = 'raw', n.leakage_risk = 'none', n.usable_as_feature = false, n.is_label = false, n.description = 'Trading-session date. Day cuts are Asia/Kolkata: a date column is a session, not a midnight-to-midnight instant.', n.uri = 'https://bharat-stock-intelligence.dev/ontology/property#date' RETURN n.name AS name;
MERGE (n:Property {name: 'signal_date'}) SET n.label = 'Signal date', n.semantic_type = 'timestamp', n.datatype = 'date', n.unit = 'calendar_day', n.timing = 'context', n.derivation = 'raw', n.leakage_risk = 'none', n.usable_as_feature = false, n.is_label = false, n.description = 'Session a signal was generated for. Entry happens at the NEXT session''s open — the most common off-by-one in this repo.', n.point_in_time_note = 'Entry is taken at the NEXT session''s open. A feature dated on `signal_date` must have been knowable before that open.', n.uri = 'https://bharat-stock-intelligence.dev/ontology/property#signal_date' RETURN n.name AS name;
MERGE (n:Property {name: 'check_date'}) SET n.label = 'Check date', n.semantic_type = 'timestamp', n.datatype = 'date', n.unit = 'calendar_day', n.timing = 'context', n.derivation = 'raw', n.leakage_risk = 'high', n.usable_as_feature = false, n.is_label = false, n.description = 'Session an outcome was resolved on; with `signal_date` it bounds the window.', n.point_in_time_note = 'Reveals that the horizon elapsed, which is itself information.', n.uri = 'https://bharat-stock-intelligence.dev/ontology/property#check_date' RETURN n.name AS name;
MERGE (n:Property {name: 'as_of_date'}) SET n.label = 'As-of date', n.semantic_type = 'timestamp', n.datatype = 'date', n.unit = 'calendar_day', n.timing = 'context', n.derivation = 'raw', n.leakage_risk = 'none', n.usable_as_feature = false, n.is_label = false, n.description = 'Point-in-time stamp on vendor snapshots: the value is knowable only from this date, whatever period it describes.', n.point_in_time_note = 'The snapshot date, not the period it describes. Vendor fundamentals describe a quarter that ended weeks earlier.', n.uri = 'https://bharat-stock-intelligence.dev/ontology/property#as_of_date' RETURN n.name AS name;
MERGE (n:Property {name: 'ex_date'}) SET n.label = 'Ex-date', n.semantic_type = 'timestamp', n.datatype = 'date', n.unit = 'calendar_day', n.timing = 'context', n.derivation = 'raw', n.leakage_risk = 'none', n.usable_as_feature = false, n.is_label = false, n.description = 'First session on which a symbol trades without the benefit of a corporate action. The anchor for every price adjustment.', n.point_in_time_note = 'Prices before the ex-date are on the pre-action basis; the adjustment factor must be applied before comparing across it.', n.uri = 'https://bharat-stock-intelligence.dev/ontology/property#ex_date' RETURN n.name AS name;
MERGE (n:Property {name: 'expiry'}) SET n.label = 'Expiry', n.semantic_type = 'timestamp', n.datatype = 'date', n.unit = 'calendar_day', n.timing = 'context', n.derivation = 'raw', n.leakage_risk = 'none', n.usable_as_feature = false, n.is_label = false, n.description = 'Derivative contract expiry. Several expiries coexist per symbol per date.', n.uri = 'https://bharat-stock-intelligence.dev/ontology/property#expiry' RETURN n.name AS name;
MERGE (n:Property {name: 'week_date'}) SET n.label = 'Week date', n.semantic_type = 'timestamp', n.datatype = 'date', n.unit = 'calendar_day', n.timing = 'context', n.derivation = 'raw', n.leakage_risk = 'none', n.usable_as_feature = false, n.is_label = false, n.description = 'Weekly anchor used by the sector-rotation panel.', n.uri = 'https://bharat-stock-intelligence.dev/ontology/property#week_date' RETURN n.name AS name;
MERGE (n:Property {name: 'datetime'}) SET n.label = 'Timestamp', n.semantic_type = 'timestamp', n.datatype = 'timestamp', n.timing = 'context', n.derivation = 'raw', n.leakage_risk = 'none', n.usable_as_feature = false, n.is_label = false, n.description = 'Intraday bar timestamp, Asia/Kolkata.', n.uri = 'https://bharat-stock-intelligence.dev/ontology/property#datetime' RETURN n.name AS name;
MERGE (n:Property {name: 'computed_at'}) SET n.label = 'Computed at', n.semantic_type = 'timestamp', n.datatype = 'timestamp', n.timing = 'context', n.derivation = 'raw', n.leakage_risk = 'none', n.usable_as_feature = false, n.is_label = false, n.description = 'When the platform produced the row. NOT uniform across tables: TEXT in `unified_recommendations`, native TIMESTAMPTZ in `confluence_signals`. Cast before comparing the two.', n.point_in_time_note = 'TEXT in `unified_recommendations`, native TIMESTAMPTZ in `confluence_signals`. Cast explicitly before comparing across the two.', n.uri = 'https://bharat-stock-intelligence.dev/ontology/property#computed_at' RETURN n.name AS name;
MERGE (n:Property {name: 'fetched_at'}) SET n.label = 'Fetched at', n.semantic_type = 'timestamp', n.datatype = 'timestamp', n.timing = 'context', n.derivation = 'raw', n.leakage_risk = 'none', n.usable_as_feature = false, n.is_label = false, n.description = 'When the provider response was received — distinct from the date the observation refers to.', n.uri = 'https://bharat-stock-intelligence.dev/ontology/property#fetched_at' RETURN n.name AS name;
MERGE (n:Property {name: 'captured_at'}) SET n.label = 'Captured at', n.semantic_type = 'timestamp', n.datatype = 'timestamp', n.timing = 'context', n.derivation = 'raw', n.leakage_risk = 'none', n.usable_as_feature = false, n.is_label = false, n.description = 'Snapshot capture time for vendor grids that are otherwise undated.', n.uri = 'https://bharat-stock-intelligence.dev/ontology/property#captured_at' RETURN n.name AS name;
MERGE (n:Property {name: 'published_at'}) SET n.label = 'Published at', n.semantic_type = 'timestamp', n.datatype = 'timestamp', n.timing = 'leading', n.derivation = 'raw', n.leakage_risk = 'none', n.usable_as_feature = false, n.is_label = false, n.description = 'Publication time of a news item or announcement. Such an item is knowable only from this instant, never from the event it describes.', n.point_in_time_note = 'An item is knowable only from this instant — never from the event it reports.', n.uri = 'https://bharat-stock-intelligence.dev/ontology/property#published_at' RETURN n.name AS name;
MERGE (n:Property {name: 'last_updated'}) SET n.label = 'Last updated', n.semantic_type = 'timestamp', n.datatype = 'timestamp', n.timing = 'context', n.derivation = 'raw', n.leakage_risk = 'none', n.usable_as_feature = false, n.is_label = false, n.description = 'Writer-supplied modification stamp. Trust it only when the writer is known to set it on every write.', n.uri = 'https://bharat-stock-intelligence.dev/ontology/property#last_updated' RETURN n.name AS name;
MERGE (n:Property {name: 'open'}) SET n.label = 'Open', n.semantic_type = 'measure', n.datatype = 'decimal', n.unit = 'per_share_INR', n.timing = 'coincident', n.derivation = 'raw', n.leakage_risk = 'none', n.usable_as_feature = true, n.is_label = false, n.description = 'Session open, in the row''s recorded price basis.', n.uri = 'https://bharat-stock-intelligence.dev/ontology/property#open' RETURN n.name AS name;
MERGE (n:Property {name: 'high'}) SET n.label = 'High', n.semantic_type = 'measure', n.datatype = 'decimal', n.unit = 'per_share_INR', n.timing = 'coincident', n.derivation = 'raw', n.leakage_risk = 'none', n.usable_as_feature = true, n.is_label = false, n.description = 'Session high.', n.uri = 'https://bharat-stock-intelligence.dev/ontology/property#high' RETURN n.name AS name;
MERGE (n:Property {name: 'low'}) SET n.label = 'Low', n.semantic_type = 'measure', n.datatype = 'decimal', n.unit = 'per_share_INR', n.timing = 'coincident', n.derivation = 'raw', n.leakage_risk = 'none', n.usable_as_feature = true, n.is_label = false, n.description = 'Session low.', n.uri = 'https://bharat-stock-intelligence.dev/ontology/property#low' RETURN n.name AS name;
MERGE (n:Property {name: 'close'}) SET n.label = 'Close', n.semantic_type = 'measure', n.datatype = 'decimal', n.unit = 'per_share_INR', n.timing = 'coincident', n.derivation = 'raw', n.leakage_risk = 'none', n.usable_as_feature = true, n.is_label = false, n.description = 'Session close. The reference price for almost every downstream calculation.', n.uri = 'https://bharat-stock-intelligence.dev/ontology/property#close' RETURN n.name AS name;
MERGE (n:Property {name: 'vwap'}) SET n.label = 'VWAP', n.semantic_type = 'measure', n.datatype = 'decimal', n.unit = 'per_share_INR', n.timing = 'coincident', n.derivation = 'raw', n.leakage_risk = 'none', n.usable_as_feature = true, n.is_label = false, n.description = 'Volume-weighted average price; present on intraday bars only.', n.uri = 'https://bharat-stock-intelligence.dev/ontology/property#vwap' RETURN n.name AS name;
MERGE (n:Property {name: 'volume'}) SET n.label = 'Volume', n.semantic_type = 'measure', n.datatype = 'decimal', n.timing = 'coincident', n.derivation = 'raw', n.leakage_risk = 'none', n.usable_as_feature = true, n.is_label = false, n.description = 'Shares traded in the session.', n.uri = 'https://bharat-stock-intelligence.dev/ontology/property#volume' RETURN n.name AS name;
MERGE (n:Property {name: 'cmp'}) SET n.label = 'Current market price', n.semantic_type = 'measure', n.datatype = 'decimal', n.unit = 'per_share_INR', n.timing = 'coincident', n.derivation = 'raw', n.leakage_risk = 'none', n.usable_as_feature = true, n.is_label = false, n.synonyms = ['ltp', 'last price'], n.description = 'Last traded price at the moment the row was written — a point-in-time snapshot, not a session close. Do not substitute it for `close`.', n.uri = 'https://bharat-stock-intelligence.dev/ontology/property#cmp' RETURN n.name AS name;
MERGE (n:Property {name: 'entry_price'}) SET n.label = 'Entry price', n.semantic_type = 'measure', n.datatype = 'decimal', n.unit = 'per_share_INR', n.timing = 'coincident', n.derivation = 'raw', n.leakage_risk = 'low', n.usable_as_feature = true, n.is_label = false, n.description = 'Assumed or realised entry fill used by an outcome calculation.', n.uri = 'https://bharat-stock-intelligence.dev/ontology/property#entry_price' RETURN n.name AS name;
MERGE (n:Property {name: 'exit_price'}) SET n.label = 'Exit price', n.semantic_type = 'measure', n.datatype = 'decimal', n.unit = 'per_share_INR', n.timing = 'coincident', n.derivation = 'raw', n.leakage_risk = 'high', n.usable_as_feature = false, n.is_label = false, n.synonyms = ['exit'], n.description = 'Realised exit fill; only exists on resolved outcomes.', n.point_in_time_note = 'Outcome-side column: it exists only because the horizon has elapsed.', n.uri = 'https://bharat-stock-intelligence.dev/ontology/property#exit_price' RETURN n.name AS name;
MERGE (n:Property {name: 'open_interest'}) SET n.label = 'Open interest', n.semantic_type = 'measure', n.datatype = 'decimal', n.unit = 'contracts', n.timing = 'coincident', n.derivation = 'raw', n.leakage_risk = 'none', n.usable_as_feature = true, n.is_label = false, n.description = 'Outstanding contracts on a derivative.', n.uri = 'https://bharat-stock-intelligence.dev/ontology/property#open_interest' RETURN n.name AS name;
MERGE (n:Property {name: 'strike'}) SET n.label = 'Strike', n.semantic_type = 'measure', n.datatype = 'decimal', n.unit = 'per_share_INR', n.timing = 'coincident', n.derivation = 'raw', n.leakage_risk = 'none', n.usable_as_feature = true, n.is_label = false, n.description = 'Option contract strike price.', n.uri = 'https://bharat-stock-intelligence.dev/ontology/property#strike' RETURN n.name AS name;
MERGE (n:Property {name: 'max_pain'}) SET n.label = 'Max pain', n.semantic_type = 'measure', n.datatype = 'decimal', n.unit = 'index_points', n.timing = 'coincident', n.derivation = 'raw', n.leakage_risk = 'none', n.usable_as_feature = true, n.is_label = false, n.description = 'Strike at which the largest number of option contracts expire worthless.', n.uri = 'https://bharat-stock-intelligence.dev/ontology/property#max_pain' RETURN n.name AS name;
MERGE (n:Property {name: 'market_cap'}) SET n.label = 'Market capitalisation', n.semantic_type = 'measure', n.datatype = 'decimal', n.unit = 'INR_or_crore_UNDECLARED', n.timing = 'lagging', n.derivation = 'raw', n.leakage_risk = 'none', n.usable_as_feature = true, n.is_label = false, n.synonyms = ['mcap', 'market capitalization'], n.description = 'Vendor-computed market cap. The stored unit is NOT declared anywhere in the schema — confirm it before aggregating across tables.', n.point_in_time_note = 'The stored unit is declared nowhere in the schema. Do not aggregate this column across tables without establishing the scale first.', n.uri = 'https://bharat-stock-intelligence.dev/ontology/property#market_cap' RETURN n.name AS name;
MERGE (n:Property {name: 'quantity'}) SET n.label = 'Quantity', n.semantic_type = 'measure', n.datatype = 'decimal', n.timing = 'coincident', n.derivation = 'raw', n.leakage_risk = 'none', n.usable_as_feature = true, n.is_label = false, n.description = 'Shares transacted in an insider or bulk transaction.', n.uri = 'https://bharat-stock-intelligence.dev/ontology/property#quantity' RETURN n.name AS name;
MERGE (n:Property {name: 'delivery_qty'}) SET n.label = 'Delivered quantity', n.semantic_type = 'measure', n.datatype = 'decimal', n.unit = 'shares', n.timing = 'lagging', n.derivation = 'raw', n.leakage_risk = 'none', n.usable_as_feature = true, n.is_label = false, n.description = 'Shares actually delivered.', n.point_in_time_note = 'Same T+1 publication lag as `delivery_pct`.', n.uri = 'https://bharat-stock-intelligence.dev/ontology/property#delivery_qty' RETURN n.name AS name;
MERGE (n:Property {name: 'traded_qty'}) SET n.label = 'Traded quantity', n.semantic_type = 'measure', n.datatype = 'decimal', n.unit = 'shares', n.timing = 'coincident', n.derivation = 'raw', n.leakage_risk = 'none', n.usable_as_feature = true, n.is_label = false, n.description = 'Total shares traded.', n.uri = 'https://bharat-stock-intelligence.dev/ontology/property#traded_qty' RETURN n.name AS name;
MERGE (n:Property {name: 'deliverable_qty'}) SET n.label = 'Deliverable quantity', n.semantic_type = 'measure', n.datatype = 'decimal', n.unit = 'shares', n.timing = 'coincident', n.derivation = 'raw', n.leakage_risk = 'none', n.usable_as_feature = true, n.is_label = false, n.description = 'Shares eligible for delivery.', n.uri = 'https://bharat-stock-intelligence.dev/ontology/property#deliverable_qty' RETURN n.name AS name;
MERGE (n:Property {name: 'contracts'}) SET n.label = 'Contracts', n.semantic_type = 'measure', n.datatype = 'decimal', n.unit = 'shares', n.timing = 'coincident', n.derivation = 'raw', n.leakage_risk = 'none', n.usable_as_feature = true, n.is_label = false, n.description = 'Number of derivative contracts.', n.uri = 'https://bharat-stock-intelligence.dev/ontology/property#contracts' RETURN n.name AS name;
MERGE (n:Property {name: 'total_oi'}) SET n.label = 'Total open interest', n.semantic_type = 'measure', n.datatype = 'decimal', n.unit = 'shares', n.timing = 'coincident', n.derivation = 'raw', n.leakage_risk = 'none', n.usable_as_feature = true, n.is_label = false, n.description = 'Open interest summed across the expiries a rollover row spans.', n.uri = 'https://bharat-stock-intelligence.dev/ontology/property#total_oi' RETURN n.name AS name;
MERGE (n:Property {name: 'lot_size'}) SET n.label = 'Lot size', n.semantic_type = 'measure', n.datatype = 'decimal', n.unit = 'shares', n.timing = 'coincident', n.derivation = 'raw', n.leakage_risk = 'none', n.usable_as_feature = true, n.is_label = false, n.description = 'Contract multiplier — required to convert a price move into a rupee P&L.', n.uri = 'https://bharat-stock-intelligence.dev/ontology/property#lot_size' RETURN n.name AS name;
MERGE (n:Property {name: 'delivery_pct'}) SET n.label = 'Delivery percentage', n.semantic_type = 'ratio', n.datatype = 'decimal', n.unit = 'percent', n.timing = 'lagging', n.derivation = 'raw', n.leakage_risk = 'none', n.usable_as_feature = true, n.is_label = false, n.synonyms = ['delivery_percentage', 'deliv_pct'], n.description = 'Delivered shares as a share of traded shares. T+1 by construction, underexploited here, and the platform''s best high-frequency ownership proxy.', n.point_in_time_note = 'NSE publishes delivery data after the session closes, so it is T+1 at best. A signal dated the same session cannot have used it.', n.uri = 'https://bharat-stock-intelligence.dev/ontology/property#delivery_pct' RETURN n.name AS name;
MERGE (n:Property {name: 'change_pct'}) SET n.label = 'Change percent', n.semantic_type = 'ratio', n.datatype = 'decimal', n.unit = 'percent', n.timing = 'coincident', n.derivation = 'raw', n.leakage_risk = 'none', n.usable_as_feature = true, n.is_label = false, n.description = 'Session or snapshot price change.', n.uri = 'https://bharat-stock-intelligence.dev/ontology/property#change_pct' RETURN n.name AS name;
MERGE (n:Property {name: 'oi_pct_change'}) SET n.label = 'OI change percent', n.semantic_type = 'ratio', n.datatype = 'decimal', n.unit = 'percent', n.timing = 'coincident', n.derivation = 'raw', n.leakage_risk = 'none', n.usable_as_feature = true, n.is_label = false, n.description = 'Session-over-session open-interest change.', n.uri = 'https://bharat-stock-intelligence.dev/ontology/property#oi_pct_change' RETURN n.name AS name;
MERGE (n:Property {name: 'rollover_pct'}) SET n.label = 'Rollover percent', n.semantic_type = 'ratio', n.datatype = 'decimal', n.unit = 'percent', n.timing = 'coincident', n.derivation = 'raw', n.leakage_risk = 'none', n.usable_as_feature = true, n.is_label = false, n.description = 'Share of open interest rolled from the near to the next expiry.', n.uri = 'https://bharat-stock-intelligence.dev/ontology/property#rollover_pct' RETURN n.name AS name;
MERGE (n:Property {name: 'pct_transacted'}) SET n.label = 'Percent transacted', n.semantic_type = 'ratio', n.datatype = 'decimal', n.unit = 'percent', n.timing = 'coincident', n.derivation = 'raw', n.leakage_risk = 'none', n.usable_as_feature = true, n.is_label = false, n.description = 'Transacted shares as a share of the float or of outstanding capital, depending on the writer.', n.uri = 'https://bharat-stock-intelligence.dev/ontology/property#pct_transacted' RETURN n.name AS name;
MERGE (n:Property {name: 'pledge_pct'}) SET n.label = 'Pledged percent', n.semantic_type = 'ratio', n.datatype = 'decimal', n.unit = 'percent', n.timing = 'lagging', n.derivation = 'raw', n.leakage_risk = 'none', n.usable_as_feature = true, n.is_label = false, n.description = 'Promoter shares pledged as collateral.', n.uri = 'https://bharat-stock-intelligence.dev/ontology/property#pledge_pct' RETURN n.name AS name;
MERGE (n:Property {name: 'mf_holding_pct'}) SET n.label = 'Mutual-fund holding percent', n.semantic_type = 'ratio', n.datatype = 'decimal', n.unit = 'percent', n.timing = 'coincident', n.derivation = 'raw', n.leakage_risk = 'none', n.usable_as_feature = true, n.is_label = false, n.description = 'Aggregate mutual-fund ownership of the symbol.', n.uri = 'https://bharat-stock-intelligence.dev/ontology/property#mf_holding_pct' RETURN n.name AS name;
MERGE (n:Property {name: 'revenue_growth'}) SET n.label = 'Revenue growth', n.semantic_type = 'ratio', n.datatype = 'decimal', n.unit = 'percent', n.timing = 'coincident', n.derivation = 'raw', n.leakage_risk = 'none', n.usable_as_feature = true, n.is_label = false, n.description = 'Vendor-computed revenue growth.', n.uri = 'https://bharat-stock-intelligence.dev/ontology/property#revenue_growth' RETURN n.name AS name;
MERGE (n:Property {name: 'earnings_growth'}) SET n.label = 'Earnings growth', n.semantic_type = 'ratio', n.datatype = 'decimal', n.unit = 'percent', n.timing = 'coincident', n.derivation = 'raw', n.leakage_risk = 'none', n.usable_as_feature = true, n.is_label = false, n.description = 'Vendor-computed earnings growth.', n.uri = 'https://bharat-stock-intelligence.dev/ontology/property#earnings_growth' RETURN n.name AS name;
MERGE (n:Property {name: 'operating_margins'}) SET n.label = 'Operating margin', n.semantic_type = 'ratio', n.datatype = 'decimal', n.unit = 'percent', n.timing = 'coincident', n.derivation = 'raw', n.leakage_risk = 'none', n.usable_as_feature = true, n.is_label = false, n.description = 'Vendor-computed operating margin.', n.uri = 'https://bharat-stock-intelligence.dev/ontology/property#operating_margins' RETURN n.name AS name;
MERGE (n:Property {name: 'return_on_equity'}) SET n.label = 'Return on equity', n.semantic_type = 'ratio', n.datatype = 'decimal', n.unit = 'percent', n.timing = 'coincident', n.derivation = 'raw', n.leakage_risk = 'none', n.usable_as_feature = true, n.is_label = false, n.description = 'Vendor-computed ROE.', n.uri = 'https://bharat-stock-intelligence.dev/ontology/property#return_on_equity' RETURN n.name AS name;
