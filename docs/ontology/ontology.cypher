// ---- metrics (with runnable SQL) ----
MERGE (n:Metric {name: 'delivery_surprise_z'}) SET n.label = 'Delivery surprise z-score', n.description = 'Today''s NSE delivery percentage as a z-score against the symbol''s own trailing 20-session history: unusual ownership behaviour on a session, the T+1-lag edge the master report names.', n.entity = 'Equity', n.sql = 'WITH hist AS (
    SELECT date AS d, delivery_pct AS dp
    FROM stock_delivery_data
    WHERE symbol = :symbol AND delivery_pct IS NOT NULL
), stats AS (
    SELECT d, dp,
           avg(dp) OVER (ORDER BY d ROWS BETWEEN 20 PRECEDING AND 1 PRECEDING) AS mu,
           stddev_samp(dp) OVER (ORDER BY d ROWS BETWEEN 20 PRECEDING AND 1 PRECEDING) AS sd
    FROM hist
)
SELECT d AS as_of, dp AS delivery_pct,
       CASE WHEN sd > 0 THEN (dp - mu) / sd ELSE 0.0 END AS delivery_surprise_z
FROM stats
WHERE d <= :as_of
ORDER BY d DESC
LIMIT 1', n.params = ['symbol', 'as_of'], n.unit = 'z', n.grain = 'one row per symbol per as-of session', n.cadence = 'daily', n.timing = 'leading', n.derivation = 'derived', n.leakage_risk = 'none', n.graded_status = 'research-candidate', n.cheap_to_run = true, n.caveats = ['Delivery data lands T+1: the z-score for session D is knowable only during session D+1, so any same-session use is a look-ahead.', 'Self-referenced (vs the symbol''s own history), not cross-sectional.'], n.synonyms = ['delivery surprise z', 'delivery surprise'], n.uri = 'https://bharat-stock-intelligence.dev/ontology/metric#delivery_surprise_z' RETURN n.name AS name;
MERGE (m:Metric {name: 'delivery_surprise_z'}) MERGE (c:Class {name: 'Equity'}) MERGE (m)-[:OF_ENTITY]->(c);
MERGE (m:Metric {name: 'delivery_surprise_z'}) MERGE (t:Table {name: 'stock_delivery_data'}) MERGE (m)-[:DERIVED_FROM]->(t);
MERGE (n:Metric {name: 'close_price'}) SET n.label = 'Closing price (basis-tagged)', n.description = 'The most recent clean closing price on or before an as-of date, excluding quarantined bars.', n.entity = 'Bar', n.sql = 'SELECT o.close AS close_price, o.date AS as_of, o.adjustment_basis
FROM stock_ohlcv o
WHERE o.symbol = :symbol AND o.date <= :as_of AND o.is_suspect = 0
ORDER BY o.date DESC
LIMIT 1', n.params = ['symbol', 'as_of'], n.unit = 'per_share_INR', n.grain = '(symbol, date)', n.cadence = 'per_session', n.timing = 'coincident', n.derivation = 'raw', n.leakage_risk = 'none', n.graded_status = 'live', n.cheap_to_run = true, n.caveats = ['The price is in whatever basis `adjustment_basis` names: mixing bases across a series is a silent backtest corruption.', '`is_suspect = 0` is applied — a quarantined bar is excluded, not corrected.'], n.synonyms = ['close', 'closing price', 'last close', 'price'], n.uri = 'https://bharat-stock-intelligence.dev/ontology/metric#close_price' RETURN n.name AS name;
MERGE (m:Metric {name: 'close_price'}) MERGE (c:Class {name: 'Bar'}) MERGE (m)-[:OF_ENTITY]->(c);
MERGE (m:Metric {name: 'close_price'}) MERGE (t:Table {name: 'stock_ohlcv'}) MERGE (m)-[:DERIVED_FROM]->(t);
MERGE (n:Metric {name: 'delivery_pct_latest'}) SET n.label = 'Latest delivery percentage', n.description = 'Delivered shares as a share of traded shares on the most recent session at or before the as-of date.', n.entity = 'DeliveryObservation', n.sql = 'SELECT d.delivery_pct AS delivery_pct, d.date AS as_of
FROM stock_delivery_data d
WHERE d.symbol = :symbol AND d.date <= :as_of
ORDER BY d.date DESC
LIMIT 1', n.params = ['symbol', 'as_of'], n.unit = 'percent', n.grain = '(symbol, date)', n.cadence = 'daily_t_plus_1', n.timing = 'lagging', n.derivation = 'raw', n.leakage_risk = 'none', n.graded_status = 'research-candidate', n.graded_evidence = 'Delivery-to-swing-returns is an unquantified link (master report §6, Experiment 4) — not yet graded by factor_edge.py.', n.cheap_to_run = true, n.caveats = ['T+1 by construction: this value was NOT knowable on the session it describes, so it cannot explain that session''s move.', 'A sibling table (`stock_delivery_volume`) reports the same concept per NSE series with different column names.'], n.synonyms = ['delivery', 'delivery percent', 'delivery percentage', 'deliv'], n.uri = 'https://bharat-stock-intelligence.dev/ontology/metric#delivery_pct_latest' RETURN n.name AS name;
MERGE (m:Metric {name: 'delivery_pct_latest'}) MERGE (c:Class {name: 'DeliveryObservation'}) MERGE (m)-[:OF_ENTITY]->(c);
MERGE (m:Metric {name: 'delivery_pct_latest'}) MERGE (t:Table {name: 'stock_delivery_data'}) MERGE (m)-[:DERIVED_FROM]->(t);
MERGE (n:Metric {name: 'delivery_pct_30d_average'}) SET n.label = 'Delivery percentage, 30-session average', n.description = 'Mean delivery percentage over the trailing window ending at the as-of date — the baseline a delivery surprise is measured against.', n.entity = 'DeliveryObservation', n.sql = 'SELECT avg(d.delivery_pct) AS delivery_avg, count(*) AS sessions
FROM stock_delivery_data d
WHERE d.symbol = :symbol AND d.date <= :as_of
  AND d.date > ((:as_of)::date - 30)', n.params = ['symbol', 'as_of'], n.unit = 'percent', n.grain = '(symbol, trailing 30 sessions)', n.cadence = 'daily_t_plus_1', n.timing = 'lagging', n.derivation = 'platform', n.leakage_risk = 'none', n.graded_status = 'research-candidate', n.cheap_to_run = true, n.caveats = ['Session count, not calendar days: the window spans trading sessions.', 'Returns NULL when the symbol has no delivery rows in the window — a coverage gap, not a zero.'], n.synonyms = ['average delivery', 'delivery baseline', 'delivery trend'], n.uri = 'https://bharat-stock-intelligence.dev/ontology/metric#delivery_pct_30d_average' RETURN n.name AS name;
MERGE (m:Metric {name: 'delivery_pct_30d_average'}) MERGE (c:Class {name: 'DeliveryObservation'}) MERGE (m)-[:OF_ENTITY]->(c);
MERGE (m:Metric {name: 'delivery_pct_30d_average'}) MERGE (t:Table {name: 'stock_delivery_data'}) MERGE (m)-[:DERIVED_FROM]->(t);
MERGE (n:Metric {name: 'rsi_14_latest'}) SET n.label = 'RSI (14), latest', n.description = 'Wilder RSI from the technical panel on the most recent date at or before the as-of date.', n.entity = 'TechnicalSignal', n.sql = 'SELECT t.rsi AS rsi_14, t.date AS as_of
FROM technical_signals t
WHERE t.symbol = :symbol AND t.date <= :as_of
ORDER BY t.date DESC
LIMIT 1', n.params = ['symbol', 'as_of'], n.unit = 'index_points', n.grain = '(symbol, date)', n.cadence = 'daily', n.timing = 'coincident', n.derivation = 'platform', n.leakage_risk = 'none', n.graded_status = 'measured', n.graded_evidence = 'rsi_14 measured NEGATIVE rank-IC at 5 days: on this platform it is a mean-reversion input, not a momentum confirmation.', n.cheap_to_run = true, n.caveats = ['Graded as a mean-reversion input — a high RSI is not a buy signal here.', 'RSI re-expresses price, so on its own it adds no information beyond the shape of the recent move.'], n.synonyms = ['rsi', 'relative strength index', 'overbought', 'oversold'], n.uri = 'https://bharat-stock-intelligence.dev/ontology/metric#rsi_14_latest' RETURN n.name AS name;
MERGE (m:Metric {name: 'rsi_14_latest'}) MERGE (c:Class {name: 'TechnicalSignal'}) MERGE (m)-[:OF_ENTITY]->(c);
MERGE (m:Metric {name: 'rsi_14_latest'}) MERGE (t:Table {name: 'technical_signals'}) MERGE (m)-[:DERIVED_FROM]->(t);
MERGE (n:Metric {name: 'signal_win_rate_5d'}) SET n.label = 'Signal win rate, 5-day horizon', n.description = 'Share of resolved 5-day signals that ended in a win under a single labelling rule, with its sample size.', n.entity = 'SignalOutcome', n.sql = 'SELECT avg(CASE WHEN s.outcome = ''WIN'' THEN 1.0 ELSE 0.0 END) AS win_rate,
       count(*) AS n
FROM signal_outcomes s
WHERE s.horizon_days = 5
  AND s.label_definition = ''path_barrier''
  AND s.outcome IN (''WIN'', ''LOSS'')
  AND s.signal_date <= :as_of', n.params = ['as_of'], n.unit = 'probability', n.grain = 'market-wide, 5-day horizon', n.cadence = 'daily', n.timing = 'target', n.derivation = 'platform', n.leakage_risk = 'high', n.graded_status = 'live', n.cheap_to_run = true, n.caveats = ['LABEL-SHAPED. This measures the platform''s own track record and is never a feature.', '`label_definition` is pinned to `path_barrier` deliberately: mixing it with `terminal_pct2` makes the rate meaningless.', '`PENDING` and `NEUTRAL` rows are excluded — the honest denominator, and it must be stated alongside any rate.', 'No `signal_source` filter, so this blends technical and confluence signals.'], n.synonyms = ['win rate', 'hit rate', 'accuracy', 'success rate'], n.uri = 'https://bharat-stock-intelligence.dev/ontology/metric#signal_win_rate_5d' RETURN n.name AS name;
MERGE (m:Metric {name: 'signal_win_rate_5d'}) MERGE (c:Class {name: 'SignalOutcome'}) MERGE (m)-[:OF_ENTITY]->(c);
MERGE (m:Metric {name: 'signal_win_rate_5d'}) MERGE (t:Table {name: 'signal_outcomes'}) MERGE (m)-[:DERIVED_FROM]->(t);
MERGE (n:Metric {name: 'usable_factor_readings_5d'}) SET n.label = 'Usable factor readings at 5 days', n.description = 'How many graded factor readings at a 5-day horizon currently clear the power and independence guards.', n.entity = 'EdgeReading', n.sql = 'SELECT count(*) AS usable_readings, max(f.eff_dates) AS max_eff_dates
FROM factor_edge_history f
WHERE f.horizon_days = 5 AND f.verdict = ''USABLE'' AND f.run_at <= :as_of', n.params = ['as_of'], n.unit = 'count', n.grain = 'per grading run, 5-day horizon', n.cadence = 'on_grading', n.timing = 'context', n.derivation = 'platform', n.leakage_risk = 'none', n.graded_status = 'live', n.cheap_to_run = true, n.caveats = ['A reading is only readable alongside its `eff_dates`: overlapping forward windows inflate a correlation by roughly the horizon factor.', '`verdict` is matched exactly — the ledger stores `no edge` with a space and `n/a` alongside `USABLE` and `LOW-DATA`.'], n.synonyms = ['usable factors', 'factor edge', 'graded factors', 'rank ic count'], n.uri = 'https://bharat-stock-intelligence.dev/ontology/metric#usable_factor_readings_5d' RETURN n.name AS name;
MERGE (m:Metric {name: 'usable_factor_readings_5d'}) MERGE (c:Class {name: 'EdgeReading'}) MERGE (m)-[:OF_ENTITY]->(c);
MERGE (m:Metric {name: 'usable_factor_readings_5d'}) MERGE (t:Table {name: 'factor_edge_history'}) MERGE (m)-[:DERIVED_FROM]->(t);
MERGE (n:Metric {name: 'unified_score_latest'}) SET n.label = 'Unified score, latest served', n.description = 'The highest composite score served for a symbol at or before the as-of date, with its conviction bucket and timeframe.', n.entity = 'Recommendation', n.sql = 'SELECT u.unified_score, u.conviction_level, u.classification, u.timeframe
FROM unified_recommendations u
WHERE u.symbol = :symbol AND u.computed_at <= :as_of
ORDER BY u.unified_score DESC
LIMIT 1', n.params = ['symbol', 'as_of'], n.unit = 'score_0_100', n.grain = '(symbol, computed_at, timeframe)', n.cadence = 'daily', n.timing = 'coincident', n.derivation = 'platform', n.leakage_risk = 'none', n.graded_status = 'live', n.cheap_to_run = true, n.caveats = ['`computed_at` is TEXT in this table — comparing it against a DATE elsewhere needs an explicit cast.', 'The ranker''s load-bearing input is the confluence engine, so a high unified score with a low engine-coverage count is weak evidence.', 'Ordering by score across timeframes returns the best of INTRADAY / SWING / POSITIONAL / LONG_TERM rather than a comparable series — filter `timeframe` first when the horizon matters.'], n.synonyms = ['unified score', 'composite score', 'conviction', 'top pick', 'ranking'], n.uri = 'https://bharat-stock-intelligence.dev/ontology/metric#unified_score_latest' RETURN n.name AS name;
MERGE (m:Metric {name: 'unified_score_latest'}) MERGE (c:Class {name: 'Recommendation'}) MERGE (m)-[:OF_ENTITY]->(c);
MERGE (m:Metric {name: 'unified_score_latest'}) MERGE (t:Table {name: 'unified_recommendations'}) MERGE (m)-[:DERIVED_FROM]->(t);
MERGE (n:Metric {name: 'confluence_score_latest'}) SET n.label = 'Confluence score, latest', n.description = 'The most recent multi-engine agreement score with the number of screeners holding the name and the model probabilities behind it.', n.entity = 'EngineScore', n.sql = 'SELECT c.confluence_score, c.active_screener_count, c.conviction_level,
       c.ml_breakout_probability, c.computed_at
FROM confluence_signals c
WHERE c.symbol = :symbol AND c.computed_at <= :as_of
ORDER BY c.computed_at DESC
LIMIT 1', n.params = ['symbol', 'as_of'], n.unit = 'score_0_100', n.grain = '(symbol, computed_at)', n.cadence = 'every_15m', n.timing = 'coincident', n.derivation = 'platform', n.leakage_risk = 'none', n.graded_status = 'measured', n.graded_evidence = 'The only engine score on this platform with a growing positive graded reading, which is why it carries the ranker.', n.cheap_to_run = true, n.caveats = ['`computed_at` is native TIMESTAMPTZ here but TEXT on `unified_recommendations` — cast across that join.', '`ml_breakout_probability` is a model output and must not be used as a feature elsewhere.'], n.synonyms = ['confluence', 'confluence score', 'engine agreement'], n.uri = 'https://bharat-stock-intelligence.dev/ontology/metric#confluence_score_latest' RETURN n.name AS name;
MERGE (m:Metric {name: 'confluence_score_latest'}) MERGE (c:Class {name: 'EngineScore'}) MERGE (m)-[:OF_ENTITY]->(c);
MERGE (m:Metric {name: 'confluence_score_latest'}) MERGE (t:Table {name: 'confluence_signals'}) MERGE (m)-[:DERIVED_FROM]->(t);
MERGE (n:Metric {name: 'index_pcr_latest'}) SET n.label = 'Index put-call ratio, latest', n.description = 'The most recent index PCR reading with the index close at the same instant.', n.entity = 'IndexDerivativesSnapshot', n.sql = 'SELECT n.pcr, n.index_close, n.ts
FROM nt_index_pcr_ts n
WHERE n.index_name = ''NIFTY50'' AND n.ts <= :as_of
ORDER BY n.ts DESC
LIMIT 1', n.params = ['as_of'], n.unit = 'ratio', n.grain = '(index, timestamp, expiry)', n.cadence = 'intraday', n.timing = 'leading', n.derivation = 'vendor', n.leakage_risk = 'none', n.graded_status = 'research-candidate', n.graded_evidence = 'Index positioning is classed as genuinely leading in the master report''s taxonomy, but remains ungraded here (Experiment 6).', n.cheap_to_run = false, n.caveats = ['Pinned to NIFTY50 deliberately: the index name is a dimension this metric does not parameterise.', 'Three PCR variants exist in the source table (OI, volume, OI change) and they measure different things.', 'Leading is not the same as profitable — this is ungraded.'], n.synonyms = ['pcr', 'put call ratio', 'index pcr', 'options positioning', 'derivatives sentiment'], n.uri = 'https://bharat-stock-intelligence.dev/ontology/metric#index_pcr_latest' RETURN n.name AS name;
MERGE (m:Metric {name: 'index_pcr_latest'}) MERGE (c:Class {name: 'IndexDerivativesSnapshot'}) MERGE (m)-[:OF_ENTITY]->(c);
MERGE (m:Metric {name: 'index_pcr_latest'}) MERGE (t:Table {name: 'nt_index_pcr_ts'}) MERGE (m)-[:DERIVED_FROM]->(t);
MERGE (n:Metric {name: 'rollover_pct_latest'}) SET n.label = 'Futures rollover, latest', n.description = 'The latest rollover percentage and annualised cost of carry for a stock''s futures, with its total open interest.', n.entity = 'FuturesPositioning', n.sql = 'SELECT r.rollover_pct, r.cost_of_carry_ann, r.total_oi, r.date
FROM fno_rollover r
WHERE r.symbol = :symbol AND r.date <= :as_of
ORDER BY r.date DESC
LIMIT 1', n.params = ['symbol', 'as_of'], n.unit = 'percent', n.grain = '(symbol, date)', n.cadence = 'daily', n.timing = 'leading', n.derivation = 'vendor', n.leakage_risk = 'none', n.graded_status = 'low-data', n.graded_evidence = 'The stock-futures panel spans ~14 dates; the master report''s verdict is LOW-DATA, so a reading from it is a calendar artefact.', n.cheap_to_run = true, n.caveats = ['LOW-DATA panel: never treat a correlation computed on it as an edge.', 'Rollover is only meaningful in the days before an expiry; outside that window the number is mostly noise.'], n.synonyms = ['rollover', 'rollover percent', 'futures rollover', 'cost of carry', 'open interest'], n.uri = 'https://bharat-stock-intelligence.dev/ontology/metric#rollover_pct_latest' RETURN n.name AS name;
MERGE (m:Metric {name: 'rollover_pct_latest'}) MERGE (c:Class {name: 'FuturesPositioning'}) MERGE (m)-[:OF_ENTITY]->(c);
MERGE (m:Metric {name: 'rollover_pct_latest'}) MERGE (t:Table {name: 'fno_rollover'}) MERGE (m)-[:DERIVED_FROM]->(t);
MERGE (n:Metric {name: 'market_breadth_latest'}) SET n.label = 'Market breadth, latest', n.description = 'Share of the universe above its 200-day average and the advance/decline ratio for the most recent session.', n.entity = 'BreadthObservation', n.sql = 'SELECT b.pct_above_200dma, b.adv_decline_ratio, b.date
FROM market_breadth b
WHERE b.date <= :as_of
ORDER BY b.date DESC
LIMIT 1', n.params = ['as_of'], n.unit = 'percent', n.grain = 'per session', n.cadence = 'daily', n.timing = 'context', n.derivation = 'platform', n.leakage_risk = 'none', n.graded_status = 'ungraded', n.cheap_to_run = true, n.caveats = ['Computed over this platform''s own universe definition, so it is not comparable to a vendor''s breadth series without re-basing.', 'Classed as a FILTER on this platform, not as alpha.'], n.synonyms = ['breadth', 'advance decline', 'participation', 'market internals'], n.uri = 'https://bharat-stock-intelligence.dev/ontology/metric#market_breadth_latest' RETURN n.name AS name;
MERGE (m:Metric {name: 'market_breadth_latest'}) MERGE (c:Class {name: 'BreadthObservation'}) MERGE (m)-[:OF_ENTITY]->(c);
MERGE (m:Metric {name: 'market_breadth_latest'}) MERGE (t:Table {name: 'market_breadth'}) MERGE (m)-[:DERIVED_FROM]->(t);
MERGE (n:Metric {name: 'current_regime'}) SET n.label = 'Current market regime', n.description = 'The regime label and its posterior probability for the most recent session at or before the as-of date.', n.entity = 'RegimeState', n.sql = 'SELECT m.regime, m.regime_prob, m.date
FROM market_regimes m
WHERE m.date <= :as_of
ORDER BY m.date DESC
LIMIT 1', n.params = ['as_of'], n.grain = 'per session', n.cadence = 'daily', n.timing = 'context', n.derivation = 'platform', n.leakage_risk = 'none', n.graded_status = 'live', n.cheap_to_run = true, n.caveats = ['The regime is a WEIGHT GATE here, not a directional call: it re-blends engine weights, so reading it as a trade is a category error.', '`regime_prob` is an HMM posterior, not a calibrated probability of a market outcome.'], n.synonyms = ['regime', 'market regime', 'bull', 'bear', 'sideways', 'volatility state'], n.uri = 'https://bharat-stock-intelligence.dev/ontology/metric#current_regime' RETURN n.name AS name;
MERGE (m:Metric {name: 'current_regime'}) MERGE (c:Class {name: 'RegimeState'}) MERGE (m)-[:OF_ENTITY]->(c);
MERGE (m:Metric {name: 'current_regime'}) MERGE (t:Table {name: 'market_regimes'}) MERGE (m)-[:DERIVED_FROM]->(t);
MERGE (n:Metric {name: 'asm_flag_latest'}) SET n.label = 'Surveillance flag, latest', n.description = 'Whether the symbol is under exchange surveillance measures as of the most recent signal date.', n.entity = 'TechnicalSignal', n.sql = 'SELECT t.asm_flag, t.date AS as_of
FROM technical_signals t
WHERE t.symbol = :symbol AND t.date <= :as_of
ORDER BY t.date DESC
LIMIT 1', n.params = ['symbol', 'as_of'], n.grain = '(symbol, date)', n.cadence = 'daily', n.timing = 'coincident', n.derivation = 'vendor', n.leakage_risk = 'none', n.graded_status = 'live', n.cheap_to_run = true, n.caveats = ['This is a TRADABILITY CONSTRAINT, not a signal: a name under surveillance can be untradeable in size regardless of how good the setup looks.', 'It is stamped from a fetched list, so it lags the exchange''s own announcement by however long the fetcher took.'], n.synonyms = ['asm', 'gsm', 'surveillance', 'tradability', 'ban'], n.uri = 'https://bharat-stock-intelligence.dev/ontology/metric#asm_flag_latest' RETURN n.name AS name;
MERGE (m:Metric {name: 'asm_flag_latest'}) MERGE (c:Class {name: 'TechnicalSignal'}) MERGE (m)-[:OF_ENTITY]->(c);
MERGE (m:Metric {name: 'asm_flag_latest'}) MERGE (t:Table {name: 'technical_signals'}) MERGE (m)-[:DERIVED_FROM]->(t);
MERGE (n:Metric {name: 'analyst_consensus_latest'}) SET n.label = 'Analyst consensus, latest', n.description = 'Mean analyst target, contributor count and consensus rating from the most recent snapshot at or before the as-of date.', n.entity = 'AnalystEstimate', n.sql = 'SELECT a.target_mean, a.n_analysts, a.final_rating, a.as_of_date
FROM analyst_estimates_history a
WHERE a.symbol = :symbol AND a.as_of_date <= :as_of
ORDER BY a.as_of_date DESC
LIMIT 1', n.params = ['symbol', 'as_of'], n.unit = 'per_share_INR', n.grain = '(symbol, as_of_date)', n.cadence = 'vendor_periodic', n.timing = 'leading', n.derivation = 'vendor', n.leakage_risk = 'none', n.graded_status = 'ungraded', n.graded_evidence = 'Genuinely leading in the taxonomy, but the revision trio derived from it is calendar-blocked to ~2026-10.', n.cheap_to_run = true, n.caveats = ['`target_mean` is a per-share price in INR, not a return — it must be divided by a price to become an upside percentage.', 'Snapshots are as-of-stamped: re-fetching later can return a different history than the one that was knowable.'], n.synonyms = ['analyst', 'consensus', 'target price', 'price target', 'analyst rating', 'estimates'], n.uri = 'https://bharat-stock-intelligence.dev/ontology/metric#analyst_consensus_latest' RETURN n.name AS name;
MERGE (m:Metric {name: 'analyst_consensus_latest'}) MERGE (c:Class {name: 'AnalystEstimate'}) MERGE (m)-[:OF_ENTITY]->(c);
MERGE (m:Metric {name: 'analyst_consensus_latest'}) MERGE (t:Table {name: 'analyst_estimates_history'}) MERGE (m)-[:DERIVED_FROM]->(t);
MERGE (n:Metric {name: 'screener_5d_forward_return'}) SET n.label = 'Screener 5-day forward return', n.description = 'Average 5-session forward return across the times this symbol was surfaced by a live screener, with the sample size.', n.entity = 'ScreenerOutcome', n.sql = 'SELECT avg(l.return_5d) AS avg_forward_5d, count(*) AS n
FROM live_screener_outcomes l
WHERE l.symbol = :symbol AND l.appeared_at <= :as_of AND l.return_5d IS NOT NULL', n.params = ['symbol', 'as_of'], n.unit = 'percent', n.grain = '(symbol, appearance)', n.cadence = 'every_15m', n.timing = 'target', n.derivation = 'platform', n.leakage_risk = 'high', n.graded_status = 'live', n.cheap_to_run = true, n.caveats = ['This is a LABEL aggregate, not a feature: it measures how the screener family performed historically for this symbol.', 'NULL `return_5d` rows are excluded, so recent appearances do not drag the average toward zero — but they do make `n` smaller than the appearance count.', 'Attribution belongs to whichever screeners surfaced the name; averaging across all of them mixes unrelated strategies.'], n.synonyms = ['screener performance', 'screener forward return', 'screener edge', 'surfacing outcome'], n.uri = 'https://bharat-stock-intelligence.dev/ontology/metric#screener_5d_forward_return' RETURN n.name AS name;
MERGE (m:Metric {name: 'screener_5d_forward_return'}) MERGE (c:Class {name: 'ScreenerOutcome'}) MERGE (m)-[:OF_ENTITY]->(c);
MERGE (m:Metric {name: 'screener_5d_forward_return'}) MERGE (t:Table {name: 'live_screener_outcomes'}) MERGE (m)-[:DERIVED_FROM]->(t);
MERGE (n:Metric {name: 'news_sentiment_5d'}) SET n.label = 'News sentiment, trailing 5 sessions', n.description = 'Mean scored sentiment across news items mentioning the symbol in the five sessions up to the as-of date, with the mention count.', n.entity = 'NewsItem', n.sql = 'SELECT avg(n.sentiment_score) AS avg_sentiment, count(*) AS mentions
FROM news_symbol_link n
WHERE n.symbol = :symbol AND n.published_at <= :as_of
  AND n.published_at > ((:as_of)::date - 5)', n.params = ['symbol', 'as_of'], n.unit = 'score_minus1_1', n.grain = '(symbol, trailing 5 sessions)', n.cadence = 'intraday', n.timing = 'leading', n.derivation = 'platform', n.leakage_risk = 'none', n.graded_status = 'measured', n.graded_evidence = 'News sentiment conditioning on movers measured a lift of ~0.13 (n=114, p=0.037) — a lead, not a result.', n.cheap_to_run = true, n.caveats = ['Counts MENTIONS, not articles: one widely covered item produces many rows and will dominate the average.', '`published_at` is the only knowable timestamp — filtering on the event date instead is a look-ahead bug.', 'A mention is not a foreign key: this join must go through the link table, never through the JSON array on the news row.', 'Scored sentiment comes from either the vendor or FinBERT depending on `ai_scored`; the two are not the same measurement.'], n.synonyms = ['news sentiment', 'sentiment', 'headline sentiment', 'news flow', 'news count'], n.uri = 'https://bharat-stock-intelligence.dev/ontology/metric#news_sentiment_5d' RETURN n.name AS name;
MERGE (m:Metric {name: 'news_sentiment_5d'}) MERGE (c:Class {name: 'NewsItem'}) MERGE (m)-[:OF_ENTITY]->(c);
MERGE (m:Metric {name: 'news_sentiment_5d'}) MERGE (t:Table {name: 'news_symbol_link'}) MERGE (m)-[:DERIVED_FROM]->(t);
MERGE (n:Metric {name: 'excursion_path_5d'}) SET n.label = 'Excursion path, 5-day horizon', n.description = 'Average maximum favourable and adverse excursion for resolved 5-day signals on a symbol, with the sample size.', n.entity = 'SignalExcursion', n.sql = 'SELECT avg(e.mfe_pct) AS avg_mfe, avg(e.mae_pct) AS avg_mae,
       count(*) AS n
FROM signal_excursions e
WHERE e.symbol = :symbol AND e.horizon_days = 5 AND e.signal_date <= :as_of', n.params = ['symbol', 'as_of'], n.unit = 'percent', n.grain = '(symbol, signal_date, horizon)', n.cadence = 'daily', n.timing = 'target', n.derivation = 'platform', n.leakage_risk = 'high', n.graded_status = 'live', n.cheap_to_run = true, n.caveats = ['LABEL-SHAPED. MFE/MAE describe what already happened; they are never inputs.', 'The horizon is pinned to 5 sessions — a 1-day and a 20-day path are different distributions and must not be averaged together.', 'Path statistics make stop placement answerable: the terminal return alone cannot say whether the trade was ever viable.'], n.synonyms = ['mfe', 'mae', 'excursion', 'drawdown', 'stop loss study', 'favourable excursion'], n.uri = 'https://bharat-stock-intelligence.dev/ontology/metric#excursion_path_5d' RETURN n.name AS name;
MERGE (m:Metric {name: 'excursion_path_5d'}) MERGE (c:Class {name: 'SignalExcursion'}) MERGE (m)-[:OF_ENTITY]->(c);
MERGE (m:Metric {name: 'excursion_path_5d'}) MERGE (t:Table {name: 'signal_excursions'}) MERGE (m)-[:DERIVED_FROM]->(t);

// ---- controlled vocabularies ----
MERGE (n:Vocabulary {name: 'timeframe'}) SET n.description = 'Trading horizon an engine or signal is expressed on. Uppercase in the canonical signal tables; `screener_master.inferred_timeframe` uses a lowercase subset — normalise before joining the two.', n.source = 'unified_recommendations.timeframe', n.open_ended = false, n.term_count = 4, n.uri = 'bsiv:timeframe' RETURN n.name AS name;
MERGE (n:Term {id: 'timeframe:INTRADAY'}) SET n.notation = 'INTRADAY', n.label = 'Intraday', n.definition = 'Entered and exited within one session.' RETURN n.id AS id;
MERGE (t:Term {id: 'timeframe:INTRADAY'}) MERGE (v:Vocabulary {name: 'timeframe'}) MERGE (t)-[:IN_SCHEME]->(v);
MERGE (n:Term {id: 'timeframe:SWING'}) SET n.notation = 'SWING', n.label = 'Swing', n.definition = 'Sessions to a few weeks. The best-powered graded horizon is 5 days.' RETURN n.id AS id;
MERGE (t:Term {id: 'timeframe:SWING'}) MERGE (v:Vocabulary {name: 'timeframe'}) MERGE (t)-[:IN_SCHEME]->(v);
MERGE (n:Term {id: 'timeframe:POSITIONAL'}) SET n.notation = 'POSITIONAL', n.label = 'Positional', n.definition = 'Weeks to a few months.' RETURN n.id AS id;
MERGE (t:Term {id: 'timeframe:POSITIONAL'}) MERGE (v:Vocabulary {name: 'timeframe'}) MERGE (t)-[:IN_SCHEME]->(v);
MERGE (n:Term {id: 'timeframe:LONG_TERM'}) SET n.notation = 'LONG_TERM', n.label = 'Long term', n.definition = 'A quarter or longer; fundamentals-led.' RETURN n.id AS id;
MERGE (t:Term {id: 'timeframe:LONG_TERM'}) MERGE (v:Vocabulary {name: 'timeframe'}) MERGE (t)-[:IN_SCHEME]->(v);
MERGE (n:Vocabulary {name: 'market_regime'}) SET n.description = 'Macro regime label from the HMM regime detector, stamped onto every technical signal. A weight-gate filter and conditioning variable, not alpha.', n.source = 'market_regimes.regime', n.open_ended = false, n.term_count = 5, n.uri = 'bsiv:market_regime' RETURN n.name AS name;
MERGE (n:Term {id: 'market_regime:BULL'}) SET n.notation = 'BULL', n.label = 'Bull', n.definition = 'Uptrend regime; risk appetite expanding.' RETURN n.id AS id;
MERGE (t:Term {id: 'market_regime:BULL'}) MERGE (v:Vocabulary {name: 'market_regime'}) MERGE (t)-[:IN_SCHEME]->(v);
MERGE (n:Term {id: 'market_regime:BEAR'}) SET n.notation = 'BEAR', n.label = 'Bear', n.definition = 'Downtrend regime.' RETURN n.id AS id;
MERGE (t:Term {id: 'market_regime:BEAR'}) MERGE (v:Vocabulary {name: 'market_regime'}) MERGE (t)-[:IN_SCHEME]->(v);
MERGE (n:Term {id: 'market_regime:SIDEWAYS'}) SET n.notation = 'SIDEWAYS', n.label = 'Sideways', n.definition = 'Range-bound; mean-reversion favoured.' RETURN n.id AS id;
MERGE (t:Term {id: 'market_regime:SIDEWAYS'}) MERGE (v:Vocabulary {name: 'market_regime'}) MERGE (t)-[:IN_SCHEME]->(v);
MERGE (n:Term {id: 'market_regime:HIGH_VOL'}) SET n.notation = 'HIGH_VOL', n.label = 'High volatility', n.definition = 'Realised volatility elevated.' RETURN n.id AS id;
MERGE (t:Term {id: 'market_regime:HIGH_VOL'}) MERGE (v:Vocabulary {name: 'market_regime'}) MERGE (t)-[:IN_SCHEME]->(v);
MERGE (n:Term {id: 'market_regime:CRASH'}) SET n.notation = 'CRASH', n.label = 'Crash', n.definition = 'Acute drawdown; filters should suppress entries.' RETURN n.id AS id;
MERGE (t:Term {id: 'market_regime:CRASH'}) MERGE (v:Vocabulary {name: 'market_regime'}) MERGE (t)-[:IN_SCHEME]->(v);
MERGE (n:Vocabulary {name: 'conviction'}) SET n.description = 'Ranked conviction bucket on a served recommendation.', n.source = 'unified_recommendations.conviction_level', n.open_ended = false, n.term_count = 3, n.uri = 'bsiv:conviction' RETURN n.name AS name;
MERGE (n:Term {id: 'conviction:S_ELITE'}) SET n.notation = 'S_ELITE', n.label = 'S — elite', n.definition = 'Highest conviction bucket.' RETURN n.id AS id;
MERGE (t:Term {id: 'conviction:S_ELITE'}) MERGE (v:Vocabulary {name: 'conviction'}) MERGE (t)-[:IN_SCHEME]->(v);
MERGE (n:Term {id: 'conviction:A_HIGH'}) SET n.notation = 'A_HIGH', n.label = 'A — high', n.definition = 'High conviction.' RETURN n.id AS id;
MERGE (t:Term {id: 'conviction:A_HIGH'}) MERGE (v:Vocabulary {name: 'conviction'}) MERGE (t)-[:IN_SCHEME]->(v);
MERGE (n:Term {id: 'conviction:D_MARGINAL'}) SET n.notation = 'D_MARGINAL', n.label = 'D — marginal', n.definition = 'Marginal; below the actionable threshold in practice.' RETURN n.id AS id;
MERGE (t:Term {id: 'conviction:D_MARGINAL'}) MERGE (v:Vocabulary {name: 'conviction'}) MERGE (t)-[:IN_SCHEME]->(v);
MERGE (n:Vocabulary {name: 'recommendation_classification'}) SET n.description = 'Action label served alongside the numeric score. Mixed case on purpose: these are stored values, not an enum.', n.source = 'unified_recommendations.classification', n.open_ended = false, n.term_count = 5, n.uri = 'bsiv:recommendation_classification' RETURN n.name AS name;
MERGE (n:Term {id: 'recommendation_classification:Strong Buy'}) SET n.notation = 'Strong Buy', n.label = 'Strong buy', n.definition = 'Top action bucket.' RETURN n.id AS id;
MERGE (t:Term {id: 'recommendation_classification:Strong Buy'}) MERGE (v:Vocabulary {name: 'recommendation_classification'}) MERGE (t)-[:IN_SCHEME]->(v);
MERGE (n:Term {id: 'recommendation_classification:Buy'}) SET n.notation = 'Buy', n.label = 'Buy', n.definition = 'Actionable long.' RETURN n.id AS id;
MERGE (t:Term {id: 'recommendation_classification:Buy'}) MERGE (v:Vocabulary {name: 'recommendation_classification'}) MERGE (t)-[:IN_SCHEME]->(v);
MERGE (n:Term {id: 'recommendation_classification:Hold'}) SET n.notation = 'Hold', n.label = 'Hold', n.definition = 'No action.' RETURN n.id AS id;
MERGE (t:Term {id: 'recommendation_classification:Hold'}) MERGE (v:Vocabulary {name: 'recommendation_classification'}) MERGE (t)-[:IN_SCHEME]->(v);
MERGE (n:Term {id: 'recommendation_classification:Sell'}) SET n.notation = 'Sell', n.label = 'Sell', n.definition = 'Actionable short / exit.' RETURN n.id AS id;
MERGE (t:Term {id: 'recommendation_classification:Sell'}) MERGE (v:Vocabulary {name: 'recommendation_classification'}) MERGE (t)-[:IN_SCHEME]->(v);
MERGE (n:Term {id: 'recommendation_classification:Strong Sell'}) SET n.notation = 'Strong Sell', n.label = 'Strong sell', n.definition = 'Exit now; short candidate.' RETURN n.id AS id;
MERGE (t:Term {id: 'recommendation_classification:Strong Sell'}) MERGE (v:Vocabulary {name: 'recommendation_classification'}) MERGE (t)-[:IN_SCHEME]->(v);
MERGE (n:Vocabulary {name: 'intraday_regime'}) SET n.description = 'Within-session risk state used by the intraday ranker.', n.source = 'intraday_recommendations.intraday_regime', n.open_ended = true, n.term_count = 2, n.uri = 'bsiv:intraday_regime' RETURN n.name AS name;
MERGE (n:Term {id: 'intraday_regime:RISK_ON'}) SET n.notation = 'RISK_ON', n.label = 'Risk on', n.definition = 'Intraday conditions supportive of longs.' RETURN n.id AS id;
MERGE (t:Term {id: 'intraday_regime:RISK_ON'}) MERGE (v:Vocabulary {name: 'intraday_regime'}) MERGE (t)-[:IN_SCHEME]->(v);
MERGE (n:Term {id: 'intraday_regime:NEUTRAL'}) SET n.notation = 'NEUTRAL', n.label = 'Neutral', n.definition = 'No directional intraday tilt.' RETURN n.id AS id;
MERGE (t:Term {id: 'intraday_regime:NEUTRAL'}) MERGE (v:Vocabulary {name: 'intraday_regime'}) MERGE (t)-[:IN_SCHEME]->(v);
MERGE (n:Vocabulary {name: 'outcome'}) SET n.description = 'Realised result of a signal, written by the outcome resolver. The primary supervised label in the platform.', n.source = 'signal_outcomes.outcome', n.open_ended = false, n.term_count = 5, n.uri = 'bsiv:outcome' RETURN n.name AS name;
MERGE (n:Term {id: 'outcome:WIN'}) SET n.notation = 'WIN', n.label = 'Win', n.definition = 'Cleared the win threshold under the recorded label definition.' RETURN n.id AS id;
MERGE (t:Term {id: 'outcome:WIN'}) MERGE (v:Vocabulary {name: 'outcome'}) MERGE (t)-[:IN_SCHEME]->(v);
MERGE (n:Term {id: 'outcome:LOSS'}) SET n.notation = 'LOSS', n.label = 'Loss', n.definition = 'Fell below the loss threshold.' RETURN n.id AS id;
MERGE (t:Term {id: 'outcome:LOSS'}) MERGE (v:Vocabulary {name: 'outcome'}) MERGE (t)-[:IN_SCHEME]->(v);
MERGE (n:Term {id: 'outcome:STOP_LOSS'}) SET n.notation = 'STOP_LOSS', n.label = 'Stop loss', n.definition = 'Stop barrier hit before the horizon closed.' RETURN n.id AS id;
MERGE (t:Term {id: 'outcome:STOP_LOSS'}) MERGE (v:Vocabulary {name: 'outcome'}) MERGE (t)-[:IN_SCHEME]->(v);
MERGE (n:Term {id: 'outcome:NEUTRAL'}) SET n.notation = 'NEUTRAL', n.label = 'Neutral', n.definition = 'Closed inside the neutral band; not tradable.' RETURN n.id AS id;
MERGE (t:Term {id: 'outcome:NEUTRAL'}) MERGE (v:Vocabulary {name: 'outcome'}) MERGE (t)-[:IN_SCHEME]->(v);
MERGE (n:Term {id: 'outcome:PENDING'}) SET n.notation = 'PENDING', n.label = 'Pending', n.definition = 'Horizon has not elapsed — never training data.' RETURN n.id AS id;
MERGE (t:Term {id: 'outcome:PENDING'}) MERGE (v:Vocabulary {name: 'outcome'}) MERGE (t)-[:IN_SCHEME]->(v);
MERGE (n:Vocabulary {name: 'exit_reason'}) SET n.description = 'Why a tracked position closed. Separates rule-driven exits from integrity exits; `SUSPECT_DATA` / `NO_ENTRY_PRICE` rows are not labels.', n.source = 'unified_signal_outcomes.exit_reason', n.open_ended = false, n.term_count = 6, n.uri = 'bsiv:exit_reason' RETURN n.name AS name;
MERGE (n:Term {id: 'exit_reason:TIME_EXIT'}) SET n.notation = 'TIME_EXIT', n.label = 'Time exit', n.definition = 'Horizon elapsed; closed at the horizon bar.' RETURN n.id AS id;
MERGE (t:Term {id: 'exit_reason:TIME_EXIT'}) MERGE (v:Vocabulary {name: 'exit_reason'}) MERGE (t)-[:IN_SCHEME]->(v);
MERGE (n:Term {id: 'exit_reason:TIME_EXIT_PARTIAL'}) SET n.notation = 'TIME_EXIT_PARTIAL', n.label = 'Time exit (partial)', n.definition = 'Horizon elapsed with a partial exit.' RETURN n.id AS id;
MERGE (t:Term {id: 'exit_reason:TIME_EXIT_PARTIAL'}) MERGE (v:Vocabulary {name: 'exit_reason'}) MERGE (t)-[:IN_SCHEME]->(v);
