MERGE (a:Class {name: 'ScreenerOutcome'}) MERGE (b:Class {name: 'OutcomeRecord'}) MERGE (a)-[:SUBCLASS_OF]->(b);
MERGE (a:Class {name: 'EventTrigger'}) MERGE (b:Class {name: 'CandidateRecord'}) MERGE (a)-[:SUBCLASS_OF]->(b);
