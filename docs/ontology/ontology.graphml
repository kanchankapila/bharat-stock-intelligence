<?xml version="1.0" encoding="UTF-8"?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="kind" for="node" attr.name="kind" attr.type="string" />
  <key id="label" for="node" attr.name="label" attr.type="string" />
  <key id="layer" for="node" attr.name="layer" attr.type="string" />
  <key id="grain" for="node" attr.name="grain" attr.type="string" />
  <key id="tables" for="node" attr.name="tables" attr.type="string" />
  <key id="entity" for="node" attr.name="entity" attr.type="string" />
  <key id="cadence" for="node" attr.name="cadence" attr.type="string" />
  <key id="training_use" for="node" attr.name="training_use" attr.type="string" />
  <key id="writers" for="node" attr.name="writers" attr.type="string" />
  <key id="pk" for="node" attr.name="pk" attr.type="string" />
  <key id="unit" for="node" attr.name="unit" attr.type="string" />
  <key id="graded_status" for="node" attr.name="graded_status" attr.type="string" />
  <key id="leakage_risk" for="node" attr.name="leakage_risk" attr.type="string" />
  <key id="description" for="node" attr.name="description" attr.type="string" />
  <graph id="bsi" edgedefault="directed">
    <node id="class:Instrument">
      <data key="kind">class</data>
      <data key="label">Instrument</data>
      <data key="layer">identity</data>
      <data key="grain">instrument_key</data>
      <data key="tables">market_instrument</data>
      <data key="description">Anything that is quoted and traded. The canonical instrument identity is table-backed in `market_instrument`; legacy observation tables still key on the exchange ticker.</data>
    </node>
    <node id="class:Issuer">
      <data key="kind">class</data>
      <data key="label">Issuer</data>
      <data key="layer">identity</data>
      <data key="grain">issuer_key</data>
      <data key="tables">market_issuer</data>
      <data key="description">The legal issuer behind one or more instruments. ISIN issuer-prefix keys are authoritative when a checksum-valid ISIN is available; symbol-only rows remain explicitly provisional.</data>
    </node>
    <node id="class:Listing">
      <data key="kind">class</data>
      <data key="label">Listing</data>
      <data key="layer">identity</data>
      <data key="grain">listing_key</data>
      <data key="tables">market_listing</data>
      <data key="description">One tradable exchange/segment/symbol representation of an instrument.</data>
    </node>
    <node id="class:ProviderIdentifier">
      <data key="kind">class</data>
      <data key="label">Provider identifier</data>
      <data key="layer">identity</data>
      <data key="grain">(provider, scheme, identifier_value)</data>
      <data key="tables">market_identifier, market_identifier_gap</data>
      <data key="description">A provider-qualified identifier for an instrument. Provider and scheme are part of the identity; collisions are recorded rather than resolved by row order.</data>
    </node>
    <node id="class:Equity">
      <data key="kind">class</data>
      <data key="label">Equity</data>
      <data key="layer">identity</data>
      <data key="grain">one row per exchange ticker in `stock_master`</data>
      <data key="tables">stock_master, nse_stocks</data>
      <data key="description">A listed equity, one row per exchange ticker. This is the platform's universal join key and the subject of every other class.</data>
    </node>
    <node id="class:Index">
      <data key="kind">class</data>
      <data key="label">Index</data>
      <data key="layer">identity</data>
      <data key="grain">one row per index</data>
      <data key="description">A market index used as a benchmark or as a derivatives underlying (NIFTY 50, BANK NIFTY, SENSEX, INDIA VIX, GIFT NIFTY, ...).</data>
    </node>
    <node id="class:Sector">
      <data key="kind">class</data>
      <data key="label">Sector</data>
      <data key="layer">identity</data>
      <data key="grain">one row per label, no canonical table</data>
      <data key="description">An industry grouping used for relative-strength and rotation analysis. Stored as free text across several tables rather than resolved to a scheme.</data>
    </node>
    <node id="class:Exchange">
      <data key="kind">class</data>
      <data key="label">Exchange</data>
      <data key="layer">identity</data>
      <data key="grain">dimension</data>
      <data key="description">The venue an instrument is admitted to. A two-value dimension (NSE / BSE): usually encoded inside `symbol`, but carried as its own column in seven tables (nse_stocks, market_holidays, nt_fno_expiry, stock_earnings_dates, institutional_deal_signals, mc_advance_decline, mc_chart_patterns).</data>
    </node>
    <node id="class:ScripCodeMapping">
      <data key="kind">class</data>
      <data key="label">Vendor scrip-code mapping</data>
      <data key="layer">identity</data>
      <data key="grain">(scid, symbol)</data>
      <data key="tables">mc_scid_map</data>
      <data key="description">The vendor's private scid mapped onto the platform symbol and issuer name — the only sanctioned route from one to the other.</data>
    </node>
    <node id="class:CompanyProfile">
      <data key="kind">class</data>
      <data key="label">CompanyProfile</data>
      <data key="layer">identity</data>
      <data key="grain">one row per symbol</data>
      <data key="tables">company_profiles</data>
      <data key="description">Narrative and high-level attributes about the issuer behind a ticker.</data>
    </node>
    <node id="class:Observation">
      <data key="kind">class</data>
      <data key="label">Observation</data>
      <data key="layer">observation</data>
      <data key="description">Abstract parent for anything measured at a point in time without the platform adding an opinion to it. Raw or vendor-supplied; never a label.</data>
    </node>
    <node id="class:Bar">
      <data key="kind">class</data>
      <data key="label">Daily bar</data>
      <data key="layer">observation</data>
      <data key="grain">(symbol, date)</data>
      <data key="tables">stock_ohlcv</data>
      <data key="description">One daily OHLCV bar per symbol per trading session — the platform's only self-owned source of truth.</data>
    </node>
    <node id="class:IntradayBar">
      <data key="kind">class</data>
      <data key="label">Intraday bar</data>
      <data key="layer">observation</data>
      <data key="grain">(symbol, datetime, series)</data>
      <data key="tables">intraday_ohlcv</data>
      <data key="description">Sub-daily OHLCV with VWAP. Currently a single interval (15m) of recent history.</data>
    </node>
    <node id="class:DeliveryObservation">
      <data key="kind">class</data>
      <data key="label">Delivery observation</data>
      <data key="layer">observation</data>
      <data key="grain">(symbol, date)</data>
      <data key="tables">stock_delivery_data, stock_delivery_volume</data>
      <data key="description">The deliverable-to-traded quantity ratio — the highest-frequency ownership-behaviour proxy the platform owns, and a T+1 lag by construction.</data>
    </node>
    <node id="class:CorporateAction">
      <data key="kind">class</data>
      <data key="label">Corporate action</data>
      <data key="layer">observation</data>
      <data key="grain">(symbol, ex_date, action_type)</data>
      <data key="tables">corporate_actions</data>
      <data key="description">A capital-structure event with a price consequence (dividend, split, bonus, rights) plus the record/ex dates that make it usable point-in-time.</data>
    </node>
    <node id="class:FundamentalSnapshot">
      <data key="kind">class</data>
      <data key="label">Fundamental snapshot</data>
      <data key="layer">observation</data>
      <data key="grain">(symbol, as_of_date)</data>
      <data key="tables">fundamentals_history</data>
      <data key="description">Vendor-supplied accounting ratios and market-cap for a symbol, captured with an as-of date. Lagging information: the publication delay is the point-in-time risk.</data>
    </node>
    <node id="class:AnalystEstimate">
      <data key="kind">class</data>
      <data key="label">Analyst estimate</data>
      <data key="layer">observation</data>
      <data key="grain">(symbol, as_of_date)</data>
      <data key="tables">analyst_estimates_history</data>
      <data key="description">Consensus ratings, target prices and next-period estimates captured as a dated snapshot. Genuinely leading information; short panel relative to the news table.</data>
    </node>
    <node id="class:EarningsSurprise">
      <data key="kind">class</data>
      <data key="label">Earnings surprise</data>
      <data key="layer">observation</data>
      <data key="grain">(symbol, quarter)</data>
      <data key="tables">eps_surprise_history</data>
      <data key="description">Actual versus estimated net profit and revenue for a quarter, with the surprise computed per line. Coincident for the print, leading for the drift after it.</data>
    </node>
    <node id="class:InsiderTransaction">
      <data key="kind">class</data>
      <data key="label">Insider transaction</data>
      <data key="layer">observation</data>
      <data key="grain">(symbol, date, acquirer, transaction)</data>
      <data key="tables">insider_trades</data>
      <data key="description">A promoter/insider buy or sell filing. Leading in principle; graded weak as a standalone signal on this platform and kept as a confluence input.</data>
    </node>
    <node id="class:BlockDeal">
      <data key="kind">class</data>
      <data key="label">Block / bulk deal</data>
      <data key="layer">observation</data>
      <data key="grain">(symbol, date, deal)</data>
      <data key="tables">block_deals</data>
      <data key="description">An off-book or bulk transaction with quantity, price and value. Value is stored in CRORES as a bare number, with no currency or unit term attached.</data>
    </node>
    <node id="class:MFHolding">
      <data key="kind">class</data>
      <data key="label">Mutual-fund holding</data>
      <data key="layer">observation</data>
      <data key="grain">(symbol, disclosure date)</data>
      <data key="tables">stock_mf_holdings</data>
      <data key="description">Aggregate mutual-fund ownership of a symbol: holding percentage, fund count and the change versus the previous disclosure.</data>
    </node>
    <node id="class:NewsItem">
      <data key="kind">class</data>
      <data key="label">News item</data>
      <data key="layer">observation</data>
      <data key="grain">one row per article/announcement</data>
      <data key="tables">news_sentiment_items, news_symbol_link</data>
      <data key="description">A news article or exchange announcement with vendor sentiment, a FinBERT tone ensemble, an impact bucket and the symbols it mentions. 15 years deep — the only panel here that supports a real event study.</data>
    </node>
    <node id="class:OptionChainRow">
      <data key="kind">class</data>
      <data key="label">Option chain row</data>
      <data key="layer">observation</data>
      <data key="grain">(symbol, date, expiry, strike)</data>
      <data key="tables">so_option_chain</data>
      <data key="description">One strike, one expiry, one session: call and put leg premium, volume, open interest, IV and greeks. A grid, not a time series.</data>
    </node>
    <node id="class:FuturesPositioning">
      <data key="kind">class</data>
      <data key="label">Futures positioning</data>
      <data key="layer">observation</data>
      <data key="grain">(symbol, date, expiry)</data>
      <data key="tables">stock_futures_oi_history, fno_rollover</data>
      <data key="description">Stock-futures open interest, buildup label, rollover percentage, basis and cost of carry for one expiry and session.</data>
    </node>
    <node id="class:IndexDerivativesSnapshot">
      <data key="kind">class</data>
      <data key="label">Index derivatives snapshot</data>
      <data key="layer">observation</data>
      <data key="grain">(index_name, date, expiry)</data>
      <data key="tables">index_max_pain, nt_index_pcr_ts</data>
      <data key="description">Index-level positioning: PCR (single-strike time series and EOD), max pain, and aggregate call/put open interest.</data>
    </node>
    <node id="class:MoverSnapshot">
      <data key="kind">class</data>
      <data key="label">Mover snapshot</data>
      <data key="layer">observation</data>
      <data key="grain">(source, trade_date, symbol, rank)</data>
      <data key="tables">mover_snapshots</data>
      <data key="description">A ranked intraday mover list entry from a vendor feed: the platform's within-day event backbone alongside the event triggers.</data>
    </node>
    <node id="class:RegimeState">
      <data key="kind">class</data>
      <data key="label">Regime state</data>
      <data key="layer">context</data>
      <data key="grain">one row per date</data>
      <data key="tables">market_regimes, intraday_regime_history</data>
      <data key="description">The macro regime for a session, with its posterior probability and the decoded HMM path. Also covers the intraday regime panel.</data>
    </node>
    <node id="class:BreadthObservation">
      <data key="kind">class</data>
      <data key="label">Breadth observation</data>
      <data key="layer">context</data>
      <data key="grain">one row per date</data>
      <data key="tables">market_breadth</data>
      <data key="description">Market-wide participation statistics: share of the universe above its 200-day average, advance/decline ratio, net highs minus lows.</data>
    </node>
    <node id="class:SectorRotationPoint">
      <data key="kind">class</data>
      <data key="label">Sector rotation point</data>
      <data key="layer">context</data>
      <data key="grain">(sector, week_date)</data>
      <data key="tables">sector_rrg_history</data>
      <data key="description">Weekly relative-rotation coordinates and quadrant per sector — the intended input to sector-plus-stock relative strength.</data>
    </node>
    <node id="class:PlatformOutput">
      <data key="kind">class</data>
      <data key="label">Platform output</data>
      <data key="layer">derived</data>
      <data key="description">Abstract parent for anything this platform computes and serves. Every subclass is an OPINION of this system, not an observation of the market.</data>
    </node>
    <node id="class:FeatureVector">
      <data key="kind">class</data>
      <data key="label">Feature vector</data>
      <data key="layer">derived</data>
      <data key="grain">(symbol, date, timeframe)</data>
      <data key="tables">feature_store</data>
      <data key="description">The rolling per-symbol, per-date feature panel the models train on. Features, not information: they re-express price, flow and vendor data.</data>
    </node>
    <node id="class:TechnicalSignal">
      <data key="kind">class</data>
      <data key="label">Technical signal</data>
      <data key="layer">derived</data>
      <data key="grain">(symbol, date)</data>
      <data key="tables">technical_signals</data>
      <data key="description">The wide per-symbol, per-date technical panel: indicators, regime stamp, flow and fundamental context columns, plus the model's probability outputs.</data>
    </node>
    <node id="class:EngineScore">
      <data key="kind">class</data>
      <data key="label">Engine score</data>
      <data key="layer">derived</data>
      <data key="grain">(symbol, date)</data>
      <data key="tables">confluence_signals, engine_composite_scores, stock_scores</data>
      <data key="description">A single engine's, or the multi-engine composite's, score for a symbol and date with its engine-coverage count.</data>
    </node>
    <node id="class:Recommendation">
      <data key="kind">class</data>
      <data key="label">Recommendation</data>
      <data key="layer">derived</data>
      <data key="grain">(symbol, computed_at, timeframe)</data>
      <data key="tables">unified_recommendations, unified_recommendations_history, intraday_recommendations</data>
      <data key="description">The served trade: composite score, conviction bucket, action label, entry zone, stop, targets, risk/reward and position size for one symbol, date and timeframe.</data>
    </node>
    <node id="class:ModelArtifact">
      <data key="kind">class</data>
      <data key="label">Model artifact</data>
      <data key="layer">derived</data>
      <data key="grain">one row per version</data>
      <data key="tables">model_registry</data>
      <data key="description">A registered trained model: type, version, evaluation metrics, feature count, horizon and active flag.</data>
    </node>
    <node id="class:FeatureImportance">
      <data key="kind">class</data>
      <data key="label">Feature importance</data>
      <data key="layer">derived</data>
      <data key="grain">(model, run, feature)</data>
      <data key="tables">feature_importance_log</data>
      <data key="description">Per-model, per-run feature importance with rank — the audit trail behind which inputs a model actually used.</data>
    </node>
    <node id="class:OutcomeRecord">
      <data key="kind">class</data>
      <data key="label">Outcome record</data>
      <data key="layer">outcome</data>
      <data key="description">Abstract parent for resolved results. Labels live here and nowhere else: nothing in this branch may ever appear on the input side of a model.</data>
    </node>
    <node id="class:EdgeReading">
      <data key="kind">class</data>
      <data key="label">Edge reading</data>
      <data key="layer">outcome</data>
      <data key="grain">(run_at, table_name, score_col, horizon_days, regime)</data>
      <data key="tables">factor_edge_history</data>
      <data key="description">One factor-grading result: rank-IC and hit-AUC for a table/column, per regime and horizon, with the effective-date count and a verdict.</data>
    </node>
    <node id="class:SignalOutcome">
      <data key="kind">class</data>
      <data key="label">Signal outcome</data>
      <data key="layer">outcome</data>
      <data key="grain">(symbol, signal_date, horizon_days, signal_source)</data>
      <data key="tables">signal_outcomes, unified_signal_outcomes</data>
      <data key="description">The resolved result of a signal: entry, exit, horizon, return and the outcome label, under one of two possibly-different labelling rules.</data>
    </node>
    <node id="class:SignalExcursion">
      <data key="kind">class</data>
      <data key="label">Signal excursion</data>
      <data key="layer">outcome</data>
      <data key="grain">(symbol, signal_date, horizon_days)</data>
      <data key="tables">signal_excursions</data>
      <data key="description">Path statistics inside the evaluation window: maximum favourable and adverse excursion, days to each, and whether MFE preceded MAE.</data>
    </node>
    <node id="class:CandidateRecord">
      <data key="kind">class</data>
      <data key="label">Candidate record</data>
      <data key="layer">candidate</data>
      <data key="description">Abstract parent for vendor-opinion streams. These SURFACE candidates; they are never ground truth.</data>
    </node>
    <node id="class:Screener">
      <data key="kind">class</data>
      <data key="label">Screener</data>
      <data key="layer">candidate</data>
      <data key="grain">one row per screener</data>
      <data key="tables">screener_master</data>
      <data key="description">A vendor screener definition with its inferred sentiment, category, reliability tier and classification confidence.</data>
    </node>
    <node id="class:ScreenerAppearance">
      <data key="kind">class</data>
      <data key="label">Screener appearance</data>
      <data key="layer">candidate</data>
      <data key="grain">(run_id, symbol, filter_key)</data>
      <data key="tables">live_screener_appearances</data>
      <data key="description">A single surfacing event: this screener listed this symbol at this instant, with the price, change and volume at that moment.</data>
    </node>
    <node id="class:ScreenerOutcome">
      <data key="kind">class</data>
      <data key="label">Screener outcome</data>
      <data key="layer">outcome</data>
      <data key="grain">(appearance_id, symbol)</data>
      <data key="tables">live_screener_outcomes</data>
      <data key="description">Forward returns pre-tracked and attached to an appearance at surfacing time.</data>
    </node>
    <node id="class:EventTrigger">
      <data key="kind">class</data>
      <data key="label">Event trigger</data>
      <data key="layer">candidate</data>
      <data key="grain">(symbol, date)</data>
      <data key="tables">stock_event_triggers</data>
      <data key="description">Detector output: which composite trigger classes fired for a symbol on a date, with news counts and bullish-tenure state.</data>
    </node>
    <node id="class:GovernanceRecord">
      <data key="kind">class</data>
      <data key="label">Governance record</data>
      <data key="layer">governance</data>
      <data key="description">Abstract parent for operational metadata. These answer 'when was this true and who wrote it', which on this platform is the difference between a usable value and a guess.</data>
    </node>
    <node id="class:Endpoint">
      <data key="kind">class</data>
      <data key="label">Data endpoint</data>
      <data key="layer">governance</data>
      <data key="grain">one row per endpoint</data>
      <data key="tables">market_endpoint_registry, url_endpoints</data>
      <data key="description">A discovered, verified market-data endpoint: provider, domain, scope, update frequency and the template to call it. The platform's data-sourcing registry.</data>
    </node>
    <node id="class:JobRun">
      <data key="kind">class</data>
      <data key="label">Job run</data>
      <data key="layer">governance</data>
      <data key="grain">one row per job</data>
      <data key="tables">job_heartbeat</data>
      <data key="description">Per-job heartbeat: last status, last success, last error and run/failure counts.</data>
    </node>
    <node id="class:DataQualityCheck">
      <data key="kind">class</data>
      <data key="label">Data-quality check</data>
      <data key="layer">governance</data>
      <data key="grain">(check_id, checked_at)</data>
      <data key="tables">data_quality_results</data>
      <data key="description">The result of one named validation check: category, criticality, status and a detail string.</data>
    </node>
    <node id="class:DataContract">
      <data key="kind">class</data>
      <data key="label">Data contract</data>
      <data key="layer">governance</data>
      <data key="grain">contract_key</data>
      <data key="tables">market_data_contract</data>
      <data key="description">A versioned machine-readable contract describing one dataset's grain, timing, source, training use, and physical lineage.</data>
    </node>
    <node id="class:FeatureDefinition">
      <data key="kind">class</data>
      <data key="label">Semantic feature definition</data>
      <data key="layer">governance</data>
      <data key="grain">feature_key</data>
      <data key="tables">semantic_feature_definition</data>
      <data key="description">A versioned authored definition of a model-facing property, including leakage and feature-use constraints.</data>
    </node>
    <node id="class:DataWatermark">
      <data key="kind">class</data>
      <data key="label">Data completeness watermark</data>
      <data key="layer">governance</data>
      <data key="grain">(dataset, partition_key)</data>
      <data key="tables">market_data_watermark</data>
      <data key="description">Producer-published completeness and input/output boundary for a dataset partition.</data>
    </node>
    <node id="class:GraphNode">
      <data key="kind">class</data>
      <data key="label">Instance graph node</data>
      <data key="layer">governance</data>
      <data key="grain">node_key</data>
      <data key="tables">market_graph_node</data>
      <data key="description">A canonical entity projected into the bitemporal market graph.</data>
    </node>
    <node id="class:GraphEdge">
      <data key="kind">class</data>
      <data key="label">Instance graph edge</data>
      <data key="layer">governance</data>
      <data key="grain">assertion_key</data>
      <data key="tables">market_graph_edge</data>
      <data key="description">A typed, bitemporal assertion between graph nodes or a literal object value.</data>
    </node>
    <node id="class:EvidenceRecord">
      <data key="kind">class</data>
      <data key="label">Evidence record</data>
      <data key="layer">governance</data>
      <data key="grain">evidence_key</data>
      <data key="tables">market_evidence, market_claim_evidence</data>
      <data key="description">Source material retained separately from the claim extracted or inferred from it.</data>
    </node>
    <node id="class:MarketClaim">
      <data key="kind">class</data>
      <data key="label">Market claim</data>
      <data key="layer">derived</data>
      <data key="grain">claim_key</data>
      <data key="tables">market_claim</data>
      <data key="description">An explicit, status-bearing assertion about a market entity, separate from raw evidence.</data>
    </node>
    <node id="class:DecisionEvent">
      <data key="kind">class</data>
      <data key="label">Decision event</data>
      <data key="layer">derived</data>
      <data key="grain">decision_key</data>
      <data key="tables">market_decision_event, market_decision_evidence</data>
      <data key="description">An append-only, reconstructable decision record with cutoff, versions, quality, and structured supporting or contradictory evidence.</data>
    </node>
    <node id="class:DecisionOutcome">
      <data key="kind">class</data>
      <data key="label">Decision outcome</data>
      <data key="layer">outcome</data>
      <data key="grain">(decision_key, label_definition, horizon_days)</data>
      <data key="tables">market_decision_outcome</data>
      <data key="description">A realized outcome attached to a decision under an explicit label definition and horizon.</data>
    </node>
    <node id="table:stock_ohlcv">
      <data key="kind">table</data>
      <data key="label">Daily OHLCV bars</data>
