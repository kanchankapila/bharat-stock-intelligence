      <data key="label">Semantic data contract</data>
      <data key="entity">DataContract</data>
      <data key="grain">(contract_key)</data>
      <data key="cadence">on_change</data>
      <data key="training_use">context</data>
      <data key="writers">semantic_contracts.py</data>
      <data key="pk">contract_key</data>
      <data key="description">Versioned executable contract for dataset grain, timing, source, and allowed use.</data>
    </node>
    <node id="table:semantic_feature_definition">
      <data key="kind">table</data>
      <data key="label">Semantic feature definition</data>
      <data key="entity">FeatureDefinition</data>
      <data key="grain">(feature_key)</data>
      <data key="cadence">on_change</data>
      <data key="training_use">context</data>
      <data key="writers">semantic_contracts.py</data>
