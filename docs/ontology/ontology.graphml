      <data key="label">Confluence signals</data>
      <data key="entity">EngineScore</data>
      <data key="grain">(symbol, computed_at)</data>
      <data key="cadence">every_15m</data>
      <data key="training_use">caution</data>
      <data key="writers">confluence_ml_engine.py</data>
      <data key="pk">symbol, computed_at</data>
