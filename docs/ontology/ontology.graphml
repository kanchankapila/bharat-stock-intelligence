      <data key="kind">table</data>
      <data key="label">Data-quality results</data>
      <data key="entity">DataQualityCheck</data>
      <data key="grain">(check_id)</data>
      <data key="cadence">continuous</data>
      <data key="training_use">forbidden</data>
      <data key="writers">run_data_quality_checks.ts</data>
      <data key="pk">check_id</data>
