      <data key="kind">table</data>
      <data key="label">Recommendation history</data>
      <data key="entity">Recommendation</data>
      <data key="grain">(symbol, computed_at)</data>
      <data key="cadence">daily</data>
      <data key="training_use">caution</data>
      <data key="writers">unified_ranker.py</data>
      <data key="pk">symbol, computed_at</data>
