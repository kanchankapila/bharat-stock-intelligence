    <node id="table:market_claim_evidence">
      <data key="kind">table</data>
      <data key="label">Claim evidence link</data>
      <data key="entity">EvidenceRecord</data>
      <data key="grain">(claim_key, evidence_key)</data>
      <data key="cadence">on_write</data>
      <data key="training_use">context</data>
      <data key="writers">semantic_evidence.py</data>
      <data key="pk">claim_key, evidence_key</data>
      <data key="description">Supports/opposes/context links from explicit claims to retained source evidence.</data>
    </node>
    <node id="table:market_decision_event">
      <data key="kind">table</data>
      <data key="label">Decision event</data>
      <data key="entity">DecisionEvent</data>
      <data key="grain">(decision_key)</data>
      <data key="cadence">on_write</data>
      <data key="training_use">context</data>
      <data key="writers">unified_ranker.py</data>
      <data key="pk">decision_key</data>
      <data key="description">Append-only decision event carrying cutoff, versions, quality, watermarks, vetoes, and guardrails.</data>
    </node>
    <node id="table:market_decision_evidence">
      <data key="kind">table</data>
      <data key="label">Decision evidence</data>
      <data key="entity">DecisionEvent</data>
      <data key="grain">(decision_key, evidence_key)</data>
      <data key="cadence">on_write</data>
      <data key="training_use">context</data>
      <data key="writers">unified_ranker.py, semantic_evidence.py</data>
      <data key="pk">decision_key, evidence_key</data>
      <data key="description">Structured support, contradiction, context, and veto evidence for each decision.</data>
    </node>
    <node id="table:market_decision_outcome">
      <data key="kind">table</data>
      <data key="label">Decision outcome</data>
      <data key="entity">DecisionOutcome</data>
      <data key="grain">(decision_key, label_definition, horizon_days)</data>
      <data key="cadence">on_outcome</data>
      <data key="training_use">labels</data>
      <data key="writers">outcome_resolver.py, semantic_evidence.py</data>
      <data key="pk">decision_key, label_definition, horizon_days</data>
      <data key="description">Realized outcome attached to a decision under an explicit label definition.</data>
    </node>
