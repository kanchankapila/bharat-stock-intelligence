    <node id="table:market_evidence">
      <data key="kind">table</data>
      <data key="label">Source evidence</data>
      <data key="entity">EvidenceRecord</data>
      <data key="grain">(evidence_key)</data>
      <data key="cadence">on_write</data>
      <data key="training_use">context</data>
      <data key="writers">semantic_evidence.py</data>
      <data key="pk">evidence_key</data>
      <data key="description">Source material retained independently from claims and decision interpretations.</data>
    </node>
    <node id="table:market_claim">
      <data key="kind">table</data>
      <data key="label">Explicit market claim</data>
      <data key="entity">MarketClaim</data>
      <data key="grain">(claim_key)</data>
      <data key="cadence">on_write</data>
      <data key="training_use">context</data>
      <data key="writers">semantic_evidence.py</data>
      <data key="pk">claim_key</data>
      <data key="description">Typed claim with stance, method, status, and bitemporal availability.</data>
