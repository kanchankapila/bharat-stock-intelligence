    </node>
    <node id="table:unified_signal_outcomes">
      <data key="kind">table</data>
      <data key="label">Unified signal outcomes</data>
      <data key="entity">SignalOutcome</data>
      <data key="grain">(symbol, signal_date, horizon_days)</data>
      <data key="cadence">daily</data>
      <data key="training_use">labels</data>
      <data key="writers">outcome_resolver.py</data>
      <data key="pk">symbol, signal_date, horizon_days</data>
      <data key="description">Outcomes for served signals with the exit reason that closed them — the forward-test surface for the ranker.</data>
    </node>
