  "@graph": [
    {
      "@id": "bsi:catalog",
      "rdf:type": {
        "@id": "dcat:Catalog"
      },
      "rdfs:label": "Bharat Stock Intelligence data catalog",
      "dct:title": "Bharat Stock Intelligence data catalog",
      "dct:description": "Documented tables of the bharat_intel database, generated from the ontology layer. cadence is carried twice on purpose: as `bsis:cadence` (literal, our vocabulary) and as `dct:accrualPeriodicity` (also a literal — the DCAT frequency IRIs were not verified this session, so the VALUE is ours, not an asserted external IRI)",
      "dct:publisher": {
        "@id": "bsis:platform"
      }
    },
    {
      "@id": "bsis:stock_ohlcv",
      "rdf:type": [
        {
          "@id": "dcat:Dataset"
        },
        {
          "@id": "schema:Dataset"
        }
      ],
      "dct:title": "Daily OHLCV bars",
      "dct:description": "One daily OHLCV bar per symbol per session. The platform's only self-owned source of truth and the basis of every return calculation.",
      "dct:identifier": "stock_ohlcv",
      "schema:name": "stock_ohlcv",
      "schema:description": "One daily OHLCV bar per symbol per session. The platform's only self-owned source of truth and the basis of every return calculation.",
      "dct:accrualPeriodicity": "per_session",
      "bsis:cadence": "per_session",
      "bsis:grain": "(symbol, date)",
      "bsis:primaryKey": "symbol, date",
      "bsis:trainingUse": "caution",
      "bsis:entity": {
        "@id": "bsi:Bar"
      },
      "dcat:inCatalog": {
        "@id": "bsi:catalog"
      },
      "bsis:freshnessColumn": "date",
      "bsis:writtenBy": [
        "nse_bhavcopy_fetcher.py",
        "bse_bhavcopy_fetcher.py"
      ],
      "bsis:caveat": [
        "Price basis is per ROW, in `adjustment_basis` (nse_bhavcopy_raw / split_only / split_dividend). Mixing bases inside one series corrupts a backtest silently.",
        "Suspect bars are flagged, not deleted: filter `is_suspect = 0` before building a panel, and read `suspect_reason` rather than imputing."
      ],
      "schema:variableMeasured": [
        {
          "@id": "_:pv_stock_ohlcv_symbol"
        },
        {
          "@id": "_:pv_stock_ohlcv_date"
        },
        {
          "@id": "_:pv_stock_ohlcv_open"
        },
        {
          "@id": "_:pv_stock_ohlcv_high"
        },
        {
          "@id": "_:pv_stock_ohlcv_low"
        },
        {
          "@id": "_:pv_stock_ohlcv_close"
        },
        {
          "@id": "_:pv_stock_ohlcv_volume"
        },
        {
          "@id": "_:pv_stock_ohlcv_is_suspect"
        },
        {
          "@id": "_:pv_stock_ohlcv_adjustment_basis"
        },
        {
          "@id": "_:pv_stock_ohlcv_suspect_reason"
        }
      ]
    },
