      "@id": "bsis:confluence_signals",
      "rdf:type": [
        {
          "@id": "dcat:Dataset"
        },
        {
          "@id": "schema:Dataset"
        }
      ],
      "dct:title": "Confluence signals",
      "dct:description": "The multi-engine agreement score with the contributing screeners, their weights at scoring time, and the model probabilities that fed it.",
      "dct:identifier": "confluence_signals",
      "schema:name": "confluence_signals",
      "schema:description": "The multi-engine agreement score with the contributing screeners, their weights at scoring time, and the model probabilities that fed it.",
      "dct:accrualPeriodicity": "every_15m",
      "bsis:cadence": "every_15m",
      "bsis:grain": "(symbol, computed_at)",
      "bsis:primaryKey": "symbol, computed_at",
      "bsis:trainingUse": "caution",
      "bsis:entity": {
        "@id": "bsi:EngineScore"
      },
      "dcat:inCatalog": {
        "@id": "bsi:catalog"
      },
      "bsis:freshnessColumn": "computed_at",
      "bsis:writtenBy": "confluence_ml_engine.py",
      "bsis:caveat": [
        "The only engine score with a growing positive graded reading on this platform — which is what makes it the ranker's load-bearing input.",
        "`computed_at` here is native TIMESTAMPTZ, unlike the TEXT `computed_at` on `unified_recommendations`: cast across the join.",
        "`ml_breakout_probability` / `ml_trend_probability` are model outputs.",
        "`screener_weights_json` records the weights AT SCORING TIME — applying today's weights to an old row is a look-ahead bug."
      ],
      "schema:variableMeasured": [
        {
          "@id": "_:pv_confluence_signals_symbol"
        },
