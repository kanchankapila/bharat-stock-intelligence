      "bsis:writtenBy": [
        "block_deals_fetcher.py",
        "mc_block_deal_history_fetcher.py"
      ],
      "bsis:caveat": [
        "`value_cr` is CRORES as a bare float — multiply by 1e7 for rupees and state that assumption wherever the number is used.",
        "`trade_type` is stored in mixed case by different fetchers: normalise with UPPER() before aggregating buys against sells.",
        "Block-deal features exist downstream but graded weak standalone."
      ],
