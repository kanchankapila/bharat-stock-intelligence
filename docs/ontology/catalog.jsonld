      "dct:description": "Forward returns attached to each appearance at surfacing time: the platform's largest pre-labelled dataset.",
      "dct:identifier": "live_screener_outcomes",
      "schema:name": "live_screener_outcomes",
      "schema:description": "Forward returns attached to each appearance at surfacing time: the platform's largest pre-labelled dataset.",
