      "dct:identifier": "intraday_ohlcv",
      "schema:name": "intraday_ohlcv",
      "schema:description": "Sub-daily OHLCV with VWAP for a single interval (15m) over recent history.",
      "dct:accrualPeriodicity": "intraday_15m",
      "bsis:cadence": "intraday_15m",
      "bsis:grain": "(symbol, datetime, interval)",
      "bsis:primaryKey": "symbol, datetime, interval",
      "bsis:trainingUse": "allowed",
