      "@id": "bsis:stock_delivery_data",
      "rdf:type": [
        {
          "@id": "dcat:Dataset"
        },
        {
          "@id": "schema:Dataset"
        }
      ],
      "dct:title": "Daily delivery data",
      "dct:description": "Deliverable quantity as a share of traded quantity: the platform's highest-frequency ownership proxy, published T+1 by the exchange.",
      "dct:identifier": "stock_delivery_data",
      "schema:name": "stock_delivery_data",
      "schema:description": "Deliverable quantity as a share of traded quantity: the platform's highest-frequency ownership proxy, published T+1 by the exchange.",
      "dct:accrualPeriodicity": "daily_t_plus_1",
      "bsis:cadence": "daily_t_plus_1",
      "bsis:grain": "(symbol, date)",
      "bsis:primaryKey": "symbol, date",
      "bsis:trainingUse": "allowed",
      "bsis:entity": {
        "@id": "bsi:DeliveryObservation"
      },
      "dcat:inCatalog": {
        "@id": "bsi:catalog"
      },
      "bsis:freshnessColumn": "updated_at",
      "bsis:writtenBy": "stock_delivery_fetcher.py",
      "bsis:caveat": [
        "T+1 by construction: no signal dated the same session can have used it.",
        "A sibling table (`stock_delivery_volume`) carries the same concept with different column names and different series coverage."
      ],
      "schema:variableMeasured": [
        {
          "@id": "_:pv_stock_delivery_data_symbol"
        },
        {
