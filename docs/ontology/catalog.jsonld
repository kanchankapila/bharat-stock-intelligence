      ],
      "dct:title": "Job heartbeats",
      "dct:description": "Per-job last status, last success, last error and run/failure counts. The operational truth behind every freshness claim.",
      "dct:identifier": "job_heartbeat",
      "schema:name": "job_heartbeat",
      "schema:description": "Per-job last status, last success, last error and run/failure counts. The operational truth behind every freshness claim.",
      "dct:accrualPeriodicity": "continuous",
      "bsis:cadence": "continuous",
      "bsis:grain": "(job_name)",
      "bsis:primaryKey": "job_name",
      "bsis:trainingUse": "forbidden",
