    {
      "@id": "bsis:stock_master",
      "rdf:type": [
        {
          "@id": "dcat:Dataset"
        },
        {
          "@id": "schema:Dataset"
        }
      ],
      "dct:title": "Instrument master",
      "dct:description": "One row per exchange ticker with its ISIN and every vendor-private id the platform uses to reach that instrument at each provider.",
      "dct:identifier": "stock_master",
      "schema:name": "stock_master",
      "schema:description": "One row per exchange ticker with its ISIN and every vendor-private id the platform uses to reach that instrument at each provider.",
      "dct:accrualPeriodicity": "on_change",
      "bsis:cadence": "on_change",
      "bsis:grain": "(symbol)",
      "bsis:primaryKey": "symbol",
      "bsis:trainingUse": "context",
      "bsis:entity": {
        "@id": "bsi:Equity"
      },
      "dcat:inCatalog": {
        "@id": "bsi:catalog"
      },
      "bsis:writtenBy": [
        "sync_stock_master.ts",
        "syncAllStockMappings.ts"
      ],
      "bsis:caveat": [
        "Keyed on TICKER, not ISIN: a company listed on both NSE and BSE is two rows here and one instrument elsewhere.",
        "The vendor id columns (mcsymbol, tlid, companyid, tickertape_sid, scripcode, fincode) are private to their providers — joining one vendor's id to another's is a defect, not a join.",
        "`sector` was EMPTY for every row as of 2026-09-21; sector arrives downstream on the signal tables instead."
      ],
      "schema:variableMeasured": [
        {
          "@id": "_:pv_stock_master_symbol"
        },
        {
          "@id": "_:pv_stock_master_isin"
        },
        {
          "@id": "_:pv_stock_master_company_name"
        },
        {
          "@id": "_:pv_stock_master_mcsymbol"
        },
        {
          "@id": "_:pv_stock_master_tlid"
        },
        {
          "@id": "_:pv_stock_master_companyid"
        },
        {
          "@id": "_:pv_stock_master_tickertape_sid"
        },
        {
          "@id": "_:pv_stock_master_scripcode"
        },
        {
          "@id": "_:pv_stock_master_fincode"
        },
        {
          "@id": "_:pv_stock_master_updated_at"
        },
        {
          "@id": "_:pv_stock_master_industry"
        }
      ]
    },
