      "schema:name": "block_deals",
      "schema:description": "Off-book and bulk transactions with quantity, price, counterparty and value.",
      "dct:accrualPeriodicity": "daily",
      "bsis:cadence": "daily",
      "bsis:grain": "(symbol, date, id)",
      "bsis:primaryKey": "symbol, date, id",
      "bsis:trainingUse": "caution",
