      "schema:description": "Delivery and traded quantity broken out by NSE trading series.",
      "dct:accrualPeriodicity": "daily_t_plus_1",
      "bsis:cadence": "daily_t_plus_1",
      "bsis:grain": "(symbol, date, series)",
      "bsis:primaryKey": "symbol, date, series",
