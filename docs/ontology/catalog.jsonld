      "dct:description": "Scored news articles and exchange announcements across 15 years — the only panel here deep enough for a real event study.",
      "dct:identifier": "news_sentiment_items",
      "schema:name": "news_sentiment_items",
      "schema:description": "Scored news articles and exchange announcements across 15 years — the only panel here deep enough for a real event study.",
