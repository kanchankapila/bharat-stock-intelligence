          "@id": "schema:Dataset"
        }
      ],
      "dct:title": "Factor edge ledger",
      "dct:description": "The platform's own measurement ledger: rank-IC and hit-AUC per factor, regime and horizon, with the independent-observation count and a verdict.",
      "dct:identifier": "factor_edge_history",
      "schema:name": "factor_edge_history",
      "schema:description": "The platform's own measurement ledger: rank-IC and hit-AUC per factor, regime and horizon, with the independent-observation count and a verdict.",
      "dct:accrualPeriodicity": "on_grading",
      "bsis:cadence": "on_grading",
      "bsis:grain": "(run_at, table_name, score_col, horizon_days)",
      "bsis:primaryKey": "run_at, table_name, score_col, horizon_days",
      "bsis:trainingUse": "forbidden",
      "bsis:entity": {
        "@id": "bsi:EdgeReading"
      },
      "dcat:inCatalog": {
        "@id": "bsi:catalog"
      },
      "bsis:freshnessColumn": "run_at",
      "bsis:writtenBy": "factor_edge.py",
      "bsis:caveat": [
        "READ `eff_dates` BEFORE the reading. Overlapping forward windows inflate a correlation by roughly the horizon factor, and effective dates are the guard that exposes it.",
        "`verdict` values include the literal string `no edge` with a space, and `n/a` — match them exactly.",
        "`table_name` and `score_col` reuse the generic source/name properties: this row is describing a COLUMN, not a table."
      ],
      "schema:variableMeasured": [
        {
          "@id": "_:pv_factor_edge_history_run_at"
        },
        {
          "@id": "_:pv_factor_edge_history_table_name"
        },
